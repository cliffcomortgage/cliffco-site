# Auto-imported headshots (regenerate via scripts/import-headshots.mjs)
# Kept in repo so the deployed site has photos without needing OneDrive access at build time.

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Trial fonts — kept locally for design work, not redistributed
brand/fonts/

# Full-resolution Adobe Stock originals. Everything in website/public/ is published,
# so commit only the resized web versions (e.g. *-hero-800/1600/2400.webp), never the
# original downloads.
website/public/**/AdobeStock_*

# Claude Code local settings (personal permissions, not shared) —
# but DO share project skills so the whole team gets them.
.claude/*
!.claude/skills/
Guidelines/SG Capital/Flex Connect Tutorial.mp4
.vercel
.env*

# Renovation reference material (flyers, training deck, product matrix).
# Kept locally only: ~45MB including a 30MB PPTX, which would bloat every clone
# permanently. The authoritative product data lives in Guidelines/.
Renovation Documents/

# Stock photo originals. Kept locally only - these are 6-14MB each and the
# web-sized versions in website/public/images are what actually ship.
# Regenerate with the sharp snippet noted in the hero commits if a crop changes.
brand/stock/
