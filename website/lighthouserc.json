{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/about/index.html",
        "http://localhost/loans/index.html",
        "http://localhost/loans/non-qm-self-employed/index.html",
        "http://localhost/loans/dscr/index.html",
        "http://localhost/loans/reverse-mortgage/index.html",
        "http://localhost/loans/business-bank-statement/index.html",
        "http://localhost/locations/new-york/long-island/index.html",
        "http://localhost/locations/florida/orlando/index.html",
        "http://localhost/loan-officers/christopher-clifford/index.html",
        "http://localhost/licensing/index.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],

        "is-crawlable": "error",
        "label": "error",
        "viewport": "error",
        "html-has-lang": "error",
        "meta-description": "error",
        "document-title": "error",

        "categories:performance": "off",
        "categories:best-practices": "off",
        "first-contentful-paint": "off",
        "interactive": "off",
        "largest-contentful-paint": "off",
        "total-blocking-time": "off",
        "speed-index": "off",
        "render-blocking-resources": "off",
        "render-blocking-insight": "off",
        "cache-insight": "off",
        "network-dependency-tree-insight": "off",
        "image-delivery-insight": "off",
        "modern-image-formats": "off",
        "unsized-images": "off",
        "uses-responsive-images": "off",
        "uses-long-cache-ttl": "off",
        "unused-javascript": "off",
        "unused-css-rules": "off",
        "uses-rel-preconnect": "off",
        "font-display": "off",
        "errors-in-console": "off",
        "uses-text-compression": "off",
        "csp-xss": "off",
        "total-byte-weight": "off",
        "color-contrast": "off",
        "tap-targets": "off",
        "target-size": "off",
        "robots-txt": "off",
        "forced-reflow-insight": "off",
        "lcp-discovery-insight": "off",
        "cls-culprits-insight": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
