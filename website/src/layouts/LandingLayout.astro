---
/**
 * Minimal, distraction-free layout for ads-only landing pages: logo + phone
 * CTA header, no site nav, no footer link list. Unlisted by design - reached
 * only via paid ads, never linked from the main site. Noindexed by default; a page can
 * opt in to indexing by passing index={true} (the NJ grant lander does, since it replaces
 * an already-indexed WordPress page).
 */
import "../styles/global.css";
import Meta from "../components/seo/Meta.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import PostHog from "../components/posthog.astro";
import Analytics from "../components/Analytics.astro";
import { COMPANY } from "../data/company";
import { FOOTER_MAIN_DISCLOSURE } from "../data/disclosures";

interface Props {
  title: string;
  description: string;
  schema?: object | object[];
  phone: string;
  phoneE164: string;
  /** Opt this lander in to search indexing. Defaults to noindex. */
  index?: boolean;
}

const { title, description, schema, phone, phoneE164, index = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <Meta title={title} description={description} noindex={!index} />
    {schema && <JsonLd data={schema} />}
    <PostHog />
    <Analytics />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Montserrat:wght@600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Montserrat:wght@600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" /></noscript>
    <!-- HubSpot tracking: sets the hubspotutk cookie so form leads carry their ad source.
         Deferred until idle/first interaction, same as the main layout. -->
    <script is:inline>
      (function () {
        var loaded = false;
        function loadHs() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.id = 'hs-script-loader';
          s.async = true;
          s.defer = true;
          s.src = 'https://js.hs-scripts.com/21616430.js';
          document.head.appendChild(s);
        }
        if ('requestIdleCallback' in window) requestIdleCallback(loadHs, { timeout: 8000 });
        else setTimeout(loadHs, 8000);
        ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (e) {
          addEventListener(e, loadHs, { once: true, passive: true });
        });
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col">

    <header class="bg-white border-b border-[var(--color-ink)] sticky top-0 z-40">
      <div class="container-wide flex items-center justify-between gap-4 py-4">
        <span class="flex items-center no-underline shrink-0" aria-label={COMPANY.legalName}>
          <img src="/images/cliffco-logo.png" alt={COMPANY.legalName} width="1730" height="409" class="h-9 w-auto" loading="eager" />
        </span>
        <a href={`tel:${phoneE164}`} class="btn btn-primary text-sm !py-2 !px-5 shrink-0 hidden sm:inline-flex">Call {phone}</a>
        <a href={`tel:${phoneE164}`} class="btn btn-primary text-sm !py-2.5 !px-3 shrink-0 sm:hidden" aria-label={`Call ${phone}`}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
        </a>
      </div>
    </header>

    <main class="flex-1 flex flex-col">
      <slot />
    </main>

    <footer class="bg-[var(--color-rich-black)] text-white">
      <div class="container-wide py-10">

        <!-- Top row: logo + links -->
        <div class="flex flex-wrap gap-4 justify-between items-center pb-6 border-b border-white/10">
          <p class="font-[var(--font-logo)] font-semibold tracking-[0.18em] text-base">{COMPANY.legalName.toUpperCase()}</p>
          <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a href="/" class="text-white/60 hover:text-white no-underline">Full Site</a>
            <a href="/loans/" class="text-white/60 hover:text-white no-underline">Loan Programs</a>
            <a href="/loan-officers/" class="text-white/60 hover:text-white no-underline">Find a Loan Officer</a>
            <a href="/licensing/" class="text-white/60 hover:text-white no-underline">State Licensing</a>
            <a href="/legal/privacy/" class="text-white/60 hover:text-white no-underline">Privacy Policy</a>
            <a href="/legal/accessibility/" class="text-white/60 hover:text-white no-underline">Accessibility</a>
            <a href="https://www.nmlsconsumeraccess.org/" class="text-white/60 hover:text-white no-underline" target="_blank" rel="noopener">NMLS Consumer Access</a>
          </div>
        </div>

        <!-- Branch info -->
        <div class="mt-6 pb-6 border-b border-white/10 text-sm text-white/60">
          <p class="font-semibold text-white/80">Cliffco Mortgage Bankers &middot; Branchburg, NJ</p>
          <p class="mt-1">3121 Route 22 East, 3rd Floor, Office 313</p>
          <p class="mt-0.5">Branchburg, NJ 08876 &middot; NMLS #2671359</p>
          <p class="mt-0.5"><a href="tel:5164087300" class="text-white/70 hover:text-white no-underline">Office: 516-408-7300</a></p>
        </div>

        <!-- Disclaimer: the official corporate text, same as the live page and main site footer -->
        <div class="mt-6 text-xs text-white/60 leading-relaxed">
          <p>{FOOTER_MAIN_DISCLOSURE}</p>
        </div>

        <p class="mt-6 text-xs text-white/60">&copy; 2026 Cliffco, Inc. &middot; NMLS #65328 &middot; Equal Housing Lender</p>

      </div>
    </footer>
  </body>
</html>
