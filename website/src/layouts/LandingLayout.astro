---
/**
 * Minimal, distraction-free layout for ads-only landing pages: logo + phone
 * CTA header, no site nav, no footer link list. Unlisted by design - reached
 * only via paid ads, never linked from the main site. Always noindexed.
 */
import "../styles/global.css";
import Meta from "../components/seo/Meta.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import PostHog from "../components/posthog.astro";
import { COMPANY } from "../data/company";

interface Props {
  title: string;
  description: string;
  schema?: object | object[];
  phone: string;
  phoneE164: string;
}

const { title, description, schema, phone, phoneE164 } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <Meta title={title} description={description} noindex={true} />
    {schema && <JsonLd data={schema} />}
    <PostHog />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&family=Montserrat:wght@600&display=optional" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&family=Montserrat:wght@600&display=optional" /></noscript>
  </head>

  <body class="min-h-screen flex flex-col">

    <header class="bg-white border-b border-[var(--color-mist-gray)] sticky top-0 z-40">
      <div class="container-wide flex items-center justify-between gap-4 py-4">
        <span class="flex items-center no-underline shrink-0" aria-label={COMPANY.legalName}>
          <img src="/images/content%20images/Cliffco%20Only@4x.png" alt={COMPANY.legalName} class="h-[20px] w-auto" loading="eager" />
        </span>
        <a href={`tel:${phoneE164}`} class="btn btn-primary text-sm !py-2 !px-5 shrink-0 hidden sm:inline-flex">Call {phone}</a>
        <a href={`tel:${phoneE164}`} class="btn btn-primary text-sm !py-2.5 !px-3 shrink-0 sm:hidden" aria-label={`Call ${phone}`}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
        </a>
      </div>
    </header>

    <main class="flex-1 flex flex-col">
      <slot />
    </main>

    <footer class="bg-[var(--color-rich-black)] text-white">
      <div class="container-wide py-10">

        <!-- Top row: logo + links -->
        <div class="flex flex-wrap gap-4 justify-between items-center pb-6 border-b border-white/10">
          <img src="/images/content%20images/Cliffco%20Only@4x.png" alt="Cliffco Mortgage Bankers" class="h-6 w-auto" style="filter: brightness(0) invert(1);" loading="lazy" />
          <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a href="https://cliffcomortgage.com/" class="text-white/60 hover:text-white no-underline" target="_blank" rel="noopener">Full Site</a>
            <a href="https://cliffcomortgage.com/licensing/" class="text-white/60 hover:text-white no-underline" target="_blank" rel="noopener">Licensing</a>
            <a href="https://cliffcomortgage.com/privacy-policy/" class="text-white/60 hover:text-white no-underline" target="_blank" rel="noopener">Privacy Policy</a>
            <a href="https://www.nmlsconsumeraccess.org/" class="text-white/60 hover:text-white no-underline" target="_blank" rel="noopener">NMLS Consumer Access</a>
          </div>
        </div>

        <!-- Branch info -->
        <div class="mt-6 pb-6 border-b border-white/10 text-sm text-white/60">
          <p class="font-semibold text-white/80">Cliffco Mortgage Bankers &middot; Branchburg, NJ</p>
          <p class="mt-1">3121 Route 22 East, 3rd Floor, Office 313</p>
          <p class="mt-0.5">Branchburg, NJ 08876 &middot; NMLS #2671359</p>
          <p class="mt-0.5"><a href="tel:5164087300" class="hover:text-white no-underline">Office: 516-408-7300</a></p>
        </div>

        <!-- Disclaimer -->
        <div class="mt-6 text-xs text-white/40 leading-relaxed">
          <p>
            Cliffco, Inc. is not affiliated with or acting on behalf of the FHA or any government entity. Equal Housing Lender. Cliffco, Inc. Corporate NMLS#65328 (<a href="https://www.nmlsconsumeraccess.org/" class="text-white/50 hover:text-white underline" target="_blank" rel="noopener">www.nmlsconsumeraccess.org</a>) 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553 (516) 408-7300. FL Office of Financial Regulation MLD1245; NJ Department of Banking &amp; Insurance; NC Commissioner of Banks L-211081; PA Department of Banking &amp; Securities 45275. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice.
          </p>
        </div>

        <p class="mt-6 text-xs text-white/30">&copy; 2026 Cliffco, Inc. &middot; NMLS #65328 &middot; Equal Housing Lender</p>

      </div>
    </footer>
  </body>
</html>
