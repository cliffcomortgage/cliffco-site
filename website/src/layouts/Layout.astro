---
import "../styles/global.css";
import Meta from "../components/seo/Meta.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { organizationSchema, websiteSchema, articleSchema } from "../lib/schema";
import { LOAN_OFFICERS } from "../data/loan-officers";

// Compact LO map passed to client - only what the attribution bar needs
const loMap = Object.fromEntries(
  LOAN_OFFICERS.map(lo => [lo.slug, {
    name: lo.displayName,
    title: lo.title,
    nmls: lo.nmls,
    phone: lo.links?.directPhone ?? null,
    apply: lo.links?.applyNow ?? null,
    photo: lo.hasPhoto ?? false,
  }])
);

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  locale?: "en-US" | "es-US";
  alternateLocales?: { hreflang: string; href: string }[];
  noindex?: boolean;
  type?: "website" | "article";
  /** Additional JSON-LD blocks specific to this page */
  schema?: object | object[];
}

const {
  title,
  description,
  canonical,
  image,
  locale = "en-US",
  alternateLocales,
  noindex,
  type,
  schema,
} = Astro.props;

const autoArticleSchema =
  type === "article"
    ? articleSchema({
        headline: title,
        description,
        url: Astro.url.pathname,
        datePublished: "2026-05-22",
        dateModified: "2026-05-22",
      })
    : null;

const baseSchema: object[] = [
  organizationSchema(),
  websiteSchema(),
  ...(autoArticleSchema ? [autoArticleSchema] : []),
];
const allSchema = schema
  ? [...baseSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : baseSchema;
---

<!doctype html>
<html lang={locale.split("-")[0]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <Meta
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      locale={locale}
      alternateLocales={alternateLocales}
      noindex={noindex}
      type={type}
    />

    <JsonLd data={allSchema} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Montserrat:wght@600&display=optional" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Custom cursor dot - positioned and colored by JS below -->
    <div id="cf-cursor" aria-hidden="true"></div>

    <script>
    (() => {
      // ═══════════════════════════════════════════════
      // SECTION 1 - CUSTOM CURSOR
      // Skip on touch / pointer-coarse devices.
      // ═══════════════════════════════════════════════
      const dot = document.getElementById('cf-cursor');
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isTouch = window.matchMedia('(pointer: coarse)').matches;

      if (dot && !prefersReduced && !isTouch) {
        const dotEl = dot as HTMLElement;
        let mx = window.innerWidth / 2;
        let my = window.innerHeight / 2;
        let cx = mx, cy = my;
        let scale = 1, targetScale = 1;

        const LERP_POS   = 0.22;
        const LERP_SCALE = 0.18;

        const COLORS = {
          default : '#6633cc',  // bright plum
          link    : '#9966ee',  // lighter plum
          button  : '#4a1fa0',  // deeper plum
          card    : '#bde8f1',  // ice blue (brand color)
          dark    : '#ffffff',  // white on dark backgrounds
        };

        let targetColor = COLORS.default;

        const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

        // Mark dark-background sections once DOM is ready
        document.querySelectorAll('section, footer').forEach(el => {
          const bg = getComputedStyle(el).backgroundColor;
          if (bg === 'rgb(13, 13, 13)' || bg === 'rgb(26, 0, 64)') {
            (el as HTMLElement).dataset.cursorDark = '';
          }
        });

        // Also mark accent-gradient sections (computed style may not reflect CSS gradient bg)
        document.querySelectorAll('.accent-gradient').forEach(el => {
          (el as HTMLElement).dataset.cursorDark = '';
        });

        function getContext(el: Element | null): keyof typeof COLORS {
          if (!el) return 'default';
          if (el.closest('[data-cursor-dark]')) return 'dark';
          if (el.closest('.btn, button, [role="button"], input[type="submit"]')) return 'button';
          if (el.closest('a')) return 'link';
          if (el.closest('.card, article, figure, picture')) return 'card';
          return 'default';
        }

        document.addEventListener('mousemove', (e) => {
          mx = e.clientX;
          my = e.clientY;
          const hit = document.elementFromPoint(mx, my);
          const ctx = getContext(hit);
          targetColor = COLORS[ctx];
          targetScale = ctx === 'default' ? 1 : 1.6;
        });

        document.addEventListener('mouseleave', () => { dotEl.style.opacity = '0'; });
        document.addEventListener('mouseenter', () => { dotEl.style.opacity = '1'; });

        let lastColor = COLORS.default;
        function tick() {
          cx = lerp(cx, mx, LERP_POS);
          cy = lerp(cy, my, LERP_POS);
          scale = lerp(scale, targetScale, LERP_SCALE);
          dotEl.style.transform = `translate(${cx}px, ${cy}px) scale(${scale})`;
          if (lastColor !== targetColor) {
            dotEl.style.background = targetColor;
            lastColor = targetColor;
          }
          requestAnimationFrame(tick);
        }
        tick();
      }

      // ═══════════════════════════════════════════════
      // SECTION 2 - HEADER GLASSMORPHISM ON SCROLL
      // ═══════════════════════════════════════════════
      const header = document.querySelector('header');
      if (header) {
        const onScroll = () => {
          header.classList.toggle('scrolled', window.scrollY > 16);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // ═══════════════════════════════════════════════
      // SECTION 3 - SCROLL-REVEAL (IntersectionObserver)
      // ═══════════════════════════════════════════════
      if (!prefersReduced) {
        const SELECTORS = [
          'main h1', 'main h2', 'main h3',
          'main .lead', 'main .eyebrow',
          'main .card', 'main article',
          'main picture', 'main dl',
          'main .btn:not(header .btn)',
        ].join(', ');

        const vh = window.innerHeight;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).classList.add('cf-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -24px 0px' });

        document.querySelectorAll(SELECTORS).forEach((el, siblingIdx) => {
          // Skip elements already fully in view on load (avoids flash)
          const rect = el.getBoundingClientRect();
          if (rect.top > vh * 0.92) {
            el.classList.add('cf-reveal');
            // Stagger siblings in the same parent
            const siblings = Array.from(el.parentElement?.querySelectorAll(':scope > *') ?? []);
            const idx = siblings.indexOf(el);
            (el as HTMLElement).style.transitionDelay = `${Math.min(idx * 55, 320)}ms`;
            observer.observe(el);
          }
        });
      }

      // ═══════════════════════════════════════════════
      // SECTION 4 - HERO STAGGER ON PAGE LOAD
      // ═══════════════════════════════════════════════
      if (!prefersReduced) {
        const hero = document.querySelector<HTMLElement>('main section:first-of-type');
        if (hero) {
          const children = hero.querySelectorAll<HTMLElement>(':scope > .container-wide > *');
          children.forEach((el, i) => {
            el.style.animation = `cf-hero-reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) ${i * 120}ms both`;
          });
        }
      }
    })();
    </script>

    <!-- ═══════════════════════════════════════════════
         LO ATTRIBUTION BAR
         Sets a 30-day cookie on LO profile visits.
         Shows a sticky bar with the LO's info on all
         other pages. Dismiss persists for the session.
         ═══════════════════════════════════════════════ -->
    <script define:vars={{ loMap }}>
    (() => {
      const COOKIE  = 'cliffco_lo';
      const SESSION = 'cliffco_lo_dismissed';

      function getCookie(name) {
        const m = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]*)'));
        return m ? decodeURIComponent(m[1]) : null;
      }
      function setCookie(name, value, days) {
        const exp = new Date(Date.now() + days * 864e5).toUTCString();
        document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + exp + '; path=/; SameSite=Lax';
      }

      const path = window.location.pathname;
      // Detect LO detail page: /loan-officers/{slug}/
      const loMatch = path.match(/\/loan-officers\/([^\/]+)\/?$/);
      const pageSlug = loMatch ? loMatch[1] : null;

      // On any LO page: set/refresh the cookie, then stop - bar never shows here
      if (pageSlug && loMap[pageSlug]) {
        setCookie(COOKIE, pageSlug, 30);
        return;
      }

      // Everywhere else: check for the stored LO
      const slug = getCookie(COOKIE);
      if (!slug || !loMap[slug]) return;

      // Respect session dismissal
      if (sessionStorage.getItem(SESSION) === slug) return;

      const lo = loMap[slug];

      // ── Build the bar ──────────────────────────────
      const bar = document.createElement('div');
      bar.id = 'lo-bar';
      bar.setAttribute('role', 'region');
      bar.setAttribute('aria-label', 'Your loan officer: ' + lo.name);
      bar.style.cssText = [
        'position:fixed', 'bottom:0', 'left:0', 'right:0', 'z-index:9998',
        'background:#0d0d0d', 'color:#fff',
        'display:flex', 'align-items:center', 'gap:12px',
        'padding:10px 20px',
        'box-shadow:0 -2px 20px rgba(0,0,0,0.4)',
        'border-top:1px solid rgba(102,51,204,0.5)',
        'font-family:inherit', 'font-size:14px',
        'animation:lo-bar-slide-up 0.35s cubic-bezier(0.16,1,0.3,1) both',
      ].join(';');

      // Photo or initial avatar
      const photoHtml = lo.photo
        ? '<img src="/team/' + slug + '.jpg" alt="' + lo.name + '" style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid rgba(102,51,204,0.7);flex-shrink:0;" loading="lazy" />'
        : '<div style="width:40px;height:40px;border-radius:50%;background:rgba(102,51,204,0.25);border:2px solid rgba(102,51,204,0.5);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-weight:700;color:#bde8f1;font-size:15px;">' + lo.name.charAt(0) + '</div>';

      // Info block
      const infoHtml = '<div style="flex:1;min-width:0;display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;">'
        + '<span style="font-size:11px;text-transform:uppercase;letter-spacing:0.12em;color:#bde8f1;white-space:nowrap;">Browsing with</span>'
        + '<strong style="font-size:15px;white-space:nowrap;">' + lo.name + '</strong>'
        + '<span style="font-size:12px;color:rgba(255,255,255,0.55);white-space:nowrap;">' + lo.title + '</span>'
        + '<span style="font-size:11px;color:rgba(255,255,255,0.35);white-space:nowrap;">NMLS #' + lo.nmls + '</span>'
        + '</div>';

      // Action buttons
      const phoneBtn = lo.phone
        ? '<a href="tel:' + lo.phone.replace(/[^+\d]/g, '') + '" style="display:inline-flex;align-items:center;gap:6px;background:#6633cc;color:#fff;text-decoration:none;padding:7px 16px;border-radius:999px;font-size:13px;font-weight:600;white-space:nowrap;flex-shrink:0;">'
          + '<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>'
          + 'Call</a>'
        : '';

      const applyBtn = lo.apply
        ? '<a href="' + lo.apply + '" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;background:transparent;color:#fff;text-decoration:none;padding:7px 16px;border-radius:999px;font-size:13px;font-weight:600;border:1px solid rgba(255,255,255,0.3);white-space:nowrap;flex-shrink:0;">Apply Now</a>'
        : '';

      const dismissBtn = '<button id="lo-bar-x" aria-label="Dismiss" style="background:none;border:none;color:rgba(255,255,255,0.45);font-size:22px;line-height:1;padding:4px 6px;flex-shrink:0;cursor:auto;">×</button>';

      bar.innerHTML = photoHtml + infoHtml
        + '<div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">'
        + phoneBtn + applyBtn + dismissBtn
        + '</div>';

      document.body.appendChild(bar);
      // Push page content up so footer isn't hidden behind bar
      document.body.style.paddingBottom = '68px';

      document.getElementById('lo-bar-x').addEventListener('click', () => {
        bar.style.animation = 'lo-bar-slide-down 0.25s ease-in both';
        setTimeout(() => {
          bar.remove();
          document.body.style.paddingBottom = '';
        }, 240);
        sessionStorage.setItem(SESSION, slug);
      });
    })();
    </script>

    <style>
      @keyframes lo-bar-slide-up {
        from { transform: translateY(100%); opacity: 0; }
        to   { transform: translateY(0);    opacity: 1; }
      }
      @keyframes lo-bar-slide-down {
        from { transform: translateY(0);    opacity: 1; }
        to   { transform: translateY(100%); opacity: 0; }
      }
    </style>
  </body>
</html>
