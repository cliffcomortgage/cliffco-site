---
/**
 * NJHMFA First Generation Homebuyer Program - ads-only landing page.
 * Lives at /nj-grant-program/, the same URL the Google Ads campaign and sitelinks
 * use on the current WordPress site, so the ads keep working when this site
 * replaces it (no re-pointing). Copy matches the live WordPress page (2026-10-07).
 * Also the source for the HubSpot export (nj-22k-grant-hubspot.html):
 * edit here, rebuild, then regenerate the self-contained file.
 */
import LandingLayout from "../../layouts/LandingLayout.astro";
import { faqPageSchema } from "../../lib/schema";

const TIER_22K = ["Bergen", "Essex", "Hudson", "Hunterdon", "Mercer", "Middlesex", "Monmouth", "Morris", "Ocean", "Passaic", "Somerset", "Union"];
const TIER_17K = ["Atlantic", "Burlington", "Camden", "Cape May", "Cumberland", "Gloucester", "Salem", "Sussex", "Warren"];

const benefits = [
  { name: "Up to $22,000", blurb: "Toward your down payment, closing costs, or both. Your exact amount depends on which NJ county you're buying in." },
  { name: "No monthly payments", blurb: "The assistance is a 0% interest loan with no monthly bill, on top of your regular mortgage payment." },
  { name: "Forgiven after 5 years", blurb: "Stay in the home as your primary residence for 5 years without refinancing, and the assistance loan is forgiven." },
  { name: "Every NJ county is eligible", blurb: "All 21 counties are covered. Some qualify for $22,000, others for $17,000. Income limits will apply and all loans are subject to NJHMFA underwriting guidelines." },
];

const howItWorks = [
  { step: "1", title: "See if you qualify", body: "A first-generation homebuyer is a first-time buyer whose parents don't currently own a home, or someone who was in foster care or experienced youth homelessness. Takes 2 minutes to check." },
  { step: "2", title: "Talk to a real loan officer", body: "Eddie Morais, NMLS 243926, and Gary Johansen, NMLS 339278, are both licensed in NJ and will walk you through exactly what you qualify for. No cost, no obligation." },
  { step: "3", title: "One combined application", body: "Your mortgage, the Down Payment Assistance loan, and the First Generation grant are all part of the same NJHMFA application, not three separate processes." },
  { step: "4", title: "Close and move in", body: "Occupy the home as your primary residence within 60 days of closing, and the 5-year forgiveness clock starts." },
];

const objections = [
  {
    q: "My parents used to own a home. Doesn't that disqualify me?",
    a: "Not necessarily. The rule is about present ownership, not history. If your parents don't currently own any residential real estate, anywhere, you can still qualify even if they owned a home in the past and sold it. A Cliffco loan officer can confirm your specific situation.",
  },
  {
    q: "Is this actually free money?",
    a: "It's a forgivable loan, not a grant: $0 interest, no monthly payment, and forgiven if you live in the home as your primary residence for 5 years without refinancing. If you sell, move out, or refinance before then, the assistance becomes repayable.",
  },
  {
    q: "What if my county isn't one of the ones offering $22,000?",
    a: "Every county in New Jersey qualifies for this program. Twelve counties (including Bergen, Essex, Middlesex, and Union) offer the full $22,000. The remaining nine offer $17,000. Either way, you're getting real assistance toward your purchase.",
  },
  {
    q: "Do I need excellent credit to qualify?",
    a: "You'll need to meet NJHMFA's credit score and debt-to-income guidelines, which are more flexible than many buyers assume. Checking your eligibility costs nothing and doesn't affect your credit.",
  },
  {
    q: "Will I have to deal with multiple lenders or agencies?",
    a: "No. Your Cliffco loan officer originates the NJHMFA first mortgage and handles the Down Payment Assistance and First Generation Homebuyer paperwork as one combined application.",
  },
];

const faq = [
  {
    question: "What exactly is the NJHMFA First Generation Homebuyer Program?",
    answer: "It's a New Jersey state program that provides $7,000 toward a down payment or closing costs, on top of NJHMFA's Smart Start Down Payment Assistance Program. Combined, qualified buyers can receive up to $22,000, depending on the county. It must be paired with an NJHMFA first mortgage.",
  },
  {
    question: "Is it a loan or a grant?",
    answer: "It's structured as a forgivable loan: 0% interest, no monthly payments, and forgiven in full after 5 years of owner-occupancy without refinancing or otherwise conveying the first mortgage.",
  },
  {
    question: "Who counts as a first-generation homebuyer?",
    answer: "A first-time homebuyer whose parents or legal guardians have no present ownership interest in any residential property anywhere, and whose spouse or domestic partner hasn't owned a primary residence in the past 3 years. It also includes anyone who was ever in foster care in New Jersey, was an emancipated youth, or was a homeless or unaccompanied youth under the McKinney-Vento Act.",
  },
  {
    question: "How much assistance is available in my county?",
    answer: `Twelve counties qualify for $22,000 total: ${TIER_22K.join(", ")}. The remaining nine counties qualify for $17,000 total: ${TIER_17K.join(", ")}.`,
  },
  {
    question: "How do I apply?",
    answer: "Talk to a licensed Cliffco loan officer serving New Jersey. Eddie Morais and Gary Johansen both originate NJHMFA loans and can confirm your eligibility and county amount at no cost.",
  },
];

// Real Cliffco client reviews (company-wide, not NJ-specific).
const reviews = [
  { quote: "It was a smooth, straight and less stressful process. I see it as a miracle. Everything was moving as planned. The agent with me gave me all the necessary info to make the process easy and I moved by her advice and it paid off. My first time buying a home was a great experience! Cliffco Mortgage is the ideal. I will use them again and again.", author: "Obiegbu R.", platform: "Google" },
  { quote: "Seamless process. No surprises. And minimum fees for closing.", author: "Mel D.", platform: "Google" },
  { quote: "I had a great experience with Cliffco. From the very beginning, the team was responsive, supportive, and thorough, walking me through the process and answering all of my questions with care.", author: "Andres A.", platform: "Google" },
];

const schema = [faqPageSchema([...objections.map((o) => ({ question: o.q, answer: o.a })), ...faq])];
---

<LandingLayout
  title="Up to $22,000 for First-Gen NJ Homebuyers | Cliffco"
  description="NJHMFA's First Generation Homebuyer Program offers up to $22,000 toward your down payment or closing costs. No monthly payments, forgiven after 5 years."
  schema={schema}
  phone="(908) 370-1575"
  phoneE164="+19083701575"
  index={true}
>
  <!-- HERO: copy (left) + form (right) -->
  <section class="relative overflow-hidden bg-white border-b border-[var(--color-ink)]">
    <div class="container-wide py-12 lg:py-16 grid lg:grid-cols-2 gap-10 lg:gap-12 items-start">
      <div>
        <p class="eyebrow">You may be eligible for</p>
        <h1 class="mt-4" style="font-size: clamp(2.25rem, 4.4vw, 3.5rem); line-height: 1.06; font-weight: 700; color: var(--color-ink);">
          Up to $22,000 to buy your first home in New Jersey.
        </h1>
        <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-[var(--color-text)]">
          The New Jersey Housing and Mortgage Finance Agency (NJHMFA) First Generation Homebuyer Program
          provides qualified borrowers with $7,000 towards down payment and/or closing costs when paired with
          NJHMFA First Mortgage Loan and Down Payment Assistance program. Depending on the county, total
          assistance can vary from $17,000 to $22,000. The best part is that the assistance has no monthly
          payment and is forgiven if you live in the property for 5 years and the loan has not been refinanced
          in that time.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--color-text-muted)]">
          <span class="font-semibold text-[var(--color-ink)]">4.9<span class="text-[var(--color-ink)]" aria-hidden="true">★</span></span>
          <span>3,617 verified reviews on Experience.com</span>
          <span class="hidden sm:inline" aria-hidden="true">·</span>
          <span>Lending since 1989 · NMLS #65328</span>
        </div>
        <p class="mt-5 max-w-xl text-sm text-[var(--color-text-muted)]">No cost to check. No impact to your credit. Cliffco, Inc. NMLS 65328 is a participating lender with the NJHMFA and Loan Officers are licensed by the NJ Department of Banking and Insurance.</p>
      </div>

      <!-- Primary conversion: form in the hero -->
      <div id="apply" class="rounded-2xl border-2 border-[var(--color-ink)] bg-white p-6 scroll-mt-24">
        <p class="eyebrow">Check your eligibility</p>
        <p class="mt-3 text-lg font-semibold text-[var(--color-ink)]">See if you qualify. It takes 2 minutes.</p>
        <div id="nj-lead-form" class="mt-4"></div>
        <p class="mt-3 text-xs text-[var(--color-text-muted)]">Prefer to talk? <a href="tel:+19083701575" class="font-semibold text-[var(--color-ink)] no-underline hover:underline">Call (908) 370-1575</a></p>
      </div>
    </div>
  </section>

  <!-- TRUST STATS -->
  <section class="bg-[var(--color-ink)] text-white">
    <div class="container-wide py-10 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-8 divide-y divide-white/15 md:divide-y-0 md:divide-x">
      {[
        ["$22,000", "Maximum combined assistance"],
        ["1989", "Cliffco has been lending since"],
        ["21 / 21", "NJ counties covered"],
        ["5 years", "Until the loan is fully forgiven"],
      ].map(([stat, label], i) => (
        <div class={i === 0 ? "md:pl-0 md:pr-8" : "pt-8 md:pt-0 md:px-8"}>
          <p class="text-2xl font-bold !text-white" style="font-family: var(--font-display);">{stat}</p>
          <p class="mt-1 text-sm text-white/65">{label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PAIN POINTS -->
  <section class="bg-white border-t border-[var(--color-ink)]" style="padding-block: var(--spacing-section);">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">If none of this feels familiar, that's the point</p>
      <h2 class="mt-3" style="font-size: var(--text-h2); font-weight: 700;">Saving a down payment is harder when nobody handed you a head start.</h2>
      <p class="mt-5 text-[var(--color-text)] leading-relaxed">
        If you're the first person in your family to buy a home, you're doing it without the things
        that make it easier for other buyers: no family down payment gift, no one who's been through
        the process to ask, and often the assumption that assistance programs are for someone else.
      </p>
      <p class="mt-4 text-[var(--color-text)] leading-relaxed">
        New Jersey built a program specifically for this. Not a general assistance fund you might not
        qualify for, one designed around exactly your situation.
      </p>
    </div>
  </section>

  <!-- TEAM (moved up: real, licensed, local proof) -->
  <section class="bg-white border-t border-[var(--color-ink)]" style="padding-block: var(--spacing-section);">
    <div class="container-wide">
      <p class="eyebrow">Who you'll talk to</p>
      <h2 class="mt-3 max-w-2xl" style="font-size: var(--text-h2); font-weight: 700;">Two licensed New Jersey loan officers, not a call center.</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 max-w-2xl">
        <div class="rounded-2xl border-2 border-[var(--color-ink)] bg-white p-6 flex flex-col">
          <img src="/team/edward-morais.webp" alt="Eddie Morais" class="w-24 h-24 rounded-xl object-cover" loading="lazy" />
          <h3 class="mt-4 text-base font-semibold text-[var(--color-ink)]">Eddie Morais</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Branch Manager &middot; NMLS #243926</p>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">23 years in mortgage lending. Speaks English, Spanish, and Portuguese.</p>
          <a href="tel:+19083701575" class="mt-4 text-sm font-semibold text-[var(--color-ink)] no-underline hover:underline">(908) 370-1575</a>
        </div>
        <div class="rounded-2xl border-2 border-[var(--color-ink)] bg-white p-6 flex flex-col">
          <img src="/team/gary-johansen.webp" alt="Gary Johansen" class="w-24 h-24 rounded-xl object-cover" loading="lazy" />
          <h3 class="mt-4 text-base font-semibold text-[var(--color-ink)]">Gary Johansen</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Regional Sales Director &middot; NMLS #339278</p>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">Over 30 years in mortgage lending, more than $15 billion closed.</p>
          <a href="tel:+15857038862" class="mt-4 text-sm font-semibold text-[var(--color-ink)] no-underline hover:underline">(585) 703-8862</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="bg-white border-t border-[var(--color-ink)]" style="padding-block: var(--spacing-section);">
    <div class="container-wide">
      <p class="eyebrow">What you actually get</p>
      <h2 class="mt-3 max-w-2xl" style="font-size: var(--text-h2); font-weight: 700;">Real assistance, with terms you can plan around.</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {benefits.map((b) => (
          <div class="card">
            <h3 class="text-base font-semibold text-[var(--color-ink)]" style="font-family: var(--font-display);">{b.name}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{b.blurb}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="#apply" class="btn btn-primary">Check My Eligibility</a>
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">Takes 2 minutes &middot; no cost &middot; no credit impact</p>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS: 3-program stack + county pills -->
  <section id="how-it-works" class="bg-white border-t border-[var(--color-ink)] scroll-mt-24" style="padding-block: var(--spacing-section);">
    <div class="container-wide">
      <p class="eyebrow">How the program works</p>
      <h2 class="mt-3 max-w-2xl" style="font-size: var(--text-h2); font-weight: 700;">Three NJHMFA programs, combined into one.</h2>
      <p class="mt-4 max-w-2xl text-[var(--color-text)] leading-relaxed">
        The First Generation Homebuyer Program provides $7,000 on its own. Paired with NJHMFA's
        Smart Start Down Payment Assistance Program (up to $15,000, depending on county) and an
        NJHMFA first mortgage, qualified buyers get up to $22,000 total toward their down payment
        or closing costs.
      </p>
      <p class="mt-4 max-w-2xl text-[var(--color-text)] leading-relaxed">
        Both assistance pieces are structured as 0% interest loans with no monthly payment, forgiven
        after 5 years of living in the home as your primary residence. Cliffco originates the first
        mortgage and helps you apply for both assistance programs as one process, not three separate
        applications.
      </p>

      <div class="mt-8 grid gap-3 sm:grid-cols-[1fr_auto_1fr_auto_1.15fr] items-center max-w-4xl">
        <div class="card text-center !p-4">
          <p class="text-xs uppercase tracking-wide text-[var(--color-text-muted)]">First Generation</p>
          <p class="mt-1 text-xl font-bold text-[var(--color-ink)]">$7,000</p>
        </div>
        <div class="text-center text-2xl font-bold text-[var(--color-text-muted)]">+</div>
        <div class="card text-center !p-4">
          <p class="text-xs uppercase tracking-wide text-[var(--color-text-muted)]">Smart Start DPA</p>
          <p class="mt-1 text-xl font-bold text-[var(--color-ink)]">up to $15,000</p>
        </div>
        <div class="text-center text-2xl font-bold text-[var(--color-text-muted)]">=</div>
        <div class="rounded-lg text-center p-4" style="background: var(--color-ink); color: #fff;">
          <p class="text-xs uppercase tracking-wide text-white/80">Total assistance</p>
          <p class="mt-1 text-xl font-bold">up to $22,000</p>
        </div>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2 max-w-4xl">
        <div>
          <p class="text-sm font-semibold text-[var(--color-ink)]">$22,000 counties <span class="text-[var(--color-text-muted)] font-normal">(12)</span></p>
          <div class="mt-3 flex flex-wrap gap-2">
            {TIER_22K.map((c) => (
              <span class="inline-block rounded-full bg-[var(--color-ink)] px-3 py-1 text-xs font-medium text-white">{c}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-sm font-semibold text-[var(--color-ink)]">$17,000 counties <span class="text-[var(--color-text-muted)] font-normal">(9)</span></p>
          <div class="mt-3 flex flex-wrap gap-2">
            {TIER_17K.map((c) => (
              <span class="inline-block rounded-full bg-white border border-[var(--color-ink)] px-3 py-1 text-xs text-[var(--color-ink)]">{c}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="bg-white border-t border-[var(--color-ink)]" style="padding-block: var(--spacing-section);">
    <div class="container-wide">
      <p class="eyebrow">The process</p>
      <h2 class="mt-3 max-w-2xl" style="font-size: var(--text-h2); font-weight: 700;">Four steps, one application.</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {howItWorks.map((s) => (
          <div class="card">
            <span class="font-mono text-xs tracking-[0.12em] text-[var(--color-text-muted)]">0{s.step}</span>
            <h3 class="mt-4 text-base font-semibold text-[var(--color-ink)]">{s.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="bg-white border-t border-[var(--color-ink)]" style="padding-block: var(--spacing-section);">
    <div class="container-wide">
      <p class="eyebrow">What Cliffco clients say</p>
      <h2 class="mt-3 max-w-2xl" style="font-size: var(--text-h2); font-weight: 700;">Real reviews from real borrowers.</h2>
      <p class="mt-2 text-sm text-[var(--color-text-muted)]">Rated 4.9/5 on Experience.com from 3,617 verified reviews &middot; 5.0/5 on Zillow &middot; A+ with the BBB.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {reviews.map((r) => (
          <figure class="card flex flex-col">
            <div class="text-[var(--color-ink)] tracking-widest" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <blockquote class="mt-3 text-sm text-[var(--color-text)] leading-relaxed">{`“${r.quote}”`}</blockquote>
            <figcaption class="mt-4 text-sm font-semibold text-[var(--color-ink)]">{r.author} <span class="font-normal text-[var(--color-text-muted)]">&middot; {r.platform}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- OBJECTIONS -->
  <section id="who-qualifies" class="bg-white border-t border-[var(--color-ink)] scroll-mt-24" style="padding-block: var(--spacing-section);">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">Before you ask</p>
      <h2 class="mt-3" style="font-size: var(--text-h2); font-weight: 700;">The questions we hear most, answered directly.</h2>
      <div class="mt-8 space-y-6">
        {objections.map((o) => (
          <div class="border-b border-[var(--color-soft-gray)] pb-5">
            <h3 class="font-semibold text-[var(--color-ink)]">{o.q}</h3>
            <p class="mt-2 text-sm text-[var(--color-text)] leading-relaxed">{o.a}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="#apply" class="btn btn-primary">Check My Eligibility</a>
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">Takes 2 minutes &middot; no cost &middot; no credit impact</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-white border-t border-[var(--color-ink)] scroll-mt-24" style="padding-block: var(--spacing-section);">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">Common questions</p>
      <h2 class="mt-3" style="font-size: var(--text-h2); font-weight: 700;">First Generation Homebuyer Program FAQ.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)] leading-relaxed">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-[var(--color-ink)] text-white" style="padding-block: var(--spacing-section);">
    <div class="container-wide text-center">
      <h2 class="text-white md:whitespace-nowrap" style="font-size: var(--text-h2); font-weight: 700;">See what you qualify for. It takes 2 minutes.</h2>
      <p class="lead mt-4 text-white/85 max-w-2xl mx-auto">
        Tell us a little about your situation and a licensed New Jersey loan officer will confirm
        your eligibility and county amount, no cost, no obligation.
      </p>
      <ul class="mt-6 inline-block text-left space-y-2 text-sm text-white/75 list-none p-0">
        <li>&#10003; No cost to check eligibility</li>
        <li>&#10003; No impact to your credit</li>
        <li>&#10003; A real, licensed loan officer responds within 1 business day</li>
      </ul>
      <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <a href="#apply" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Check My Eligibility</a>
        <a href="tel:+19083701575" class="btn btn-secondary !border-white !text-white">Call (908) 370-1575</a>
      </div>
    </div>
  </section>

  <!-- Mobile sticky conversion bar -->
  <a href="#apply" class="fixed bottom-0 inset-x-0 z-50 lg:hidden bg-[var(--color-ink)] text-white text-center font-semibold py-4 no-underline" style="box-shadow: 0 -2px 16px rgba(0,0,0,0.18);">Check My Eligibility &middot; 2 Minutes</a>
</LandingLayout>

<style is:inline>@media (max-width: 1023px){ body { padding-bottom: 64px; } }</style>
<script is:inline charset="utf-8" src="//js.hsforms.net/forms/embed/v2.js"></script>
<script is:inline>
  // Render the HubSpot form via hbspt.forms.create for a reliable submit
  // callback (the new hs-form-frame embed's postMessage fires inconsistently).
  (function () {
    function createForm() {
      if (!(window.hbspt && window.hbspt.forms)) { return setTimeout(createForm, 200); }
      window.hbspt.forms.create({
        region: 'na1',
        portalId: '21616430',
        formId: 'd614cef1-1fd7-4a16-bce3-a3832c5be61c',
        target: '#nj-lead-form',
        onFormSubmitted: function () {
          if (window.cliffcoTrack) window.cliffcoTrack.conversion('AW-17848823591/ulN2CMSi190cEKfe_b5C', 0);
        }
      });
    }
    createForm();
  })();
</script>
