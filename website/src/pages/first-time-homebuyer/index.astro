---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { faqPageSchema, articleSchema } from "../../lib/schema";


const loanOptions = [
  {
    name: "FHA Loan",
    downPayment: "3.5% down",
    minFICO: "580+ FICO",
    highlight: true,
    description: "Government-backed, most flexible credit standards. The most common choice for first-time buyers. Mortgage insurance required.",
  },
  {
    name: "Conventional Loan",
    downPayment: "3% down",
    minFICO: "No minimum FICO",
    highlight: false,
    description: "Conventional loan with just 3% down. No upfront mortgage insurance premium. PMI cancels once you reach 20% equity.",
  },
  {
    name: "VA Loan",
    downPayment: "0% down",
    minFICO: "580+ FICO",
    highlight: false,
    description: "For active military, veterans, and eligible spouses. No down payment, no monthly mortgage insurance. One of the best programs available.",
  },
];

const faq = [
  {
    question: "How much do I really need to buy my first home?",
    answer: "Less than most people think. FHA loans require 3.5% down with a 580+ credit score. Conventional options go as low as 3%. VA loans require nothing down if you qualify. On top of the down payment, budget for 2 to 5 percent of the purchase price in closing costs, though seller concessions and lender credits can reduce what you bring to the table. Your Cliffco loan officer will walk through the exact numbers for your situation.",
  },
  {
    question: "What credit score do I need to buy a house?",
    answer: "FHA allows scores as low as 500 with 10% down, or 580 for the standard 3.5% down option. Conventional has no fixed minimum: the automated underwriting system looks at your full credit profile, and your score affects pricing rather than acting as a cutoff. VA loans don't have a government-mandated minimum, though Cliffco requires 580. If your score is below 580, there are still paths forward depending on your full financial picture.",
  },
  {
    question: "Should I get pre-qualified or pre-approved?",
    answer: "Pre-qualification is a quick estimate based on what you tell us. Pre-approval involves verifying your income, assets, and credit, which makes your offer much stronger. In a competitive market, sellers and real estate agents take pre-approved buyers more seriously. Cliffco provides full pre-approval letters, not just soft pre-quals.",
  },
  {
    question: "How long does it take to close on a first home?",
    answer: "Typically 30 to 45 days from accepted offer to closing, assuming the file is complete and the appraisal comes in cleanly. Cliffco loan officers are in contact with you throughout the process so there are no surprises. You will always know where you stand.",
  },
  {
    question: "What's the difference between the interest rate and APR?",
    answer: "The interest rate is the cost of borrowing expressed as a percentage. The APR (annual percentage rate) includes the rate plus certain fees, giving you a fuller picture of the loan's total cost. When comparing lenders, look at both. A low rate with high fees can cost more over time than a slightly higher rate with lower fees.",
  },
  {
    question: "Can I buy a home if I have student loans?",
    answer: "Yes. Student loan debt is factored into your debt-to-income (DTI) ratio. As long as the total of your monthly obligations, including the proposed mortgage payment, falls within program guidelines, student loans don't automatically disqualify you. FHA and conventional programs have different rules for how income-driven repayment plans are calculated, so the specific program matters. Your loan officer will review the best fit.",
  },
];

const schema = [
  faqPageSchema(faq),
  articleSchema({
    headline: "First-Time Homebuyer Mortgage Guide",
    description: "FHA, conventional, and VA loan options for first-time buyers. Low down payment programs, pre-approval, and real guidance from loan officers who walk you through every step.",
    url: "/first-time-homebuyer/",
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];

import AsymHero from "../../components/asym/AsymHero.astro";
import Split from "../../components/asym/Split.astro";
import FormCard from "../../components/asym/FormCard.astro";
import FaqList from "../../components/asym/FaqList.astro";
import CtaBand from "../../components/asym/CtaBand.astro";

const steps = [
  { heading: "Get pre-approved", body: "Your loan officer reviews your income, credit, and assets and gives you a pre-approval letter. This tells you exactly what you can afford and makes your offer competitive. Takes one business day." },
  { heading: "Find your home and go under contract", body: "Once you have an accepted offer, your loan officer orders the appraisal and begins underwriting. You'll provide documents and answer questions as they come up. We keep you informed at every stage." },
  { heading: "Close and get your keys", body: "Closing typically takes 30 to 45 days from accepted offer. You'll sign documents, pay closing costs (or roll them in), and walk away with the keys. Your loan officer is reachable the entire way." },
];
const concerns = [
  { concern: "I don't have enough saved for a down payment.", response: "FHA requires 3.5%. Conventional goes to 3%. VA requires nothing. On a $400,000 home, 3.5% is $14,000. Down payment assistance programs in many states can reduce this further. Most buyers need less than they think." },
  { concern: "My credit isn't great.", response: "FHA works with scores as low as 580 for the standard 3.5% down option. Scores between 500 and 579 can still qualify with 10% down. If you're below 580, your loan officer can walk you through what it would take to get there, or whether a different program fits now." },
  { concern: "I don't understand the process.", response: "That's exactly what we're here for. Cliffco loan officers explain every document, every step, and every decision point in plain language. You are never left guessing what comes next." },
  { concern: "I'm not sure how much house I can afford.", response: "That's what pre-approval is for. Before you look at a single listing, your loan officer will tell you your real number: what the payment looks like, what you'd need at closing, and what range makes sense for your budget." },
];
---

<Layout
  title="First-Time Homebuyer Mortgages | FHA, Conventional & VA | Cliffco"
  description="Buying your first home? Cliffco walks you through FHA, conventional, and VA loan options, low down payment programs, and what to expect at every step. Get pre-approved in one business day."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "First-Time Homebuyer", href: "/first-time-homebuyer/" },
  ]} />

  <AsymHero
    eyebrow="First-Time Homebuyer · FHA, Conventional, and VA Loans"
    lead="Low down payments. Flexible credit standards. A loan officer who makes the whole process make sense."
    image={{
      src: "/images/content%20images/first-time-homebuyer-hero-1600.webp",
      srcset: "/images/content%20images/first-time-homebuyer-hero-800.webp 800w, /images/content%20images/first-time-homebuyer-hero-1600.webp 1600w, /images/content%20images/first-time-homebuyer-hero-2400.webp 2400w",
      alt: "A young couple relaxing on a couch in their new home, surrounded by moving boxes",
      position: "40% 50%",
    }}
    tag={{ stat: "3%", label: "Down, conventional" }}
  >
    Buying Your First Home<br />Should Be Simple.
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">See What I Qualify For</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
    <Fragment slot="note">No credit pull. No commitment. A loan officer responds in one business day.</Fragment>
  </AsymHero>

  <!-- LEAD FORM + WHO THIS IS FOR -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <FormCard title="Start with a conversation, not an application." sub="Tell us your situation and we'll show you which programs apply and what you'd pay monthly." formSource="first-time-homebuyer" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-8">
        <p class="eyebrow">Who this is for</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">You don't need a perfect financial picture to buy your first home.</h2>
        <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed" style="font-size: 1.0625rem;">
          Most first-time buyers are surprised by how accessible homeownership actually is. The barriers are usually smaller than they appear.
        </p>
        <p class="mt-8 font-semibold text-[var(--color-ink)]">You may be ready if you:</p>
        <ul class="mt-4 list-none m-0 p-0 border-t border-[var(--color-ink)]">
          {[
            "Have a credit score of 580 or higher (lower scores may still have options)",
            "Can put 3 to 3.5% down, or qualify for VA with zero down",
            "Have stable income for at least 2 years (W-2 or self-employed)",
            "Are buying a primary residence (not an investment property)",
            "Are a first-time buyer, or haven't owned a home in the past 3 years",
          ].map((item) => (
            <li class="flex gap-4 items-start py-4 border-b border-black/15" style="font-size: 1.0625rem;">
              <span class="font-mono text-sm text-[var(--color-ink)] pt-0.5" aria-hidden="true">✓</span>
              <span class="text-[var(--color-text)]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- LOAN OPTIONS -->
  <Split eyebrow="Your options" title="The most common first-time buyer loan programs." intro={`There is no single "best" program. The right fit depends on your credit, down payment, and whether you have military service.`}>
    <div class="grid sm:grid-cols-2 gap-4">
      {loanOptions.map((opt) => (
        <div class={`rounded-2xl p-6 flex flex-col gap-3 ${opt.highlight ? "bg-[var(--color-ink)] text-white" : "border-2 border-[var(--color-ink)]"}`}>
          {opt.highlight && (
            <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/60">Most Common</span>
          )}
          <h3 class={`text-lg font-semibold ${opt.highlight ? "!text-white" : "text-[var(--color-ink)]"}`}>{opt.name}</h3>
          <div class="flex gap-4 text-sm">
            <span class="font-semibold">{opt.downPayment}</span>
            <span class={opt.highlight ? "text-white/65" : "text-[var(--color-text-muted)]"}>{opt.minFICO}</span>
          </div>
          <p class={`text-sm leading-relaxed ${opt.highlight ? "text-white/85" : "text-[var(--color-text)]"}`}>{opt.description}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-sm text-[var(--color-text-muted)]">Down payment assistance programs may be available in your state. Ask your Cliffco loan officer what's offered where you're buying.</p>
  </Split>

  <!-- HOW IT WORKS -->
  <Split eyebrow="The process" title="What buying your first home looks like, step by step.">
    <ol class="list-none m-0 p-0 border-t border-[var(--color-ink)]">
      {steps.map((s, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-8 border-b border-black/15">
          <span class="font-mono text-sm text-[var(--color-text-muted)] pt-1">0{i + 1}</span>
          <div>
            <h3 class="text-xl font-semibold text-[var(--color-ink)]">{s.heading}</h3>
            <p class="mt-3 text-[var(--color-text)] leading-relaxed">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </Split>

  <!-- WHAT PEOPLE WORRY ABOUT (black band) -->
  <Split dark eyebrow="Common concerns" title="The things first-time buyers worry about most.">
    <ol class="list-none m-0 p-0 border-t border-white/40">
      {concerns.map((item) => (
        <li class="py-6 border-b border-white/15">
          <p class="text-sm font-semibold text-white/55">"{item.concern}"</p>
          <p class="mt-2 text-white leading-relaxed" style="font-size: 1.0625rem;">{item.response}</p>
        </li>
      ))}
    </ol>
  </Split>

  <!-- FAQ -->
  <Split rule={false} eyebrow="FAQ" title="What first-time buyers ask us most.">
    <FaqList items={faq} />
  </Split>

  <!-- DPA CALLOUT -->
  <Split eyebrow="Don't have enough saved?" title="Down payment assistance programs may cover it.">
    <p class="text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">
      Many first-time buyers don't realize that state, county, and nonprofit programs can cover some or all of your down payment and closing costs. Grants, forgivable loans, and deferred-payment second mortgages are all available in most of the markets we serve.
    </p>
    <a href="/down-payment-assistance/" class="mt-5 inline-block text-sm font-semibold text-[var(--color-ink)]">Learn about down payment assistance →</a>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/down-payment-assistance/" class="btn btn-primary">Explore DPA options</a>
      <a href="/get-started/" class="btn btn-secondary">Start my pre-qual</a>
    </div>
  </Split>

  <CtaBand
    title="See what first-time buyers in your area can qualify for."
    text="A Cliffco loan officer reviews your situation within one business day and tells you exactly where you stand."
  >
    <a href="#contact" class="btn btn-primary">Get Pre-Approved</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
