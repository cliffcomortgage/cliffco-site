---
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumbs from "../../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../../data/company";
import { location } from "../../../../data/locations";
import { BRANCHES } from "../../../../data/branches";
import { LOAN_OFFICERS } from "../../../../data/loan-officers";
import { product } from "../../../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../../../lib/schema";
import Headshot from "../../../../components/ui/Headshot.astro";

const loc = location("new-york/long-island")!;
const liBranches = BRANCHES.filter((b) => b.metro === "Long Island");

const EXCLUDE = new Set(["christopher-clifford-65234"]);
const uniondaleLOs = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "uniondale-headquarters" && !EXCLUDE.has(lo.slug));
const wantaghLOs  = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "wantagh-ny");
const bayShore    = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "bay-shore-ny");

const branchLOCount: Record<string, number> = {
  "uniondale-headquarters": uniondaleLOs.length,
  "wantagh-ny":             wantaghLOs.length,
  "bay-shore-ny":           bayShore.length,
};

const faq = [
  { question: "Where is Cliffco's Long Island office?", answer: "Cliffco's headquarters is at 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553, phone (516) 408-7300. We also have Long Island branches in Wantagh (Nassau) and Bay Shore (Suffolk)." },
  { question: "Is Cliffco licensed in New York?", answer: "Yes. Cliffco, Inc. is a Licensed Mortgage Banker by the New York State Department of Financial Services (LMBC109800), NMLS #65328. Cliffco has been originating mortgages on Long Island since 1989." },
  { question: "What loan products are most relevant on Long Island?", answer: "Long Island's median single-family price is high (Nassau ~$849K, Suffolk ~$700K as of early 2026), which means jumbo loans matter. Long Island also has a heavy self-employed trades workforce, a strong fit for Cliffco's bank-statement non-QM. North Shore aging-in-place homeowners drive a steady reverse-mortgage practice. Hamptons buyers tap super-jumbo and asset-utilization programs." },
  { question: "Does Cliffco do non-warrantable Long Island co-ops or condos?", answer: "Yes. Cliffco's non-QM and portfolio programs handle scenarios that conventional Fannie/Freddie cannot, including non-warrantable condos and co-op buildings outside standard agency guidelines. Speak with a Long Island LO for specifics on a building." },
];

const schema = [
  ...liBranches.map((b) => localBusinessSchema(b)),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "New York", url: "/locations/new-york/" },
    { name: "Long Island", url: "/locations/new-york/long-island/" },
  ]),
];

const yearsInBiz = COMPANY.yearsInBusiness();
---

<Layout
  title="Long Island Mortgage Lender | Cliffco Mortgage Bankers"
  description={loc.blurb}
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "New York", href: "/locations/new-york/" },
    { name: "Long Island", href: "/locations/new-york/long-island/" },
  ]} />

  <section class="container-wide pt-12 pb-12">
    <p class="eyebrow">Long Island, NY</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">Long Island mortgage lender. {yearsInBiz} years on the Island.</h1>
    <p class="lead mt-6">{loc.blurb}</p>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide">
      <p class="eyebrow">Long Island market data (2026)</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">What buyers and refinancers are seeing.</h2>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="card">
          <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">Nassau median price (single-family)</p>
          <p class="mt-2 text-3xl font-semibold text-[var(--color-ink)]">$849K</p>
          <p class="mt-2 text-xs text-[var(--color-text-muted)]">+4% YoY (March 2026, Long Island MLS / Newsday)</p>
        </div>
        <div class="card">
          <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">Suffolk median price (single-family)</p>
          <p class="mt-2 text-3xl font-semibold text-[var(--color-ink)]">$700K</p>
          <p class="mt-2 text-xs text-[var(--color-text-muted)]">+4.5% YoY (Jan 2026, Long Island MLS)</p>
        </div>
        <div class="card">
          <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">2026 conforming limit (Nassau-Suffolk MSA)</p>
          <p class="mt-2 text-3xl font-semibold text-[var(--color-ink)]">$1,209,750</p>
          <p class="mt-2 text-xs text-[var(--color-text-muted)]">High-balance conforming limit; jumbo above</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">Loans we lead with on Long Island</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Built for the Long Island borrower.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {loc.featuredProducts.map((slug) => {
          const p = product(slug);
          if (!p) return null;
          return (
            <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
              <h3 class="font-semibold">{p.shortName}</h3>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] flex-1">{p.oneLiner}</p>
              <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <p class="eyebrow">Our Long Island offices</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Three offices across the Island.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {liBranches.map((b) => (
          <article class="card">
            <h3 class="text-lg font-semibold">{b.name}</h3>
            {b.street && <p class="text-sm text-[var(--color-text-muted)] mt-2">{b.street}<br/>{b.city}, {b.region} {b.postalCode}</p>}
            {b.phone && <p class="text-sm mt-1"><a href={`tel:${b.phone.replace(/\D/g, "")}`} class="text-[var(--color-ink)] no-underline font-medium">{b.phone}</a></p>}
            {b.nmls && <p class="text-xs text-[var(--color-text-muted)] mt-2">Branch NMLS #{b.nmls}</p>}
            <p class="text-sm text-[var(--color-text-muted)] mt-3">{branchLOCount[b.slug] ?? 0} loan officer{(branchLOCount[b.slug] ?? 0) === 1 ? "" : "s"}.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Uniondale HQ -->
  {uniondaleLOs.length > 0 && (
    <section class="section bg-white">
      <div class="container-wide">
        <p class="eyebrow">Uniondale, NY (Headquarters)</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Loan officers at our HQ.</h2>
        <p class="lead mt-4 max-w-3xl text-[var(--color-text-muted)]">
          70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {uniondaleLOs.map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Wantagh -->
  {wantaghLOs.length > 0 && (
    <section class="section bg-[var(--color-mist-gray)]">
      <div class="container-wide">
        <p class="eyebrow">Wantagh, NY</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Loan officers at our Wantagh office.</h2>
        <p class="lead mt-4 max-w-3xl text-[var(--color-text-muted)]">
          3265 Merrick Road, Wantagh, NY 11793
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {wantaghLOs.map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Bay Shore -->
  {bayShore.length > 0 && (
    <section class="section bg-white">
      <div class="container-wide">
        <p class="eyebrow">Bay Shore, NY</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Loan officers at our Bay Shore office.</h2>
        <p class="lead mt-4 max-w-3xl text-[var(--color-text-muted)]">
          50 Park Avenue, 2nd Floor, Suite 1, Bay Shore, NY 11706
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {bayShore.map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-prose">
      <p class="eyebrow">Long Island FAQ</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Local borrower questions.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Long Island borrowers: talk to your local Cliffco LO.</h2>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a pre-qual</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>
</Layout>
