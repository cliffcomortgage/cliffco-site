---
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumbs from "../../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../../data/company";
import { location } from "../../../../data/locations";
import { BRANCHES } from "../../../../data/branches";
import { LOAN_OFFICERS, loanOfficersByBranch } from "../../../../data/loan-officers";
import { product } from "../../../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../../../lib/schema";

const loc = location("new-york/long-island")!;
const liBranches = BRANCHES.filter((b) => b.metro === "Long Island");
const branchLandingPages: Record<string, string> = {
  'uniondale-headquarters': '/uniondale/',
  'bay-shore-ny': '/bay-shore-ny/',
};

const EXCLUDE = new Set(["christopher-clifford"]);
// Primary-office LOs plus those who also work out of HQ (e.g. the Zambellis).
const uniondaleLOs = loanOfficersByBranch("uniondale-headquarters").filter((lo) => !EXCLUDE.has(lo.slug));
const bayShore    = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "bay-shore-ny");

const branchLOCount: Record<string, number> = {
  "uniondale-headquarters": loanOfficersByBranch("uniondale-headquarters").length,
  "bay-shore-ny":           loanOfficersByBranch("bay-shore-ny").length,
};

const faq = [
  { question: "Where is Cliffco's Long Island office?", answer: "Cliffco's headquarters is at 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553, phone (516) 408-7300. We also have a Long Island branch in Bay Shore (Suffolk)." },
  { question: "Is Cliffco licensed in New York?", answer: "Yes. Cliffco, Inc. is a Licensed Mortgage Banker by the New York State Department of Financial Services (LMBC109800), NMLS #65328. Cliffco has been originating mortgages on Long Island since 1989." },
  { question: "What loan products are most relevant on Long Island?", answer: "Most Long Island buyers use conventional or FHA financing, and first-time buyers can often pair them with SONYMA programs and down payment assistance. Because the median single-family price is high (Nassau ~$849K, Suffolk ~$700K as of early 2026), jumbo loans matter too. Cliffco also offers bank statement loans for Long Island's large self-employed trades workforce, reverse mortgages for North Shore homeowners aging in place, and super-jumbo and asset-utilization programs for Hamptons buyers." },
  { question: "Does Cliffco do non-warrantable Long Island co-ops or condos?", answer: "Yes. Cliffco's Non-QM and portfolio programs handle scenarios that conventional Fannie/Freddie cannot, including non-warrantable condos and co-op buildings outside standard agency guidelines. Speak with a Long Island LO for specifics on a building." },
];

const schema = [
  ...liBranches.map((b) => localBusinessSchema(b)),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "New York", url: "/locations/new-york/" },
    { name: "Long Island", url: "/locations/new-york/long-island/" },
  ]),
];

const yearsInBiz = COMPANY.yearsInBusiness();

import CityHero from "../../../../components/asym/CityHero.astro";
import Split from "../../../../components/asym/Split.astro";
import FormCard from "../../../../components/asym/FormCard.astro";
import FaqList from "../../../../components/asym/FaqList.astro";
import CtaBand from "../../../../components/asym/CtaBand.astro";
import LoCard from "../../../../components/asym/LoCard.astro";

const marketData = [
  { label: "Nassau median price (single-family)", value: "$849K", note: "+4% YoY (March 2026, Long Island MLS / Newsday)" },
  { label: "Suffolk median price (single-family)", value: "$700K", note: "+4.5% YoY (Jan 2026, Long Island MLS)" },
  { label: "2026 conforming limit (Nassau-Suffolk MSA)", value: "$1,249,125", note: "High-balance conforming limit; jumbo above" },
];
---
<Layout
  title="Long Island Mortgage Lender | Cliffco Mortgage Bankers"
  description={loc.blurb}
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "New York", href: "/locations/new-york/" },
    { name: "Long Island", href: "/locations/new-york/long-island/" },
  ]} />

  <CityHero
    word="Long Island"
    sub="Mortgage Lender"
    eyebrow="Long Island, NY · Founded Here in 1989"
    lead={loc.blurb}
    facts={[
      { label: "Founded here", value: "1989" },
      { label: "Offices", value: liBranches.map((b) => b.city).join(" · ") },
      { label: "2026 conforming limit", value: "$1,249,125" },
    ]}
  >
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
      <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary">{COMPANY.hq.phone}</a>
    </Fragment>
  </CityHero>

  <!-- VISIT / CALL + FORM -->
  <section class="bg-white">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 lg:col-start-8 lg:row-start-1">
        <FormCard
          title="Questions about buying or refinancing on Long Island?"
          sub="Tell us what you're working with and a Long Island loan officer will be in touch within one business day."
          formSource="location-long-island"
        />
      </div>
      <div class="lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:pt-8">
        <p class="eyebrow">Long Island market data (2026)</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">What buyers and refinancers are seeing.</h2>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {marketData.map((m) => (
            <div class="py-6 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)]">{m.label}</dt>
              <dd class="mt-2 text-[var(--color-ink)] font-bold" style="font-family: var(--font-display); font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -0.02em; line-height: 1.1;">{m.value}</dd>
              <dd class="mt-2 text-xs text-[var(--color-text-muted)]">{m.note}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>


  

  <!-- FEATURED PRODUCTS -->
  <Split eyebrow="Loans we lead with on Long Island" title="Built for the Long Island borrower." wide>
    <div class="grid sm:grid-cols-2 gap-4">
      {loc.featuredProducts.map((slug) => {
        const p = product(slug);
        if (!p) return null;
        return (
          <a href={`/loans/${p.slug}/`} class="group rounded-2xl border-2 border-[var(--color-ink)] p-6 no-underline text-[var(--color-ink)] flex flex-col h-full hover:bg-[var(--color-ink)] hover:text-white transition-colors">
            <h3 class="text-lg font-semibold group-hover:!text-white">{p.shortName}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] group-hover:text-white/75 flex-1 leading-relaxed">{p.oneLiner}</p>
            <span class="mt-4 text-sm font-semibold">Learn more →</span>
          </a>
        );
      })}
    </div>
  </Split>

  <!-- OFFICES (black band) -->
  <Split dark eyebrow="Our Long Island offices" title="Two offices across the Island." wide>
    <div class="grid sm:grid-cols-2 gap-4">
      {liBranches.map((b) => {
        const landingUrl = branchLandingPages[b.slug];
        const n = branchLOCount[b.slug] ?? 0;
        const inner = (
          <>
            <h3 class="text-lg font-semibold !text-white">{b.name}</h3>
            {b.street && <p class="text-sm text-white/75 mt-3">{b.street}<br/>{b.city}, {b.region} {b.postalCode}</p>}
            {b.phone && <p class="text-sm mt-1 font-medium text-white">{b.phone}</p>}
            {b.nmls && <p class="text-xs text-white/55 mt-2">Branch NMLS #{b.nmls}</p>}
            {n > 0 && <p class="text-sm text-white/75 mt-3">{n} loan officer{n === 1 ? "" : "s"}.</p>}
            {landingUrl && <span class="mt-auto pt-4 text-sm font-semibold text-white">View office →</span>}
          </>
        );
        return landingUrl ? (
          <a href={landingUrl} class="rounded-2xl border-2 border-white/40 hover:border-white p-7 no-underline flex flex-col transition-colors">{inner}</a>
        ) : (
          <article class="rounded-2xl border-2 border-white/40 p-7 flex flex-col">{inner}</article>
        );
      })}
    </div>
  </Split>

  <!-- Uniondale HQ -->
  {uniondaleLOs.length > 0 && (
    <Split rule={false} eyebrow="Uniondale, NY (Headquarters)" title="Loan officers at our HQ." intro="70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553" wide>
      <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
        {uniondaleLOs.map((lo) => <LoCard lo={lo} />)}
      </div>
    </Split>
  )}

  <!-- Bay Shore -->
  {bayShore.length > 0 && (
    <Split eyebrow="Bay Shore, NY" title="Loan officers at our Bay Shore office." intro="50 Park Avenue, 2nd Floor, Suite 1, Bay Shore, NY 11706" wide>
      <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
        {bayShore.map((lo) => <LoCard lo={lo} />)}
      </div>
    </Split>
  )}

  <!-- FAQ -->
  <Split eyebrow="Long Island FAQ" title="Local borrower questions.">
    <FaqList items={faq} />
  </Split>

  <CtaBand title="Long Island borrowers: talk to your local Cliffco LO.">
    <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
    <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary">{COMPANY.hq.phone}</a>
  </CtaBand>

</Layout>
