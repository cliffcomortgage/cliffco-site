---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { location } from "../../../data/locations";
import { BRANCHES } from "../../../data/branches";
import { product } from "../../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../../lib/schema";
import ContactForm from "../../../components/forms/ContactForm.astro";

const loc = location("new-york")!;
const nyBranches = BRANCHES.filter((b) => loc.branchSlugs?.includes(b.slug));

const faq = [
  { question: "Is Cliffco licensed in New York?", answer: "Yes. Cliffco, Inc. is a Licensed Mortgage Banker by the New York State Department of Financial Services (LMBC109800), corporate NMLS #65328. Cliffco was founded on Long Island in 1989 and is headquartered in Uniondale, NY." },
  { question: "Where is Cliffco's New York office?", answer: "Cliffco is headquartered at 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553, phone (516) 408-7300. We also have New York branches in Wantagh (Nassau), Bay Shore (Suffolk), and Jamaica (Queens)." },
  { question: "Does New York require an attorney at closing?", answer: "Yes. New York is an attorney-state for residential real estate closings. Both buyer and seller typically retain attorneys, and the closing is conducted in the attorney's office. Cliffco can recommend experienced real-estate attorneys in our local markets." },
  { question: "What is a CEMA refinance?", answer: "A Consolidation, Extension and Modification Agreement (CEMA) is a New York-specific refinance structure that allows you to consolidate the existing mortgage balance with the new mortgage instead of paying it off and originating a fresh one, saving the New York mortgage recording tax (typically ~1.8%-2.05%) on the consolidated portion. Cliffco closes CEMAs regularly." },
];

const schema = [
  ...nyBranches.map((b) => localBusinessSchema(b)),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "New York", url: "/locations/new-york/" },
  ]),
];
---

<Layout title="New York Mortgage Lender | Cliffco" description={loc.blurb} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "New York", href: "/locations/new-york/" },
  ]} />

  <section class="accent-gradient">
    <div class="container-wide py-16 lg:py-24">
      <p class="eyebrow !text-[var(--color-ice-blue)]">New York · Cliffco Mortgage Bankers</p>
      <h1 class="mt-4 text-white max-w-3xl" style="font-size: var(--text-display-xl); line-height: 1.1; font-weight: 300; font-family: var(--font-sans);">
        New York Mortgage Lender
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">{loc.blurb}</p>
      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide space-y-4">
      <!-- Long Island - prominent featured card -->
      <a href="/locations/new-york/long-island/" class="card no-underline text-[var(--color-ink)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-2 border-[var(--color-accent)]/30 hover:border-[var(--color-accent)] transition-colors">
        <div>
          <p class="eyebrow">Our home market since 1989</p>
          <h2 class="mt-1" style="font-size: var(--text-h3);">Long Island</h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] max-w-xl">Nassau and Suffolk counties, three offices (Uniondale HQ, Wantagh, Bay Shore). More Long Island loan officers and more Long Island experience than any other independent mortgage bank our size.</p>
        </div>
        <span class="btn btn-primary shrink-0">Find Long Island Loan Officers</span>
      </a>

      <!-- Queens - prominent card -->
      <a href="/locations/new-york/queens/" class="card no-underline text-[var(--color-ink)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-2 border-[var(--color-accent)]/30 hover:border-[var(--color-accent)] transition-colors">
        <div>
          <p class="eyebrow">New York City office</p>
          <h2 class="mt-1" style="font-size: var(--text-h3);">Queens</h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] max-w-xl">Our Jamaica office serves Queens, Brooklyn, and all five boroughs. Co-op and condo financing, Non-QM, jumbo, and DSCR for NYC buyers and investors.</p>
        </div>
        <span class="btn btn-primary shrink-0">Find Queens Loan Officers</span>
      </a>

      <!-- Other coverage areas -->
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="card">
          <h2 class="text-lg font-semibold">Hudson Valley + Upstate</h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Cliffco lends statewide. Loan officers based on Long Island serve all 62 NY counties remotely.</p>
        </div>
        <div class="card">
          <h2 class="text-lg font-semibold">NYC Boroughs</h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Brooklyn, the Bronx, Manhattan, Staten Island. Co-op, condo, jumbo, and Non-QM specialists.</p>
        </div>
      </div>

      <div class="mt-6">
        <a href="/loan-officers/?state=NY" class="btn btn-primary">View all NY loan officers →</a>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">What we lead with in New York</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Built for New York borrowers.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {loc.featuredProducts.map((slug) => {
          const p = product(slug);
          if (!p) return null;
          return (
            <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
              <h3 class="font-semibold">{p.shortName}</h3>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] flex-1">{p.oneLiner}</p>
              <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-prose">
      <p class="eyebrow">New York FAQ</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Local borrower questions.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">New York borrowers: talk to a Long Island-based Cliffco LO.</h2>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a pre-qual</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <h2 class="mt-3" style="font-size: var(--text-h2);">Questions about buying or refinancing in New York?</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">Tell us your situation and a Long Island-based loan officer will be in touch within one business day.</p>
      <div class="mt-8">
        <ContactForm
          formTo="websiteleads@cliffcomortgage.com,cliffcorpteam@cliffcomortgage.com"
          formSource="location-new-york"
        />
      </div>
    </div>
  </section>
</Layout>
