---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { location } from "../../../data/locations";
import { BRANCHES } from "../../../data/branches";
import { product } from "../../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../../lib/schema";

const loc = location("new-york")!;
const nyBranches = BRANCHES.filter((b) => loc.branchSlugs?.includes(b.slug));

const faq = [
  { question: "Is Cliffco licensed in New York?", answer: "Yes. Cliffco, Inc. is a Licensed Mortgage Banker by the New York State Department of Financial Services (LMBC109800), corporate NMLS #65328. Cliffco was founded on Long Island in 1989 and is headquartered in Uniondale, NY." },
  { question: "Where is Cliffco's New York office?", answer: "Cliffco is headquartered at 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553 — phone (516) 408-7300. We also have New York branches in Wantagh (Nassau), Bay Shore (Suffolk), and Jamaica (Queens)." },
  { question: "Does New York require an attorney at closing?", answer: "Yes — New York is an attorney-state for residential real estate closings. Both buyer and seller typically retain attorneys, and the closing is conducted in the attorney's office. Cliffco can recommend experienced real-estate attorneys in our local markets." },
  { question: "What is a CEMA refinance?", answer: "A Consolidation, Extension and Modification Agreement (CEMA) is a New York-specific refinance structure that allows you to consolidate the existing mortgage balance with the new mortgage instead of paying it off and originating a fresh one — saving the New York mortgage recording tax (typically ~1.8%–2.05%) on the consolidated portion. Cliffco closes CEMAs regularly." },
];

const schema = [
  ...nyBranches.map((b) => localBusinessSchema(b)),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "New York", url: "/locations/new-york/" },
  ]),
];
---

<Layout title="New York Mortgage Lender | Cliffco" description={loc.blurb} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "New York", href: "/locations/new-york/" },
  ]} />

  <section class="container-wide pt-12 pb-12">
    <p class="eyebrow">New York</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">New York mortgage lender — founded on Long Island in 1989.</h1>
    <p class="lead mt-6 max-w-3xl">{loc.blurb}</p>
  </section>

  <section class="bg-white pb-12">
    <div class="container-prose">
      <div class="direct-answer">
        Cliffco Mortgage Bankers is a New York Licensed Mortgage Banker (NYS DFS LMBC109800,
        NMLS #65328) headquartered in Uniondale, NY since 1989. We operate four New York
        branches — Uniondale (HQ), Wantagh (Nassau), Bay Shore (Suffolk), and Jamaica (Queens) —
        with deep expertise in jumbo, non-QM, reverse mortgages, DSCR, and business bank statement loans
        scenarios across Long Island, the five boroughs, and beyond.
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide grid gap-8 md:grid-cols-3">
      <a href="/locations/new-york/long-island/" class="card no-underline text-[var(--color-ink)]">
        <h2 class="text-lg font-semibold">Long Island</h2>
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">Cliffco's home market — Nassau and Suffolk counties, three branches.</p>
        <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">Visit Long Island →</span>
      </a>
      <div class="card">
        <h2 class="text-lg font-semibold">New York City</h2>
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">Five boroughs. Co-op + condo financing, jumbo, non-QM. Jamaica, NY office in Queens.</p>
      </div>
      <div class="card">
        <h2 class="text-lg font-semibold">Hudson Valley + upstate</h2>
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">Cliffco lends statewide. Loan officers based in Long Island serve all 62 NY counties remotely.</p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">What we lead with in New York</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Built for New York borrowers.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {loc.featuredProducts.map((slug) => {
          const p = product(slug);
          if (!p) return null;
          return (
            <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
              <h3 class="font-semibold">{p.shortName}</h3>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] flex-1">{p.oneLiner}</p>
              <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-prose">
      <p class="eyebrow">New York FAQ</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Local borrower questions.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">New York borrowers — talk to a Long Island-based Cliffco LO.</h2>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a pre-qual</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>
</Layout>
