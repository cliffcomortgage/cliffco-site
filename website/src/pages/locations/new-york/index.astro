---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { location } from "../../../data/locations";
import { BRANCHES } from "../../../data/branches";
import { product } from "../../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../../lib/schema";

const loc = location("new-york")!;
const nyBranches = BRANCHES.filter((b) => loc.branchSlugs?.includes(b.slug));

const faq = [
  { question: "Is Cliffco licensed in New York?", answer: "Yes. Cliffco, Inc. is a Licensed Mortgage Banker by the New York State Department of Financial Services (LMBC109800), corporate NMLS #65328. Cliffco was founded on Long Island in 1989 and is headquartered in Uniondale, NY." },
  { question: "Where is Cliffco's New York office?", answer: "Cliffco is headquartered at 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553, phone (516) 408-7300. We also have a New York branch in Bay Shore (Suffolk)." },
  { question: "Does New York require an attorney at closing?", answer: "Yes. New York is an attorney-state for residential real estate closings. Both buyer and seller typically retain attorneys, and the closing is conducted in the attorney's office. Cliffco can recommend experienced real-estate attorneys in our local markets." },
  { question: "What is a CEMA refinance?", answer: "A Consolidation, Extension and Modification Agreement (CEMA) is a New York-specific refinance structure that allows you to consolidate the existing mortgage balance with the new mortgage instead of paying it off and originating a fresh one, saving the New York mortgage recording tax (typically ~1.8%-2.05%) on the consolidated portion. Cliffco closes CEMAs regularly." },
];

const schema = [
  ...nyBranches.map((b) => localBusinessSchema(b)),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "New York", url: "/locations/new-york/" },
  ]),
];
import CityHero from "../../../components/asym/CityHero.astro";
import Split from "../../../components/asym/Split.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";
---

<Layout title="New York Mortgage Lender | Cliffco" description={loc.blurb} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "New York", href: "/locations/new-york/" },
  ]} />

  <CityHero
    word="New York"
    sub="Mortgage Lender"
    eyebrow="New York · Cliffco Mortgage Bankers"
    lead={loc.blurb}
    facts={[
      { label: "Home market since", value: "1989" },
      { label: "Long Island offices", value: nyBranches.map((b) => b.city).join(" · ") },
      { label: "NY license", value: "LMBC109800" },
    ]}
  >
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
      <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary">{COMPANY.hq.phone}</a>
    </Fragment>
  </CityHero>

  <!-- VISIT / CALL + FORM -->
  <section class="bg-white">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 lg:col-start-8 lg:row-start-1">
        <FormCard
          title="Questions about buying or refinancing in New York?"
          sub="Tell us your situation and a Long Island-based loan officer will be in touch within one business day."
          formSource="location-new-york"
        />
      </div>
      <div class="lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:pt-8 space-y-4">
        <!-- Long Island - prominent featured card -->
        <a href="/locations/new-york/long-island/" class="block rounded-2xl bg-[var(--color-ink)] p-7 no-underline">
          <p class="eyebrow !text-white/55">Our home market since 1989</p>
          <h2 class="mt-2 !text-white" style="font-size: var(--text-h3); font-weight: 700;">Long Island</h2>
          <p class="mt-3 text-sm text-white/80 leading-relaxed">Nassau and Suffolk counties, two offices (Uniondale HQ and Bay Shore). More Long Island loan officers and more Long Island experience than any other independent mortgage bank our size.</p>
          <span class="mt-5 btn btn-primary !bg-white !text-[var(--color-ink)]">Find Long Island Loan Officers</span>
        </a>

        <!-- Other coverage areas -->
        <div class="rounded-2xl border-2 border-[var(--color-ink)] p-6">
          <h2 class="text-lg font-semibold">Hudson Valley + Upstate</h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Cliffco lends statewide. Loan officers based on Long Island serve all 62 NY counties remotely.</p>
        </div>
        <div class="rounded-2xl border-2 border-[var(--color-ink)] p-6">
          <h2 class="text-lg font-semibold">NYC Boroughs</h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Queens, Brooklyn, the Bronx, Manhattan, Staten Island. Co-op, condo, jumbo, and Non-QM specialists.</p>
        </div>

        <a href="/loan-officers/?state=NY" class="mt-2 btn btn-secondary">View all NY loan officers →</a>
      </div>
    </div>
  </section>


  

  <!-- FEATURED PRODUCTS -->
  <Split eyebrow="What we lead with in New York" title="Built for New York borrowers." wide>
    <div class="grid sm:grid-cols-2 gap-4">
      {loc.featuredProducts.map((slug) => {
        const p = product(slug);
        if (!p) return null;
        return (
          <a href={`/loans/${p.slug}/`} class="group rounded-2xl border-2 border-[var(--color-ink)] p-6 no-underline text-[var(--color-ink)] flex flex-col h-full hover:bg-[var(--color-ink)] hover:text-white transition-colors">
            <h3 class="text-lg font-semibold group-hover:!text-white">{p.shortName}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] group-hover:text-white/75 flex-1 leading-relaxed">{p.oneLiner}</p>
            <span class="mt-4 text-sm font-semibold">Learn more →</span>
          </a>
        );
      })}
    </div>
  </Split>

  <!-- FAQ -->
  <Split eyebrow="New York FAQ" title="Local borrower questions.">
    <FaqList items={faq} />
  </Split>

  <CtaBand title="New York borrowers: talk to a Long Island-based Cliffco LO.">
    <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
    <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary">{COMPANY.hq.phone}</a>
  </CtaBand>

</Layout>
