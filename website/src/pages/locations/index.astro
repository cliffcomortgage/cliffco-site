---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import CityHero from "../../components/asym/CityHero.astro";
import Split from "../../components/asym/Split.astro";
import CtaBand from "../../components/asym/CtaBand.astro";
import { COMPANY } from "../../data/company";
import { LOCATIONS } from "../../data/locations";
import { BRANCHES } from "../../data/branches";
import { STATE_LICENSES } from "../../data/state-licenses";

const markets = LOCATIONS.filter((l) => !l.path.includes("/"));
---

<Layout
  title="Cliffco Locations & Service Areas"
  description={`Cliffco Mortgage Bankers is licensed in ${STATE_LICENSES.length} states with ${BRANCHES.length} branches across NY, NJ, AZ, MN, and FL. Pick your market.`}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
  ]} />

  <CityHero
    word="Where we lend."
    eyebrow="Locations"
    lead={`Cliffco is licensed in ${STATE_LICENSES.length} states with ${BRANCHES.length} physical branches. Our five priority markets (NY, NJ, AZ, MN, and FL) each have local loan officers on the ground and a full market page with state licensing, local FAQs, and featured loan products.`}
    facts={[
      { label: "Licensed states", value: String(STATE_LICENSES.length) },
      { label: "Physical branches", value: String(BRANCHES.length) },
      { label: "Priority markets", value: "NY · NJ · AZ · MN · FL" },
    ]}
  >
    <Fragment slot="actions">
      <a href="#markets" class="btn btn-primary">Pick your market</a>
      <a href="/licensing/" class="btn btn-secondary">State licensing</a>
    </Fragment>
  </CityHero>

  <Split id="markets" eyebrow="Our markets" title="Pick your market." wide>
    <div class="grid sm:grid-cols-2 gap-4">
      {markets.map((l) => {
        const branches = BRANCHES.filter((b) => l.branchSlugs?.includes(b.slug));
        return (
          <a href={`/locations/${l.path}/`} class="group rounded-2xl border-2 border-[var(--color-ink)] p-7 no-underline text-[var(--color-ink)] flex flex-col h-full hover:bg-[var(--color-ink)] hover:text-white transition-colors">
            <h2 class="group-hover:!text-white" style="font-size: var(--text-h3); font-weight: 700;">{l.name}</h2>
            {branches.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {branches.map((b) => (
                  <span class="font-mono text-[11px] uppercase tracking-[0.1em] px-3 py-1 rounded-full border border-current">{b.displayCity ?? b.city}</span>
                ))}
              </div>
            )}
            <p class="mt-4 text-sm text-[var(--color-text-muted)] group-hover:text-white/75 leading-relaxed flex-1">{l.blurb.split(".")[0]}.</p>
            <span class="mt-5 text-sm font-semibold">View market →</span>
          </a>
        );
      })}
    </div>
  </Split>

  <CtaBand title="Not in one of these markets?" text={`Cliffco lends in all ${STATE_LICENSES.length} states where we're licensed. A loan officer licensed in your state responds in one business day.`}>
    <a href="/get-started/" class="btn btn-primary">Get Started</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
