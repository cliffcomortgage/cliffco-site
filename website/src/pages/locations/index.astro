---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { LOCATIONS } from "../../data/locations";
import { BRANCHES } from "../../data/branches";
import { STATE_LICENSES } from "../../data/state-licenses";
---

<Layout
  title="Cliffco Locations & Service Areas"
  description={`Cliffco Mortgage Bankers is licensed in ${STATE_LICENSES.length} states with nine branches across NY, NJ, AZ, MN, and FL. Pick your market.`}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
  ]} />

  <section class="container-wide pt-12 pb-16">
    <p class="eyebrow">Locations</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">Where we lend.</h1>
    <p class="lead mt-6">
      Cliffco is licensed in {STATE_LICENSES.length} states with nine physical branches.
      Our five priority markets â€” NY, NJ, AZ, MN, and FL â€” each have local loan officers
      on the ground and a full market page with state licensing, local FAQs, and featured loan products.
    </p>
  </section>

  <section class="bg-white pb-16">
    <div class="container-wide">
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {LOCATIONS.filter((l) => !l.path.includes("/")).map((l) => {
          const branches = BRANCHES.filter((b) => l.branchSlugs?.includes(b.slug));
          return (
            <a href={`/locations/${l.path}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
              <h2 class="text-lg font-semibold">{l.name}</h2>
              {branches.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {branches.map((b) => (
                    <span class="text-xs font-medium px-3 py-1 rounded-full bg-[var(--color-mist-gray)] text-[var(--color-text-muted)]">{b.city}</span>
                  ))}
                </div>
              )}
              <p class="mt-4 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">{l.blurb.split(".")[0]}.</p>
              <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">View market â†’</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
