---
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumbs from "../../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../../data/company";
import { location } from "../../../../data/locations";
import { BRANCHES } from "../../../../data/branches";
import { LOAN_OFFICERS } from "../../../../data/loan-officers";
import { product } from "../../../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../../../lib/schema";
import Headshot from "../../../../components/ui/Headshot.astro";
import ContactForm from "../../../../components/forms/ContactForm.astro";

const loc = location("florida/orlando")!;
const orlandoBranch = BRANCHES.find((b) => b.slug === "orlando-fl")!;
const EXCLUDE = new Set(["christopher-clifford"]);
const branchLOs = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "orlando-fl" && !EXCLUDE.has(lo.slug));
const licensedOnlyLOs = LOAN_OFFICERS.filter(
  (lo) => lo.states.includes("FL") && lo.branchSlug !== "orlando-fl" && lo.branchSlug !== "fort-lauderdale-fl" && !EXCLUDE.has(lo.slug),
);
const totalFLLOs = LOAN_OFFICERS.filter((lo) => lo.states.includes("FL")).length;

const faq = [
  { question: "Where is Cliffco's Orlando office?", answer: "Cliffco's Orlando branch operates under our Florida DBA, Swish Capital, Inc. The branch serves the Orlando metro and Central Florida; ask any Orlando-area LO listed below for the office address and direct line, or call our headquarters at (516) 408-7300." },
  { question: "Is Cliffco licensed to lend in Florida?", answer: "Yes. Cliffco, Inc. doing business in Florida as Swish Capital, Inc., is a New York corporation authorized to transact business in the State of Florida. Corporate NMLS #65328." },
  { question: "Can Cliffco finance a Disney-area short-term rental?", answer: "Yes. Cliffco's DSCR program qualifies short-term-rental properties in markets where STR is permitted, including parts of Polk County (Reunion, ChampionsGate, Davenport) and parts of Osceola County. We use AirDNA-supported projections for new STR purchases and trailing 12-month statements for existing operators. Note that most of Orange County does NOT permit STR; we'll help you confirm eligibility before you write the offer." },
  { question: "Are Cliffco's Orlando loan officers bilingual?", answer: "Yes. Several Orlando LOs work in English and Spanish (Keyla Cruz, Nadia Geyer Castro, Wenceslao Hernandez Romero, Julia Jorge-Delcarmen). Branch Manager Francisco Veras is also bilingual." },
  { question: "What products are most popular in the Orlando market?", answer: "DSCR loans for STR investors (the Disney-area angle), business bank statement loans for self-employed Florida small-business owners and ITIN borrowers, Non-QM for a wide range of scenarios, and reverse mortgages in retiree-heavy Central Florida communities." },
  { question: "Can I buy an Orlando rental from out of state?", answer: "Yes. Out-of-state investors are a large share of Cliffco's Orlando DSCR business, particularly New Yorkers and New Jerseyans buying Florida investment property. Cliffco is licensed in 32 states; we can lend on the property in Florida regardless of where the borrower lives." },
];

const schema = [
  localBusinessSchema(orlandoBranch),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "Florida", url: "/locations/florida/" },
    { name: "Orlando", url: "/locations/florida/orlando/" },
  ]),
];
---

<Layout
  title="Orlando Mortgage Lender | Cliffco (Swish Capital)"
  description={loc.blurb}
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "Florida", href: "/locations/florida/" },
    { name: "Orlando", href: "/locations/florida/orlando/" },
  ]} />

  <section class="accent-gradient">
    <div class="container-wide py-16 lg:py-24">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Orlando, FL · Operating as Swish Capital, Inc.</p>
      <h1 class="mt-4 text-white max-w-3xl" style="font-size: var(--text-display-xl); line-height: 1.1; font-weight: 400; font-family: var(--font-sans);">
        Orlando Mortgage Lender
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">{loc.blurb}</p>
      <p class="mt-4 text-sm text-white/70">{COMPANY.floridaDba.disclosure}</p>
      <div class="mt-6 flex flex-wrap gap-4 items-center">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide">
      <p class="eyebrow">Orlando market data (2026)</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">What investors and buyers are seeing.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="card">
          <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">Orlando metro median price</p>
          <p class="mt-2 text-3xl font-semibold text-[var(--color-ink)]">$378K</p>
          <p class="mt-2 text-xs text-[var(--color-text-muted)]">−7.9% YoY (Feb 2026, Orlando Regional REALTOR Assn) "" lower entry points for investors</p>
        </div>
        <div class="card">
          <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">Disney-area STR avg revenue</p>
          <p class="mt-2 text-3xl font-semibold text-[var(--color-ink)]">~$38K/yr</p>
          <p class="mt-2 text-xs text-[var(--color-text-muted)]">67% avg occupancy, $150-$250 nightly (AirDNA)</p>
        </div>
        <div class="card">
          <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">FL DSCR rate range (April 2026)</p>
          <p class="mt-2 text-3xl font-semibold text-[var(--color-ink)]">7.15%-8.75%</p>
          <p class="mt-2 text-xs text-[var(--color-text-muted)]">Varies by FICO, LTV, ratio</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">What we lead with in Orlando</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Built for the Orlando investor + buyer.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {loc.featuredProducts.map((slug) => {
          const p = product(slug);
          if (!p) return null;
          return (
            <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
              <h3 class="font-semibold">{p.shortName}</h3>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] flex-1">{p.oneLiner}</p>
              <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- LOs physically at the Orlando branch -->
  {branchLOs.length > 0 && (
    <section class="section bg-[var(--color-mist-gray)]">
      <div class="container-wide">
        <p class="eyebrow">Located at our Orlando office</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Bilingual team. Local underwriting. Real names.</h2>
        <p class="lead mt-4 max-w-3xl text-[var(--color-text-muted)]">
          These loan officers are physically based at Cliffco's Orlando branch (operating as Swish Capital, Inc.).
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {branchLOs.map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- LOs licensed in FL but based elsewhere -->
  {licensedOnlyLOs.length > 0 && (
    <section class="section bg-white">
      <div class="container-wide">
        <p class="eyebrow">Also licensed in Florida</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Other Florida-licensed loan officers.</h2>
        <p class="lead mt-4 max-w-3xl text-[var(--color-text-muted)]">
          These loan officers are based at other Cliffco offices but are fully licensed to originate loans in Florida.
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3 lo-shuffle-grid">
          {licensedOnlyLOs.slice(0, 6).map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
        <p class="mt-6"><a href="/loan-officers/?state=FL" class="btn btn-primary">View all {totalFLLOs} Florida-licensed loan officers →</a></p>
      </div>
    </section>
  )}

  <section class="section bg-white">
    <div class="container-prose">
      <p class="eyebrow">Orlando FAQ</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Borrower and investor questions.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Got an Orlando deal? Talk to our Florida team.</h2>
      <p class="lead mt-4 text-white/85">Bilingual loan officers. Out-of-state investor friendly. Real underwriting in 24 hours.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a pre-qual</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-8">
    <div class="container-wide">
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{COMPANY.floridaDba.disclosure}</p>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <h2 class="mt-3" style="font-size: var(--text-h2);">Have an Orlando deal or question? Talk to our team.</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">Tell us the property and your situation and we'll match you with an Orlando loan officer who knows this market.</p>
      <div class="mt-8">
        <ContactForm
          formTo="fveras@cliffcomortgage.com,websiteleads@cliffcomortgage.com"
          formSource="location-orlando"
        />
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>(".lo-shuffle-grid").forEach((grid) => {
    const children = [...grid.children] as HTMLElement[];
    for (let i = children.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      grid.appendChild(children[j]);
    }
  });
</script>
