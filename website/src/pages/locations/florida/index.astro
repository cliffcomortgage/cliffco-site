---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { location } from "../../../data/locations";
import { BRANCHES } from "../../../data/branches";
import { product } from "../../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../../lib/schema";

const loc = location("florida")!;
const flBranches = BRANCHES.filter((b) => loc.branchSlugs?.includes(b.slug));

const faq = [
  { question: "Is Cliffco licensed to lend in Florida?", answer: "Yes. Cliffco, Inc. doing business in Florida as Swish Capital, Inc., is a New York corporation authorized to transact business in the State of Florida. Corporate NMLS #65328." },
  { question: "Why does Cliffco operate as Swish Capital in Florida?", answer: "Swish Capital, Inc. is the registered Florida fictitious name (DBA) under which Cliffco, Inc. transacts business in the state. The borrower relationship, NMLS registration, underwriting, and servicing are all Cliffco's; the DBA is a state-required marketing identifier." },
  { question: "What products is Cliffco strongest at in Florida?", answer: "DSCR for short-term-rental investors (Disney area, Tampa, Naples), business bank statement loans for self-employed Florida small-business owners and ITIN borrowers, non-QM for a wide range of scenarios, reverse mortgages in retiree-heavy Central and SW Florida, and Spanish-language loan support across the state." },
  { question: "How does Florida's insurance crisis affect my mortgage qualification?", answer: "Florida homeowners insurance averages roughly 3× the national average (~$7,100/yr for $300K coverage as of 2025/2026). That cost is included in your debt-to-income calculation, materially affecting how much home you can afford. Cliffco's Florida LOs walk through realistic insurance + tax estimates before you write an offer." },
  { question: "Does Cliffco finance Florida non-warrantable condos?", answer: "Yes. Post-Champlain Towers, Florida passed structural inspection requirements that have made many older condos non-warrantable for conventional Fannie/Freddie financing. Cliffco's non-QM and portfolio programs handle non-warrantable scenarios that conventional cannot." },
];

const schema = [
  ...flBranches.map((b) => localBusinessSchema(b)),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "Florida", url: "/locations/florida/" },
  ]),
];
import ContactForm from "../../../components/forms/ContactForm.astro";
---

<Layout title="Florida Mortgage Lender | Cliffco (Swish Capital)" description={loc.blurb} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "Florida", href: "/locations/florida/" },
  ]} />

  <section class="accent-gradient">
    <div class="container-wide py-16 lg:py-24">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Florida · Operating as Swish Capital, Inc.</p>
      <h1 class="mt-4 text-white max-w-3xl" style="font-size: var(--text-display-xl); line-height: 1.05; font-weight: 700; font-family: var(--font-sans);">
        Florida Mortgage Lender
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">{loc.blurb}</p>
      <p class="mt-4 text-sm text-white/70">{COMPANY.floridaDba.disclosure}</p>
      <div class="mt-6 flex flex-wrap gap-4 items-center">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <!-- Branch offices - prominent cards -->
  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide space-y-4">
      <!-- Orlando - primary FL branch -->
      <a href="/locations/florida/orlando/" class="card no-underline text-[var(--color-ink)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-2 border-[var(--color-accent)]/30 hover:border-[var(--color-accent)] transition-colors">
        <div>
          <p class="eyebrow">Our Florida anchor office</p>
          <h2 class="mt-1" style="font-size: var(--text-h3);">Orlando, FL</h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] max-w-xl">Central Florida hub for DSCR and short-term rental investors, business bank statement, non-QM, and reverse mortgages. Bilingual English and Spanish team. Operates as Swish Capital, Inc.</p>
        </div>
        <span class="btn btn-primary shrink-0">Find Orlando Loan Officers</span>
      </a>

      <!-- Ft. Lauderdale - secondary FL branch -->
      <a href="/locations/florida/fort-lauderdale/" class="card no-underline text-[var(--color-ink)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-2 border-[var(--color-accent)]/30 hover:border-[var(--color-accent)] transition-colors">
        <div>
          <p class="eyebrow">South Florida office</p>
          <h2 class="mt-1" style="font-size: var(--text-h3);">Ft. Lauderdale, FL</h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] max-w-xl">Serving Miami-Dade, Broward, and Palm Beach. Foreign national, ITIN, condo non-warrantable, jumbo, and DSCR for SE Florida's investor-dense markets. Operates as Swish Capital, Inc.</p>
        </div>
        <span class="btn btn-primary shrink-0">Find Ft. Lauderdale Loan Officers</span>
      </a>

      <!-- Other coverage areas -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="card">
          <h3 class="text-base font-semibold">Tampa Bay</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Investor SFR and small-multi DSCR; growing primary-residence market.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold">Jacksonville</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Affordable entry market; military and first-time buyer.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold">Naples / SW Florida</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Reverse, jumbo, and post-Ian rebuild financing.</p>
        </div>
      </div>

      <div class="mt-6">
        <a href="/loan-officers/?state=FL" class="btn btn-primary">View all FL loan officers →</a>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">What we lead with in Florida</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Built for Florida borrowers and investors.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {loc.featuredProducts.map((slug) => {
          const p = product(slug);
          if (!p) return null;
          return (
            <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
              <h3 class="font-semibold">{p.shortName}</h3>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] flex-1">{p.oneLiner}</p>
              <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-prose">
      <p class="eyebrow">Florida FAQ</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Borrower and investor questions.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Florida borrowers: talk to our Florida team.</h2>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a pre-qual</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-8">
    <div class="container-wide">
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{COMPANY.floridaDba.disclosure}</p>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <p class="eyebrow">Get in touch</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Ready to talk to a loan officer?</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">No credit pull. No commitment. Fill out the form and a loan officer will reach out within one business day.</p>
      <div class="mt-8">
        <ContactForm
          formTo="websiteleads@cliffcomortgage.com,cliffcorpteam@cliffcomortgage.com"
          formSource="location-florida"
        />
      </div>
    </div>
  </section>
</Layout>
