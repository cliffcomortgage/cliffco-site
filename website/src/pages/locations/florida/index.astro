---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { location } from "../../../data/locations";
import { BRANCHES } from "../../../data/branches";
import { product } from "../../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../../lib/schema";

const loc = location("florida")!;
const flBranches = BRANCHES.filter((b) => loc.branchSlugs?.includes(b.slug));

const faq = [
  { question: "Is Cliffco licensed to lend in Florida?", answer: "Yes. Cliffco, Inc. doing business in Florida as Clout Mortgage, Inc., is a New York corporation authorized to transact business in the State of Florida. Corporate NMLS #65328." },
  { question: "Why does Cliffco operate as Clout Mortgage in Florida?", answer: "Clout Mortgage, Inc. is the registered Florida fictitious name (DBA) under which Cliffco, Inc. transacts business in the state. The borrower relationship, NMLS registration, underwriting, and servicing are all Cliffco's; the DBA is a state-required marketing identifier." },
  { question: "What products is Cliffco strongest at in Florida?", answer: "DSCR for short-term-rental investors (Disney area, Tampa, Naples), business bank statement loans for self-employed Florida small-business owners and ITIN borrowers, Non-QM for a wide range of scenarios, reverse mortgages in retiree-heavy Central and SW Florida, and Spanish-language loan support across the state." },
  { question: "How does Florida's insurance crisis affect my mortgage qualification?", answer: "Florida homeowners insurance averages roughly 3× the national average (~$7,100/yr for $300K coverage as of 2025/2026). That cost is included in your debt-to-income calculation, materially affecting how much home you can afford. Cliffco's Florida LOs walk through realistic insurance + tax estimates before you write an offer." },
  { question: "Does Cliffco finance Florida non-warrantable condos?", answer: "Yes. Post-Champlain Towers, Florida passed structural inspection requirements that have made many older condos non-warrantable for conventional Fannie/Freddie financing. Cliffco's Non-QM and portfolio programs handle non-warrantable scenarios that conventional cannot." },
];

const schema = [
  ...flBranches.map((b) => localBusinessSchema(b)),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "Florida", url: "/locations/florida/" },
  ]),
];

import CityHero from "../../../components/asym/CityHero.astro";
import Split from "../../../components/asym/Split.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const coverage = [
  { name: "Orlando / Central Florida", body: "Disney-area short-term-rental and DSCR investors, plus Non-QM for self-employed Central Florida buyers." },
  { name: "Tampa Bay", body: "Investor SFR and small-multi DSCR; growing primary-residence market." },
  { name: "Jacksonville", body: "Affordable entry market; military and first-time buyer." },
  { name: "Naples / SW Florida", body: "Reverse, jumbo, and post-Ian rebuild financing." },
];
---
<Layout title="Florida Mortgage Lender | Cliffco (Clout Mortgage)" description={loc.blurb} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "Florida", href: "/locations/florida/" },
  ]} />

  <CityHero
    word="Florida"
    sub="Mortgage Lender"
    eyebrow="Florida · Operating as Clout Mortgage, Inc."
    lead={loc.blurb}
    facts={[
      { label: "Florida office", value: "Ft. Lauderdale" },
      { label: "Operating as", value: "Clout Mortgage, Inc." },
      { label: "Corporate NMLS", value: `#${COMPANY.nmls}` },
    ]}
  >
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
    <Fragment slot="note">{COMPANY.floridaDba.disclosure}</Fragment>
  </CityHero>

  

  <!-- FEATURED PRODUCTS -->
  <Split eyebrow="What we lead with in Florida" title="Built for Florida borrowers and investors." wide>
    <div class="grid sm:grid-cols-2 gap-4">
      {loc.featuredProducts.map((slug) => {
        const p = product(slug);
        if (!p) return null;
        return (
          <a href={`/loans/${p.slug}/`} class="group rounded-2xl border-2 border-[var(--color-ink)] p-6 no-underline text-[var(--color-ink)] flex flex-col h-full hover:bg-[var(--color-ink)] hover:text-white transition-colors">
            <h3 class="text-lg font-semibold group-hover:!text-white">{p.shortName}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] group-hover:text-white/75 flex-1 leading-relaxed">{p.oneLiner}</p>
            <span class="mt-4 text-sm font-semibold">Learn more →</span>
          </a>
        );
      })}
    </div>
  </Split>

  <!-- FAQ -->
  <Split eyebrow="Florida FAQ" title="Borrower and investor questions.">
    <FaqList items={faq} />
  </Split>

  <CtaBand title="Florida borrowers: talk to our Florida team.">
    <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
    <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary">{COMPANY.hq.phone}</a>
  </CtaBand>

  <!-- VISIT / CALL + FORM -->
  <section class="bg-white">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 lg:col-start-8 lg:row-start-1">
        <FormCard
          title="Questions about buying or investing in Florida?"
          sub="Tell us your situation and we'll connect you with a Florida loan officer who knows this market."
          formSource="location-florida"
        />
      </div>
      <div class="lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:pt-8 space-y-4">
        <!-- Ft. Lauderdale - primary FL branch -->
        <a href="/locations/florida/fort-lauderdale/" class="block rounded-2xl bg-[var(--color-ink)] p-7 no-underline">
          <p class="eyebrow !text-white/55">Our Florida anchor office</p>
          <h2 class="mt-2 !text-white" style="font-size: var(--text-h3); font-weight: 700;">Ft. Lauderdale, FL</h2>
          <p class="mt-3 text-sm text-white/80 leading-relaxed">Serving Miami-Dade, Broward, and Palm Beach. Foreign national, ITIN, condo non-warrantable, jumbo, and DSCR for SE Florida's investor-dense markets. Operates as Clout Mortgage, Inc.</p>
          <span class="mt-5 btn btn-primary !bg-white !text-[var(--color-ink)]">Find Ft. Lauderdale Loan Officers</span>
        </a>

        <!-- Other coverage areas -->
        <div class="grid gap-4 sm:grid-cols-2">
          {coverage.map((c) => (
            <div class="rounded-2xl border-2 border-[var(--color-ink)] p-5">
              <h3 class="text-base font-semibold">{c.name}</h3>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{c.body}</p>
            </div>
          ))}
        </div>

        <a href="/loan-officers/?state=FL" class="mt-2 btn btn-secondary">View all FL loan officers →</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-8">
    <div class="container-wide">
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{COMPANY.floridaDba.disclosure}</p>
    </div>
  </section>
</Layout>
