---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { location } from "../../../data/locations";
import { BRANCHES } from "../../../data/branches";
import { LOAN_OFFICERS } from "../../../data/loan-officers";
import { product } from "../../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../../lib/schema";

const loc = location("florida")!;
const flBranches = BRANCHES.filter((b) => loc.branchSlugs?.includes(b.slug));
const flLOs = LOAN_OFFICERS.filter((lo) => lo.states.includes("FL"));

const faq = [
  { question: "Is Cliffco licensed to lend in Florida?", answer: "Yes. Cliffco, Inc. doing business in Florida as Swish Capital, Inc., is a New York corporation authorized to transact business in the State of Florida. Corporate NMLS #65328." },
  { question: "Why does Cliffco operate as Swish Capital in Florida?", answer: "Swish Capital, Inc. is the registered Florida fictitious name (DBA) under which Cliffco, Inc. transacts business in the state. The borrower relationship, NMLS registration, underwriting, and servicing are all Cliffco's; the DBA is a state-required marketing identifier." },
  { question: "What products is Cliffco strongest at in Florida?", answer: "DSCR for short-term-rental investors (Disney area, Tampa, Naples), business bank statement loans for self-employed Florida small-business owners and ITIN borrowers, non-QM for a wide range of scenarios, reverse mortgages in retiree-heavy Central and SW Florida, and Spanish-language loan support across the state." },
  { question: "How does Florida's insurance crisis affect my mortgage qualification?", answer: "Florida homeowners insurance averages roughly 3Ã— the national average (~$7,100/yr for $300K coverage as of 2025/2026). That cost is included in your debt-to-income calculation, materially affecting how much home you can afford. Cliffco's Florida LOs walk through realistic insurance + tax estimates before you write an offer." },
  { question: "Does Cliffco finance Florida non-warrantable condos?", answer: "Yes â€” post-Champlain Towers, Florida passed structural inspection requirements that have made many older condos non-warrantable for conventional Fannie/Freddie financing. Cliffco's non-QM and portfolio programs handle non-warrantable scenarios that conventional cannot." },
];

const schema = [
  ...flBranches.map((b) => localBusinessSchema(b)),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "Florida", url: "/locations/florida/" },
  ]),
];
---

<Layout title="Florida Mortgage Lender | Cliffco (Swish Capital)" description={loc.blurb} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "Florida", href: "/locations/florida/" },
  ]} />

  <section class="container-wide pt-12 pb-12">
    <p class="eyebrow">Florida â€” operating as Swish Capital, Inc.</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">Florida mortgage lender. DSCR, non-QM, reverse, and business bank statement.</h1>
    <p class="lead mt-6">{loc.blurb}</p>
    <p class="mt-4 text-sm font-semibold text-[var(--color-accent)]">{COMPANY.floridaDba.disclosure}</p>
  </section>

  <section class="bg-white pb-12">
    <div class="container-prose">
      <div class="direct-answer">
        Our Orlando branch anchors a bilingual Florida team handling DSCR loans for
        short-term-rental investors, business bank statement loans, non-QM and ITIN scenarios
        for self-employed Floridians, and reverse mortgages across retiree-heavy Central and SW Florida.
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide">
      <p class="eyebrow">Florida metros we serve</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Our Florida coverage.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <a href="/locations/florida/orlando/" class="card no-underline text-[var(--color-ink)]">
          <h3 class="text-lg font-semibold">Orlando</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Cliffco's Florida anchor; DSCR + STR + bilingual LOs.</p>
          <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">Visit Orlando â†’</span>
        </a>
        <div class="card"><h3 class="text-lg font-semibold">Miami-Dade & SE Florida</h3><p class="mt-2 text-sm text-[var(--color-text-muted)]">Foreign national, ITIN, condo non-warrantable, jumbo.</p></div>
        <div class="card"><h3 class="text-lg font-semibold">Tampa Bay</h3><p class="mt-2 text-sm text-[var(--color-text-muted)]">Investor SFR + small-multi DSCR; growing primary-residence market.</p></div>
        <div class="card"><h3 class="text-lg font-semibold">Jacksonville</h3><p class="mt-2 text-sm text-[var(--color-text-muted)]">Affordable entry market; military + first-time buyer.</p></div>
        <div class="card"><h3 class="text-lg font-semibold">Naples / SW Florida</h3><p class="mt-2 text-sm text-[var(--color-text-muted)]">Reverse + jumbo + post-Ian rebuild.</p></div>
        <div class="card"><h3 class="text-lg font-semibold">Panhandle</h3><p class="mt-2 text-sm text-[var(--color-text-muted)]">Vacation rental + military market.</p></div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">What we lead with in Florida</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Built for Florida borrowers + investors.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {loc.featuredProducts.map((slug) => {
          const p = product(slug);
          if (!p) return null;
          return (
            <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
              <h3 class="font-semibold">{p.shortName}</h3>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] flex-1">{p.oneLiner}</p>
              <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">Learn more â†’</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {flLOs.length > 0 && (
    <section class="section bg-[var(--color-mist-gray)]">
      <div class="container-wide">
        <p class="eyebrow">Florida loan officers</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Bilingual team. Real local people.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {flLOs.slice(0, 9).map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" Â· ")}</p>
              )}
              <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">View bio â†’</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section bg-white">
    <div class="container-prose">
      <p class="eyebrow">Florida FAQ</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Borrower and investor questions.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Florida borrowers â€” talk to our Florida team.</h2>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a pre-qual</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-8">
    <div class="container-wide">
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{COMPANY.floridaDba.disclosure}</p>
    </div>
  </section>
</Layout>
