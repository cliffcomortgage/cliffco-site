---
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumbs from "../../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../../data/company";
import { location } from "../../../../data/locations";
import { BRANCHES } from "../../../../data/branches";
import { LOAN_OFFICERS } from "../../../../data/loan-officers";
import { product } from "../../../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../../../lib/schema";

const loc = location("florida/fort-lauderdale")!;
const ftlBranch = BRANCHES.find((b) => b.slug === "fort-lauderdale-fl")!;
const EXCLUDE = new Set(["christopher-clifford"]);
const branchLOs = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "fort-lauderdale-fl" && !EXCLUDE.has(lo.slug));
const licensedOnlyLOs = LOAN_OFFICERS.filter(
  (lo) => lo.states.includes("FL") && lo.branchSlug !== "fort-lauderdale-fl",
);
// Show up to LIST_MAX people per grid; a "View all" button only appears when there are more.
const LIST_MAX = 9;
const totalFLLOs = LOAN_OFFICERS.filter((lo) => lo.states.includes("FL")).length;

const faq = [
  { question: "Where is Cliffco's Ft. Lauderdale office?", answer: "Cliffco's Ft. Lauderdale branch is at 300 SE 2nd Street, Suite 600, Office 50, Fort Lauderdale, FL 33301. It operates under Cliffco's Florida DBA, Clout Mortgage, Inc. Branch NMLS #2829876." },
  { question: "Is Cliffco licensed to lend in Florida?", answer: "Yes. Cliffco, Inc. doing business in Florida as Clout Mortgage, Inc., is a New York corporation authorized to transact business in the State of Florida. Corporate NMLS #65328." },
  { question: "What loan products does Cliffco offer in South Florida?", answer: "South Florida is a strong market for DSCR loans for investors, foreign national and ITIN programs, non-warrantable condo financing (especially post-Champlain Towers), jumbo and super-jumbo, business bank statement, and Non-QM for self-employed borrowers." },
  { question: "Can Cliffco finance a Miami-Dade or Broward non-warrantable condo?", answer: "Yes. Many South Florida condo buildings became non-warrantable after the structural inspection requirements that followed the Champlain Towers collapse. Cliffco's Non-QM and portfolio programs handle non-warrantable scenarios that conventional Fannie/Freddie lenders cannot." },
  { question: "Does Cliffco work with foreign national buyers in South Florida?", answer: "Yes. Foreign national and ITIN programs are a significant part of South Florida mortgage demand. Speak with a Cliffco loan officer about documentation requirements and available programs for non-US-citizen borrowers." },
];

const schema = [
  localBusinessSchema(ftlBranch),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "Florida", url: "/locations/florida/" },
    { name: "Ft. Lauderdale", url: "/locations/florida/fort-lauderdale/" },
  ]),
];

import CityHero from "../../../../components/asym/CityHero.astro";
import Split from "../../../../components/asym/Split.astro";
import FormCard from "../../../../components/asym/FormCard.astro";
import FaqList from "../../../../components/asym/FaqList.astro";
import CtaBand from "../../../../components/asym/CtaBand.astro";
import LoCard from "../../../../components/asym/LoCard.astro";
---
<Layout
  title="Ft. Lauderdale Mortgage Lender | Cliffco (Clout Mortgage)"
  description={loc.blurb}
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "Florida", href: "/locations/florida/" },
    { name: "Ft. Lauderdale", href: "/locations/florida/fort-lauderdale/" },
  ]} />

  <CityHero
    word="Ft. Lauderdale"
    sub="Mortgage Lender"
    eyebrow="Ft. Lauderdale, FL · Operating as Clout Mortgage, Inc."
    lead={loc.blurb}
    facts={[
      { label: "Address", value: `${ftlBranch.street}, ${ftlBranch.city}, ${ftlBranch.region} ${ftlBranch.postalCode}` },
      ...(ftlBranch.nmls ? [{ label: "Branch NMLS", value: `#${ftlBranch.nmls}` }] : []),
      { label: "Florida-licensed loan officers", value: String(totalFLLOs) },
    ]}
  >
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
    <Fragment slot="note">{COMPANY.floridaDba.disclosure}</Fragment>
  </CityHero>

  <!-- VISIT / CALL + FORM -->
  <section class="bg-white">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 lg:col-start-8 lg:row-start-1">
        <FormCard
          title="Have a South Florida deal or question? Talk to our team."
          sub="Tell us the property and your situation and we'll have a South Florida loan officer back to you within one business day."
          formTo="karabian@cliffcomortgage.com,websiteleads@cliffcomortgage.com"
          formSource="location-ftlauderdale"
        />
      </div>
      <div class="lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:pt-8">
        <p class="eyebrow">Our Ft. Lauderdale office</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">Where we are.</h2>
        <article class="mt-8 rounded-2xl bg-[var(--color-ink)] text-white p-7">
          <h3 class="text-lg font-semibold !text-white">{ftlBranch.name}</h3>
          {ftlBranch.street && <p class="text-white/80 mt-3">{ftlBranch.street}<br/>{ftlBranch.city}, {ftlBranch.region} {ftlBranch.postalCode}</p>}
          {ftlBranch.nmls && <p class="text-xs text-white/55 mt-3">Branch NMLS #{ftlBranch.nmls}</p>}
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-white mt-4">Operates as Clout Mortgage, Inc.</p>
        </article>
      </div>
    </div>
  </section>


  

  <!-- FEATURED PRODUCTS -->
  <Split eyebrow="What we lead with in South Florida" title="Built for South Florida borrowers and investors." wide>
    <div class="grid sm:grid-cols-2 gap-4">
      {loc.featuredProducts.map((slug) => {
        const p = product(slug);
        if (!p) return null;
        return (
          <a href={`/loans/${p.slug}/`} class="group rounded-2xl border-2 border-[var(--color-ink)] p-6 no-underline text-[var(--color-ink)] flex flex-col h-full hover:bg-[var(--color-ink)] hover:text-white transition-colors">
            <h3 class="text-lg font-semibold group-hover:!text-white">{p.shortName}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] group-hover:text-white/75 flex-1 leading-relaxed">{p.oneLiner}</p>
            <span class="mt-4 text-sm font-semibold">Learn more →</span>
          </a>
        );
      })}
    </div>
  </Split>

  <!-- LOs physically at the Ft. Lauderdale branch -->
  {branchLOs.length > 0 && (
    <Split
      eyebrow="Located at our Ft. Lauderdale office"
      title="Loan officers based here."
      intro="These loan officers are physically based at Cliffco's Ft. Lauderdale branch (operating as Clout Mortgage, Inc.)."
      wide
    >
      <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
        {branchLOs.map((lo) => <LoCard lo={lo} />)}
      </div>
    </Split>
  )}

  <!-- LOs licensed in FL but based elsewhere -->
  {licensedOnlyLOs.length > 0 && (
    <Split
      eyebrow="Also licensed in Florida"
      title="Other Florida-licensed loan officers."
      intro="These loan officers are based at other Cliffco offices but are fully licensed to originate loans in Florida."
      wide
    >
      <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4 lo-shuffle-grid">
        {licensedOnlyLOs.slice(0, LIST_MAX).map((lo) => <LoCard lo={lo} />)}
      </div>
      {licensedOnlyLOs.length > LIST_MAX && (
        <a href="/loan-officers/?state=FL" class="mt-8 btn btn-primary">View all {totalFLLOs} Florida-licensed loan officers →</a>
      )}
    </Split>
  )}

  <!-- FAQ -->
  <Split eyebrow="Ft. Lauderdale FAQ" title="Borrower and investor questions.">
    <FaqList items={faq} />
  </Split>

  <CtaBand title="Got a South Florida deal? Talk to our team." text="DSCR, non-warrantable condo, foreign national, and Non-QM specialists. Real underwriting in 24 hours.">
    <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
    <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary">{COMPANY.hq.phone}</a>
  </CtaBand>

<section class="bg-white py-8">
    <div class="container-wide">
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{COMPANY.floridaDba.disclosure}</p>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>(".lo-shuffle-grid").forEach((grid) => {
    const children = [...grid.children] as HTMLElement[];
    for (let i = children.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      grid.appendChild(children[j]);
    }
  });
</script>
