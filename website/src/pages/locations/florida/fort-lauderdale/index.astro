---
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumbs from "../../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../../data/company";
import { location } from "../../../../data/locations";
import { BRANCHES } from "../../../../data/branches";
import { LOAN_OFFICERS } from "../../../../data/loan-officers";
import { product } from "../../../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../../../lib/schema";
import Headshot from "../../../../components/ui/Headshot.astro";

const loc = location("florida/fort-lauderdale")!;
const ftlBranch = BRANCHES.find((b) => b.slug === "fort-lauderdale-fl")!;
const EXCLUDE = new Set(["christopher-clifford"]);
const branchLOs = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "fort-lauderdale-fl" && !EXCLUDE.has(lo.slug));
const licensedOnlyLOs = LOAN_OFFICERS.filter(
  (lo) => lo.states.includes("FL") && lo.branchSlug !== "fort-lauderdale-fl" && lo.branchSlug !== "orlando-fl" && !EXCLUDE.has(lo.slug),
);
const totalFLLOs = LOAN_OFFICERS.filter((lo) => lo.states.includes("FL")).length;

const faq = [
  { question: "Where is Cliffco's Ft. Lauderdale office?", answer: "Cliffco's Ft. Lauderdale branch is at 300 SE 2nd Street, Suite 600, Office 50, Fort Lauderdale, FL 33301. It operates under Cliffco's Florida DBA, Swish Capital, Inc. Branch NMLS #2829876." },
  { question: "Is Cliffco licensed to lend in Florida?", answer: "Yes. Cliffco, Inc. doing business in Florida as Swish Capital, Inc., is a New York corporation authorized to transact business in the State of Florida. Corporate NMLS #65328." },
  { question: "What loan products does Cliffco offer in South Florida?", answer: "South Florida is a strong market for DSCR loans for investors, foreign national and ITIN programs, non-warrantable condo financing (especially post-Champlain Towers), jumbo and super-jumbo, business bank statement, and Non-QM for self-employed borrowers." },
  { question: "Can Cliffco finance a Miami-Dade or Broward non-warrantable condo?", answer: "Yes. Many South Florida condo buildings became non-warrantable after the structural inspection requirements that followed the Champlain Towers collapse. Cliffco's Non-QM and portfolio programs handle non-warrantable scenarios that conventional Fannie/Freddie lenders cannot." },
  { question: "Does Cliffco work with foreign national buyers in South Florida?", answer: "Yes. Foreign national and ITIN programs are a significant part of South Florida mortgage demand. Speak with a Cliffco loan officer about documentation requirements and available programs for non-US-citizen borrowers." },
];

const schema = [
  localBusinessSchema(ftlBranch),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "Florida", url: "/locations/florida/" },
    { name: "Ft. Lauderdale", url: "/locations/florida/fort-lauderdale/" },
  ]),
];
import ContactForm from "../../../../components/forms/ContactForm.astro";
---

<Layout
  title="Ft. Lauderdale Mortgage Lender | Cliffco (Swish Capital)"
  description={loc.blurb}
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "Florida", href: "/locations/florida/" },
    { name: "Ft. Lauderdale", href: "/locations/florida/fort-lauderdale/" },
  ]} />

  <section class="accent-gradient">
    <div class="container-wide py-16 lg:py-24">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Ft. Lauderdale, FL · Operating as Swish Capital, Inc.</p>
      <h1 class="mt-4 text-white max-w-3xl" style="font-size: var(--text-display-xl); line-height: 1.05; font-weight: 700; font-family: var(--font-sans);">
        Ft. Lauderdale Mortgage Lender
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">{loc.blurb}</p>
      <p class="mt-4 text-sm text-white/70">{COMPANY.floridaDba.disclosure}</p>
      <div class="mt-6 flex flex-wrap gap-4 items-center">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide">
      <p class="eyebrow">Our Ft. Lauderdale office</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Where we are.</h2>
      <div class="mt-8 max-w-sm">
        <article class="card">
          <h3 class="text-lg font-semibold">{ftlBranch.name}</h3>
          {ftlBranch.street && <p class="text-sm text-[var(--color-text-muted)] mt-2">{ftlBranch.street}<br/>{ftlBranch.city}, {ftlBranch.region} {ftlBranch.postalCode}</p>}
          {ftlBranch.nmls && <p class="text-xs text-[var(--color-text-muted)] mt-2">Branch NMLS #{ftlBranch.nmls}</p>}
          <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">Operates as Swish Capital, Inc.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">What we lead with in South Florida</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Built for South Florida borrowers and investors.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {loc.featuredProducts.map((slug) => {
          const p = product(slug);
          if (!p) return null;
          return (
            <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
              <h3 class="font-semibold">{p.shortName}</h3>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] flex-1">{p.oneLiner}</p>
              <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- LOs physically at the Ft. Lauderdale branch -->
  {branchLOs.length > 0 && (
    <section class="section bg-[var(--color-mist-gray)]">
      <div class="container-wide">
        <p class="eyebrow">Located at our Ft. Lauderdale office</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Loan officers based here.</h2>
        <p class="lead mt-4 max-w-3xl text-[var(--color-text-muted)]">
          These loan officers are physically based at Cliffco's Ft. Lauderdale branch (operating as Swish Capital, Inc.).
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {branchLOs.map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- LOs licensed in FL but based elsewhere -->
  {licensedOnlyLOs.length > 0 && (
    <section class={`section ${branchLOs.length > 0 ? "bg-white" : "bg-[var(--color-mist-gray)]"}`}>
      <div class="container-wide">
        <p class="eyebrow">Also licensed in Florida</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Other Florida-licensed loan officers.</h2>
        <p class="lead mt-4 max-w-3xl text-[var(--color-text-muted)]">
          These loan officers are based at other Cliffco offices but are fully licensed to originate loans in Florida.
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3 lo-shuffle-grid">
          {licensedOnlyLOs.slice(0, 6).map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
        <p class="mt-6"><a href="/loan-officers/?state=FL" class="btn btn-primary">View all {totalFLLOs} Florida-licensed loan officers →</a></p>
      </div>
    </section>
  )}

  <section class="section bg-white">
    <div class="container-prose">
      <p class="eyebrow">Ft. Lauderdale FAQ</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Borrower and investor questions.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Got a South Florida deal? Talk to our team.</h2>
      <p class="lead mt-4 text-white/85">DSCR, non-warrantable condo, foreign national, and Non-QM specialists. Real underwriting in 24 hours.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a pre-qual</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-8">
    <div class="container-wide">
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{COMPANY.floridaDba.disclosure}</p>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <p class="eyebrow">Get in touch</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Have a South Florida deal or question? Talk to our team.</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">No credit pull. Tell us the property and your situation and we'll have a South Florida loan officer back to you within one business day.</p>
      <div class="mt-8">
        <ContactForm
          formTo="karabian@cliffcomortgage.com,websiteleads@cliffcomortgage.com"
          formSource="location-ftlauderdale"
        />
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>(".lo-shuffle-grid").forEach((grid) => {
    const children = [...grid.children] as HTMLElement[];
    for (let i = children.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      grid.appendChild(children[j]);
    }
  });
</script>
