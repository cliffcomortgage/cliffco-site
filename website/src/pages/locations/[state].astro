---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { location } from "../../data/locations";
import { BRANCHES } from "../../data/branches";
import { LOAN_OFFICERS, loanOfficersByBranch } from "../../data/loan-officers";
import { product } from "../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../lib/schema";
import Headshot from "../../components/ui/Headshot.astro";
import ContactForm from "../../components/forms/ContactForm.astro";

export async function getStaticPaths() {
  // Render top-level state pages: new-jersey, arizona, minnesota, florida.
  // (new-york + long-island + orlando are dedicated nested files.)
  const states = ["new-jersey", "arizona", "minnesota", "florida"] as const;
  return states.map((slug) => {
    const loc = location(slug)!;
    return { params: { state: slug }, props: { loc } };
  });
}

const { loc } = Astro.props;
const stateBranches = BRANCHES.filter((b) => loc.branchSlugs?.includes(b.slug));
const branchLandingPages: Record<string, string> = {
  'buckeye-az': '/buckeye-az/',
  'excelsior-mn': '/excelsior-mn/',
  'branchburg-nj': '/branchburg-nj/',
};
const stateBranchSlugs = new Set(stateBranches.map((b) => b.slug));
const EXCLUDE_FROM_LOCATIONS = new Set(["christopher-clifford"]);
// LOs physically assigned to a branch in this state
const branchLOs = LOAN_OFFICERS.filter(
  (lo) => lo.states.includes(loc.state) && stateBranchSlugs.has(lo.branchSlug) && !EXCLUDE_FROM_LOCATIONS.has(lo.slug),
);
// LOs licensed in this state but based at a branch elsewhere
const licensedOnlyLOs = LOAN_OFFICERS.filter(
  (lo) => lo.states.includes(loc.state) && !stateBranchSlugs.has(lo.branchSlug) && !EXCLUDE_FROM_LOCATIONS.has(lo.slug),
);
// Total state-licensed LOs shown in the directory when filtered by state
const totalStateLOs = LOAN_OFFICERS.filter((lo) => lo.states.includes(loc.state)).length;

const faq = loc.isFlorida
  ? [
      { question: "Is Cliffco licensed to lend in Florida?", answer: "Yes. Cliffco, Inc. doing business in Florida as Swish Capital, Inc., is a New York corporation authorized to transact business in the State of Florida. Corporate NMLS #65328." },
      { question: "What products is Cliffco strongest at in Florida?", answer: "DSCR for short-term-rental investors (Disney area, Tampa, Naples), business bank statement loans for self-employed Florida small-business owners and ITIN borrowers, Non-QM for a wide range of scenarios, and reverse mortgages in retiree-heavy Central and SW Florida." },
      { question: "How does Florida's insurance market affect my mortgage?", answer: "Florida homeowners insurance averages roughly 3× the national average (~$7,100/yr for $300K coverage as of 2025/2026). That cost is included in your debt-to-income calculation, which materially affects how much home you can afford. Cliffco's Florida LOs walk through realistic insurance + tax estimates before you write an offer." },
    ]
  : loc.state === "MN"
  ? [
      { question: "Is Cliffco licensed in Minnesota?", answer: "Yes. Cliffco is licensed by the Minnesota Department of Commerce as MN-MO-65328 (corporate NMLS #65328). Our Excelsior, MN office serves the Twin Cities and beyond." },
      { question: "Who is Cliffco's Minnesota loan officer?", answer: "Mitchell Patterson (NMLS #2560483) is our Excelsior, MN-based loan officer. Several other Cliffco LOs are also MN-licensed, including President Christopher Clifford." },
    ]
  : loc.state === "AZ"
  ? [
      { question: "Is Cliffco licensed in Arizona?", answer: "Yes. Cliffco holds Arizona Mortgage Banker License 1045708 (corporate NMLS #65328). Our Buckeye branch serves the Phoenix metro and statewide." },
      { question: "What products are strongest in Arizona?", answer: "Reverse mortgages in retiree-heavy areas (Sun City, Sun Lakes), DSCR for the state's investor-friendly SFR market, Non-QM bank statement loans, and business bank statement loans for self-employed borrowers." },
    ]
  : [
      { question: `Is Cliffco licensed in ${loc.name}?`, answer: `Yes. ${COMPANY.legalName} (NMLS #${COMPANY.nmls}) is licensed to originate residential mortgages in ${loc.name}. See the licensing page for the regulator and license number specific to ${loc.name}.` },
      { question: `What products does Cliffco offer in ${loc.name}?`, answer: `Cliffco offers all four of our specialty products in ${loc.name}: Non-QM and self-employed loans, reverse mortgages, DSCR for investors, and business bank statement loans, plus conventional, FHA, VA, USDA, and renovation loans.` },
    ];

const schema = [
  ...stateBranches.map((b) => localBusinessSchema(b)),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: loc.name, url: `/locations/${loc.path}/` },
  ]),
];
---

<Layout title={`${loc.name} Mortgage Lender | Cliffco`} description={loc.blurb} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: loc.name, href: `/locations/${loc.path}/` },
  ]} />

  <section class="accent-gradient">
    <div class="container-wide py-16 lg:py-24">
      <p class="eyebrow !text-[var(--color-ice-blue)]">{loc.name} · Cliffco Mortgage Bankers</p>
      <h1 class="mt-4 text-white max-w-3xl" style="font-size: var(--text-display-xl); line-height: 1.1; font-weight: 400; font-family: var(--font-sans);">
        {loc.name} Mortgage Lender
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">{loc.blurb}</p>
      {loc.isFlorida && (
        <p class="mt-4 text-sm text-white/70">{COMPANY.floridaDba.disclosure}</p>
      )}
      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>


  {stateBranches.length > 0 && (
    <section class="bg-[var(--color-mist-gray)] section">
      <div class="container-wide">
        <p class="eyebrow">Our {loc.name} offices</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Where we are.</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {stateBranches.map((b) => {
            const landingUrl = branchLandingPages[b.slug];
            return landingUrl ? (
              <a href={landingUrl} class="card no-underline text-[var(--color-ink)] flex flex-col">
                <h3 class="text-lg font-semibold">{b.name}</h3>
                {b.metro && <p class="text-xs text-[var(--color-text-muted)] mt-1">{b.metro}</p>}
                {b.street && <p class="text-sm text-[var(--color-text-muted)] mt-2">{b.street}<br/>{b.city}, {b.region} {b.postalCode}</p>}
                {b.phone && <p class="text-sm mt-1 font-medium">{b.phone}</p>}
                {b.nmls && <p class="text-xs text-[var(--color-text-muted)] mt-2">Branch NMLS #{b.nmls}</p>}
                <p class="text-sm text-[var(--color-text-muted)] mt-3">{loanOfficersByBranch(b.slug).length} loan officer{loanOfficersByBranch(b.slug).length === 1 ? "" : "s"}.</p>
                <span class="mt-auto pt-3 text-sm font-semibold text-[var(--color-accent)]">View office →</span>
              </a>
            ) : (
              <article class="card">
                <h3 class="text-lg font-semibold">{b.name}</h3>
                {b.metro && <p class="text-xs text-[var(--color-text-muted)] mt-1">{b.metro}</p>}
                {b.street && <p class="text-sm text-[var(--color-text-muted)] mt-2">{b.street}<br/>{b.city}, {b.region} {b.postalCode}</p>}
                {b.phone && <p class="text-sm mt-1"><a href={`tel:${b.phone.replace(/\D/g, "")}`} class="text-[var(--color-ink)] no-underline font-medium">{b.phone}</a></p>}
                {b.nmls && <p class="text-xs text-[var(--color-text-muted)] mt-2">Branch NMLS #{b.nmls}</p>}
                <p class="text-sm text-[var(--color-text-muted)] mt-3">{loanOfficersByBranch(b.slug).length} loan officer{loanOfficersByBranch(b.slug).length === 1 ? "" : "s"}.</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">What we lead with in {loc.name}</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Built for {loc.name} borrowers.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {loc.featuredProducts.map((slug) => {
          const p = product(slug);
          if (!p) return null;
          return (
            <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
              <h3 class="font-semibold">{p.shortName}</h3>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] flex-1">{p.oneLiner}</p>
              <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {branchLOs.length > 0 && (
    <section class="section bg-[var(--color-mist-gray)]">
      <div class="container-wide">
        <p class="eyebrow">Located at our {loc.name} offices</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Loan officers based here.</h2>
        <p class="lead mt-4 max-w-3xl text-[var(--color-text-muted)]">
          These loan officers are physically located at a Cliffco branch in {loc.name}.
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {branchLOs.slice(0, 9).map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {licensedOnlyLOs.length > 0 && (
    <section class="section bg-white">
      <div class="container-wide">
        <p class="eyebrow">{loc.state === "AZ" ? "Licensed in Arizona" : `Also licensed in ${loc.name}`}</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">{loc.state === "AZ" ? "Arizona-licensed loan officers." : `Other ${loc.name}-licensed loan officers.`}</h2>
        <p class="lead mt-4 max-w-3xl text-[var(--color-text-muted)]">
          These loan officers are based at other Cliffco offices but are fully licensed to originate loans in {loc.name}.
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3 lo-shuffle-grid">
          {licensedOnlyLOs.slice(0, 6).map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls} · Based in {BRANCHES.find((b) => b.slug === lo.branchSlug)?.city ?? "NY"}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
        <p class="mt-6"><a href={`/loan-officers/?state=${loc.state}`} class="btn btn-primary">View all {totalStateLOs} {loc.name}-licensed loan officers →</a></p>
      </div>
    </section>
  )}

  <section class="section bg-white">
    <div class="container-prose">
      <p class="eyebrow">{loc.name} FAQ</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Local borrower questions.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">{loc.name} borrowers - talk to a real Cliffco LO.</h2>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a pre-qual</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>

  {loc.isFlorida && (
    <section class="bg-white py-8">
      <div class="container-wide">
        <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{COMPANY.floridaDba.disclosure}</p>
      </div>
    </section>
  )}

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <h2 class="mt-3" style="font-size: var(--text-h2);">Questions about buying or refinancing in {loc.name}?</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">Tell us your situation and a {loc.name}-licensed loan officer will be in touch within one business day.</p>
      <div class="mt-8">
        <ContactForm
          formTo={{
            NJ: "gjohansen@cliffcomortgage.com,emorais@cliffcomortgage.com,dfeliciano@cliffcomortgage.com,websiteleads@cliffcomortgage.com",
            MN: "mpatterson@cliffcomortgage.com,websiteleads@cliffcomortgage.com",
          }[loc.state] ?? "websiteleads@cliffcomortgage.com,cliffcorpteam@cliffcomortgage.com"}
          formSource={`location-${loc.state.toLowerCase()}`}
        />
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>(".lo-shuffle-grid").forEach((grid) => {
    const children = [...grid.children] as HTMLElement[];
    for (let i = children.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      grid.appendChild(children[j]);
    }
  });
</script>
