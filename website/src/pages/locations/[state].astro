---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { location } from "../../data/locations";
import { BRANCHES } from "../../data/branches";
import { LOAN_OFFICERS, loanOfficersByBranch } from "../../data/loan-officers";
import { product } from "../../data/products";
import { localBusinessSchema, faqPageSchema, breadcrumbSchema } from "../../lib/schema";
import CityHero from "../../components/asym/CityHero.astro";
import Split from "../../components/asym/Split.astro";
import FormCard from "../../components/asym/FormCard.astro";
import FaqList from "../../components/asym/FaqList.astro";
import CtaBand from "../../components/asym/CtaBand.astro";
import LoCard from "../../components/asym/LoCard.astro";

export async function getStaticPaths() {
  // Render top-level state pages: new-jersey, arizona, minnesota, florida.
  // (new-york + long-island + orlando are dedicated nested files.)
  const states = ["new-jersey", "arizona", "minnesota", "florida"] as const;
  return states.map((slug) => {
    const loc = location(slug)!;
    return { params: { state: slug }, props: { loc } };
  });
}

const { loc } = Astro.props;
const stateBranches = BRANCHES.filter((b) => loc.branchSlugs?.includes(b.slug));
const branchLandingPages: Record<string, string> = {
  'buckeye-az': '/buckeye-az/',
  'excelsior-mn': '/excelsior-mn/',
  'branchburg-nj': '/branchburg-nj/',
};
const stateBranchSlugs = new Set(stateBranches.map((b) => b.slug));
const EXCLUDE_FROM_LOCATIONS = new Set(["christopher-clifford"]);
// LOs physically assigned to a branch in this state
const branchLOs = LOAN_OFFICERS.filter(
  (lo) => lo.states.includes(loc.state) && stateBranchSlugs.has(lo.branchSlug) && !EXCLUDE_FROM_LOCATIONS.has(lo.slug),
);
// LOs licensed in this state but based at a branch elsewhere
const licensedOnlyLOs = LOAN_OFFICERS.filter(
  (lo) => lo.states.includes(loc.state) && !stateBranchSlugs.has(lo.branchSlug),
);
// Show up to LIST_MAX people per grid (three full rows); a "View all" button only appears when there are more.
const LIST_MAX = 9;
// Total state-licensed LOs shown in the directory when filtered by state
const totalStateLOs = LOAN_OFFICERS.filter((lo) => lo.states.includes(loc.state)).length;

const faq = loc.isFlorida
  ? [
      { question: "Is Cliffco licensed to lend in Florida?", answer: "Yes. Cliffco, Inc. doing business in Florida as Clout Mortgage, Inc., is a New York corporation authorized to transact business in the State of Florida. Corporate NMLS #65328." },
      { question: "What products is Cliffco strongest at in Florida?", answer: "DSCR for short-term-rental investors (Disney area, Tampa, Naples), business bank statement loans for self-employed Florida small-business owners and ITIN borrowers, Non-QM for a wide range of scenarios, and reverse mortgages in retiree-heavy Central and SW Florida." },
      { question: "How does Florida's insurance market affect my mortgage?", answer: "Florida homeowners insurance averages roughly 3× the national average (~$7,100/yr for $300K coverage as of 2025/2026). That cost is included in your debt-to-income calculation, which materially affects how much home you can afford. Cliffco's Florida LOs walk through realistic insurance + tax estimates before you write an offer." },
    ]
  : loc.state === "MN"
  ? [
      { question: "Is Cliffco licensed in Minnesota?", answer: "Yes. Cliffco is licensed by the Minnesota Department of Commerce as MN-MO-65328 (corporate NMLS #65328). Our Excelsior, MN office serves the Twin Cities and beyond." },
      { question: "Who is Cliffco's Minnesota loan officer?", answer: "Mitchell Patterson (NMLS #2560483) is our Excelsior, MN-based loan officer. Several other Cliffco LOs are also MN-licensed, including President Christopher Clifford." },
    ]
  : loc.state === "AZ"
  ? [
      { question: "Is Cliffco licensed in Arizona?", answer: "Yes. Cliffco holds Arizona Mortgage Banker License 1045708 (corporate NMLS #65328). Our Buckeye branch serves the Phoenix metro and statewide." },
      { question: "What products are strongest in Arizona?", answer: "Reverse mortgages in retiree-heavy areas (Sun City, Sun Lakes), DSCR for the state's investor-friendly SFR market, Non-QM bank statement loans, and business bank statement loans for self-employed borrowers." },
    ]
  : [
      { question: `Is Cliffco licensed in ${loc.name}?`, answer: `Yes. ${COMPANY.legalName} (NMLS #${COMPANY.nmls}) is licensed to originate residential mortgages in ${loc.name}. See the licensing page for the regulator and license number specific to ${loc.name}.` },
      { question: `What products does Cliffco offer in ${loc.name}?`, answer: `Cliffco offers all four of our specialty products in ${loc.name}: Non-QM and self-employed loans, reverse mortgages, DSCR for investors, and business bank statement loans, plus conventional, FHA, VA, USDA, and renovation loans.` },
    ];

const leadTo = ({
  NJ: "gjohansen@cliffcomortgage.com,emorais@cliffcomortgage.com,dfeliciano@cliffcomortgage.com,websiteleads@cliffcomortgage.com",
  MN: "mpatterson@cliffcomortgage.com,websiteleads@cliffcomortgage.com",
} as Record<string, string>)[loc.state] ?? "websiteleads@cliffcomortgage.com,cliffcorpteam@cliffcomortgage.com";

const schema = [
  ...stateBranches.map((b) => localBusinessSchema(b)),
  faqPageSchema(faq),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: loc.name, url: `/locations/${loc.path}/` },
  ]),
];
---

<Layout title={`${loc.name} Mortgage Lender | Cliffco`} description={loc.blurb} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: loc.name, href: `/locations/${loc.path}/` },
  ]} />

  <CityHero
    word={loc.name}
    sub="Mortgage Lender"
    eyebrow={`${loc.name} · Cliffco Mortgage Bankers`}
    lead={loc.blurb}
    facts={[
      { label: `${loc.name}-licensed loan officers`, value: String(totalStateLOs) },
      ...(stateBranches.length > 0 ? [{ label: stateBranches.length === 1 ? "Office" : "Offices", value: stateBranches.map((b) => b.city).join(" · ") }] : []),
      { label: "Corporate NMLS", value: `#${COMPANY.nmls}` },
    ]}
  >
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
    {loc.isFlorida && <Fragment slot="note">{COMPANY.floridaDba.disclosure}</Fragment>}
  </CityHero>

  <!-- VISIT / CALL + FORM -->
  <section class="bg-white">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 lg:col-start-8 lg:row-start-1">
        <FormCard
          title={`Questions about buying or refinancing in ${loc.name}?`}
          sub={`Tell us your situation and a ${loc.name}-licensed loan officer will be in touch within one business day.`}
          formTo={leadTo}
          formSource={`location-${loc.state.toLowerCase()}`}
        />
      </div>
      <div class="lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:pt-8">
        {stateBranches.length > 0 ? (
          <>
            <p class="eyebrow">Our {loc.name} offices</p>
            <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">Where we are.</h2>
            <div class="mt-8 grid gap-4">
              {stateBranches.map((b) => {
                const landingUrl = branchLandingPages[b.slug];
                const n = loanOfficersByBranch(b.slug).length;
                const inner = (
                  <>
                    <h3 class="text-lg font-semibold !text-white">{b.name}</h3>
                    {b.metro && <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/55 mt-1">{b.metro}</p>}
                    {b.street && <p class="text-sm text-white/80 mt-3">{b.street}<br/>{b.city}, {b.region} {b.postalCode}</p>}
                    {b.phone && <p class="text-sm mt-1 font-medium text-white">{b.phone}</p>}
                    {b.nmls && <p class="text-xs text-white/55 mt-2">Branch NMLS #{b.nmls}</p>}
                    {n > 0 && <p class="text-sm text-white/80 mt-3">{n} loan officer{n === 1 ? "" : "s"}.</p>}
                    {landingUrl && <span class="mt-4 inline-block text-sm font-semibold text-white">View office →</span>}
                  </>
                );
                return landingUrl ? (
                  <a href={landingUrl} class="block rounded-2xl bg-[var(--color-ink)] p-7 no-underline">{inner}</a>
                ) : (
                  <article class="rounded-2xl bg-[var(--color-ink)] p-7">{inner}</article>
                );
              })}
            </div>
          </>
        ) : (
          <>
            <p class="eyebrow">What we lead with in {loc.name}</p>
            <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">Built for {loc.name} borrowers.</h2>
            <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{loc.blurb}</p>
          </>
        )}
      </div>
    </div>
  </section>


  

  <!-- FEATURED PRODUCTS -->
  <Split eyebrow={`What we lead with in ${loc.name}`} title={`Built for ${loc.name} borrowers.`} wide>
    <div class="grid sm:grid-cols-2 gap-4">
      {loc.featuredProducts.map((slug) => {
        const p = product(slug);
        if (!p) return null;
        return (
          <a href={`/loans/${p.slug}/`} class="group rounded-2xl border-2 border-[var(--color-ink)] p-6 no-underline text-[var(--color-ink)] flex flex-col h-full hover:bg-[var(--color-ink)] hover:text-white transition-colors">
            <h3 class="text-lg font-semibold group-hover:!text-white">{p.shortName}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] group-hover:text-white/75 flex-1 leading-relaxed">{p.oneLiner}</p>
            <span class="mt-4 text-sm font-semibold">Learn more →</span>
          </a>
        );
      })}
    </div>
  </Split>

  {branchLOs.length > 0 && (
    <Split
      eyebrow={`Located at our ${loc.name} offices`}
      title="Loan officers based here."
      intro={`These loan officers are physically located at a Cliffco branch in ${loc.name}.`}
      wide
    >
      <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
        {branchLOs.slice(0, LIST_MAX).map((lo) => <LoCard lo={lo} />)}
      </div>
    </Split>
  )}

  {licensedOnlyLOs.length > 0 && (
    <Split
      eyebrow={loc.state === "AZ" ? "Licensed in Arizona" : `Also licensed in ${loc.name}`}
      title={loc.state === "AZ" ? "Arizona-licensed loan officers." : `Other ${loc.name}-licensed loan officers.`}
      intro={`These loan officers are based at other Cliffco offices but are fully licensed to originate loans in ${loc.name}.`}
      wide
    >
      <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4 lo-shuffle-grid">
        {licensedOnlyLOs.slice(0, LIST_MAX).map((lo) => (
          <LoCard lo={lo} note={`Based in ${BRANCHES.find((b) => b.slug === lo.branchSlug)?.city ?? "NY"}`} />
        ))}
      </div>
      {licensedOnlyLOs.length > LIST_MAX && (
        <a href={`/loan-officers/?state=${loc.state}`} class="mt-8 btn btn-primary">View all {totalStateLOs} {loc.name}-licensed loan officers →</a>
      )}
    </Split>
  )}

  <!-- FAQ -->
  <Split eyebrow={`${loc.name} FAQ`} title="Local borrower questions.">
    <FaqList items={faq} />
  </Split>

  <CtaBand title={`${loc.name} borrowers - talk to a real Cliffco LO.`}>
    <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
    <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary">{COMPANY.hq.phone}</a>
  </CtaBand>

{loc.isFlorida && (
    <section class="bg-white py-8">
      <div class="container-wide">
        <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{COMPANY.floridaDba.disclosure}</p>
      </div>
    </section>
  )}
</Layout>

<script>
  document.querySelectorAll<HTMLElement>(".lo-shuffle-grid").forEach((grid) => {
    const children = [...grid.children] as HTMLElement[];
    for (let i = children.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      grid.appendChild(children[j]);
    }
  });
</script>
