---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { BRANCHES } from "../../data/branches";
import { LOAN_OFFICERS, loanOfficersByBranch } from "../../data/loan-officers";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";

const branch = BRANCHES.find((b) => b.slug === "uniondale-headquarters")!;
const EXCLUDE = new Set(["christopher-clifford"]);
// Primary-office LOs plus those who also work out of HQ (e.g. the Zambellis).
const los = loanOfficersByBranch("uniondale-headquarters").filter((lo) => !EXCLUDE.has(lo.slug));
const featuredLOs = los.slice(0, 12);
const uniondaleCount = loanOfficersByBranch("uniondale-headquarters").length;

const schema = [
  localBusinessSchema(branch),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "New York", url: "/locations/new-york/" },
    { name: "Long Island", url: "/locations/new-york/long-island/" },
    { name: "Uniondale", url: "/uniondale/" },
  ]),
];

import BranchPage from "../../components/asym/BranchPage.astro";

---

<Layout
  title="Uniondale, NY Headquarters | Cliffco Mortgage Bankers"
  description="Cliffco Mortgage Bankers headquarters - 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553. (516) 408-7300. Corporate NMLS #65328. Founded 1989."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "New York", href: "/locations/new-york/" },
    { name: "Long Island", href: "/locations/new-york/long-island/" },
    { name: "Uniondale", href: "/uniondale/" },
  ]} />

  <BranchPage
    city="Uniondale"
    eyebrow="Uniondale, NY · Headquarters · Since 1989"
    title="Cliffco Headquarters"
    lead="Cliffco Mortgage Bankers was founded in Uniondale in 1989 and has been headquartered here ever since. Our HQ is home to our largest team of loan officers, underwriting, operations, and leadership."
    addressName="Cliffco Mortgage Bankers (Headquarters)"
    street={COMPANY.hq.street}
    cityLine={`${COMPANY.hq.city}, ${COMPANY.hq.region} ${COMPANY.hq.postalCode}`}
    nmlsLabel={`Corporate #${COMPANY.nmls}`}
    phone={{ e164: COMPANY.hq.phoneE164, display: COMPANY.hq.phone, label: "Main" }}
    findTitle="Find us in Uniondale."
    about={`Founded in 1989, Cliffco has been independently owned and operated from Uniondale for ${COMPANY.yearsInBusiness()} years. Our HQ team includes specialists across every product: Non-QM, DSCR, reverse mortgage, bank statement, conventional, FHA, VA, and jumbo, all underwritten in-house with no call centers and no handoffs.`}
    back={{ href: "/locations/new-york/long-island/", label: "← All Long Island offices" }}
    los={featuredLOs}
    teamEyebrow="Loan officers at headquarters"
    teamTitle="Our Uniondale team."
    teamIntro={`${uniondaleCount} loan officers work out of our Uniondale headquarters. A selection is shown below.`}
    allLink={{ href: "/loan-officers/", label: `View all ${uniondaleCount} Uniondale loan officers →` }}
    ctaTitle="Find the right loan program with our HQ team."
    formTitle="Buying or refinancing anywhere in New York?"
    formSub="Tell us your situation and a Cliffco loan officer will be in touch within one business day."
    formSource="branch-uniondale"
  >
    <Fragment slot="info">
      <p>NMLS #{COMPANY.nmls}</p>
      <p>Toll Free <a href={`tel:${COMPANY.tollFreeE164}`} class="text-[var(--color-ink)] font-medium no-underline hover:underline">{COMPANY.tollFree}</a></p>
    </Fragment>
  </BranchPage>
</Layout>
