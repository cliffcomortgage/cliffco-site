---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { BRANCHES } from "../../data/branches";
import { LOAN_OFFICERS } from "../../data/loan-officers";
import Headshot from "../../components/ui/Headshot.astro";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";

const branch = BRANCHES.find((b) => b.slug === "uniondale-headquarters")!;
const EXCLUDE = new Set(["christopher-clifford"]);
const los = LOAN_OFFICERS.filter(
  (lo) => lo.branchSlug === "uniondale-headquarters" && !EXCLUDE.has(lo.slug),
);
const featuredLOs = los.slice(0, 12);

const schema = [
  localBusinessSchema(branch),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "New York", url: "/locations/new-york/" },
    { name: "Long Island", url: "/locations/new-york/long-island/" },
    { name: "Uniondale", url: "/uniondale/" },
  ]),
];
---

<Layout
  title="Uniondale, NY Headquarters | Cliffco Mortgage Bankers"
  description="Cliffco Mortgage Bankers headquarters — 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553. (516) 408-7300. Corporate NMLS #65328. Founded 1989."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "New York", href: "/locations/new-york/" },
    { name: "Long Island", href: "/locations/new-york/long-island/" },
    { name: "Uniondale", href: "/uniondale/" },
  ]} />

  <section class="accent-gradient">
    <div class="container-wide py-16 lg:py-24">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Uniondale, NY · Headquarters · Since 1989</p>
      <h1 class="mt-4 text-white max-w-3xl" style="font-size: var(--text-display-xl); line-height: 1.05; font-weight: 700; font-family: var(--font-sans);">
        Cliffco Headquarters
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">
        Cliffco Mortgage Bankers was founded in Uniondale in 1989 and has been headquartered here ever since. Our HQ is home to our largest team of loan officers, underwriting, operations, and leadership.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">
          <span class="text-white/70 font-normal text-xs">Main</span>&nbsp;{COMPANY.hq.phone}
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide grid lg:grid-cols-2 gap-10 items-start">
      <div>
        <p class="eyebrow">Headquarters information</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Find us in Uniondale.</h2>
        <address class="not-italic mt-6 space-y-2 text-[var(--color-text)]">
          <p class="font-semibold text-[var(--color-ink)]">Cliffco Mortgage Bankers (Headquarters)</p>
          <p>{COMPANY.hq.street}</p>
          <p>{COMPANY.hq.city}, {COMPANY.hq.region} {COMPANY.hq.postalCode}</p>
          <p>
            <span class="text-[var(--color-text-muted)] text-xs">Toll Free</span>
            <a href={`tel:${COMPANY.tollFreeE164}`} class="ml-1 text-[var(--color-ink)] no-underline font-medium hover:text-[var(--color-accent)]">{COMPANY.tollFree}</a>
          </p>
          <p>
            <span class="text-[var(--color-text-muted)] text-xs">Main</span>
            <a href={`tel:${COMPANY.hq.phoneE164}`} class="ml-1 text-[var(--color-ink)] no-underline font-medium hover:text-[var(--color-accent)]">{COMPANY.hq.phone}</a>
          </p>
        </address>
        <p class="mt-4 text-sm text-[var(--color-text-muted)]">NMLS #{COMPANY.nmls}</p>
      </div>
      <div class="card">
        <p class="eyebrow">About our headquarters</p>
        <p class="mt-3 text-[var(--color-text)] leading-relaxed">
          Founded in 1989, Cliffco has been independently owned and operated from Uniondale for over 36 years. Our HQ team includes specialists across every product: non-QM, DSCR, reverse mortgage, bank statement, conventional, FHA, VA, and jumbo — all underwritten in-house with no call centers and no handoffs.
        </p>
        <a href="/locations/new-york/long-island/" class="mt-4 inline-block text-sm font-semibold text-[var(--color-accent)] no-underline hover:underline">← All Long Island offices</a>
      </div>
    </div>
  </section>

  {featuredLOs.length > 0 && (
    <section class="section bg-[var(--color-mist-gray)]">
      <div class="container-wide">
        <p class="eyebrow">Loan officers at headquarters</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Our Uniondale team.</h2>
        <p class="lead mt-4 max-w-3xl text-[var(--color-text-muted)]">
          {los.length} loan officers are based at our Uniondale headquarters. A selection is shown below.
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {featuredLOs.map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-auto pt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/loan-officers/" class="btn btn-primary">View all {los.length} Uniondale loan officers →</a>
        </div>
      </div>
    </section>
  )}

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Ready to get started?</h2>
      <p class="lead mt-4 text-white/85">A licensed Cliffco loan officer responds in one business day.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>
</Layout>
