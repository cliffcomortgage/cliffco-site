---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { LOAN_OFFICERS, loanOfficer } from "../../data/loan-officers";
import Headshot from "../../components/ui/Headshot.astro";
import { faqPageSchema, articleSchema } from "../../lib/schema";

const today = new Date().toISOString().slice(0, 10);

const teamSlugs = ["joseph-cordeira", "emily-cordeira"];
const teamMembers = teamSlugs.map(s => LOAN_OFFICERS.find(lo => lo.slug === s)!).filter(Boolean);
const joe = loanOfficer("joseph-cordeira")!;

const faq = [
  {
    question: "What is a Non-QM loan?",
    answer: "Non-QM stands for Non-Qualified Mortgage. It refers to loans that don't conform to the standard Fannie Mae and Freddie Mac guidelines most banks follow. Non-QM doesn't mean high-risk. It means flexible. These programs use alternative documentation like bank statements, P&L statements, or asset depletion to qualify borrowers whose income doesn't present cleanly through tax returns.",
  },
  {
    question: "Who is a Non-QM loan right for?",
    answer: "Self-employed professionals, business owners, real estate investors, 1099 contractors, and anyone who has been turned down by a conventional lender despite having the income and assets to support a mortgage. If your tax returns understate what you actually earn, Non-QM programs are designed for exactly that situation.",
  },
  {
    question: "What is a bank statement loan?",
    answer: "A bank statement loan qualifies you using 12 to 24 months of personal or business bank deposits rather than tax returns. Lenders average your deposits over the statement period to calculate qualifying income. For business accounts, a standard expense ratio is applied. No W-2 or tax return documentation is required.",
  },
  {
    question: "Can I qualify for a Non-QM loan if I was turned down elsewhere?",
    answer: "Often, yes. The most common reason creditworthy borrowers are declined by conventional lenders is income documentation, not actual financial strength. If you have solid assets, consistent deposits, and good credit, a Non-QM program may qualify you where a bank could not. Team Cordeira reviews each file personally and identifies which program gives you the best path forward.",
  },
  {
    question: "Are Non-QM rates significantly higher than conventional rates?",
    answer: "Non-QM rates are typically somewhat higher than conventional mortgage rates to reflect the alternative documentation structure. However, for borrowers who can't qualify conventionally, the access to financing outweighs the rate difference. Team Cordeira will show you the full cost picture so you can make an informed decision.",
  },
  {
    question: "What programs does Team Cordeira offer beyond bank statement loans?",
    answer: "The team originates a full range of Non-QM products including P&L-only loans, 1099 loans, asset depletion programs for high-net-worth individuals, DSCR loans for investors, and ITIN loans for borrowers without a Social Security number. They also originate conventional, FHA, and VA loans for borrowers who qualify through traditional documentation.",
  },
];

const schema = [
  faqPageSchema(faq),
  articleSchema({
    headline: "Team Cordeira | Cliffco Mortgage Bankers",
    description: "Team Cordeira at Cliffco Mortgage Bankers. A husband and wife Non-QM specialist team helping self-employed borrowers, investors, and clients turned down elsewhere on Long Island.",
    url: "/team-cordeira/",
    datePublished: "2026-04-15",
    dateModified: today,
    authorSlug: "joseph-cordeira",
  }),
];
import ContactForm from "../../components/forms/ContactForm.astro";
---

<Layout
  title="Team Cordeira | Non-QM Specialists | Cliffco Mortgage Bankers"
  description="Team Cordeira at Cliffco Mortgage Bankers. A husband and wife Non-QM specialist team. Bank statements, P&L, DSCR, 1099, and asset depletion programs for Long Island borrowers."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Team Cordeira", href: "/team-cordeira/" },
  ]} />

  <!-- ═══ HERO ═════════════════════════════════════════════════ -->
  <section class="bg-[var(--color-rich-black)] relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="background-image:radial-gradient(rgba(189,232,241,0.06) 1px,transparent 1px);background-size:32px 32px;" aria-hidden="true"></div>
    <div class="container-wide pt-20 pb-16 lg:pt-28 lg:pb-20 relative z-10">
      <div class="text-center">
        <img
          src="/images/team%20logos/Team%20Cordeira_Stacked_White.png"
          alt="Team Cordeira"
          class="mx-auto mb-8 select-none"
          style="max-height:108px;width:auto;"
          loading="eager"
        />
        <p class="text-[var(--color-ice-blue)] text-xs tracking-[0.3em] uppercase font-light mb-5">Cliffco Mortgage Bankers · Uniondale, New York</p>
        <h1 class="text-white" style="font-size:clamp(2.25rem,5vw,4rem);font-weight:200;letter-spacing:-0.04em;line-height:1.08;">
          A husband and wife Non-QM team<br/>
          <em style="font-style:italic;font-weight:300;color:rgba(189,232,241,0.9);">built around your real financial story.</em>
        </h1>
        <p class="mt-6 text-white/65 font-light leading-relaxed max-w-xl mx-auto" style="font-size:1.05rem;">
          Joe and Emily Cordeira specialize in Non-QM mortgage solutions for self-employed borrowers, investors, and clients who don't fit the conventional mold. If a bank said no, they want to know why.
        </p>
        <div class="mt-14 flex justify-center gap-4 flex-wrap">
          <a href={joe.links?.applyNow ?? "/get-started/"} target="_blank" rel="noopener"
            style="background:#fff;color:#0d0d0d;text-decoration:none;padding:0.875rem 2.25rem;border-radius:999px;font-weight:600;font-size:0.9375rem;letter-spacing:0.02em;">
            Work With The Team
          </a>
          {joe.links?.directPhone && (
            <a href={`tel:${joe.links.directPhone.replace(/[^+\d]/g, "")}`}
              style="background:transparent;color:rgba(255,255,255,0.8);text-decoration:none;padding:0.875rem 2.25rem;border-radius:999px;font-weight:400;font-size:0.9375rem;border:1px solid rgba(255,255,255,0.25);">
              {joe.links.directPhone}
            </a>
          )}
        </div>
      </div>

      <!-- Stats -->
      <div class="mt-16 pt-14 border-t border-white/15 grid sm:grid-cols-3 gap-10 sm:gap-0 sm:divide-x divide-white/15">
        {[
          { stat: "2015", label: "In the mortgage industry", sub: "Nearly a decade of experience" },
          { stat: "Non-QM", label: "Primary specialty", sub: "Bank statement · P&L · DSCR · 1099" },
          { stat: "2", label: "Specialists on the team", sub: "Joe & Emily Cordeira" },
        ].map(d => (
          <div class="sm:px-16 first:pl-0 last:pr-0 text-center sm:text-left">
            <p style="font-size:clamp(1.75rem,4vw,2.75rem);font-weight:200;letter-spacing:-0.04em;color:#fff;line-height:1;">{d.stat}</p>
            <p class="text-white/65 font-light text-sm mt-3">{d.label}</p>
            <p class="text-white/40 text-xs mt-1.5 tracking-wide">{d.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ THE TEAM ══════════════════════════════════════════════ -->
  <section style="padding-block:6rem;" class="bg-white">
    <div class="container-wide">
      <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-text-muted)] font-light mb-4">The team</p>
      <h2 style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:300;letter-spacing:-0.03em;color:var(--color-ink);">Meet Team Cordeira.</h2>
      <p class="mt-4 text-[var(--color-text-muted)] font-light leading-relaxed max-w-xl" style="font-size:1.05rem;">
        Joe and Emily have built their careers together in mortgage, bringing a personal and partnership-driven approach to every file. Two specialists, one team, one shared commitment to getting clients into homes.
      </p>
      <div class="mt-12 grid gap-10 sm:grid-cols-2 max-w-2xl">
        {teamMembers.map((lo) => (
          <a href={`/loan-officers/${lo.slug}/`} class="group no-underline text-[var(--color-ink)] flex flex-col">
            {lo.hasPhoto && (
              <div class="rounded-lg overflow-hidden aspect-square bg-[var(--color-mist-gray)] mb-4">
                <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="group-hover:scale-105 transition-transform duration-500" />
              </div>
            )}
            <div class="border-t border-[var(--color-mist-gray)] pt-3">
              <p class="font-medium text-[var(--color-ink)] text-sm">{lo.displayName}</p>
              <p class="text-xs text-[var(--color-text-muted)] font-light mt-0.5">{lo.title}</p>
              <p class="text-xs text-[var(--color-text-muted)]/60 mt-0.5">NMLS #{lo.nmls}</p>
              <span class="mt-2 text-xs font-medium text-[var(--color-accent)] inline-block">View profile →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PROGRAMS ══════════════════════════════════════════════ -->
  <section style="padding-block:6rem;" class="bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-text-muted)] font-light mb-4">Non-QM programs</p>
      <h2 style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:300;letter-spacing:-0.03em;color:var(--color-ink);">Most lenders stop at your tax return.<br/>We start there.</h2>
      <p class="mt-4 text-[var(--color-text-muted)] font-light leading-relaxed max-w-xl" style="font-size:1.05rem;">
        Non-QM loans use alternative documentation methods to capture what your tax returns don't. Here are the programs Team Cordeira originates most frequently.
      </p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {[
          {
            name: "Bank Statement Loans",
            range: "12–24 months",
            href: "/loans/business-bank-statement/",
            body: "Qualify using personal or business bank deposits. Lenders average 12 to 24 months of statements. No tax returns required. For self-employed borrowers, freelancers, and business owners.",
          },
          {
            name: "P&L Loans",
            range: "CPA-prepared P&L",
            href: "/loans/non-qm-self-employed/",
            body: "A CPA-prepared Profit and Loss statement replaces the tax return. Designed for business owners with complex write-offs that make taxable income look lower than actual cash flow.",
          },
          {
            name: "1099 Loans",
            range: "Independent contractors",
            href: "/loans/non-qm-self-employed/",
            body: "Qualify using 1099 income from one or multiple sources. No business bank statements or tax returns required. Ideal for gig workers, consultants, and independent contractors.",
          },
          {
            name: "DSCR Loans",
            range: "Qualify on rental income",
            href: "/loans/dscr/",
            body: "Investment properties qualify on their own cash flow. No personal income documentation. Short-term and long-term rentals accepted. LLC vesting allowed.",
          },
          {
            name: "Asset Depletion",
            range: "High-net-worth borrowers",
            href: "/loans/non-qm-self-employed/",
            body: "Significant liquid assets are converted into a qualifying income figure. For retirees, high-net-worth individuals, or borrowers with savings but limited active income.",
          },
          {
            name: "ITIN Loans",
            range: "No SSN required",
            href: "/loans/non-qm-self-employed/",
            body: "Borrowers without a Social Security number can use an Individual Taxpayer Identification Number to qualify. Available for eligible immigrants and non-permanent residents.",
          },
        ].map(spec => (
          <a href={spec.href} class="group card no-underline text-[var(--color-ink)] flex flex-col gap-3 h-full">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-medium text-[var(--color-ink)]" style="font-size:1.05rem;letter-spacing:-0.01em;">{spec.name}</h3>
              <span class="text-xs font-semibold text-[var(--color-accent)] bg-[var(--color-accent)]/8 px-2.5 py-1 rounded-full shrink-0 mt-0.5">{spec.range}</span>
            </div>
            <p class="text-sm text-[var(--color-text-muted)] font-light leading-relaxed flex-1">{spec.body}</p>
            <span class="text-xs font-medium text-[var(--color-accent)] mt-auto group-hover:translate-x-1 inline-block transition-transform">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ WHY NON-QM ════════════════════════════════════════════ -->
  <section style="padding-block:6rem;" class="bg-white">
    <div class="container-wide grid lg:grid-cols-2 gap-16 items-start">
      <div>
        <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-text-muted)] font-light mb-4">Why Non-QM</p>
        <h2 style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:300;letter-spacing:-0.03em;color:var(--color-ink);">A bank no doesn't mean the answer is no.</h2>
        <p class="mt-5 text-[var(--color-text)] font-light leading-relaxed" style="font-size:1.05rem;">
          The conventional mortgage system was built around W-2 employment. For the growing number of Americans who are self-employed, run businesses, or invest in real estate, that system routinely produces declines that don't reflect actual financial strength.
        </p>
        <p class="mt-4 text-[var(--color-text)] font-light leading-relaxed" style="font-size:1.05rem;">
          Non-QM programs exist to close that gap. Team Cordeira reviews each file personally, identifies which program gives the borrower the best qualification, and structures the loan around what they actually earn.
        </p>
        <a href={joe.links?.applyNow ?? "/get-started/"} target="_blank" rel="noopener" class="mt-10 inline-block btn btn-primary text-sm">
          Tell us your situation
        </a>
      </div>
      <div class="space-y-4 lg:pt-10">
        {[
          { label: "No credit pull for pre-qualification", detail: "Team Cordeira reviews your file on a soft inquiry. A hard pull only happens when you formally apply and authorize it." },
          { label: "We review complex files personally", detail: "Every file is reviewed by Joe or Emily, not a processing system. Complex income situations get the human attention they require." },
          { label: "We can also broker when it benefits you", detail: "Cliffco is a direct lender, but also has access to a broker channel when a specific program or rate is better sourced elsewhere." },
          { label: "We also do conventional, FHA, and VA", detail: "Non-QM is the specialty, but Team Cordeira originates the full range of programs. If conventional is the right fit, they'll say so." },
        ].map(p => (
          <div class="border border-[var(--color-mist-gray)] rounded-lg p-6">
            <h3 class="font-medium text-[var(--color-ink)]" style="font-size:1rem;">{p.label}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] font-light leading-relaxed">{p.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══════════════════════════════════════════════════ -->
  <section style="padding-block:6rem;" class="bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-3xl">
      <h2 style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:300;letter-spacing:-0.03em;color:var(--color-ink);">The Non-QM questions we hear every week.</h2>
      <div class="mt-10 space-y-2">
        {faq.map((item) => (
          <details class="bg-white rounded-lg border border-[var(--color-mist-gray)] overflow-hidden group">
            <summary class="flex items-center justify-between px-6 py-5 font-medium text-[var(--color-ink)] cursor-pointer list-none text-sm">
              {item.question}
              <svg class="w-4 h-4 shrink-0 text-[var(--color-accent)] transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="px-6 pb-6 text-sm text-[var(--color-text)] font-light leading-relaxed border-t border-[var(--color-mist-gray)] pt-4">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══════════════════════════════════════════════════ -->
  <section class="bg-[var(--color-rich-black)] relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="background-image:radial-gradient(rgba(189,232,241,0.06) 1px,transparent 1px);background-size:32px 32px;" aria-hidden="true"></div>
    <div class="container-wide py-20 lg:py-28 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-[var(--color-ice-blue)] text-xs tracking-[0.3em] uppercase font-light mb-5">If a bank said no</p>
          <h2 style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:200;letter-spacing:-0.04em;color:#fff;line-height:1.1;">
            Tell us why.<br/>
            <span style="font-weight:300;color:rgba(255,255,255,0.6);">We'll find the right program.</span>
          </h2>
          <p class="mt-5 text-white/50 font-light leading-relaxed" style="font-size:1rem;">
            No credit pull. No commitment. A conversation with Joe or Emily starts with your situation and ends with a clear path forward.
          </p>
        </div>
        <div class="flex flex-col items-center gap-4">
          <div style="width:100%;max-width:260px;">
            <img
              src="/images/team%20logos/Team%20Cordeira_Stacked_White.png"
              alt="Team Cordeira"
              class="w-full h-auto mb-7 select-none"
              style="max-height:108px;object-fit:contain;object-position:center;"
              loading="lazy"
            />
            <a href={joe.links?.applyNow ?? "/get-started/"} target="_blank" rel="noopener"
              style="display:block;width:100%;text-align:center;background:#fff;color:#0d0d0d;text-decoration:none;padding:0.875rem 1.5rem;border-radius:999px;font-weight:600;font-size:0.9375rem;letter-spacing:0.01em;">
              Start Your Application
            </a>
          </div>
          <div class="flex flex-col gap-2 items-center text-center">
            {joe.links?.email && (
              <a href={`mailto:${joe.links.email}`}
                style="color:rgba(255,255,255,0.4);font-size:0.8125rem;font-weight:300;text-decoration:none;"
                class="hover:text-white transition-colors">
                {joe.links.email}
              </a>
            )}
            {joe.links?.directPhone && (
              <a href={`tel:${joe.links.directPhone.replace(/[^+\d]/g, "")}`}
                style="color:rgba(255,255,255,0.4);font-size:0.8125rem;font-weight:300;text-decoration:none;"
                class="hover:text-white transition-colors">
                {joe.links.directPhone}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <h2 class="mt-3" style="font-size: var(--text-h2);">Turned down by a bank? Talk to Team Cordeira.</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">Tell us why you were declined and Joe or Emily will identify which Non-QM program fits.</p>
      <div class="mt-8">
        <ContactForm
          formTo="jcordeira@cliffcomortgage.com,websiteleads@cliffcomortgage.com"
          formSource="team-cordeira"
        />
      </div>
    </div>
  </section>
</Layout>
