---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { LOAN_OFFICERS, loanOfficer } from "../../data/loan-officers";
import { faqPageSchema, articleSchema } from "../../lib/schema";


const teamSlugs = ["joseph-cordeira", "emily-cordeira"];
const teamMembers = teamSlugs.map(s => LOAN_OFFICERS.find(lo => lo.slug === s)!).filter(Boolean);
const joe = loanOfficer("joseph-cordeira")!;

const faq = [
  {
    question: "What is a Non-QM loan?",
    answer: "Non-QM stands for Non-Qualified Mortgage. It refers to loans that don't conform to the standard Fannie Mae and Freddie Mac guidelines most banks follow. Non-QM doesn't mean high-risk. It means flexible. These programs use alternative documentation like bank statements, P&L statements, or asset depletion to qualify borrowers whose income doesn't present cleanly through tax returns.",
  },
  {
    question: "Who is a Non-QM loan right for?",
    answer: "Self-employed professionals, business owners, real estate investors, 1099 contractors, and anyone who has been turned down by a conventional lender despite having the income and assets to support a mortgage. If your tax returns understate what you actually earn, Non-QM programs are designed for exactly that situation.",
  },
  {
    question: "What is a bank statement loan?",
    answer: "A bank statement loan qualifies you using 12 to 24 months of personal or business bank deposits rather than tax returns. Lenders average your deposits over the statement period to calculate qualifying income. For business accounts, a standard expense ratio is applied. No W-2 or tax return documentation is required.",
  },
  {
    question: "Can I qualify for a Non-QM loan if I was turned down elsewhere?",
    answer: "Often, yes. The most common reason creditworthy borrowers are declined by conventional lenders is income documentation, not actual financial strength. If you have solid assets, consistent deposits, and good credit, a Non-QM program may qualify you where a bank could not. Team Cordeira reviews each file personally and identifies which program gives you the best path forward.",
  },
  {
    question: "Are Non-QM rates significantly higher than conventional rates?",
    answer: "Non-QM rates are typically somewhat higher than conventional mortgage rates to reflect the alternative documentation structure. However, for borrowers who can't qualify conventionally, the access to financing outweighs the rate difference. Team Cordeira will show you the full cost picture so you can make an informed decision.",
  },
  {
    question: "What programs does Team Cordeira offer beyond bank statement loans?",
    answer: "The team originates a full range of Non-QM products including P&L-only loans, 1099 loans, asset depletion programs for high-net-worth individuals, DSCR loans for investors, and ITIN loans for borrowers without a Social Security number. They also originate conventional, FHA, and VA loans for borrowers who qualify through traditional documentation.",
  },
];

const schema = [
  faqPageSchema(faq),
  articleSchema({
    headline: "Team Cordeira | Cliffco Mortgage Bankers",
    description: "Team Cordeira at Cliffco Mortgage Bankers. A husband and wife Non-QM specialist team helping self-employed borrowers, investors, and clients turned down elsewhere on Long Island.",
    url: "/team-cordeira/",
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
    authorSlug: "joseph-cordeira",
  }),
];

import TeamPoster from "../../components/asym/TeamPoster.astro";
import TeamBlock from "../../components/asym/TeamBlock.astro";
import FaqList from "../../components/asym/FaqList.astro";
import FormCard from "../../components/asym/FormCard.astro";

const programs = [
  { name: "Bank Statement Loans", range: "12–24 months", href: "/loans/business-bank-statement/", body: "Qualify using personal or business bank deposits. Lenders average 12 to 24 months of statements. No tax returns required. For self-employed borrowers, freelancers, and business owners." },
  { name: "P&L Loans", range: "CPA-prepared P&L", href: "/loans/non-qm-self-employed/", body: "A CPA-prepared Profit and Loss statement replaces the tax return. Designed for business owners with complex write-offs that make taxable income look lower than actual cash flow." },
  { name: "1099 Loans", range: "Independent contractors", href: "/loans/non-qm-self-employed/", body: "Qualify using 1099 income from one or multiple sources. No business bank statements or tax returns required. Ideal for gig workers, consultants, and independent contractors." },
  { name: "DSCR Loans", range: "Qualify on rental income", href: "/loans/dscr/", body: "Investment properties qualify on their own cash flow. No personal income documentation. Short-term and long-term rentals accepted. LLC vesting allowed." },
  { name: "Asset Depletion", range: "High-net-worth borrowers", href: "/loans/non-qm-self-employed/", body: "Significant liquid assets are converted into a qualifying income figure. For retirees, high-net-worth individuals, or borrowers with savings but limited active income." },
  { name: "ITIN Loans", range: "No SSN required", href: "/loans/non-qm-self-employed/", body: "Borrowers without a Social Security number can use an Individual Taxpayer Identification Number to qualify. Available for eligible immigrants and non-permanent residents." },
];
const promises = [
  { label: "No credit pull for pre-qualification", detail: "Team Cordeira reviews your file on a soft inquiry. A hard pull only happens when you formally apply and authorize it." },
  { label: "We review complex files personally", detail: "Every file is reviewed by Joe or Emily, not a processing system. Complex income situations get the human attention they require." },
  { label: "We can also broker when it benefits you", detail: "Cliffco is a direct lender, but also has access to a broker channel when a specific program or rate is better sourced elsewhere." },
  { label: "We also do conventional, FHA, and VA", detail: "Non-QM is the specialty, but Team Cordeira originates the full range of programs. If conventional is the right fit, they'll say so." },
];
---

<Layout
  title="Team Cordeira | Non-QM Specialists | Cliffco Mortgage Bankers"
  description="Team Cordeira at Cliffco Mortgage Bankers. A husband and wife Non-QM specialist team. Bank statements, P&L, DSCR, 1099, and asset depletion programs for Long Island borrowers."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Team Cordeira", href: "/team-cordeira/" },
  ]} />

  <TeamPoster
    eyebrow="Cliffco Mortgage Bankers · Uniondale, New York"
    logo={{ src: "/images/team%20logos/Team%20Cordeira_Stacked_White.png", alt: "Team Cordeira", maxHeight: "96px" }}
    members={teamMembers}
    teamTitle="Meet Team Cordeira."
    teamIntro="Joe and Emily have built their careers together in mortgage, bringing a personal and partnership-driven approach to every file. Two specialists, one team, one shared commitment to getting clients into homes."
    stats={[
      { stat: "2015", label: "In the mortgage industry", sub: "Nearly a decade of experience" },
      { stat: "Non-QM", label: "Primary specialty", sub: "Bank statement · P&L · DSCR · 1099" },
      { stat: "2", label: "Specialists on the team", sub: "Joe & Emily Cordeira" },
    ]}
  >
    A husband and wife Non-QM team built around your real financial story.
    <p slot="lead" class="text-white/75 leading-relaxed" style="font-size: 1.0625rem;">
      Joe and Emily Cordeira specialize in Non-QM mortgage solutions for self-employed borrowers, investors, and clients who don't fit the conventional mold. If a bank said no, they want to know why.
    </p>
    <Fragment slot="actions">
      <a href={joe.links?.applyNow ?? "/get-started/"} target="_blank" rel="noopener" class="btn btn-primary">Work With The Team</a>
      {joe.links?.directPhone && (
        <a href={`tel:+1${joe.links.directPhone.replace(/\D/g, "")}`} class="btn btn-secondary">{joe.links.directPhone}</a>
      )}
    </Fragment>
  </TeamPoster>

  <!-- PROGRAMS -->
  <TeamBlock eyebrow="Non-QM programs" title="Most lenders stop at your tax return.<br/>We start there." intro="Non-QM loans use alternative documentation methods to capture what your tax returns don't. Here are the programs Team Cordeira originates most frequently.">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {programs.map((spec) => (
        <a href={spec.href} class="group rounded-2xl border-2 border-[var(--color-ink)] p-6 no-underline text-[var(--color-ink)] flex flex-col gap-3 h-full hover:bg-[var(--color-ink)] hover:text-white transition-colors">
          <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] group-hover:text-white/60">{spec.range}</span>
          <h3 class="font-semibold group-hover:!text-white" style="font-size: 1.125rem;">{spec.name}</h3>
          <p class="text-sm text-[var(--color-text-muted)] group-hover:text-white/75 leading-relaxed flex-1">{spec.body}</p>
          <span class="text-sm font-semibold mt-auto">Learn more →</span>
        </a>
      ))}
    </div>
  </TeamBlock>

  <!-- WHY NON-QM -->
  <TeamBlock eyebrow="Why Non-QM" title="A bank no doesn't mean the answer is no.">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <p class="text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">
          The conventional mortgage system was built around W-2 employment. For the growing number of Americans who are self-employed, run businesses, or invest in real estate, that system routinely produces declines that don't reflect actual financial strength.
        </p>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">
          Non-QM programs exist to close that gap. Team Cordeira reviews each file personally, identifies which program gives the borrower the best qualification, and structures the loan around what they actually earn.
        </p>
        <a href={joe.links?.applyNow ?? "/get-started/"} target="_blank" rel="noopener" class="mt-8 inline-block btn btn-primary text-sm">Tell us your situation</a>
      </div>
      <ol class="lg:col-span-6 lg:col-start-7 list-none m-0 p-0 border-t-2 border-[var(--color-ink)]">
        {promises.map((p, i) => (
          <li class="grid grid-cols-[3rem_1fr] gap-3 py-5 border-b border-black/15">
            <span class="font-mono text-sm text-[var(--color-text-muted)]">0{i + 1}</span>
            <div>
              <h3 class="font-semibold text-[var(--color-ink)]" style="font-size: 1.0625rem;">{p.label}</h3>
              <p class="mt-1 text-sm text-[var(--color-text)] leading-relaxed">{p.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </TeamBlock>

  <!-- FAQ -->
  <TeamBlock eyebrow="FAQ" title="The Non-QM questions we hear every week.">
    <div class="max-w-4xl"><FaqList items={faq} /></div>
  </TeamBlock>

  <!-- CTA + FORM -->
  <TeamBlock dark eyebrow="If a bank said no" title="Tell us why. We'll find the right program." intro="No credit pull. No commitment. A conversation with Joe or Emily starts with your situation and ends with a clear path forward.">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <img src="/images/team%20logos/Team%20Cordeira_Stacked_White.png" alt="Team Cordeira" class="select-none w-auto" style="max-height: 96px;" loading="lazy" />
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={joe.links?.applyNow ?? "/get-started/"} target="_blank" rel="noopener" class="btn btn-primary !bg-white !text-[var(--color-ink)] hover:!bg-white/85">Start Your Application</a>
        </div>
        <div class="mt-6 flex flex-col gap-1.5 text-sm">
          {joe.links?.email && <a href={`mailto:${joe.links.email}`} class="!text-white/70 no-underline hover:!text-white">{joe.links.email}</a>}
          {joe.links?.directPhone && <a href={`tel:+1${joe.links.directPhone.replace(/\D/g, "")}`} class="!text-white/70 no-underline hover:!text-white">{joe.links.directPhone}</a>}
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <FormCard
          eyebrow="Talk to Team Cordeira"
          title="Turned down by a bank? Talk to Team Cordeira."
          sub="Tell us why you were declined and Joe or Emily will identify which Non-QM program fits."
          formTo="jcordeira@cliffcomortgage.com,websiteleads@cliffcomortgage.com"
          formSource="team-cordeira"
        />
      </div>
    </div>
  </TeamBlock>
</Layout>
