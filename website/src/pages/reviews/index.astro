---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { REVIEW_PLATFORMS, FEATURED_REVIEWS } from "../../data/reviews";

const totalReviews = REVIEW_PLATFORMS.reduce((sum, p) => sum + p.reviewCount, 0);
const ratedPlatforms = REVIEW_PLATFORMS.filter((p) => p.rating !== null);
const avgRating =
  ratedPlatforms.reduce((sum, p) => sum + (p.rating ?? 0), 0) / ratedPlatforms.length;

function stars(rating: number | null) {
  if (rating === null) return "";
  const full = Math.floor(rating);
  const half = rating - full >= 0.5;
  return "★".repeat(full) + (half ? "½" : "") + "☆".repeat(5 - full - (half ? 1 : 0));
}

const writeReviewPlatforms = REVIEW_PLATFORMS.filter((p) => p.writeUrl);
---

<Layout
  title="Reviews | Cliffco Mortgage Bankers"
  description={`Cliffco Mortgage Bankers has over ${totalReviews.toLocaleString()} reviews across Experience.com, WalletHub, Zillow, Google, and more — with an average rating of ${avgRating.toFixed(1)} out of 5.`}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Reviews", href: "/reviews/" },
  ]} />

  <!-- HERO -->
  <section class="container-wide pt-12 pb-12">
    <p class="eyebrow">Reviews</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">What borrowers say about Cliffco.</h1>
    <p class="lead mt-6">
      Over {totalReviews.toLocaleString()}+ reviews across the web. Averaged across rated platforms: {avgRating.toFixed(1)} out of 5.
    </p>
  </section>

  <!-- PLATFORM CARDS -->
  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide">
      <p class="eyebrow">Ratings by platform</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Where to find our reviews.</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {REVIEW_PLATFORMS.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card no-underline text-[var(--color-ink)] flex flex-col"
          >
            <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">{p.name}</p>
            <p class="mt-2 text-3xl font-semibold text-[var(--color-ink)]">{p.ratingDisplay}</p>
            {p.rating !== null && (
              <p class="mt-1 text-[var(--color-accent)] text-lg tracking-wide" aria-hidden="true">
                {stars(p.rating)}
              </p>
            )}
            {p.reviewCount > 0 && (
              <p class="mt-1 text-sm text-[var(--color-text-muted)]">
                {p.reviewCount.toLocaleString()}+ reviews
              </p>
            )}
            {p.note && (
              <p class="mt-2 text-xs text-[var(--color-text-muted)] flex-1">{p.note}</p>
            )}
            <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">
              Read on {p.name} ↗
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED QUOTES -->
  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">What people are saying</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">In their own words.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {FEATURED_REVIEWS.map((r) => (
          <figure class="card flex flex-col">
            <blockquote class="text-sm text-[var(--color-text)] leading-relaxed flex-1">
              <p>"{r.quote}"</p>
            </blockquote>
            <figcaption class="mt-4 pt-4 border-t border-[var(--color-mist-gray)]">
              <p class="text-xs font-semibold text-[var(--color-ink)]">{r.author}</p>
              <p class="text-xs text-[var(--color-text-muted)]">{r.platform}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- LEAVE A REVIEW -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow">Leave a review</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Worked with Cliffco? We'd love to hear from you.</h2>
        <p class="mt-4 text-[var(--color-text-muted)]">
          Reviews help future borrowers find a lender they can trust, and they help us keep improving. It only takes a minute.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {writeReviewPlatforms.map((p) => (
          <a
            href={p.writeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="card no-underline text-[var(--color-ink)] flex items-center justify-between gap-4"
          >
            <div>
              <p class="font-semibold">{p.name}</p>
              {p.ratingDisplay && (
                <p class="text-xs text-[var(--color-text-muted)] mt-0.5">{p.ratingDisplay} overall</p>
              )}
            </div>
            <span class="text-sm font-semibold text-[var(--color-accent)] whitespace-nowrap">Write a review ↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Ready to become one of our borrowers?</h2>
      <p class="lead mt-4 text-white/85">A licensed Cliffco LO responds within one business day.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get started</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>
</Layout>
