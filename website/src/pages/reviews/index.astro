---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import IndexHeader from "../../components/asym/IndexHeader.astro";
import IndexSection from "../../components/asym/IndexSection.astro";
import { COMPANY } from "../../data/company";
import { REVIEW_PLATFORMS, FEATURED_REVIEWS, averageRating } from "../../data/reviews";

const totalReviews = REVIEW_PLATFORMS.reduce((sum, p) => sum + p.reviewCount, 0);
const avgRating = averageRating();

function stars(rating: number | null) {
  if (rating === null) return "";
  const full = Math.floor(rating);
  const half = rating - full >= 0.5;
  return "★".repeat(full) + (half ? "½" : "") + "☆".repeat(5 - full - (half ? 1 : 0));
}

const writeReviewPlatforms = REVIEW_PLATFORMS.filter((p) => p.writeUrl);
---

<Layout
  title="Reviews | Cliffco Mortgage Bankers"
  description={`Cliffco Mortgage Bankers has over ${totalReviews.toLocaleString()} reviews across Experience.com, Zillow, Google, and more, with an average rating of ${avgRating.toFixed(1)} out of 5.`}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Reviews", href: "/reviews/" },
  ]} />

  <IndexHeader eyebrow="Reviews">
    What borrowers say about Cliffco.
    <p slot="lead" class="mt-5 max-w-2xl text-[var(--color-text-muted)]" style="font-size: 1.125rem; line-height: 1.6;">
      {totalReviews.toLocaleString()}+ reviews across the web. Average rating, weighted by number of reviews: {avgRating.toFixed(1)} out of 5.
    </p>
    <Fragment slot="meta">
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Average rating</dt>
        <dd class="mt-1 text-2xl font-bold">{avgRating.toFixed(1)} / 5</dd>
      </div>
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Reviews</dt>
        <dd class="mt-1 text-2xl font-bold">{totalReviews.toLocaleString()}+</dd>
      </div>
    </Fragment>
  </IndexHeader>

  <!-- RATINGS BY PLATFORM -->
  <IndexSection label="Ratings by platform" title="Where to find our reviews.">
    <div class="relative overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-left">
          <tr class="border-b-2 border-[var(--color-ink)]">
            <th class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.14em] font-normal">Platform</th>
            <th class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.14em] font-normal">Rating</th>
            <th class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.14em] font-normal">Reviews</th>
            <th class="py-3 font-mono text-[11px] uppercase tracking-[0.14em] font-normal"><span class="sr-only">Link</span></th>
          </tr>
        </thead>
        <tbody>
          {REVIEW_PLATFORMS.map((p) => (
            <tr class="border-b border-black/15 align-top">
              <td class="py-4 pr-4">
                <span class="font-semibold text-[var(--color-ink)]">{p.name}</span>
                {p.note && <span class="block text-xs text-[var(--color-text-muted)] mt-1 max-w-xs">{p.note}</span>}
              </td>
              <td class="py-4 pr-4 whitespace-nowrap">
                <span class="text-xl font-bold text-[var(--color-ink)]">{p.ratingDisplay}</span>
                {p.rating !== null && <span class="ml-2 text-[var(--color-ink)] tracking-wide" aria-hidden="true">{stars(p.rating)}</span>}
              </td>
              <td class="py-4 pr-4 font-mono text-xs text-[var(--color-text)] whitespace-nowrap">{p.reviewCount > 0 && `${p.reviewCount.toLocaleString()}+ reviews`}</td>
              <td class="py-4 text-right whitespace-nowrap">
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[var(--color-ink)]">Read on {p.name} ↗</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </IndexSection>

  <!-- ELFSIGHT REVIEWS WIDGET -->
  <IndexSection label="In their words">
    <div>
      <script src="https://elfsightcdn.com/platform.js" async></script>
      <div class="elfsight-app-48e4bead-fc89-45e0-9839-000043509c1d" data-elfsight-app-lazy></div>
    </div>
  </IndexSection>

  <!-- LEAVE A REVIEW -->
  <IndexSection
    label="Leave a review"
    title="Worked with Cliffco? We'd love to hear from you."
    intro="Reviews help future borrowers find a lender they can trust, and they help us keep improving. It only takes a minute."
  >
    <ul class="list-none m-0 p-0 border-t border-[var(--color-ink)]">
      {writeReviewPlatforms.map((p) => (
        <li class="border-b border-black/15">
          <a href={p.writeUrl} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between gap-4 py-4 no-underline text-[var(--color-ink)]">
            <span>
              <span class="font-semibold group-hover:underline">{p.name}</span>
              {p.ratingDisplay && <span class="ml-3 font-mono text-xs text-[var(--color-text-muted)]">{p.ratingDisplay} overall</span>}
            </span>
            <span class="text-sm font-semibold whitespace-nowrap">Write a review ↗</span>
          </a>
        </li>
      ))}
    </ul>
  </IndexSection>

  <!-- CTA -->
  <IndexSection label="Get started" title="Work with the team behind these reviews." intro="A licensed Cliffco LO responds within one business day.">
    <div class="flex flex-wrap gap-3">
      <a href="/get-started/" class="btn btn-primary">Get started</a>
      <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary">{COMPANY.hq.phone}</a>
    </div>
  </IndexSection>
</Layout>
