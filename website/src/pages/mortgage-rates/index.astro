---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { faqPageSchema, articleSchema } from "../../lib/schema";


const rateFactors = [
  {
    factor: "Credit score",
    impact: "The higher your score, the better your rate. Conventional pricing improves in steps up to roughly 780, while FHA and VA are more forgiving of lower scores. In Non-QM programs, the range spans from 500 to 800+, with more granular pricing steps.",
  },
  {
    factor: "Down payment (LTV)",
    impact: "A larger down payment reduces your loan-to-value (LTV) and typically lowers your rate. On a conventional loan, 20% down also removes private mortgage insurance. Most Non-QM programs have defined LTV tiers (65%, 70%, 75%, 80%) with different pricing at each level.",
  },
  {
    factor: "Loan type",
    impact: "Conventional, FHA, and VA loans each price differently, and Non-QM runs higher than all of them because those loans are not eligible for sale to Fannie Mae or Freddie Mac.",
  },
  {
    factor: "Property type",
    impact: "Primary residences get the best pricing. Second homes, investment properties, multi-family, condos, and short-term rentals carry additional rate adjustments.",
  },
  {
    factor: "Loan amount",
    impact: "Loan amounts above the conforming limit (jumbo) carry their own pricing. Very high loan amounts on Non-QM programs can add additional adjustments.",
  },
  {
    factor: "Income documentation type",
    impact: "Full documentation (W-2, tax returns) gets the best rate. Bank statement programs and no-ratio DSCR programs carry a premium that reflects the additional lender risk.",
  },
];

const faq = [
  {
    question: "Why don't you post your current rates on this page?",
    answer: "Because the rate you'd actually get depends on your scenario. Advertised rates usually assume an ideal borrower, and real pricing adjusts for credit score, down payment, loan type, property type, loan amount, and lock period. A rate quoted without knowing your situation is meaningless at best and misleading at worst. Call us or start a conversation and you'll have a real number in one business day.",
  },
  {
    question: "What's a rate lock, and how long does it last?",
    answer: "A rate lock guarantees your interest rate for a set period, typically 30, 45, or 60 days. This protects you from rate increases while your loan is in underwriting. Locks typically require a property address and accepted contract. Extended locks are available for new construction or longer timelines but usually carry a cost.",
  },
  {
    question: "What's the difference between the interest rate and the APR?",
    answer: "The interest rate is what you pay to borrow the loan amount. The APR (annual percentage rate) adds lender fees, points, and mortgage insurance to show the total yearly cost of the loan, so it's usually higher than the rate. Comparing APRs is the best way to compare offers from different lenders.",
  },
  {
    question: "Are mortgage rates fixed or adjustable?",
    answer: "Both options exist. Most buyers choose a 30-year fixed rate for a payment that never changes, and 15-year fixed loans carry lower rates with higher monthly payments. ARM options (5/1, 7/1) can offer a lower initial rate if you plan to sell or refinance within the initial fixed period. The same choices are available on most Non-QM programs. Your loan officer will explain the trade-offs for your specific timeline.",
  },
  {
    question: "How much higher are Non-QM rates than conventional rates?",
    answer: "Higher, but how much higher depends on the program and the scenario. Non-QM rates for borrowers with strong credit and significant equity can be competitive, and the gap narrows the stronger the overall profile. The only reliable number is a quote on your actual file.",
  },
  {
    question: "Can I refinance out of a Non-QM loan into a conventional loan later?",
    answer: "Yes, and many borrowers plan to do exactly that. If a borrower's situation changes (for example, a self-employed borrower files two years of stronger tax returns, or a recent credit event clears the conventional waiting period), refinancing into a conventional loan at a lower rate is a straightforward path. Your Cliffco loan officer will help you understand what that transition looks like from day one.",
  },
];

const schema = [
  faqPageSchema(faq),
  articleSchema({
    headline: "Mortgage Rates: What Affects Your Rate",
    description: "Mortgage rates are scenario-specific. Learn what affects your conventional, FHA, VA, or specialty loan rate, and how to get a real number for your situation.",
    url: "/mortgage-rates/",
    datePublished: "2026-04-15",
    dateModified: "2026-10-07",
  }),
];
import IndexHeader from "../../components/asym/IndexHeader.astro";
import IndexSection from "../../components/asym/IndexSection.astro";
import FaqList from "../../components/asym/FaqList.astro";

const rateContext = [
  { program: "Conventional (30-yr fixed)", context: "Usually the best available pricing, and the benchmark everything else is compared against." },
  { program: "FHA (30-yr fixed)", context: "Slightly above conventional. Lower credit threshold. Mortgage insurance required." },
  { program: "VA (30-yr fixed)", context: "Often priced at or below conventional for eligible veterans and service members. No monthly mortgage insurance." },
  { program: "Bank Statement Loans", context: "Higher than conventional. Priced on your credit, down payment, and the strength of the file." },
  { program: "DSCR Investment Loans", context: "Varies by property cash flow ratio, credit score, and LTV. Often competitive with conventional investor rates." },
  { program: "Non-QM (general)", context: "Higher than conventional, because these loans aren't sold to Fannie Mae or Freddie Mac. Pricing depends heavily on the full scenario." },
];
---

<Layout
  title="Mortgage Rates | Conventional, FHA, VA & Refinance Rates | Cliffco"
  description="Your mortgage rate depends on your credit, down payment, loan type, and property. Learn what moves conventional, FHA, and VA rates, and get a real quote from Cliffco in one business day."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Mortgage Rates", href: "/mortgage-rates/" },
  ]} />

  <IndexHeader
    eyebrow="Conventional, FHA, VA, and Refinance Rates"
    lead="Rates change daily and depend on your credit, down payment, and loan type. Tell us what you're planning and we'll give you a real number in one business day."
  >
    Your Rate Depends On Your Situation.
    <Fragment slot="actions">
      <a href="/get-started/" class="btn btn-primary">Get My Rate</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
    <Fragment slot="meta">
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Real quote in</dt>
        <dd class="mt-1 text-2xl font-bold">One business day</dd>
      </div>
      <div>
        <dd class="text-sm text-[var(--color-text-muted)]">No credit pull. No commitment. Rates are scenario-specific and can change daily.</dd>
      </div>
    </Fragment>
  </IndexHeader>

  <!-- WHY NO RATE TABLE -->
  <IndexSection label="Why we don't post a rate table" title="A rate without context is just a number.">
    <div class="grid xl:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] gap-10 items-start">
      <div class="space-y-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">
        <p>The rates you see advertised usually assume a near-perfect borrower: top-tier credit, 20% or more down, a single-family primary residence, and sometimes points paid up front. If that isn't exactly you, the rate you'd actually get is different.</p>
        <p>Your rate moves with your credit score, down payment, loan type, property, and how long you lock. A first-time buyer putting 3.5% down on an FHA loan and a move-up buyer putting 20% down on a conventional loan are priced differently on the same day. Posting one number that fits neither would mislead you.</p>
        <p>We'd rather give you a real number for your real situation. That takes one business day and requires no credit pull.</p>
      </div>
      <div class="rounded-2xl overflow-hidden aspect-[4/3] border-2 border-[var(--color-ink)]">
        <img src="/images/content%20images/Mortgage%20Rates.jpg" alt="Mortgage rate consultation" class="w-full h-full object-cover" loading="lazy" />
      </div>
    </div>
  </IndexSection>

  <!-- RATE CONTEXT -->
  <IndexSection label="What you can expect" title="Rate context by loan type.">
    <dl class="border-t-2 border-[var(--color-ink)]">
      {rateContext.map((item) => (
        <div class="grid md:grid-cols-[minmax(0,16rem)_1fr] gap-x-8 gap-y-1 py-4 border-b border-black/15">
          <dt class="font-semibold text-[var(--color-ink)]">{item.program}</dt>
          <dd class="text-[var(--color-text)]">{item.context}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-4 text-xs text-[var(--color-text-muted)]">Ranges are indicative only. Rates change daily and vary based on your specific scenario. Not a commitment to lend.</p>
  </IndexSection>

  <!-- RATE FACTORS -->
  <IndexSection label="What affects your rate" title="Six factors that move your rate.">
    <ol class="list-none m-0 p-0 border-t-2 border-[var(--color-ink)]">
      {rateFactors.map((item, i) => (
        <li class="grid grid-cols-[3rem_1fr] md:grid-cols-[3rem_minmax(0,14rem)_1fr] gap-x-6 gap-y-1 py-5 border-b border-black/15">
          <span class="font-mono text-sm text-[var(--color-text-muted)]">0{i + 1}</span>
          <h3 class="font-semibold text-[var(--color-ink)]">{item.factor}</h3>
          <p class="col-start-2 md:col-start-3 text-[var(--color-text)] leading-relaxed">{item.impact}</p>
        </li>
      ))}
    </ol>
  </IndexSection>

  <!-- FAQ -->
  <IndexSection label="FAQ" title="Common questions about rates.">
    <FaqList items={faq} />
  </IndexSection>

  <!-- CTA -->
  <IndexSection
    label="Get your rate"
    title="Get a real rate for your real situation."
    intro="Tell us what you're planning. A Cliffco loan officer responds with a real rate within one business day. No credit pull. No commitment."
  >
    <div class="flex flex-wrap gap-3">
      <a href="/get-started/" class="btn btn-primary">Get My Rate</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </div>
    <p class="mt-8 text-xs text-[var(--color-text-muted)] max-w-2xl">Rate information on this page is indicative and for educational purposes only. Rates change daily and are not guaranteed. A rate quote requires a complete loan application. {COMPANY.legalName} NMLS #{COMPANY.nmls}. Equal Housing Lender.</p>
  </IndexSection>
</Layout>
