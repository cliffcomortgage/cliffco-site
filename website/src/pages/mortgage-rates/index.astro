---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { faqPageSchema, articleSchema } from "../../lib/schema";


const rateFactors = [
  {
    factor: "Loan type",
    impact: "Non-QM rates are typically 0.5% to 2% higher than conventional rates because these loans are not eligible for sale to Fannie Mae or Freddie Mac. The exact spread depends on the program.",
  },
  {
    factor: "Credit score",
    impact: "The lower the credit score, the higher the rate adjustment. In Non-QM programs, the range spans from 500 to 800+, and pricing steps are more granular than in conventional lending.",
  },
  {
    factor: "Loan-to-value (LTV)",
    impact: "A larger down payment reduces your LTV and typically lowers your rate. Most Non-QM programs have defined LTV tiers (65%, 70%, 75%, 80%) with different pricing at each level.",
  },
  {
    factor: "Property type",
    impact: "Non-owner-occupied properties, investment condos, multi-family, and short-term rental properties carry additional rate adjustments. Primary residences get the best pricing.",
  },
  {
    factor: "Income documentation type",
    impact: "Full documentation (W-2, tax returns) gets the best rate. Bank statement programs and no-ratio DSCR programs carry a premium that reflects the additional lender risk.",
  },
  {
    factor: "Loan amount",
    impact: "Jumbo loan amounts (above conventional conforming limits) carry their own pricing. Very high loan amounts on Non-QM programs can add additional adjustments.",
  },
];

const faq = [
  {
    question: "Why don't you post your current rates on this page?",
    answer: "Non-QM rates are scenario-specific. Unlike conventional rates, which are set against a narrow range of borrower profiles, Non-QM rates adjust for 6 to 10 factors simultaneously: credit score, LTV, documentation type, property type, loan amount, and more. A rate quoted without knowing your scenario is meaningless at best and misleading at worst. Call us or start a conversation and you'll have a real number in one business day.",
  },
  {
    question: "How much higher are Non-QM rates than conventional rates?",
    answer: "Typically 0.5% to 2% higher, depending on the program and scenario. Bank statement loans usually run 0.75% to 1.5% above conventional. DSCR loans vary based on the property's cash flow ratio and LTV. Non-QM rates for borrowers with strong credit and significant equity can be competitive. The gap narrows the stronger the overall profile.",
  },
  {
    question: "Can I refinance out of a Non-QM loan into a conventional loan later?",
    answer: "Yes, and many borrowers plan to do exactly that. If a borrower's situation changes (for example, a self-employed borrower files two years of stronger tax returns, or a recent credit event clears the conventional waiting period), refinancing into a conventional loan at a lower rate is a straightforward path. Your Cliffco loan officer will help you understand what that transition looks like from day one.",
  },
  {
    question: "What's a rate lock, and how long does it last?",
    answer: "A rate lock guarantees your interest rate for a set period, typically 30, 45, or 60 days. This protects you from rate increases while your loan is in underwriting. Locks typically require a property address and accepted contract. Extended locks are available for new construction or longer timelines but usually carry a cost.",
  },
  {
    question: "Are Non-QM rates fixed or adjustable?",
    answer: "Both options exist. Most Non-QM loans are offered as 30-year fixed rates, which are the most common choice. ARM options (5/1, 7/1) are available and can offer lower initial rates for borrowers who plan to sell or refinance within the initial fixed period. Your loan officer will explain the trade-offs for your specific timeline.",
  },
];

const schema = [
  faqPageSchema(faq),
  articleSchema({
    headline: "Non-QM and Conventional Mortgage Rates: What Affects Your Rate",
    description: "Mortgage rates are scenario-specific. Learn what factors affect your Non-QM, bank statement, or DSCR mortgage rate, and how to get a real number for your situation.",
    url: "/mortgage-rates/",
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];
import IndexHeader from "../../components/asym/IndexHeader.astro";
import IndexSection from "../../components/asym/IndexSection.astro";
import FaqList from "../../components/asym/FaqList.astro";

const rateContext = [
  { program: "Conventional (30-yr fixed)", context: "Best available pricing for W-2 borrowers with 620+ credit. Benchmark for comparison." },
  { program: "FHA (30-yr fixed)", context: "Slightly above conventional. Lower credit threshold. Mortgage insurance required." },
  { program: "Bank Statement Loans", context: "Typically 0.75% to 1.5% above conventional depending on credit and LTV." },
  { program: "DSCR Investment Loans", context: "Varies by property cash flow ratio, credit score, and LTV. Often competitive with conventional investor rates." },
  { program: "Non-QM (general)", context: "0.5% to 2% above conventional. Specific pricing depends heavily on the full scenario." },
];
---

<Layout
  title="Mortgage Rates | Non-QM, Bank Statement & DSCR Rates | Cliffco"
  description="Non-QM mortgage rates depend on your specific scenario: loan type, credit, LTV, and documentation. Learn what factors affect your rate and how to get a real quote in one business day."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Mortgage Rates", href: "/mortgage-rates/" },
  ]} />

  <IndexHeader
    eyebrow="Non-QM, Bank Statement, DSCR, and Conventional Rates"
    lead="Non-QM rates aren't posted because they're specific. Tell us your scenario and we'll give you a real number in one business day."
  >
    Your Rate Depends On Your Situation.
    <Fragment slot="actions">
      <a href="/get-started/" class="btn btn-primary">Get My Rate</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
    <Fragment slot="meta">
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Real quote in</dt>
        <dd class="mt-1 text-2xl font-bold">One business day</dd>
      </div>
      <div>
        <dd class="text-sm text-[var(--color-text-muted)]">No credit pull. No commitment. Rates are scenario-specific and can change daily.</dd>
      </div>
    </Fragment>
  </IndexHeader>

  <!-- WHY NO RATE TABLE -->
  <IndexSection label="Why we don't post a rate table" title="A rate without context is just a number.">
    <div class="grid xl:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] gap-10 items-start">
      <div class="space-y-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">
        <p>Conventional lenders can post a rate because their borrowers are largely the same: W-2 income, 720+ credit score, 20% down, primary residence. The rate for that profile on a given day is a meaningful data point.</p>
        <p>Non-QM lending doesn't work that way. A bank statement loan for a self-employed borrower with 680 credit and 25% down is priced differently than a DSCR loan for an investor with an 800 score and a 75% LTV property generating strong cash flow. Posting a rate that covers neither accurately would mislead you.</p>
        <p>We'd rather give you a real number for your real situation. That takes one business day and requires no credit pull.</p>
      </div>
      <div class="rounded-2xl overflow-hidden aspect-[4/3] border-2 border-[var(--color-ink)]">
        <img src="/images/content%20images/Mortgage%20Rates.jpg" alt="Mortgage rate consultation" class="w-full h-full object-cover" loading="lazy" />
      </div>
    </div>
  </IndexSection>

  <!-- RATE CONTEXT -->
  <IndexSection label="What you can expect" title="Non-QM rate context.">
    <dl class="border-t-2 border-[var(--color-ink)]">
      {rateContext.map((item) => (
        <div class="grid md:grid-cols-[minmax(0,16rem)_1fr] gap-x-8 gap-y-1 py-4 border-b border-black/15">
          <dt class="font-semibold text-[var(--color-ink)]">{item.program}</dt>
          <dd class="text-[var(--color-text)]">{item.context}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-4 text-xs text-[var(--color-text-muted)]">Ranges are indicative only. Rates change daily and vary based on your specific scenario. Not a commitment to lend.</p>
  </IndexSection>

  <!-- RATE FACTORS -->
  <IndexSection label="What affects your rate" title="Six factors that move your Non-QM rate.">
    <ol class="list-none m-0 p-0 border-t-2 border-[var(--color-ink)]">
      {rateFactors.map((item, i) => (
        <li class="grid grid-cols-[3rem_1fr] md:grid-cols-[3rem_minmax(0,14rem)_1fr] gap-x-6 gap-y-1 py-5 border-b border-black/15">
          <span class="font-mono text-sm text-[var(--color-text-muted)]">0{i + 1}</span>
          <h3 class="font-semibold text-[var(--color-ink)]">{item.factor}</h3>
          <p class="col-start-2 md:col-start-3 text-[var(--color-text)] leading-relaxed">{item.impact}</p>
        </li>
      ))}
    </ol>
  </IndexSection>

  <!-- FAQ -->
  <IndexSection label="FAQ" title="Common questions about rates.">
    <FaqList items={faq} />
  </IndexSection>

  <!-- CTA -->
  <IndexSection
    label="Get your rate"
    title="Get a real rate for your real situation."
    intro="Tell us your scenario. A Cliffco loan officer responds with a real rate within one business day. No credit pull. No commitment."
  >
    <div class="flex flex-wrap gap-3">
      <a href="/get-started/" class="btn btn-primary">Get My Rate</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </div>
    <p class="mt-8 text-xs text-[var(--color-text-muted)] max-w-2xl">Rate information on this page is indicative and for educational purposes only. Rates change daily and are not guaranteed. A rate quote requires a complete loan application. {COMPANY.legalName} NMLS #{COMPANY.nmls}. Equal Housing Lender.</p>
  </IndexSection>
</Layout>
