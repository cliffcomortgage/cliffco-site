---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { LOAN_OFFICERS, type LoanOfficer, nmlsConsumerAccessUrl } from "../../data/loan-officers";
import { BRANCHES } from "../../data/branches";
import { STATE_LICENSES } from "../../data/state-licenses";
import { fullDisclosureBlock } from "../../data/disclosures";
import { telHref } from "../../lib/phone";
import { personSchema, breadcrumbSchema } from "../../lib/schema";
import Headshot from "../../components/ui/Headshot.astro";
import FormCard from "../../components/asym/FormCard.astro";
import FaqList from "../../components/asym/FaqList.astro";

export async function getStaticPaths() {
  return LOAN_OFFICERS.map((lo) => ({ params: { slug: lo.slug }, props: { lo } }));
}

interface Props { lo: LoanOfficer }
const { lo } = Astro.props;

const branch = BRANCHES.find((b) => b.slug === lo.branchSlug)!;
const branchNames = [branch, ...(lo.alsoAtBranchSlugs ?? []).map((slug) => BRANCHES.find((b) => b.slug === slug)).filter((b) => !!b)]
  .map((b) => b!.name)
  .join(" · ");
const branchCount = 1 + (lo.alsoAtBranchSlugs?.length ?? 0);
const stateNames = lo.states
  .map((code) => STATE_LICENSES.find((s) => s.code === code)?.name ?? code)
  .join(", ");
const isFloridaLicensed = lo.states.includes("FL");
const disclosure = fullDisclosureBlock(lo.states);
// Banner tagline per team, shown on each member's bio
const TEAM_TAGLINES: Record<string, string> = {
  "the-fallarino-group": "Jumbo · Alt-A · DSCR · Non-QM specialists",
  "team-zambelli": "SONYMA · First-time homebuyer specialists",
  "team-cordeira": "Non-QM · Bank statement · DSCR specialists",
};
const verifyUrl = nmlsConsumerAccessUrl(lo.nmls);
const first = lo.firstName.split(" ")[0];

const extraLanguages = (lo.languages ?? []).filter((l) => l !== "English");
const otherSpecialties = (lo.specialties ?? []).filter((s) => !lo.featuredSpecialties?.includes(s));

const calculators = [
  { href: "/mortgage-guides/calculators/payment-estimator/", title: "Payment Estimator", desc: "See your full monthly payment at any price, rate, and down payment." },
  { href: "/mortgage-guides/calculators/affordability/", title: "Affordability Review", desc: "Find the price range that fits your income and savings with real down payment scenarios." },
  { href: "/mortgage-guides/calculators/closing-costs/", title: "Closing Costs Estimator", desc: "Get an itemized closing cost estimate by state, property type, and purchase price." },
];

const faq = [
  {
    question: "How do I get started?",
    answer: `The first step is a short conversation: no credit pull, no paperwork. ${first} will ask about your goals, income situation, and timeline to identify the right program. From there, you can move into a formal pre-approval when you're ready.`,
  },
  {
    question: "Will getting pre-qualified hurt my credit score?",
    answer: "Pre-qualification at Cliffco uses a soft credit inquiry, which has no impact on your score. A hard pull only happens when you formally apply for a loan and authorize it, and we'll always tell you before that step.",
  },
  {
    question: "What's the difference between pre-qualification and pre-approval?",
    answer: "Pre-qualification is a quick estimate based on what you share with us. Pre-approval goes deeper: we verify your income, assets, and credit and issue a formal letter. Sellers take pre-approved buyers more seriously, and in competitive markets it's often required before an offer is considered.",
  },
  {
    question: "How long does the mortgage process take?",
    answer: "A conventional purchase typically closes in 21–45 days from an accepted offer. Non-QM, DSCR, and reverse mortgage transactions can take 30–45 days. Your timeline depends on the loan type, appraisal scheduling, and how quickly documents come together. We'll give you a realistic estimate at the start.",
  },
  {
    question: "What documents will I need?",
    answer: "For most loans: two years of tax returns, recent pay stubs or bank statements, W-2s, and two months of asset statements. For Non-QM and bank statement loans, requirements differ: typically 12–24 months of personal or business bank statements in place of tax returns. We'll give you a specific checklist based on your situation.",
  },
  {
    question: "Can I qualify if I'm self-employed?",
    answer: "Yes. Cliffco offers programs built for non-traditional income: bank statement loans, P&L-based loans, DSCR for investors, and Alt-A programs for high-income borrowers whose tax returns don't reflect their full financial picture. Being self-employed isn't a barrier; it just means using the right program.",
  },
];

const schema = [
  personSchema(lo),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Loan Officers", url: "/loan-officers/" },
    { name: lo.displayName, url: `/loan-officers/${lo.slug}/` },
  ]),
];
---

<Layout
  title={`${lo.displayName} - ${lo.title} · NMLS #${lo.nmls}`}
  description={`${lo.displayName}, ${lo.title} at ${COMPANY.brandName} (NMLS #${COMPANY.nmls}). Licensed in ${lo.states.length} state${lo.states.length === 1 ? '' : 's'} (${stateNames}). Verify at NMLS Consumer Access.`}
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loan Officers", href: "/loan-officers/" },
    { name: lo.displayName, href: `/loan-officers/${lo.slug}/` },
  ]} />

  <!-- PINNED PROFILE: black column stays put on desktop while the right side scrolls -->
  <div class="lo-profile lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] border-t border-[var(--color-ink)]">
    <aside class="lo-rail bg-[var(--color-ink)] text-white lg:sticky lg:top-[4.5rem] lg:h-[calc(100vh-4.5rem)] lg:overflow-y-auto self-start">
      <div class="lo-rail-inner py-10 lg:py-12 flex flex-col">
        {lo.hasPhoto && (
          <div class="w-full max-w-[300px] aspect-square overflow-hidden rounded-2xl border-2 border-white/15">
            <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" priority />
          </div>
        )}
        <p class="mt-7 font-mono text-[11px] uppercase tracking-[0.14em] text-white/55">{lo.title}</p>
        <h1 class="mt-2 !text-white" style="font-size: clamp(2rem, 3vw, 2.75rem); line-height: 1.05; font-weight: 700; letter-spacing: -0.03em; font-family: var(--font-display);">
          {lo.displayName}
        </h1>
        <p class="mt-4 text-sm text-white/80">
          <strong class="text-white">NMLS #{lo.nmls}</strong>
          <span class="mx-2 text-white/40" aria-hidden="true">·</span>
          <a href={verifyUrl} class="!text-white underline underline-offset-2" rel="noopener">Verify on NMLS Consumer Access ↗</a>
        </p>

        <dl class="mt-7 border-t border-white/25">
          <div class="py-3 border-b border-white/15">
            <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/55">{branchCount > 1 ? "Branches" : "Branch"}</dt>
            <dd class="mt-1 text-white">{branchNames}</dd>
          </div>
          {lo.links?.directPhone && (
            <div class="py-3 border-b border-white/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/55">Office</dt>
              <dd class="mt-1"><a href={telHref(lo.links.directPhone)} class="!text-white no-underline hover:underline">{lo.links.directPhone}</a></dd>
            </div>
          )}
          {lo.links?.cellPhone && (
            <div class="py-3 border-b border-white/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/55">Cell</dt>
              <dd class="mt-1"><a href={telHref(lo.links.cellPhone)} class="!text-white no-underline hover:underline">{lo.links.cellPhone}</a></dd>
            </div>
          )}
          {lo.links?.email && (
            <div class="py-3 border-b border-white/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/55">Email</dt>
              <dd class="mt-1 break-all"><a href={`mailto:${lo.links.email}`} class="!text-white no-underline hover:underline">{lo.links.email}</a></dd>
            </div>
          )}
        </dl>

        <div class="mt-7 flex flex-wrap gap-3">
          {lo.links?.applyNow ? (
            <a href={lo.links.applyNow} class="btn btn-primary !bg-white !text-[var(--color-ink)] hover:!bg-white/85" target="_blank" rel="noopener">Apply Now</a>
          ) : (
            <a href="#contact" class="btn btn-primary !bg-white !text-[var(--color-ink)] hover:!bg-white/85">Talk to {first}</a>
          )}
          <a href="#contact" class="btn btn-secondary !border-white !text-white">Contact {first}</a>
        </div>

        {lo.team && (
          <a href={`/${lo.team.slug}/`} class="mt-8 flex items-center gap-4 border-t border-white/25 pt-6 no-underline group">
            <img src={lo.team.logoUrl} alt={lo.team.name} class={`${lo.team.bannerLogoHeight ?? 'h-12'} select-none`} loading="lazy" />
            <span>
              {TEAM_TAGLINES[lo.team.slug] && <span class="block font-mono text-[10px] uppercase tracking-[0.12em] text-white/55">{TEAM_TAGLINES[lo.team.slug]}</span>}
              <span class="block mt-1 text-sm font-semibold text-white group-hover:underline">View {lo.team.name} →</span>
            </span>
          </a>
        )}
      </div>
    </aside>

    <div class="lo-main bg-white">
      <!-- BIO NARRATIVE -->
      {lo.bio && (
        <section class="lo-block">
          <p class="eyebrow">About {first}</p>
          <h2 class="mt-3" style="font-size: var(--text-h2); font-weight: 700;">In their own words.</h2>
          {lo.personalLogo && (
            <img src={lo.personalLogo} alt={`${first}'s personal brand`} class="mt-6 w-[160px] object-contain" loading="lazy" />
          )}
          <p class="mt-6 text-[var(--color-text)]" style="font-size: 1.1875rem; line-height: 1.75;">{lo.bio}</p>
        </section>
      )}

      <!-- AT A GLANCE -->
      <section class="lo-block">
        <p class="eyebrow">At a glance</p>
        <dl class="mt-6 border-t border-[var(--color-ink)]">
          <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
            <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">States licensed in</dt>
            <dd class="text-[var(--color-text)]">{lo.states.join(" · ")}</dd>
          </div>
          {extraLanguages.length > 0 && (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">Additional Languages</dt>
              <dd class="text-[var(--color-text)]">{extraLanguages.join(", ")}</dd>
            </div>
          )}
          {(lo.featuredSpecialties?.length || otherSpecialties.length > 0) && (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-2 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">Specialties</dt>
              <dd class="flex flex-wrap gap-2">
                {lo.featuredSpecialties?.map((s) => (
                  <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-[var(--color-ink)] text-white">{s}</span>
                ))}
                {otherSpecialties.map((s) => (
                  <span class="text-xs font-medium px-3 py-1.5 rounded-full border border-[var(--color-ink)] text-[var(--color-ink)]">{s}</span>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </section>

      <!-- LEAD FORM -->
      <section class="lo-block">
        <FormCard
          eyebrow={`Talk to ${first}`}
          title={`Talk to ${lo.displayName}`}
          formTo={(lo.links?.leadTo ?? lo.links?.email) ? `${lo.links?.leadTo ?? lo.links?.email},websiteleads@cliffcomortgage.com` : 'websiteleads@cliffcomortgage.com'}
          formSource={`lo-${lo.slug}`}
          ctaLabel={`Send message to ${first}`}
        />
      </section>

      <!-- SCENARIOS -->
      {lo.scenarios && lo.scenarios.length > 0 && (
        <section class="lo-block">
          <p class="eyebrow">Recent closings</p>
          <h2 class="mt-3" style="font-size: var(--text-h2); font-weight: 700;">Real scenarios. Anonymized.</h2>
          <ol class="mt-6 list-none m-0 p-0 border-t border-[var(--color-ink)]">
            {lo.scenarios.map((s, i) => (
              <li class="grid grid-cols-[3rem_1fr] gap-4 py-6 border-b border-black/15">
                <span class="font-mono text-sm text-[var(--color-text-muted)] pt-1">0{i + 1}</span>
                <div>
                  <h3 class="text-lg font-semibold text-[var(--color-ink)]">{s.title}</h3>
                  <p class="mt-2 text-[var(--color-text)] leading-relaxed">{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- BLOG -->
      {lo.blog && lo.blog.length > 0 && (
        <section class="lo-block">
          <p class="eyebrow">{lo.blog[0].section}</p>
          <h2 class="mt-3" style="font-size: var(--text-h2); font-weight: 700;">Written by {first}.</h2>
          <div class="mt-6 grid sm:grid-cols-2 gap-4">
            {lo.blog.map((post) => (
              <a href={`/${post.slug}/`} class="group rounded-2xl border-2 border-[var(--color-ink)] overflow-hidden no-underline flex flex-col bg-white">
                <div class="aspect-[16/9] overflow-hidden border-b-2 border-[var(--color-ink)]">
                  <img src={post.image} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </div>
                <div class="p-5 flex flex-col flex-1">
                  <h3 class="font-semibold text-[var(--color-ink)] leading-snug flex-1">{post.title}</h3>
                  <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed line-clamp-2">{post.description}</p>
                  <span class="mt-4 text-sm font-semibold text-[var(--color-ink)]">Read article →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- CALCULATORS -->
      <section class="lo-block">
        <p class="eyebrow">Free tools</p>
        <h2 class="mt-3" style="font-size: var(--text-h2); font-weight: 700;">Run the numbers before you apply.</h2>
        <p class="mt-3 text-[var(--color-text-muted)] leading-relaxed">Use these calculators to estimate your payment, buying power, and closing costs, then talk to {first} about the specifics.</p>
        <ol class="mt-6 list-none m-0 p-0 border-t border-[var(--color-ink)]">
          {calculators.map((calc, i) => (
            <li class="border-b border-black/15">
              <a href={calc.href} class="group grid grid-cols-[3rem_1fr] sm:grid-cols-[3rem_1fr_auto] gap-4 py-5 no-underline text-[var(--color-ink)]">
                <span class="font-mono text-sm text-[var(--color-text-muted)] pt-0.5">0{i + 1}</span>
                <span>
                  <span class="block font-semibold text-lg group-hover:underline">{calc.title}</span>
                  <span class="block mt-1 text-sm text-[var(--color-text-muted)] leading-relaxed">{calc.desc}</span>
                </span>
                <span class="hidden sm:block text-sm font-semibold pt-1 whitespace-nowrap">Use calculator →</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <!-- FAQ -->
      <section class="lo-block">
        <p class="eyebrow">Common questions</p>
        <h2 class="mt-3" style="font-size: var(--text-h2); font-weight: 700;">Answers before you reach out.</h2>
        <div class="mt-6"><FaqList items={faq} /></div>
        <p class="mt-6 text-sm text-[var(--color-text-muted)]">
          Have a question not answered here?{" "}
          {lo.links?.email
            ? <a href={`mailto:${lo.links.email}`} class="text-[var(--color-ink)] font-semibold">Email {first} directly →</a>
            : <a href="/contact/" class="text-[var(--color-ink)] font-semibold">Contact us →</a>
          }
        </p>
      </section>

      <!-- DISCLOSURE -->
      <section class="lo-block">
        {isFloridaLicensed && (
          <p class="text-sm font-semibold text-[var(--color-ink)] mb-4">{COMPANY.floridaDba.disclosure}</p>
        )}
        <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{disclosure}</p>
      </section>
    </div>
  </div>
</Layout>

<style>
  /* Align the rail's content with the site's 80rem container on wide screens. */
  .lo-rail-inner { padding-inline: 1.5rem; }
  .lo-block { padding: 3rem 1.5rem; border-bottom: 1px solid rgb(0 0 0 / 0.15); }
  .lo-block:last-child { border-bottom: 0; }
  @media (min-width: 1024px) {
    .lo-rail-inner { padding-left: max(1.5rem, calc((100vw - 80rem) / 2 + 1.5rem)); padding-right: 3rem; }
    .lo-block { padding: 4rem max(1.5rem, calc((100vw - 80rem) / 2 + 1.5rem)) 4rem 4rem; }
  }
</style>
