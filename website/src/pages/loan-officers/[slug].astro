---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { LOAN_OFFICERS, type LoanOfficer, nmlsConsumerAccessUrl } from "../../data/loan-officers";
import { BRANCHES } from "../../data/branches";
import { STATE_LICENSES } from "../../data/state-licenses";
import { fullDisclosureBlock } from "../../data/disclosures";
import { personSchema, breadcrumbSchema } from "../../lib/schema";
import Headshot from "../../components/ui/Headshot.astro";

export async function getStaticPaths() {
  return LOAN_OFFICERS.map((lo) => ({ params: { slug: lo.slug }, props: { lo } }));
}

interface Props { lo: LoanOfficer }
const { lo } = Astro.props;

const branch = BRANCHES.find((b) => b.slug === lo.branchSlug)!;
const stateNames = lo.states
  .map((code) => STATE_LICENSES.find((s) => s.code === code)?.name ?? code)
  .join(", ");
const isFloridaLicensed = lo.states.includes("FL");
const disclosure = fullDisclosureBlock(lo.states);
const verifyUrl = nmlsConsumerAccessUrl(lo.nmls);

const schema = [
  personSchema(lo),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Loan Officers", url: "/loan-officers/" },
    { name: lo.displayName, url: `/loan-officers/${lo.slug}/` },
  ]),
];
---

<Layout
  title={`${lo.displayName} — ${lo.title} · NMLS #${lo.nmls}`}
  description={`${lo.displayName}, ${lo.title} at ${COMPANY.brandName} (NMLS #${COMPANY.nmls}). Licensed in ${lo.states.length} state${lo.states.length === 1 ? '' : 's'} (${stateNames}). Verify at NMLS Consumer Access.`}
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loan Officers", href: "/loan-officers/" },
    { name: lo.displayName, href: `/loan-officers/${lo.slug}/` },
  ]} />

  <!-- HERO -->
  <section class="container-wide pt-12 pb-16 grid gap-10 lg:grid-cols-[1fr_2fr] items-start">
    <div>
      {lo.hasPhoto ? (
        <Headshot slug={lo.slug} name={lo.displayName} size={400} priority shape="rounded" />
      ) : (
        <div class="bg-[var(--color-mist-gray)] rounded-2xl aspect-square flex items-center justify-center text-[var(--color-text-muted)]">
          <span class="text-sm">Photo coming soon</span>
        </div>
      )}
    </div>

    <div>
      <p class="eyebrow">{lo.title}</p>
      <h1 class="mt-3" style="font-size: var(--text-display-lg);">{lo.displayName}</h1>

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <span class="text-[var(--color-text-muted)]"><strong class="text-[var(--color-ink)]">NMLS #{lo.nmls}</strong></span>
        <a href={verifyUrl} class="text-[var(--color-accent)] font-semibold no-underline hover:underline" rel="noopener">Verify on NMLS Consumer Access ↗</a>
      </div>

      <dl class="mt-6 grid gap-4 sm:grid-cols-2 max-w-2xl">
        <div>
          <dt class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">Branch</dt>
          <dd class="mt-1 text-[var(--color-ink)]">{branch.name}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">States licensed in</dt>
          <dd class="mt-1 text-[var(--color-ink)]">{lo.states.join(" · ")}</dd>
        </div>
        {lo.languages && lo.languages.length > 0 && (
          <div>
            <dt class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">Languages</dt>
            <dd class="mt-1 text-[var(--color-ink)]">{lo.languages.join(", ")}</dd>
          </div>
        )}
        {lo.specialties && lo.specialties.length > 0 && (
          <div>
            <dt class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">Specialties</dt>
            <dd class="mt-1 text-[var(--color-ink)]">{lo.specialties.join(" · ")}</dd>
          </div>
        )}
      </dl>

      <div class="mt-8 flex flex-wrap gap-3">
        <button id="contact-trigger" class="btn btn-primary">Talk to {lo.firstName.split(" ")[0]}</button>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>

  <!-- Contact dialog -->
  <dialog id="contact-dialog" class="fixed inset-0 z-50 m-auto rounded-2xl shadow-2xl border border-[var(--color-mist-gray)] bg-white p-8 w-full max-w-lg">
    <div class="flex items-start justify-between mb-6">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h2 class="mt-1" style="font-size: var(--text-h3);">Talk to {lo.displayName}</h2>
      </div>
      <button id="contact-close" class="text-[var(--color-text-muted)] hover:text-[var(--color-ink)] text-2xl leading-none" aria-label="Close">&times;</button>
    </div>
    <form id="lo-contact-form" action="/api/lead" method="POST" class="space-y-4">
      <input type="hidden" name="lo_name" value={lo.displayName} />
      <input type="hidden" name="lo_nmls" value={lo.nmls} />
      <input type="hidden" name="source" value={`/loan-officers/${lo.slug}/`} />
      <div>
        <label class="block text-sm font-medium text-[var(--color-ink)] mb-1" for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" required placeholder="Jane Smith" class="w-full border border-[var(--color-mist-gray)] rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" />
      </div>
      <div>
        <label class="block text-sm font-medium text-[var(--color-ink)] mb-1" for="cf-phone">Phone number</label>
        <input id="cf-phone" name="phone" type="tel" required placeholder="(555) 555-5555" class="w-full border border-[var(--color-mist-gray)] rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" />
      </div>
      <div>
        <label class="block text-sm font-medium text-[var(--color-ink)] mb-1" for="cf-email">Email address</label>
        <input id="cf-email" name="email" type="email" required placeholder="jane@example.com" class="w-full border border-[var(--color-mist-gray)] rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" />
      </div>
      <div>
        <label class="block text-sm font-medium text-[var(--color-ink)] mb-1" for="cf-message">What can {lo.firstName.split(" ")[0]} help you with?</label>
        <textarea id="cf-message" name="message" rows="3" placeholder="Tell us about your situation..." class="w-full border border-[var(--color-mist-gray)] rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] resize-none"></textarea>
      </div>
      <button type="submit" class="btn btn-primary w-full">Send message to {lo.firstName.split(" ")[0]}</button>
      <p class="text-xs text-[var(--color-text-muted)] text-center">By submitting you agree to be contacted about your mortgage inquiry.</p>
    </form>
  </dialog>

  <!-- BIO NARRATIVE -->
  {lo.bio && (
    <section class="bg-white pb-16">
      <div class="container-prose">
        <p class="eyebrow">About {lo.firstName.split(" ")[0]}</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">In their own words.</h2>
        <p class="lead mt-6">{lo.bio}</p>
      </div>
    </section>
  )}

  <!-- SCENARIOS -->
  {lo.scenarios && lo.scenarios.length > 0 && (
    <section class="bg-[var(--color-mist-gray)] section">
      <div class="container-wide">
        <p class="eyebrow">Recent closings</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Real scenarios. Anonymized.</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {lo.scenarios.map((s) => (
            <article class="card">
              <h3 class="text-base font-semibold text-[var(--color-ink)]">{s.title}</h3>
              <p class="mt-3 text-sm text-[var(--color-text)]">{s.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- DISCLOSURE -->
  <section class="bg-white py-12">
    <div class="container-wide">
      {isFloridaLicensed && (
        <p class="text-sm font-semibold text-[var(--color-accent)] mb-4">{COMPANY.floridaDba.disclosure}</p>
      )}
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{disclosure}</p>
    </div>
  </section>
</Layout>

<script>
  const dialog = document.getElementById("contact-dialog") as HTMLDialogElement | null;
  const trigger = document.getElementById("contact-trigger");
  const close = document.getElementById("contact-close");

  trigger?.addEventListener("click", () => dialog?.showModal());
  close?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
