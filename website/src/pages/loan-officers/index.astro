---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { LOAN_OFFICERS, loanOfficersByBranch } from "../../data/loan-officers";
import { BRANCHES } from "../../data/branches";
import AsymHero from "../../components/asym/AsymHero.astro";

// Group by branch for the default view
const byBranch = BRANCHES.map((b) => ({
  branch: b,
  officers: loanOfficersByBranch(b.slug),
})).filter((g) => g.officers.length > 0);

// All unique states across all LOs, sorted
const allStates = [...new Set(LOAN_OFFICERS.flatMap((lo) => [...lo.states]))].sort();

const stateNames: Record<string, string> = {
  AK: "Alaska", AL: "Alabama", AR: "Arkansas", AZ: "Arizona", CA: "California",
  CO: "Colorado", CT: "Connecticut", DC: "Washington DC", DE: "Delaware",
  FL: "Florida", GA: "Georgia", HI: "Hawaii", IA: "Iowa", ID: "Idaho",
  IL: "Illinois", IN: "Indiana", KS: "Kansas", KY: "Kentucky", LA: "Louisiana",
  MA: "Massachusetts", MD: "Maryland", ME: "Maine", MI: "Michigan", MN: "Minnesota",
  MO: "Missouri", MS: "Mississippi", MT: "Montana", NC: "North Carolina",
  ND: "North Dakota", NE: "Nebraska", NH: "New Hampshire", NJ: "New Jersey",
  NM: "New Mexico", NV: "Nevada", NY: "New York", OH: "Ohio", OK: "Oklahoma",
  OR: "Oregon", PA: "Pennsylvania", RI: "Rhode Island", SC: "South Carolina",
  SD: "South Dakota", TN: "Tennessee", TX: "Texas", UT: "Utah", VA: "Virginia",
  VT: "Vermont", WA: "Washington", WI: "Wisconsin", WV: "West Virginia", WY: "Wyoming",
};
---

<Layout
  title="Cliffco Loan Officers"
  description="Meet Cliffco Mortgage Bankers' loan officers: every officer is NMLS-licensed and verifiable on NMLS Consumer Access. Filter by state or browse by branch."
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loan Officers", href: "/loan-officers/" },
  ]} />

  <AsymHero
    eyebrow="Our People"
    lead="Cliffco's loan officers aren't a call center you get routed to. They know their markets, answer their own phones, and have seen the kinds of loans conventional lenders turn away. Browse by office or filter by state to find yours."
    facts={[
      { label: "Loan officers", value: String(LOAN_OFFICERS.length) },
      { label: "Offices", value: String(byBranch.length) },
      { label: "States covered", value: String(allStates.length) },
    ]}
  >
    Meet the people who get families home.
    <Fragment slot="actions">
      <a href="#find" class="btn btn-primary">Find your loan officer</a>
      <a href="/get-started/" class="btn btn-secondary">Get Started</a>
    </Fragment>
  </AsymHero>

  <!-- Filters -->
  <section id="find" class="bg-white border-t border-[var(--color-ink)] scroll-mt-24">
    <div class="container-wide py-10 lg:py-12">
      <div class="flex flex-wrap items-center gap-4">
        <div class="flex items-center gap-3 flex-1 min-w-[220px]">
          <label for="lo-search" class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] whitespace-nowrap">Search</label>
          <div class="relative flex-1">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-text-muted)] pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 15.803 7.5 7.5 0 0015.803 15.803z" /></svg>
            <input
              id="lo-search"
              type="search"
              placeholder="Name..."
              autocomplete="off"
              class="w-full border-2 border-[var(--color-ink)] rounded-xl pl-9 pr-4 py-2.5 text-sm font-medium text-[var(--color-ink)] bg-white focus:outline-none focus:ring-2 focus:ring-[var(--color-ink)]/30"
            />
          </div>
        </div>
        <div class="flex items-center gap-3">
          <label for="state-filter" class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] whitespace-nowrap">State</label>
          <select
            id="state-filter"
            class="border-2 border-[var(--color-ink)] rounded-xl px-4 py-2.5 text-sm font-medium text-[var(--color-ink)] bg-white focus:outline-none focus:ring-2 focus:ring-[var(--color-ink)]/30 min-w-[200px] cursor-pointer"
          >
            <option value="">All states</option>
            {allStates.map((s) => (
              <option value={s}>{stateNames[s] ?? s} ({s})</option>
            ))}
          </select>
        </div>
        <span id="filter-count" class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] hidden"></span>
      </div>
    </div>
  </section>

  <!-- Branch-grouped view (default) -->
  <section id="branch-view" class="bg-white">
    {byBranch.map((g) => (
      <div class="border-t border-[var(--color-ink)]">
        <div class="container-wide py-14 lg:py-20 grid lg:grid-cols-12 gap-10">
          <div class="lg:col-span-3 lg:sticky lg:top-28 self-start">
            <p class="eyebrow">{g.branch.metro ?? "Office"}</p>
            <h2 class="mt-3" id={g.branch.slug} style="font-size: var(--text-h3); font-weight: 700;">{g.branch.name}</h2>
            <p class="mt-2 text-sm text-[var(--color-text-muted)]">{g.officers.length} loan officer{g.officers.length === 1 ? "" : "s"}</p>
          </div>
          <div class="lg:col-span-9 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 lo-shuffle-grid">
            {g.officers.map((lo) => (
              <a href={`/loan-officers/${lo.slug}/`} class="group rounded-2xl border-2 border-[var(--color-ink)] p-6 no-underline text-[var(--color-ink)] flex flex-col bg-white hover:bg-[var(--color-ink)] hover:text-white transition-colors">
                <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] group-hover:text-white/60">{lo.title}</p>
                <h3 class="mt-2 text-lg font-semibold group-hover:!text-white">{lo.displayName}</h3>
                <p class="text-xs text-[var(--color-text-muted)] group-hover:text-white/70 mt-1">NMLS #{lo.nmls}</p>
                <p class="text-xs text-[var(--color-text-muted)] group-hover:text-white/70 mt-0.5">Licensed in {lo.states.join(", ")}</p>
                {(() => { const extra = (lo.languages ?? []).filter((l: string) => l !== "English"); return extra.length > 0 && (
                  <p class="text-xs mt-2 font-medium">{extra.join(" · ")}</p>
                ); })()}
                <span class="mt-auto pt-4 text-sm font-semibold">View bio →</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    ))}
  </section>

  <!-- State-filtered view (shown when a state is selected) -->
  <section id="state-view" class="bg-white border-t border-[var(--color-ink)] hidden">
    <div class="container-wide py-14 lg:py-20">
      <div id="state-results" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"></div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>(".lo-shuffle-grid").forEach((grid) => {
    const children = [...grid.children] as HTMLElement[];
    for (let i = children.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      grid.appendChild(children[j]);
    }
  });
</script>

<!-- LO data for client-side filtering -->
<script define:vars={{ loData: LOAN_OFFICERS.map((lo) => ({
  slug: lo.slug,
  displayName: lo.displayName,
  title: lo.title,
  nmls: lo.nmls,
  states: lo.states,
  languages: lo.languages ?? [],
})) }}>
  const searchInput = document.getElementById("lo-search");
  const select = document.getElementById("state-filter");
  const branchView = document.getElementById("branch-view");
  const stateView = document.getElementById("state-view");
  const stateResults = document.getElementById("state-results");
  const filterCount = document.getElementById("filter-count");

  function cardHtml(lo) {
    const extra = lo.languages.filter((l) => l !== "English");
    return `
      <a href="/loan-officers/${lo.slug}/" class="group rounded-2xl border-2 border-[var(--color-ink)] p-6 no-underline text-[var(--color-ink)] flex flex-col bg-white hover:bg-[var(--color-ink)] hover:text-white transition-colors">
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] group-hover:text-white/60">${lo.title}</p>
        <h3 class="mt-2 text-lg font-semibold group-hover:!text-white">${lo.displayName}</h3>
        <p class="text-xs text-[var(--color-text-muted)] group-hover:text-white/70 mt-1">NMLS #${lo.nmls}</p>
        <p class="text-xs text-[var(--color-text-muted)] group-hover:text-white/70 mt-0.5">${lo.states.join(", ")}</p>
        ${extra.length > 0 ? `<p class="text-xs mt-2 font-medium">${extra.join(" · ")}</p>` : ""}
        <span class="mt-auto pt-4 text-sm font-semibold">View bio →</span>
      </a>
    `;
  }

  function applyFilters() {
    const state = select.value;
    const query = searchInput.value.trim().toLowerCase();

    if (!state && !query) {
      branchView.classList.remove("hidden");
      stateView.classList.add("hidden");
      filterCount.classList.add("hidden");
      return;
    }

    let matched = loData;
    if (state) matched = matched.filter((lo) => lo.states.includes(state));
    if (query) matched = matched.filter((lo) => lo.displayName.toLowerCase().includes(query));

    branchView.classList.add("hidden");
    stateView.classList.remove("hidden");

    let label = "";
    if (query && state) label = `${matched.length} result${matched.length === 1 ? "" : "s"} for "${searchInput.value}" in ${state}`;
    else if (query) label = `${matched.length} loan officer${matched.length === 1 ? "" : "s"} matching "${searchInput.value}"`;
    else label = `${matched.length} loan officer${matched.length === 1 ? "" : "s"} licensed in ${state}`;

    filterCount.textContent = label;
    filterCount.classList.remove("hidden");

    if (matched.length === 0) {
      stateResults.innerHTML = `<p style="color:var(--color-text-muted);grid-column:1/-1;">No loan officers found. Try a different name or state.</p>`;
    } else {
      stateResults.innerHTML = matched.map(cardHtml).join("");
    }
  }

  select.addEventListener("change", applyFilters);
  searchInput.addEventListener("input", applyFilters);

  // Auto-apply state filter from URL param (e.g. ?state=NY)
  const initialState = new URLSearchParams(window.location.search).get("state");
  if (initialState) {
    select.value = initialState;
    applyFilters();
  }
</script>
