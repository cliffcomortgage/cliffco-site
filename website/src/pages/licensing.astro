---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../data/company";
import { STATE_LICENSES } from "../data/state-licenses";

const sorted = [...STATE_LICENSES].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout
  title="State Licensing | Cliffco Mortgage Bankers"
  description={`Cliffco Mortgage Bankers (NMLS #${COMPANY.nmls}) is licensed to originate residential mortgage loans in ${STATE_LICENSES.length} states. Full state-by-state license details, regulators, and license numbers.`}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Licensing", href: "/licensing/" },
  ]} />

  <section class="container-wide pt-12 pb-16">
    <p class="eyebrow">State Licensing</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">
      Licensed in {STATE_LICENSES.length} states.
    </h1>
    <p class="lead mt-6">
      Our NMLS # is {COMPANY.nmls}. {COMPANY.legalName} (d/b/a Cliffco Mortgage Bankers)
      is licensed in the states listed below. Verify our licenses and complaint history
      any time at <a href={COMPANY.nmlsConsumerAccessUrl} rel="noopener">NMLS Consumer Access</a>.
    </p>
  </section>

  <section class="bg-white pb-16">
    <div class="container-wide">
      <div class="overflow-x-auto rounded-lg border border-[var(--color-mist-gray)]">
        <table class="w-full text-sm">
          <thead class="bg-[var(--color-mist-gray)] text-left">
            <tr>
              <th class="py-3 px-4 font-semibold text-[var(--color-ink)]">State</th>
              <th class="py-3 px-4 font-semibold text-[var(--color-ink)]">Regulator</th>
              <th class="py-3 px-4 font-semibold text-[var(--color-ink)]">License</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((s) => (
              <tr class="border-t border-[var(--color-mist-gray)] align-top">
                <td class="py-3 px-4 font-semibold text-[var(--color-ink)]">{s.name} <span class="text-[var(--color-text-muted)] text-xs ml-1">({s.code})</span></td>
                <td class="py-3 px-4 text-[var(--color-text)]">{s.regulator}</td>
                <td class="py-3 px-4 text-[var(--color-text)] font-mono text-xs">
                  {s.licenseNumber ?? "N/A"}
                  {s.notes && <div class="mt-1 not-italic text-[var(--color-text-muted)] font-sans normal-case">{s.notes}</div>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-12 grid md:grid-cols-2 gap-6">
        <div class="card">
          <h2 class="text-base font-semibold text-[var(--color-ink)]">Florida DBA Disclosure</h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">
            {COMPANY.floridaDba.disclosure}
          </p>
        </div>

        <div class="card">
          <h2 class="text-base font-semibold text-[var(--color-ink)]">Texas Consumer Complaint Procedure</h2>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">
            See our <a href="/legal/texas-complaints/">Texas consumer complaint procedure page</a> for the
            statutorily-required complaint contact information for Texas borrowers.
          </p>
        </div>
      </div>

      <div class="mt-12">
        <h2 class="text-xl font-semibold text-[var(--color-ink)]">Verify Cliffco at NMLS Consumer Access</h2>
        <p class="lead mt-3 max-w-3xl text-[var(--color-text-muted)]">
          NMLS Consumer Access is the public, federally-chartered registry for the residential
          mortgage industry. You can look up Cliffco's company-level record (NMLS #{COMPANY.nmls})
          and any individual loan officer's record there.
        </p>
        <a href={COMPANY.nmlsConsumerAccessUrl} class="btn btn-primary mt-6" rel="noopener">Verify Cliffco at NMLS Consumer Access ↗</a>
      </div>

      <div class="mt-12 border-t border-[var(--color-mist-gray)] pt-8 space-y-3 text-xs text-[var(--color-text-muted)]">
        <p>{COMPANY.legalName} is not affiliated with or acting on behalf of the FHA or any government entity. Equal Housing Lender.</p>
        <p>This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states.</p>
      </div>
    </div>
  </section>
</Layout>
