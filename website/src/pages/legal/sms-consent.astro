---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
const lastUpdated = "2026-06-04";
---

<Layout title="SMS / Text Message Consent" description={`SMS / TCPA consent terms for ${COMPANY.brandName}.`}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Legal", href: "/legal/" },
    { name: "SMS Consent", href: "/legal/sms-consent/" },
  ]} />
  <section class="container-prose pt-12 pb-16">
    <h1 style="font-size: var(--text-display-lg);">SMS / Text Message Consent</h1>
    <p class="text-sm text-[var(--color-text-muted)] mt-2">Last updated: {lastUpdated}</p>
    <p class="mt-6">
      By providing your mobile phone number to {COMPANY.legalName} (NMLS #{COMPANY.nmls}), you
      expressly consent to receive informational and promotional text messages from
      {COMPANY.legalName} regarding your loan inquiry, application, and Cliffco's products and
      services.
    </p>
    <ul>
      <li><strong>Message frequency:</strong> recurring messages may be sent.</li>
      <li><strong>Message and data rates may apply.</strong></li>
      <li><strong>Opt out:</strong> contact <a href="mailto:compliance@cliffcomortgage.com">compliance@cliffcomortgage.com</a> to unsubscribe from future messages.</li>
      <li><strong>Help:</strong> for help, contact us at <a href="tel:+15164087300">516-408-7300</a>.</li>
      <li><strong>Carriers:</strong> we work with major US wireless carriers; we are not liable for delayed or undelivered messages.</li>
    </ul>
    <p>
      Consent to receive marketing text messages is not a condition of any purchase or loan
      application. Cliffco honors all opt-out requests and retains consent records as required
      by the Telephone Consumer Protection Act (TCPA).
    </p>
    <p class="text-xs text-[var(--color-text-muted)] mt-8">
      This SMS consent disclosure is a baseline and should be reviewed by Cliffco's compliance
      counsel before launch.
    </p>
  </section>
</Layout>
