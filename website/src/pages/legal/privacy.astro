---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
const today = new Date().toISOString().slice(0, 10);
---

<Layout title="Privacy Policy" description={`Privacy Policy for ${COMPANY.brandName} (NMLS #${COMPANY.nmls}).`} noindex={false}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Legal", href: "/legal/" },
    { name: "Privacy Policy", href: "/legal/privacy/" },
  ]} />

  <section class="container-prose pt-12 pb-16">
    <h1 style="font-size: var(--text-display-lg);">Privacy Policy</h1>
    <p class="text-sm text-[var(--color-text-muted)] mt-2">Last updated: {today}</p>

    <p class="mt-6">
      This Privacy Policy describes how {COMPANY.legalName} (NMLS #{COMPANY.nmls})
      and its Florida DBA Swish Capital, Inc. (collectively, "Cliffco," "we," "us")
      collects, uses, and shares personal information when you visit cliffcomortgage.com,
      apply for a loan, or otherwise interact with us.
    </p>

    <h2 class="mt-10">Information we collect</h2>
    <p>
      We collect personal information you provide (name, email, phone, mailing address,
      Social Security Number when required for credit-pull authorization, financial
      information needed for loan qualification), information collected automatically
      (device, IP address, pages viewed, referrer), and information from third parties
      (credit bureaus, employers, asset verifiers).
    </p>

    <h2 class="mt-10">How we use your information</h2>
    <ul>
      <li>To process loan applications and originate, underwrite, and service mortgages.</li>
      <li>To respond to inquiries and provide quotes.</li>
      <li>To comply with federal and state mortgage regulations and reporting requirements.</li>
      <li>To send you marketing about Cliffco's products and services where you have opted in.</li>
      <li>To prevent fraud, comply with legal obligations, and protect Cliffco and our customers.</li>
    </ul>

    <h2 class="mt-10">How we share information</h2>
    <p>
      We share information with: investors, agency entities (Fannie Mae, Freddie Mac, FHA, VA,
      USDA), settlement service providers (title companies, appraisers, credit bureaus),
      regulators, and service providers acting on our behalf under written contracts requiring
      confidentiality. We do not sell personal information.
    </p>

    <h2 class="mt-10">State privacy rights (California, Virginia, Colorado, Connecticut, Utah, Florida, Texas, Oregon)</h2>
    <p>
      Residents of states with comprehensive privacy laws have specific rights including the
      right to know, the right to delete, the right to correct, the right to opt out of certain
      processing, and the right to data portability. To exercise any of these rights, contact us
      at <a href="mailto:privacy@cliffcomortgage.com">privacy@cliffcomortgage.com</a>.
      See <a href="/legal/ccpa/">CCPA disclosures</a> for California-specific details.
    </p>

    <h2 class="mt-10">SMS / TCPA</h2>
    <p>
      See our <a href="/legal/sms-consent/">SMS Consent</a> page for the text-message terms,
      consent disclosures, and opt-out instructions required under the Telephone Consumer
      Protection Act (TCPA).
    </p>

    <h2 class="mt-10">Contact</h2>
    <p>
      Privacy inquiries: <a href="mailto:privacy@cliffcomortgage.com">privacy@cliffcomortgage.com</a><br/>
      {COMPANY.legalName}<br/>
      {COMPANY.hq.street}<br/>
      {COMPANY.hq.city}, {COMPANY.hq.region} {COMPANY.hq.postalCode}<br/>
      {COMPANY.hq.phone}
    </p>

    <p class="text-xs text-[var(--color-text-muted)] mt-8">
      This privacy policy is a baseline drafted for the relaunched Cliffco site and should be
      reviewed by Cliffco's compliance counsel before launch.
    </p>
  </section>
</Layout>
