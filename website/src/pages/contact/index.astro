---
import { STATE_LICENSES } from "../../data/state-licenses";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import IndexHeader from "../../components/asym/IndexHeader.astro";
import IndexSection from "../../components/asym/IndexSection.astro";
import { COMPANY } from "../../data/company";
import { BRANCHES } from "../../data/branches";
import ContactForm from "../../components/forms/ContactForm.astro";

const allBranches = BRANCHES;
const branchStates = new Set(BRANCHES.map((b) => b.region)).size;
---

<Layout
  title="Contact Cliffco Mortgage Bankers | (800) 834-4040"
  description={`Reach Cliffco by phone, online, or in person. ${BRANCHES.length} branch offices across NY, NJ, FL, AZ, and MN. Toll-free (800) 834-4040. A loan officer responds within one business day.`}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Contact", href: "/contact/" },
  ]} />

  <IndexHeader eyebrow="Contact Us" lead="No bots. No call centers. When you reach out, a licensed Cliffco loan officer responds within one business day.">
    Talk to a Real Loan Officer.
    <Fragment slot="actions">
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-primary">Call {COMPANY.tollFree}</a>
      <a href="/get-started/" class="btn btn-secondary">Start an Application</a>
    </Fragment>
    <Fragment slot="meta">
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Toll Free</dt>
        <dd class="mt-1 text-2xl font-bold"><a href={`tel:${COMPANY.tollFreeE164}`} class="text-[var(--color-ink)] no-underline">{COMPANY.tollFree}</a></dd>
      </div>
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Response time</dt>
        <dd class="mt-1 text-lg font-semibold">One business day</dd>
      </div>
    </Fragment>
  </IndexHeader>

  <!-- CONTACT CHANNELS + FORM -->
  <IndexSection label="Reach us" title="However works best for you.">
    <div class="grid xl:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] gap-12 items-start">
      <dl class="border-t border-[var(--color-ink)]">
        <div class="py-5 border-b border-black/15">
          <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Call Us · Toll Free</dt>
          <dd class="mt-1">
            <a href={`tel:${COMPANY.tollFreeE164}`} class="text-[var(--color-ink)] font-semibold no-underline text-lg">{COMPANY.tollFree}</a>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">Mon–Fri 9am–6pm ET. Leave a voicemail anytime.</p>
          </dd>
        </div>
        <div class="py-5 border-b border-black/15">
          <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Headquarters</dt>
          <dd class="mt-1">
            <address class="not-italic text-[var(--color-text)] leading-relaxed">
              {COMPANY.hq.street}<br/>
              {COMPANY.hq.city}, {COMPANY.hq.region} {COMPANY.hq.postalCode}<br/>
              <span class="text-[var(--color-text-muted)] text-xs uppercase tracking-wide">Main</span> <a href={`tel:${COMPANY.hq.phoneE164}`} class="text-[var(--color-ink)] no-underline hover:underline">{COMPANY.hq.phone}</a>
            </address>
          </dd>
        </div>
        <div class="py-5 border-b border-black/15">
          <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Response time</dt>
          <dd class="mt-1 text-[var(--color-text)]">We respond to all online inquiries within one business day. Usually much faster.</dd>
        </div>
        <div class="py-5">
          <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Ready to apply?</dt>
          <dd class="mt-1">
            <p class="text-[var(--color-text)]">If you're ready to start the mortgage process, use our guided intake instead.</p>
            <a href="/get-started/" class="btn btn-primary text-sm mt-4 inline-block">Start Your Application →</a>
          </dd>
        </div>
      </dl>

      <div id="contact" class="scroll-mt-24 rounded-2xl border-2 border-[var(--color-ink)] p-6 sm:p-8">
        <p class="eyebrow">Send a message</p>
        <h2 class="mt-3" style="font-size: clamp(1.5rem, 2.2vw, 1.875rem); font-weight: 700;">General inquiry form.</h2>
        <p class="mt-3 text-sm text-[var(--color-text-muted)]">For mortgage applications, use the <a href="/get-started/" class="text-[var(--color-ink)] underline underline-offset-2">guided intake</a> instead. This form is for general questions and non-application inquiries.</p>
        <div class="mt-6">
          <ContactForm
            formTo="websiteleads@cliffcomortgage.com,cliffcorpteam@cliffcomortgage.com"
            formSource="contact-page"
            ctaLabel="Send Message"
            showPurpose={false}
            showState={false}
            notesRequired={true}
            notesLabel="How Can We Help?"
          />
        </div>
      </div>
    </div>
  </IndexSection>

  <!-- BRANCH OFFICES -->
  <IndexSection label="Our offices" title={`${BRANCHES.length} branches across ${branchStates} states.`}>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-left">
          <tr class="border-b-2 border-[var(--color-ink)]">
            <th class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.14em] font-normal">Office</th>
            <th class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.14em] font-normal">Address</th>
            <th class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.14em] font-normal">Phone</th>
            <th class="py-3 font-mono text-[11px] uppercase tracking-[0.14em] font-normal">Branch NMLS</th>
          </tr>
        </thead>
        <tbody>
          {allBranches.map((b) => (
            <tr class="border-b border-black/15 align-top">
              <td class="py-4 pr-4">
                <span class="font-semibold text-[var(--color-ink)]">{b.displayCity ?? b.city}{b.isHeadquarters ? " (HQ)" : ""}</span>
                {b.metro && <span class="block text-xs text-[var(--color-text-muted)] mt-0.5">{b.metro}</span>}
                {b.isFloridaDba && <span class="block font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--color-ink)] mt-1">Clout Mortgage</span>}
              </td>
              <td class="py-4 pr-4 text-[var(--color-text)]">
                {b.street && <address class="not-italic leading-relaxed">{b.street}<br/>{b.city}, {b.region} {b.postalCode}</address>}
              </td>
              <td class="py-4 pr-4 whitespace-nowrap">
                {b.phone && <a href={`tel:+1${b.phone.replace(/\D/g, "")}`} class="font-medium text-[var(--color-ink)] no-underline hover:underline">{b.phone}</a>}
              </td>
              <td class="py-4 font-mono text-xs text-[var(--color-ink)]">{b.nmls && `#${b.nmls}`}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-6 text-sm text-[var(--color-text-muted)]">
      Cliffco is licensed in {STATE_LICENSES.length} states. <a href="/locations/" class="text-[var(--color-ink)] font-semibold">View all locations and loan officers →</a>
    </p>
  </IndexSection>
</Layout>
