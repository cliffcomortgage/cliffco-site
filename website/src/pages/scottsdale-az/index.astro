---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { BRANCHES } from "../../data/branches";
import { LOAN_OFFICERS } from "../../data/loan-officers";
import Headshot from "../../components/ui/Headshot.astro";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";

const branch = BRANCHES.find((b) => b.slug === "scottsdale-az")!;
const los = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "scottsdale-az");

const schema = [
  localBusinessSchema(branch),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "Arizona", url: "/locations/arizona/" },
    { name: "Scottsdale", url: "/scottsdale-az/" },
  ]),
];
import ContactForm from "../../components/forms/ContactForm.astro";
---

<Layout
  title="Scottsdale, AZ Mortgage Office | Cliffco Mortgage Bankers"
  description="Cliffco Mortgage Bankers Scottsdale office - 15955 Dial Boulevard, Suite 5, Scottsdale, AZ 85260. Branch NMLS #2476150. Serving the Phoenix metro and greater Arizona."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "Arizona", href: "/locations/arizona/" },
    { name: "Scottsdale", href: "/scottsdale-az/" },
  ]} />

  <section class="accent-gradient">
    <div class="container-wide py-16 lg:py-24">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Scottsdale, AZ · Phoenix Metro</p>
      <h1 class="mt-4 text-white max-w-3xl" style="font-size: var(--text-display-xl); line-height: 1.1; font-weight: 300; font-family: var(--font-sans);">
        Scottsdale Mortgage Office
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">
        Cliffco's Scottsdale branch serves the greater Phoenix metro and statewide Arizona. Multilingual team specializing in DSCR for investors, Non-QM, and bank statement loans.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">
          <span class="text-white/70 font-normal text-xs">Toll Free</span>&nbsp;{COMPANY.tollFree}
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide grid lg:grid-cols-2 gap-10 items-start">
      <div>
        <p class="eyebrow">Branch information</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Find us in Scottsdale.</h2>
        <address class="not-italic mt-6 space-y-2 text-[var(--color-text)]">
          <p class="font-semibold text-[var(--color-ink)]">{branch.name}</p>
          <p>{branch.street}</p>
          <p>{branch.city}, {branch.region} {branch.postalCode}</p>
        </address>
        {branch.nmls && <p class="mt-4 text-sm text-[var(--color-text-muted)]">Branch NMLS #{branch.nmls}</p>}
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">Arizona Mortgage Banker License #1045708.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-primary text-sm">Call Toll Free: {COMPANY.tollFree}</a>
          <a href="/get-started/" class="btn btn-secondary text-sm">Start Application</a>
        </div>
      </div>
      <div class="card">
        <p class="eyebrow">About this office</p>
        <p class="mt-3 text-[var(--color-text)] leading-relaxed">
          Our Scottsdale team is multilingual - fluent in English, Mandarin, and Spanish - and specializes in serving self-employed borrowers, real estate investors, and buyers with non-traditional income documentation across Arizona, California, and Texas.
        </p>
        <a href="/locations/arizona/" class="mt-4 inline-block text-sm font-semibold text-[var(--color-accent)] no-underline hover:underline">← All Arizona offices</a>
      </div>
    </div>
  </section>

  {los.length > 0 && (
    <section class="section bg-[var(--color-mist-gray)]">
      <div class="container-wide">
        <p class="eyebrow">Loan officers at this office</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Your Scottsdale team.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {los.map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-auto pt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Buying or investing in the Phoenix metro? We're here.</h2>
      <p class="lead mt-4 text-white/85">A licensed Cliffco loan officer responds in one business day.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <h2 class="mt-3" style="font-size: var(--text-h2);">Buying or investing in the Phoenix metro?</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">Tell us your situation and the Scottsdale team will be in touch within one business day.</p>
      <div class="mt-8">
        <ContactForm
          formTo="swei@cliffcomortgage.com,websiteleads@cliffcomortgage.com"
          formSource="branch-scottsdale"
        />
      </div>
    </div>
  </section>
</Layout>
