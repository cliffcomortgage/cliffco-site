---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { LOAN_OFFICERS, loanOfficer } from "../../data/loan-officers";
import { faqPageSchema, articleSchema } from "../../lib/schema";


const teamSlugs = ["david-fallarino", "lee-horen", "fabrizio-alosa", "brandon-kenney", "kevan-scott"];
const teamMembers = teamSlugs.map(s => LOAN_OFFICERS.find(lo => lo.slug === s)!).filter(Boolean);
const david = loanOfficer("david-fallarino")!;

const faq = [
  {
    question: "What types of borrowers does The Fallarino Group work with?",
    answer: "We specialize in high-income professionals, entrepreneurs, business owners, and real estate investors whose financial profiles don't fit conventional bank guidelines. If you have complex income, need jumbo or super-jumbo financing, want to qualify on investment property cash flow, or are optimizing a tax strategy that makes your returns look light, we're built for exactly that.",
  },
  {
    question: "What is the largest loan The Fallarino Group has originated?",
    answer: "Our programs reach into the super-jumbo range, up to $40M, on Alt-A and portfolio products. Loan size is rarely the limiting factor for our borrowers. The conversation starts with your financial profile and goals, not a loan limit.",
  },
  {
    question: "How is Alt-A different from Non-QM?",
    answer: "Alt-A loans sit between A-paper conventional and Non-QM. They use the same tax returns as conventional underwriting but evaluate gross income and essential expenses rather than the after-deduction bottom line. This typically produces better rates than Non-QM while still accommodating the income complexity that makes conventional underwriting fall short for entrepreneurs.",
  },
  {
    question: "Can I qualify for a DSCR loan if the property is an Airbnb or short-term rental?",
    answer: "Yes. DSCR programs accept projected or historical short-term rental income using AirDNA projections or your actual booking history. You do not need to show W-2 income. The property's cash flow is the qualification. LLC vesting is also allowed.",
  },
  {
    question: "How quickly can The Fallarino Group issue a pre-approval?",
    answer: "In most cases, same day. Our team reviews complex financial files daily and understands how to move quickly without sacrificing precision. A pre-approval letter for a high-value purchase or investment transaction is typically issued within 24 hours of receiving your documentation.",
  },
  {
    question: "Do you work with out-of-state buyers?",
    answer: "Yes. David is licensed in 13 states and the team collectively covers a broad footprint. If you're purchasing investment property outside New York or refinancing a property in another state, reach out and we'll confirm coverage.",
  },
];

const schema = [
  faqPageSchema(faq),
  articleSchema({
    headline: "The Fallarino Group | Cliffco Mortgage Bankers",
    description: "The Fallarino Group at Cliffco Mortgage Bankers specializes in jumbo, Alt-A, DSCR, and Non-QM financing for high-growth entrepreneurs, investors, and high-net-worth professionals.",
    url: "/the-fallarino-group/",
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
    authorSlug: "david-fallarino",
  }),
];

import TeamPoster from "../../components/asym/TeamPoster.astro";
import TeamBlock from "../../components/asym/TeamBlock.astro";
import FaqList from "../../components/asym/FaqList.astro";
import FormCard from "../../components/asym/FormCard.astro";

const whoToCall = [
  { name: "David Fallarino", slug: "david-fallarino", role: "High Growth Entrepreneurs", tags: ["Super Jumbo", "Alt-A", "Non-QM", "Condo & Co-op", "Renovation Loans"] },
  { name: "Lee Horen", slug: "lee-horen", role: "Complex & Jumbo Deals", tags: ["Jumbo & Super Jumbo", "Complex Income", "Self-Employed", "Tough Scenarios"] },
  { name: "Kevan Scott", slug: "kevan-scott", role: "Investors & Entrepreneurs", tags: ["DSCR", "P&L Loans", "Bank Statement", "Real Estate Investors"] },
  { name: "Brandon Kenney", slug: "brandon-kenney", role: "Investment Properties", tags: ["Investment Properties", "Renovation Loans", "VA Loans", "FNMA"] },
  { name: "Fabrizio Alosa", slug: "fabrizio-alosa", role: "First-Time Buyers & Non-QM", tags: ["Spanish-Speaking", "First-Time Buyers", "Non-QM", "FHA"] },
];
const specialties = [
  { name: "Jumbo & Super Jumbo", range: "Up to $40M", href: "/loans/conventional/", body: "High-balance conforming, jumbo, and super-jumbo financing for primary residences, second homes, and investment properties. Conventional and Alt-A structures available." },
  { name: "Alt-A Mortgage", range: "Better terms than Non-QM", href: "/jumbo-alt-a-loans-entrepreneurs-david-fallarino/", body: "For entrepreneurs whose tax returns understate their income. Alt-A uses gross revenue minus essential expenses, offering rates competitive with A-paper while accommodating complex business income." },
  { name: "DSCR for Investors", range: "Qualify on rental income", href: "/loans/dscr/", body: "No W-2. No tax returns. DSCR loans qualify investment properties on their own rental cash flow, short-term or long-term. LLC vesting allowed. Portfolio scaling without personal income caps." },
  { name: "Non-QM", range: "No tax returns required", href: "/loans/non-qm-self-employed/", body: "For business owners and self-employed professionals who need flexibility beyond what Alt-A covers. P&L, 1099-only, asset depletion, ITIN, and foreign national programs." },
  { name: "Business Bank Statement", range: "12–24 months of statements", href: "/loans/business-bank-statement/", body: "12–24 months of business deposits with a standard expense ratio applied. Built for LLCs, S-Corps, and sole proprietors whose returns understate actual cash flow." },
  { name: "Conventional", range: "Conforming & high-balance", href: "/loans/conventional-government/", body: "Fannie Mae and Freddie Mac conforming loans, including high-balance programs up to $1,249,125 in high-cost markets like Nassau and Suffolk. Competitive rates for buyers with strong credit profiles." },
];
const market = [
  { label: "Nassau median price", value: "$849K", note: "Single-family · 2026" },
  { label: "Suffolk median price", value: "$700K", note: "Single-family · 2026" },
  { label: "High-balance limit", value: "$1.25M", note: "Nassau-Suffolk MSA" },
  { label: "Alt-A max loan", value: "$40M", note: "Via The Fallarino Group" },
];
const calculators = [
  { href: "/mortgage-guides/calculators/dscr/", title: "DSCR Calculator", desc: "Instantly see whether an investment property qualifies and what your coverage ratio is.", badge: "Investors" },
  { href: "/mortgage-guides/calculators/buydown/", title: "Buydown Calculator", desc: "See the exact cost of a 3-2-1, 2-1, or 1-0 buydown and monthly savings per plan.", badge: "Buyers" },
  { href: "/mortgage-guides/calculators/closing-costs/", title: "Closing Costs", desc: "Itemized estimate with NY mortgage recording tax, transfer tax, and title by state.", badge: "NY-aware" },
];
---

<Layout
  title="The Fallarino Group | Jumbo, Alt-A & DSCR Specialists | Cliffco"
  description="The Fallarino Group at Cliffco Mortgage Bankers. Jumbo up to $40M, Alt-A, DSCR, and Non-QM financing for high-growth entrepreneurs, investors, and high-net-worth professionals. $3B+ closed."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "The Fallarino Group", href: "/the-fallarino-group/" },
  ]} />

  <TeamPoster
    eyebrow="Cliffco Mortgage Bankers · Uniondale, New York"
    logo={{ src: "/images/team%20logos/The%20Fallarino%20Group_Stacked_White.png", alt: "The Fallarino Group", maxHeight: "88px" }}
    members={teamMembers}
    teamTitle="Meet The Fallarino Group."
    teamIntro="Five specialists. One team. Every file gets the full resources of a direct lender with the flexibility to broker when it benefits the client."
    stats={[
      { stat: "$3B+", label: "In closed loan volume", sub: "Across a 20+ year career" },
      { stat: "$40M", label: "Maximum loan amount", sub: "Alt-A and portfolio programs" },
      { stat: "5", label: "Specialists on the team", sub: "Jumbo · Alt-A · DSCR · Non-QM" },
    ]}
  >
    Strategic financing for high-growth entrepreneurs and investors.
    <p slot="lead" class="text-white/75 leading-relaxed" style="font-size: 1.0625rem;">
      Over $3 billion closed. Jumbo to $40M. Alt-A, DSCR, Non-QM structured around how you actually earn. Not how a W-2 says you do.
    </p>
    <Fragment slot="actions">
      <a href={david.links?.applyNow ?? "/get-started/"} target="_blank" rel="noopener" class="btn btn-primary">Work With The Team</a>
      {david.links?.directPhone && (
        <a href={`tel:+1${david.links.directPhone.replace(/\D/g, "")}`} class="btn btn-secondary">{david.links.directPhone}</a>
      )}
    </Fragment>
  </TeamPoster>

  <!-- WHO TO CALL -->
  <TeamBlock eyebrow="Who handles what" title="The right specialist for your deal.">
    <ul class="list-none m-0 p-0 border-t-2 border-[var(--color-ink)]">
      {whoToCall.map((m) => (
        <li class="border-b border-black/15">
          <a href={`/loan-officers/${m.slug}/`} class="group grid md:grid-cols-12 gap-x-6 gap-y-2 py-5 no-underline text-[var(--color-ink)] items-center">
            <span class="md:col-span-3 font-semibold text-lg group-hover:underline">{m.name}</span>
            <span class="md:col-span-3 font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)]">{m.role}</span>
            <span class="md:col-span-5 flex flex-wrap gap-1.5">
              {m.tags.map((tag) => (
                <span class="text-xs font-medium px-2.5 py-1 rounded-full border border-[var(--color-ink)]">{tag}</span>
              ))}
            </span>
            <span class="md:col-span-1 text-sm font-semibold md:text-right">→</span>
          </a>
        </li>
      ))}
    </ul>
  </TeamBlock>

  <!-- SPECIALTIES -->
  <TeamBlock eyebrow="What we do best" title="Built for complexity.<br/>Optimized for performance.">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {specialties.map((spec) => (
        <a href={spec.href} class="group rounded-2xl border-2 border-[var(--color-ink)] p-6 no-underline text-[var(--color-ink)] flex flex-col gap-3 h-full hover:bg-[var(--color-ink)] hover:text-white transition-colors">
          <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] group-hover:text-white/60">{spec.range}</span>
          <h3 class="font-semibold group-hover:!text-white" style="font-size: 1.125rem;">{spec.name}</h3>
          <p class="text-sm text-[var(--color-text-muted)] group-hover:text-white/75 leading-relaxed flex-1">{spec.body}</p>
          <span class="text-sm font-semibold mt-auto">Learn more →</span>
        </a>
      ))}
    </div>
  </TeamBlock>

  <!-- MARKET CONTEXT -->
  <TeamBlock eyebrow="The Long Island market" title="Where we operate.<br/>What it means for your loan.">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-6">
        <p class="text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">
          Long Island is one of the most expensive residential markets in the country. Nassau and Suffolk median prices are well above conforming limits. Jumbo financing isn't a luxury product here; it's the baseline for a significant segment of buyers.
        </p>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">
          The Fallarino Group has operated on Long Island for decades. We know the local lenders, appraisers, attorneys, and market dynamics. That local knowledge makes a material difference when a high-value transaction needs to close on time.
        </p>
        <a href={david.links?.applyNow ?? "/get-started/"} target="_blank" rel="noopener" class="mt-8 inline-block btn btn-primary text-sm">Start a conversation</a>
      </div>
      <dl class="lg:col-span-5 lg:col-start-8 grid grid-cols-2 border-t-2 border-l-2 border-[var(--color-ink)]">
        {market.map((s) => (
          <div class="p-5 border-r-2 border-b-2 border-[var(--color-ink)]">
            <dd class="font-bold text-[var(--color-ink)]" style="font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2rem); letter-spacing: -0.02em;">{s.value}</dd>
            <dt class="text-xs font-medium text-[var(--color-ink)] mt-2 leading-snug">{s.label}</dt>
            <dt class="font-mono text-[10px] uppercase tracking-[0.1em] text-[var(--color-text-muted)] mt-1">{s.note}</dt>
          </div>
        ))}
      </dl>
    </div>
  </TeamBlock>

  <!-- 500:1 BLOG -->
  {david.blog && david.blog.length > 0 && (
    <TeamBlock eyebrow="500:1 Blog" title="Written by David Fallarino." intro="Insights on Alt-A, DSCR, jumbo, and Non-QM from someone who has structured $3 billion worth of these transactions.">
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {david.blog.map((post) => (
          <a href={`/${post.slug}/`} class="group rounded-2xl border-2 border-[var(--color-ink)] overflow-hidden no-underline flex flex-col bg-white">
            <div class="aspect-[16/9] overflow-hidden border-b-2 border-[var(--color-ink)]">
              <img src={post.image} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
            </div>
            <div class="p-5 flex flex-col flex-1">
              <h3 class="font-semibold text-[var(--color-ink)] leading-snug flex-1" style="font-size: 0.9375rem;">{post.title}</h3>
              <span class="mt-4 text-sm font-semibold text-[var(--color-ink)]">Read article →</span>
            </div>
          </a>
        ))}
      </div>
    </TeamBlock>
  )}

  <!-- CALCULATORS -->
  <TeamBlock eyebrow="Free tools" title="Run the numbers first.">
    <ol class="list-none m-0 p-0 border-t-2 border-[var(--color-ink)]">
      {calculators.map((c) => (
        <li class="border-b border-black/15">
          <a href={c.href} class="group grid md:grid-cols-12 gap-x-6 gap-y-1 py-5 no-underline text-[var(--color-ink)] items-baseline">
            <span class="md:col-span-2 font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)]">{c.badge}</span>
            <span class="md:col-span-3 font-semibold text-lg group-hover:underline">{c.title}</span>
            <span class="md:col-span-5 text-sm text-[var(--color-text-muted)] leading-relaxed">{c.desc}</span>
            <span class="md:col-span-2 text-sm font-semibold md:text-right">Use calculator →</span>
          </a>
        </li>
      ))}
    </ol>
  </TeamBlock>

  <!-- FAQ -->
  <TeamBlock eyebrow="FAQ" title="Questions we answer every day.">
    <div class="max-w-4xl"><FaqList items={faq} /></div>
  </TeamBlock>

  <!-- CTA + FORM -->
  <TeamBlock dark eyebrow="Ready to get started?" title="Your situation is complex. Let's keep the process simple." intro="No credit pull. No commitment. A 10-minute conversation with David or a team member tells you which program fits and what it costs.">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <img src="/images/team%20logos/The%20Fallarino%20Group_Stacked_White.png" alt="The Fallarino Group" class="select-none w-auto" style="max-height: 72px;" loading="lazy" />
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={david.links?.applyNow ?? "/get-started/"} target="_blank" rel="noopener" class="btn btn-primary !bg-white !text-[var(--color-ink)] hover:!bg-white/85">Start Your Application</a>
        </div>
        <div class="mt-6 flex flex-col gap-1.5 text-sm">
          {david.links?.email && <a href={`mailto:${david.links.email}`} class="!text-white/70 no-underline hover:!text-white">{david.links.email}</a>}
          {david.links?.directPhone && <a href={`tel:+1${david.links.directPhone.replace(/\D/g, "")}`} class="!text-white/70 no-underline hover:!text-white">{david.links.directPhone}</a>}
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <FormCard
          eyebrow="Talk to The Fallarino Group"
          title="Have a jumbo, Alt-A, or complex income deal? Talk to the team."
          sub="Tell us the loan size and how you earn and we'll identify which program fits."
          formTo="dfallarino@cliffcomortgage.com,websiteleads@cliffcomortgage.com"
          formSource="team-fallarino"
        />
      </div>
    </div>
  </TeamBlock>
</Layout>
