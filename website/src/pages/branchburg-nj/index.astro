---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { BRANCHES } from "../../data/branches";
import { LOAN_OFFICERS } from "../../data/loan-officers";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";

const branch = BRANCHES.find((b) => b.slug === "branchburg-nj")!;
const los = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "branchburg-nj");

const schema = [
  localBusinessSchema(branch),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "New Jersey", url: "/locations/new-jersey/" },
    { name: "Branchburg", url: "/branchburg-nj/" },
  ]),
];

import BranchPage from "../../components/asym/BranchPage.astro";

---

<Layout
  title="Branchburg, NJ Mortgage Office | Cliffco Mortgage Bankers"
  description="Cliffco Mortgage Bankers Branchburg, NJ office - 3121 Route 22 East, 3rd Floor, Office 313, Branchburg, NJ 08876. Branch NMLS #2671359. Serving Central New Jersey."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "New Jersey", href: "/locations/new-jersey/" },
    { name: "Branchburg", href: "/branchburg-nj/" },
  ]} />

  <BranchPage
    city="Branchburg"
    eyebrow="Branchburg, NJ · Central New Jersey"
    title="Branchburg Mortgage Office"
    lead="Our Branchburg branch serves Central New Jersey. Bilingual loan officers specializing in self-employed borrowers, DSCR for investors, and first-time homebuyer programs."
    addressName={branch.name}
    street={branch.street}
    cityLine={`${branch.city}, ${branch.region} ${branch.postalCode}`}
    nmlsLabel={`Branch #${branch.nmls}`}
    phone={{ e164: COMPANY.tollFreeE164, display: COMPANY.tollFree, label: "Toll Free" }}
    findTitle="Find us in Branchburg."
    about="The Branchburg office is part of Cliffco's bilingual lending cluster serving New Jersey's Spanish-speaking communities. Loan officers here specialize in Non-QM, bank statement loans, DSCR, and first-time homebuyer programs across NJ, FL, and PA."
    back={{ href: "/locations/new-jersey/", label: "← All New Jersey offices" }}
    los={los}
    teamEyebrow="Loan officers at this office"
    teamTitle="Your Branchburg team."
    ctaTitle="Buying in Central New Jersey? Let's talk."
    formTitle="Buying or refinancing in Central New Jersey?"
    formSub="Tell us your situation and the Branchburg team will be in touch within one business day."
    formSource="branch-branchburg"
  >
    <Fragment slot="info">
      {branch.nmls && <p>Branch NMLS #{branch.nmls}</p>}
    </Fragment>
  </BranchPage>
</Layout>
