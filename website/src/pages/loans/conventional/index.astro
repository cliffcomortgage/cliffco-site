---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("conventional")!;

const faq = [
  { question: "What is a conventional loan?", answer: "A conventional mortgage is a home loan that meets Fannie Mae or Freddie Mac guidelines and is not insured by a government agency (FHA, VA, or USDA). Conforming conventional loans fall within the annual loan limits set by the FHFA; high-balance loans allow higher amounts in designated high-cost counties." },
  { question: "How much down payment do I need for a conventional loan?", answer: "As little as 3% for first-time homebuyers (HomeReady, Home Possible), 5% for repeat buyers, and 10–20% to avoid private mortgage insurance (PMI). Investment properties and second homes typically require 10–20% down." },
  { question: "What credit score do I need?", answer: "Most conventional programs require a minimum 620 FICO. The best pricing is at 740+ FICO. Scores below 680 may require a larger down payment or result in higher rate adjustments." },
  { question: "What is PMI and when can I remove it?", answer: "Private mortgage insurance (PMI) is required on conventional loans when the down payment is less than 20%. PMI can typically be removed once the loan-to-value ratio reaches 80%, either through scheduled amortization or increased home value (with a new appraisal)." },
  { question: "What is the 2026 conforming loan limit?", answer: "For 2026, the standard conforming loan limit is $806,500 for a single-family property in most of the country. High-cost counties (including much of the New York metro and coastal Florida markets) have higher limits up to $1,209,750. Cliffco originates both conforming and high-balance conventional loans." },
  { question: "Can I get a conventional loan on an investment property?", answer: "Yes. Conventional programs allow financing of 1–4 unit investment properties. Down payment requirements are higher (typically 15–25%), and rate adjustments apply. For investors who prefer to qualify on rental income rather than personal income, Cliffco's DSCR program may be a better fit." },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
    authorSlug: "christopher-clifford",
  }),
];
import ContactForm from "../../../components/forms/ContactForm.astro";
---

<Layout title={`Conventional Loans | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <section class="container-wide pt-12 pb-5">
    <p class="eyebrow">{p.category}</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">{p.name}</h1>
    <p class="lead mt-6">{p.oneLiner}</p>
  </section>

  <section class="bg-white pb-12">
    <div class="container-wide">
      <p class="lead">{p.directAnswer}</p>
    </div>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Conventional at a glance</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Flexible terms. PMI you can shed.</h2>
      </div>
      <dl class="space-y-3">
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Min down payment</dt><dd class="text-[var(--color-text-muted)]">3% (first-time), 5% (repeat buyers)</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Min FICO</dt><dd class="text-[var(--color-text-muted)]">620 (best pricing 740+)</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>2026 conforming limit</dt><dd class="text-[var(--color-text-muted)]">$806,500 (standard); up to $1,209,750 (high-cost)</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>PMI required</dt><dd class="text-[var(--color-text-muted)]">Under 20% down; removable at 80% LTV</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Terms</dt><dd class="text-[var(--color-text-muted)]">10, 15, 20, 25, 30-year fixed; 5/1, 7/1, 10/1 ARM</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Property types</dt><dd class="text-[var(--color-text-muted)]">Primary, second home, investment (1–4 units)</dd></div>
      </dl>
    </div>
  </section>

  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <h2 class="mt-3" style="font-size: var(--text-h2);">Conventional loan questions.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <div class="rounded-lg border border-[var(--color-mist-gray)] p-6 flex flex-col sm:flex-row gap-6 items-start sm:items-center justify-between">
        <div>
          <p class="font-semibold text-[var(--color-ink)]">Need help with the down payment?</p>
          <p class="text-sm text-[var(--color-text-muted)] mt-1">Down payment assistance programs can cover your 3–5% down payment. Ask your loan officer what's currently available in your county.</p>
        </div>
        <a href="/down-payment-assistance/" class="btn btn-secondary text-sm shrink-0">Explore DPA options →</a>
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Get pre-qualified this week.</h2>
      <p class="lead mt-4 text-white/85">A licensed Cliffco loan officer responds in one business day.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a pre-qual</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <h2 class="mt-3" style="font-size: var(--text-h2);">Want to compare your conventional loan options?</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">Tell us your situation and we'll show you which programs apply and what each costs.</p>
      <div class="mt-8">
        <ContactForm
          formTo="websiteleads@cliffcomortgage.com,cliffcorpteam@cliffcomortgage.com"
          formSource="loan-conventional"
        />
      </div>
    </div>
  </section>
</Layout>
