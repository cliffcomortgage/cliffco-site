---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("reverse-mortgage")!;
const HECM_LIMIT_2026 = "$1,249,125";

const faq = [
  { question: "What is a reverse mortgage?", answer: "A reverse mortgage is a federally-insured home loan available to homeowners 62 and older that converts a portion of home equity into cash, a line of credit, or monthly income, with no required monthly mortgage payment as long as the home remains the primary residence and property taxes, homeowners insurance, and any HOA dues are kept current." },
  { question: "Who qualifies for a HECM reverse mortgage in 2026?", answer: "Eligibility requires at least one borrower age 62 or older, ownership of the home as a primary residence (with sufficient equity), the financial means to keep up with property charges (taxes, insurance, HOA), and completion of HUD-approved reverse mortgage counseling before signing the application." },
  { question: "Can the bank take my home with a reverse mortgage?", answer: "No. The borrower retains the title to the home for the life of the loan. As long as loan obligations are met (occupancy, taxes, insurance, maintenance), the borrower cannot be forced out. The HECM is a non-recourse loan: when the loan ends (typically when the home is sold or the borrower no longer occupies it), neither the borrower nor heirs are responsible for more than the home's appraised value, with FHA insurance covering any shortfall." },
  { question: "What is the 2026 HECM lending limit?", answer: `For 2026, the FHA HECM maximum claim amount is ${HECM_LIMIT_2026}. Homes valued above that amount may qualify for proprietary (jumbo) reverse mortgage products that Cliffco also offers.` },
  { question: "Is HUD counseling required, and how long does it take?", answer: "Yes. Every HECM applicant must complete an independent counseling session with a HUD-approved housing counseling agency before signing the loan application. Sessions typically take 60-90 minutes and can be done by phone or in person. Counseling fees are typically $125-$200 and may be financed into the loan." },
  { question: "What happens to my heirs?", answer: "When the loan becomes due (typically at the borrower's passing or permanent move-out), heirs have several options: pay off the balance and keep the home, sell the home and keep any equity above the loan balance, or sign the home over to the lender via deed-in-lieu. Because HECM is non-recourse, heirs never owe more than the home's value." },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];
import TermSheetHero from "../../../components/asym/TermSheetHero.astro";
import TermSheet from "../../../components/asym/TermSheet.astro";
import Chapter from "../../../components/asym/Chapter.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const payouts = [
  { name: "Lump sum", body: "A single one-time disbursement at closing. Often used to pay off an existing mortgage or make a major purchase." },
  { name: "Line of credit (with growth feature)", body: "Draw as needed. The unused portion of the line grows over time at the same rate the loan would accrue, a unique HECM feature financial planners often pair with retirement strategies." },
  { name: "Tenure or term payments", body: "Monthly disbursements for life (tenure) or for a fixed period (term). Useful for supplementing fixed income." },
];
---

<Layout title={`${p.name} (HECM) | Cliffco`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <TermSheetHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Eligible age", value: "62 and older" },
      { label: "2026 HECM limit", value: HECM_LIMIT_2026 },
      { label: "Programs", value: "HECM & proprietary jumbo" },
    ]}
  >
    {p.name} (HECM and proprietary)
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Schedule a family consultation</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </TermSheetHero>

  <TermSheet>
    <FormCard slot="form" title="Want to see if a reverse mortgage makes sense for your situation?" sub="Tell us about your home and your goals and we'll be direct about whether it's the right move." formSource="loan-reverse" />

    <Chapter eyebrow="Programs" title="HECM and proprietary jumbo reverse.">
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <div class="mt-8 grid gap-4">
          <article class="rounded-2xl p-6 bg-[var(--color-ink)] text-white">
            <h3 class="text-lg font-semibold !text-white">HECM (Home Equity Conversion Mortgage)</h3>
            <p class="mt-3 text-sm text-white/85 leading-relaxed">FHA-insured. Available nationwide for owner-occupied 1-4 unit properties (with primary occupancy). 2026 maximum claim amount: <strong class="text-white">{HECM_LIMIT_2026}</strong>.</p>
          </article>
          <article class="rounded-2xl p-6 border-2 border-[var(--color-ink)]">
            <h3 class="text-lg font-semibold text-[var(--color-ink)]">Proprietary jumbo reverse</h3>
            <p class="mt-3 text-sm text-[var(--color-text)] leading-relaxed">For higher-value homes above the FHA HECM limit. Underwriting and loan amounts vary by program; Cliffco can compare proprietary options to a standard HECM.</p>
          </article>
        </div>
      </Chapter>

  <!-- PAYOUT OPTIONS -->
  <Chapter eyebrow="Three ways to receive your money" title="Pick the structure that fits your plan.">
    <ol class="list-none m-0 p-0 border-t border-[var(--color-ink)]">
      {payouts.map((o, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-7 border-b border-black/15">
          <span class="font-mono text-sm text-[var(--color-text-muted)] pt-1">0{i + 1}</span>
          <div>
            <h3 class="text-lg font-semibold text-[var(--color-ink)]">{o.name}</h3>
            <p class="mt-2 text-[var(--color-text)] leading-relaxed">{o.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </Chapter>

  <!-- COUNSELING (black band) -->
  <Chapter dark eyebrow="Counseling is required (typically low-cost or covered entirely)" title="Independent HUD-approved counseling, before any application.">
    <p class="text-white/85 leading-relaxed" style="font-size: 1.125rem;">
      Federal law requires every HECM borrower to complete a counseling session with an
      independent <a href="https://www.hudexchange.info/programs/housing-counseling/" rel="noopener" class="!text-white underline">HUD-approved housing counseling agency</a>
      before signing a reverse mortgage application. Sessions take roughly 60-90 minutes, are
      available by phone or in person, and cost $125-$200 (often financeable into the loan).
      Cliffco can recommend approved agencies, but the counselor must be independent of the
      lender. That's the law, and we like it that way.
    </p>
  </Chapter>

  <!-- FAQ -->
  <Chapter rule={false} eyebrow="FAQ" title="Common reverse mortgage questions.">
    <FaqList items={faq} />
  </Chapter>
  </TermSheet>


  <CtaBand title="Bring the kids on the call." text="A reverse mortgage decision is a family decision. Cliffco welcomes adult children on the consultation.">
    <a href="#contact" class="btn btn-primary">Schedule a family consultation</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
