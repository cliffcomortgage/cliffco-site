---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";
import ContactForm from "../../../components/forms/ContactForm.astro";

const p = product("reverse-mortgage")!;
const today = new Date().toISOString().slice(0, 10);
const HECM_LIMIT_2026 = "$1,249,125";

const faq = [
  { question: "What is a reverse mortgage?", answer: "A reverse mortgage is a federally-insured home loan available to homeowners 62 and older that converts a portion of home equity into cash, a line of credit, or monthly income, with no required monthly mortgage payment as long as the home remains the primary residence and property taxes, homeowners insurance, and any HOA dues are kept current." },
  { question: "Who qualifies for a HECM reverse mortgage in 2026?", answer: "Eligibility requires at least one borrower age 62 or older, ownership of the home as a primary residence (with sufficient equity), the financial means to keep up with property charges (taxes, insurance, HOA), and completion of HUD-approved reverse mortgage counseling before signing the application." },
  { question: "Can the bank take my home with a reverse mortgage?", answer: "No. The borrower retains the title to the home for the life of the loan. As long as loan obligations are met (occupancy, taxes, insurance, maintenance), the borrower cannot be forced out. The HECM is a non-recourse loan: when the loan ends (typically when the home is sold or the borrower no longer occupies it), neither the borrower nor heirs are responsible for more than the home's appraised value, with FHA insurance covering any shortfall." },
  { question: "What is the 2026 HECM lending limit?", answer: `For 2026, the FHA HECM maximum claim amount is ${HECM_LIMIT_2026}. Homes valued above that amount may qualify for proprietary (jumbo) reverse mortgage products that Cliffco also offers.` },
  { question: "Is HUD counseling required, and how long does it take?", answer: "Yes. Every HECM applicant must complete an independent counseling session with a HUD-approved housing counseling agency before signing the loan application. Sessions typically take 60-90 minutes and can be done by phone or in person. Counseling fees are typically $125-$200 and may be financed into the loan." },
  { question: "What happens to my heirs?", answer: "When the loan becomes due (typically at the borrower's passing or permanent move-out), heirs have several options: pay off the balance and keep the home, sell the home and keep any equity above the loan balance, or sign the home over to the lender via deed-in-lieu. Because HECM is non-recourse, heirs never owe more than the home's value." },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: today,
    authorSlug: "christopher-clifford",
  }),
];
---

<Layout title={`${p.name} (HECM) | Cliffco`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <section class="container-wide pt-12 pb-5">
    <p class="eyebrow">{p.category}</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">{p.name} (HECM and proprietary)</h1>
    <p class="lead mt-6">{p.oneLiner}</p>
  </section>

  <section class="bg-white pb-12">
    <div class="container-wide">
      <p class="lead">{p.directAnswer}</p>
</div>
    </div>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide">
      <p class="eyebrow">Programs</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">HECM and proprietary jumbo reverse.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <article class="card">
          <h3 class="text-lg font-semibold">HECM (Home Equity Conversion Mortgage)</h3>
          <p class="mt-3 text-sm">FHA-insured. Available nationwide for owner-occupied 1-4 unit properties (with primary occupancy). 2026 maximum claim amount: <strong>{HECM_LIMIT_2026}</strong>.</p>
        </article>
        <article class="card">
          <h3 class="text-lg font-semibold">Proprietary jumbo reverse</h3>
          <p class="mt-3 text-sm">For higher-value homes above the FHA HECM limit. Underwriting and loan amounts vary by program; Cliffco can compare proprietary options to a standard HECM.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Three ways to receive your money</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Pick the structure that fits your plan.</h2>
      </div>
      <div class="space-y-4">
        <div class="card"><h3 class="text-base font-semibold">Lump sum</h3><p class="mt-2 text-sm text-[var(--color-text-muted)]">A single one-time disbursement at closing. Often used to pay off an existing mortgage or make a major purchase.</p></div>
        <div class="card"><h3 class="text-base font-semibold">Line of credit (with growth feature)</h3><p class="mt-2 text-sm text-[var(--color-text-muted)]">Draw as needed. The unused portion of the line grows over time at the same rate the loan would accrue "" a unique HECM feature financial planners often pair with retirement strategies.</p></div>
        <div class="card"><h3 class="text-base font-semibold">Tenure or term payments</h3><p class="mt-2 text-sm text-[var(--color-text-muted)]">Monthly disbursements for life (tenure) or for a fixed period (term). Useful for supplementing fixed income.</p></div>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <p class="eyebrow">Counseling is required (typically low-cost or covered entirely)</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Independent HUD-approved counseling, before any application.</h2>
      <p class="mt-4">
        Federal law requires every HECM borrower to complete a counseling session with an
        independent <a href="https://www.hudexchange.info/programs/housing-counseling/" rel="noopener">HUD-approved housing counseling agency</a>
        before signing a reverse mortgage application. Sessions take roughly 60-90 minutes, are
        available by phone or in person, and cost $125-$200 (often financeable into the loan).
        Cliffco can recommend approved agencies, but the counselor must be independent of the
        lender. That's the law, and we like it that way.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <h2 class="mt-3" style="font-size: var(--text-h2);">Common reverse mortgage questions.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Bring the kids on the call.</h2>
      <p class="lead mt-4 text-white/85">A reverse mortgage decision is a family decision. Cliffco welcomes adult children on the consultation.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Schedule a family consultation</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <h2 class="mt-3" style="font-size: var(--text-h2);">Want to see if a reverse mortgage makes sense for your situation?</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">No credit pull. Tell us about your home and your goals and we'll be direct about whether it's the right move.</p>
      <div class="mt-8">
        <ContactForm
          formTo="websiteleads@cliffcomortgage.com,cliffcorpteam@cliffcomortgage.com"
          formSource="loan-reverse"
        />
      </div>
    </div>
  </section>
</Layout>
