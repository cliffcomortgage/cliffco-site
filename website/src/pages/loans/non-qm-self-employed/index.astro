---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { loanOfficer, nmlsConsumerAccessUrl } from "../../../data/loan-officers";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("non-qm-self-employed")!;
const reviewer = loanOfficer("christopher-clifford-65234")!;
const yearsInBiz = COMPANY.yearsInBusiness();
const today = new Date().toISOString().slice(0, 10);

const faq = [
  {
    question: "What is a non-QM mortgage?",
    answer:
      "A non-QM (non-Qualified Mortgage) is a home loan that doesn't fall under the CFPB's standard QM rules, typically because it qualifies the borrower using something other than W-2s and tax returns. Common non-QM programs include bank statement loans, P&L only loans, 1099 only loans, asset utilization loans, ITIN mortgages, and foreign national mortgages. Non-QM loans are full-doc loans: they use different documentation than conventional, not less.",
  },
  {
    question: "Can I get a mortgage if I'm self-employed for less than 2 years?",
    answer:
      "Yes. Cliffco offers non-QM programs that accept borrowers who have been self-employed for as little as 12 months, evidenced by 12 months of business or personal bank statements (or a CPA-prepared P&L). Conventional Fannie Mae / Freddie Mac loans typically require two years of self-employment history; non-QM bank statement loans do not.",
  },
  {
    question: "Is a non-QM loan the same as a stated-income loan?",
    answer:
      "No. Pre-2008 stated-income loans let borrowers state any income figure with no documentation. Today's non-QM loans are full-doc: Cliffco verifies income through bank statements, P&L statements, 1099s, asset balances, or other supporting documents. The CFPB's Ability-to-Repay rule still applies; non-QM loans simply use alternative documentation rather than skipping documentation.",
  },
  {
    question: "What rates do non-QM mortgages have?",
    answer:
      "Non-QM rates typically run 1—2 percentage points above conventional, depending on the program, FICO score, down payment, and documentation type. As of mid-2026, Cliffco's bank-statement non-QM rates generally range from 6.75%—9.0%, with stronger borrower files (740+ FICO, 25%+ down) pricing toward the lower end.",
  },
  {
    question: "How much down payment do I need for a non-QM loan?",
    answer:
      "Most Cliffco non-QM programs require 10%—25% down. Bank statement loans for purchases commonly start at 10% down with 680+ FICO; investor-purpose programs and lower FICO files require 20%—25%. Cash-out refinances typically allow up to 80%—85% LTV.",
  },
  {
    question: "Can I qualify for a non-QM loan with an ITIN instead of an SSN?",
    answer:
      "Yes. Cliffco offers ITIN mortgages for borrowers without a Social Security Number. Documentation requirements are similar to a standard non-QM file (bank statements or 1099s evidencing income), with proof of ITIN and identity. ITIN borrowers can buy primary residences, second homes, or investment properties.",
  },
];

const schema = [
  mortgageLoanSchema(p, { rateRange: { min: 6.75, max: 9.0 } }),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: today,
    dateModified: today,
    authorSlug: reviewer.slug,
  }),
];
---

<Layout
  title={`${p.name} | Cliffco`}
  description={p.directAnswer}
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <!-- HERO -->
  <section class="container-wide pt-12 pb-12">
    <p class="eyebrow">{p.category}</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">{p.name}</h1>
    <p class="lead mt-6">{p.oneLiner}</p>
  </section>

  <!-- DIRECT ANSWER (inverted pyramid) -->
  <section class="bg-white pb-12">
    <div class="container-prose">
      <div class="direct-answer">{p.directAnswer}</div>

      <div class="reviewed-by mt-6">
        <div><strong>Last reviewed:</strong> {today}</div>
        <div>
          <strong>Reviewed by:</strong> {reviewer.displayName}, {reviewer.title} ·
          NMLS #{reviewer.nmls} ·
          <a href={nmlsConsumerAccessUrl(reviewer.nmls)} rel="noopener">Verify ↗</a>
        </div>
        <div><a href="/about/editorial-process/" class="text-sm">How Cliffco creates and reviews content →</a></div>
      </div>
    </div>
  </section>

  <!-- WHO QUALIFIES -->
  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow">Who qualifies</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">If a bank pre-declined you, start here.</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="card">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">Self-employed (1+ year)</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">12 or 24 months of business or personal bank statements; we calculate qualifying income from deposits net of expense factors.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">1099 contractors / freelancers</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">1099 income tied to one or more clients; we qualify from the 1099s themselves, not the personal tax return.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">Small business owners (S-corp / LLC)</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">P&L only programs let business owners qualify based on a CPA-prepared profit-and-loss statement, ideal when tax returns reflect heavy reinvestment or depreciation.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">High-net-worth borrowers</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Asset utilization and asset depletion programs qualify borrowers using verified liquid assets "" useful for retirees, investors with low W-2 income, or borrowers between businesses.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">ITIN borrowers</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Cliffco lends to borrowers with an ITIN in lieu of an SSN. Primary, second-home, and investment-property purchases all eligible.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">Foreign nationals</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Non-resident foreign nationals can purchase US real estate using foreign-bank reference letters and assets, with no US credit history required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAM TYPES -->
  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">Programs</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Six non-QM programs Cliffco originates.</h2>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <article class="card">
          <h3 class="text-lg font-semibold">12 / 24-month bank statement loan</h3>
          <p class="mt-3 text-sm">For self-employed borrowers; income is calculated from gross deposits less an industry expense factor or a CPA letter. 12-month is available for established businesses; 24-month allows lower rates.</p>
        </article>
        <article class="card">
          <h3 class="text-lg font-semibold">P&L only</h3>
          <p class="mt-3 text-sm">Income comes from a CPA / tax-preparer-prepared profit-and-loss statement covering the most recent 12—24 months. Best for owners whose tax-return income is depressed by depreciation or reinvestment.</p>
        </article>
        <article class="card">
          <h3 class="text-lg font-semibold">1099 only</h3>
          <p class="mt-3 text-sm">For independent contractors paid via 1099. Qualifying income is the 1099 totals net of an expense factor "" no tax returns required.</p>
        </article>
        <article class="card">
          <h3 class="text-lg font-semibold">Asset utilization / asset depletion</h3>
          <p class="mt-3 text-sm">Qualifying income is derived from verified liquid assets (checking, savings, brokerage, IRA) divided over a program period. Strong fit for retirees and pre-retirees with substantial savings but low recurring W-2 income.</p>
        </article>
        <article class="card">
          <h3 class="text-lg font-semibold">ITIN mortgage</h3>
          <p class="mt-3 text-sm">Mortgages for borrowers without an SSN, using an Individual Taxpayer Identification Number. Documentation parallels other non-QM programs "" bank statements or 1099s "" plus ITIN and identity verification.</p>
        </article>
        <article class="card">
          <h3 class="text-lg font-semibold">Foreign national</h3>
          <p class="mt-3 text-sm">For non-US-resident foreign nationals purchasing US real estate. Uses foreign-bank reference letters, foreign income documentation, and asset verification "" no US credit history required.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- HOW WE CALCULATE -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-prose">
      <p class="eyebrow">How we calculate it</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">A worked bank-statement income example.</h2>
      <p class="mt-6">
        Suppose you're a 1099 contractor with average monthly business deposits of $42,000 over
        the last 12 months. Cliffco's typical bank-statement income calculation works like this:
      </p>
      <ul class="mt-4">
        <li><strong>$42,000</strong> (average monthly deposits)</li>
        <li><strong>× 50%</strong> (standard expense factor, varies 30%—60% by industry; CPA letter can override)</li>
        <li>= <strong>$21,000 / month qualifying income</strong></li>
      </ul>
      <p class="mt-4">
        That $21K/mo qualifies you for the same loan amount a W-2 borrower with a $252K salary
        would qualify for, even if your tax return shows $90K of net income after legitimate
        business deductions.
      </p>
      <p class="text-sm text-[var(--color-text-muted)] mt-4">
        <em>This is a worked example for illustration only. Actual approval is subject to
        Cliffco's underwriting and the documentation Cliffco requests.</em>
      </p>
    </div>
  </section>

  <!-- RATES & TERMS -->
  <section class="section bg-white">
    <div class="container-wide grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Rates & terms (illustrative, current 2026)</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">What to expect.</h2>
        <p class="mt-4 text-[var(--color-text-muted)]">
          Final pricing depends on program, FICO, LTV, occupancy, and documentation type.
          Rate ranges below are illustrative.
        </p>
      </div>
      <dl class="space-y-4">
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2">
          <dt class="font-medium">Bank statement loan</dt><dd class="text-[var(--color-text-muted)]">6.75%—9.00%</dd>
        </div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2">
          <dt class="font-medium">P&L only</dt><dd class="text-[var(--color-text-muted)]">7.00%—9.25%</dd>
        </div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2">
          <dt class="font-medium">1099 only</dt><dd class="text-[var(--color-text-muted)]">6.75%—9.00%</dd>
        </div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2">
          <dt class="font-medium">Asset utilization</dt><dd class="text-[var(--color-text-muted)]">6.50%—8.75%</dd>
        </div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2">
          <dt class="font-medium">ITIN</dt><dd class="text-[var(--color-text-muted)]">7.50%—9.50%</dd>
        </div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2">
          <dt class="font-medium">Foreign national</dt><dd class="text-[var(--color-text-muted)]">7.75%—9.75%</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- FAQ (FAQPage schema attached above) -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-prose">
      <p class="eyebrow">Frequently asked</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Borrower questions, answered.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">
              {q.question}
            </summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Tell us your situation. We'll tell you what we can do.</h2>
      <p class="lead mt-4 text-white/85">A licensed Cliffco loan officer responds in one business day.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Start a pre-qual</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>
</Layout>
