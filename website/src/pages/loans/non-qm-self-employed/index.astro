---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("non-qm-self-employed")!;
const yearsInBiz = COMPANY.yearsInBusiness();

const faq = [
  {
    question: "What is a Non-QM mortgage?",
    answer:
      "A Non-QM (non-Qualified Mortgage) is a home loan that doesn't fall under the CFPB's standard QM rules, typically because it qualifies the borrower using something other than W-2s and tax returns. Common Non-QM programs include bank statement loans, P&L only loans, 1099 only loans, asset utilization loans, ITIN mortgages, and foreign national mortgages. Non-QM loans are full-doc loans: they use different documentation than conventional, not less.",
  },
  {
    question: "Can I get a mortgage if I'm self-employed for less than 2 years?",
    answer:
      "Most Non-QM bank statement programs require 2 years of self-employment history. If you recently transitioned from W-2 employment to self-employment in the same field, some programs may accept as little as 12 months of documented history. Conventional Fannie Mae / Freddie Mac loans also require two years; Non-QM gives you more flexibility, but a full history strengthens your file.",
  },
  {
    question: "Is a Non-QM loan the same as a stated-income loan?",
    answer:
      "No. Pre-2008 stated-income loans let borrowers state any income figure with no documentation. Today's Non-QM loans are full-doc: Cliffco verifies income through bank statements, P&L statements, 1099s, asset balances, or other supporting documents. The CFPB's Ability-to-Repay rule still applies; Non-QM loans simply use alternative documentation rather than skipping documentation.",
  },
  {
    question: "What rates do Non-QM mortgages have?",
    answer:
      "Non-QM rates typically run 1-2 percentage points above conventional, depending on the program, FICO score, down payment, and documentation type. As of mid-2026, Cliffco's bank-statement Non-QM rates generally range from 6.75%-9.0%, with stronger borrower files (740+ FICO, 25%+ down) pricing toward the lower end.",
  },
  {
    question: "How much down payment do I need for a Non-QM loan?",
    answer:
      "Most Cliffco Non-QM programs require 10%-25% down. Bank statement loans for purchases commonly start at 10% down with 680+ FICO; investor-purpose programs and lower FICO files require 20%-25%. Cash-out refinances typically allow up to 75%-80% LTV, depending on FICO and loan amount.",
  },
  {
    question: "Can I qualify for a Non-QM loan with an ITIN instead of an SSN?",
    answer:
      "Yes. Cliffco offers ITIN mortgages for borrowers without a Social Security Number. Documentation requirements are similar to a standard Non-QM file (bank statements or 1099s evidencing income), with proof of ITIN and identity. ITIN borrowers can buy primary residences, second homes, or investment properties.",
  },
];

const schema = [
  mortgageLoanSchema(p, { rateRange: { min: 6.75, max: 9.0 } }),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];
import AsymHero from "../../../components/asym/AsymHero.astro";
import Split from "../../../components/asym/Split.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const whoQualifies = [
  { title: "Self-employed (2+ years)", body: "Most programs require 2 years of self-employment history. Qualifying income is calculated from 12 or 24 months of business or personal bank deposits, net of expense factors. In certain scenarios, 1 year may be accepted." },
  { title: "1099 contractors / freelancers", body: "1099 income tied to one or more clients; we qualify from the 1099s themselves, not the personal tax return." },
  { title: "Small business owners (S-corp / LLC)", body: "P&L only programs let business owners qualify based on a CPA-prepared profit-and-loss statement, ideal when tax returns reflect heavy reinvestment or depreciation." },
  { title: "Borrowers with assets", body: "Asset utilization programs qualify borrowers using verified liquid assets: checking, savings, brokerage, IRA. Works as sole income or to supplement existing earnings. You don't need to be retired or wealthy to use it: if you have documented assets, they can count." },
  { title: "ITIN borrowers", body: "Cliffco lends to borrowers with an ITIN in lieu of an SSN. Primary, second-home, and investment-property purchases all eligible." },
  { title: "Foreign nationals", body: "Non-resident foreign nationals can purchase US real estate using foreign-bank reference letters and assets, with no US credit history required." },
];
const programs = [
  { name: "12 / 24-month bank statement loan", body: "For self-employed borrowers; income is calculated from gross deposits less an industry expense factor or a CPA letter. 12-month is available for established businesses; 24-month allows lower rates." },
  { name: "P&L only", body: "Income comes from a CPA / tax-preparer-prepared profit-and-loss statement covering the most recent 12-24 months. Best for owners whose tax-return income is depressed by depreciation or reinvestment." },
  { name: "1099 only", href: "/loans/1099-mortgage/", body: "For independent contractors paid via 1099. Qualifying income is the 1099 totals net of an expense factor; only 1099 transcripts required." },
  { name: "Asset utilization / asset depletion", href: "/loans/asset-utilization-mortgage/", body: "Qualifying income is derived from verified liquid assets (checking, savings, brokerage, IRA) divided over a program period. Can stand alone as sole income or be layered on top of any other documented income, useful for retirees, borrowers with income gaps, and anyone whose assets can strengthen their qualifying file." },
  { name: "ITIN mortgage", href: "/loans/itin-mortgage/", body: "Mortgages for borrowers without an SSN, using an Individual Taxpayer Identification Number. Documentation parallels other Non-QM programs (bank statements or 1099s), plus ITIN and identity verification." },
  { name: "Foreign national", href: "/loans/foreign-national-mortgage/", body: "For non-US-resident foreign nationals purchasing US real estate. Uses foreign-bank reference letters, foreign income documentation, and asset verification; no US credit history required." },
  { name: "VOE (Verification of Employment)", body: "For W-2 employees who can document their employment and income through a written or verbal employer verification rather than pay stubs or tax returns. Strong fit for borrowers who are recently hired, have complex pay structures, or can't easily obtain standard income documentation." },
];
const rates = [
  ["Bank statement loan", "6.75%-9.00%"],
  ["P&L only", "7.00%-9.25%"],
  ["1099 only", "6.75%-9.00%"],
  ["Asset utilization", "6.50%-8.75%"],
  ["ITIN", "7.50%-9.50%"],
  ["Foreign national", "7.75%-9.75%"],
  ["VOE", "6.75%-8.75%"],
];
---

<Layout
  title={`${p.name} | Cliffco`}
  description={p.directAnswer}
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <AsymHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Qualify with", value: "Bank statements, 1099s, P&L, or assets" },
      { label: "Programs", value: "Seven Non-QM options" },
      { label: "Tax returns", value: "Not required" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Start a pre-qual</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </AsymHero>

  <!-- LEAD FORM + RATES & TERMS -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <FormCard title="Find the Non-QM program that fits how you earn." sub="Tell us how you document income and we'll match you to the right program." formSource="loan-non-qm" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-8">
        <p class="eyebrow">Rates & terms</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">What to expect.</h2>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <p class="mt-4 text-[var(--color-text-muted)]">Final pricing depends on program, FICO, LTV, occupancy, and documentation type.</p>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {rates.map(([k, v]) => (
            <div class="flex justify-between gap-6 py-3.5 border-b border-black/15">
              <dt class="font-medium text-[var(--color-ink)]">{k}</dt>
              <dd class="font-mono text-sm text-[var(--color-text)]">{v}</dd>
            </div>
          ))}
        </dl>
        <p class="text-xs text-[var(--color-text-muted)] mt-4 leading-relaxed">The chart above is for illustrative purposes only. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice.</p>
      </div>
    </div>
  </section>

  <!-- WHO QUALIFIES -->
  <Split eyebrow="Who qualifies" title="If a bank pre-declined you, start here." wide>
    <ol class="list-none m-0 p-0 grid sm:grid-cols-2 gap-4">
      {whoQualifies.map((w, i) => (
        <li class="rounded-2xl border-2 border-[var(--color-ink)] p-6">
          <span class="font-mono text-xs text-[var(--color-text-muted)]">0{i + 1}</span>
          <h3 class="mt-3 text-lg font-semibold text-[var(--color-ink)]">{w.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{w.body}</p>
        </li>
      ))}
    </ol>
  </Split>

  <!-- PROGRAM TYPES -->
  <Split eyebrow="Programs" title="Seven Non-QM programs Cliffco originates.">
    <ol class="list-none m-0 p-0 border-t border-[var(--color-ink)]">
      {programs.map((prog, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-7 border-b border-black/15">
          <span class="font-mono text-sm text-[var(--color-text-muted)] pt-1">0{i + 1}</span>
          <div>
            <h3 class="text-lg font-semibold text-[var(--color-ink)]">{prog.name}</h3>
            <p class="mt-2 text-[var(--color-text)] leading-relaxed">{prog.body}</p>
            {prog.href && <a href={prog.href} class="mt-3 inline-block text-sm font-semibold text-[var(--color-ink)]">Learn more →</a>}
          </div>
        </li>
      ))}
    </ol>
  </Split>

  <!-- WORKED EXAMPLE (black band) -->
  <Split dark eyebrow="How we calculate it" title="A worked bank-statement income example.">
    <div class="space-y-4 text-white/85 leading-relaxed" style="font-size: 1.0625rem;">
      <p>
        Suppose you're a 1099 contractor with average monthly business deposits of $42,000 over
        the last 12 months. Cliffco's typical bank-statement income calculation works like this:
      </p>
      <ul class="list-none m-0 p-0 border-t border-white/40 font-mono text-[0.9375rem]">
        <li class="py-3.5 border-b border-white/15 text-white"><strong>$42,000</strong> (average monthly deposits)</li>
        <li class="py-3.5 border-b border-white/15 text-white"><strong>× 50%</strong> (standard expense factor; varies by business type and employee count; CPA letter can override)</li>
        <li class="py-3.5 border-b border-white/15 text-white">= <strong>$21,000 / month qualifying income</strong></li>
      </ul>
      <p>
        That $21K/mo qualifies you for the same loan amount a W-2 borrower with a $252K salary
        would qualify for, even if your tax return shows $90K of net income after legitimate
        business deductions.
      </p>
      <p class="text-sm text-white/55">
        <em>This is a worked example for illustration only. Actual approval is subject to
        Cliffco's underwriting and the documentation Cliffco requests.</em>
      </p>
    </div>
  </Split>

  <!-- FAQ -->
  <Split rule={false} eyebrow="FAQ" title="Questions about Non-QM lending.">
    <FaqList items={faq} />
  </Split>

  <CtaBand title="Tell us your situation. We'll tell you what we can do." text="A licensed Cliffco loan officer responds in one business day.">
    <a href="#contact" class="btn btn-primary">Start a pre-qual</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
