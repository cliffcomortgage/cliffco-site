---
import { STATE_LICENSES } from "../../../data/state-licenses";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("dscr")!;

const faq = [
  { question: "What is a DSCR loan?", answer: "A DSCR (Debt-Service Coverage Ratio) loan is a mortgage for real estate investors that qualifies the borrower based on the rental income of the subject property, not the borrower's personal income. The qualifying ratio is monthly rent divided by monthly principal-and-interest, taxes, insurance, and HOA (PITIA). Most DSCR programs accept ratios from 0.75 (with strong reserves) up to 1.25+ for best pricing." },
  { question: "How is DSCR calculated?", answer: "DSCR = Gross Monthly Rent ÷ Monthly PITIA. For a $2,500/mo rental with $2,000/mo PITIA, the DSCR is 1.25. Cliffco can use long-term lease income or short-term-rental projections (AirDNA-supported for STR markets like Orlando)." },
  { question: "Are Airbnb / short-term rentals eligible?", answer: "Yes. Cliffco's DSCR program accepts short-term-rental income for properties in markets where STR is allowed (e.g., Disney-area Polk County, FL). For new STR purchases without operating history, we use market projections from sources like AirDNA. For existing STRs, we use trailing 12-month operating statements." },
  { question: "Can I close in an LLC?", answer: "Yes. Cliffco's DSCR loans allow vesting in an LLC (or in a personal name), a common preference among investors building portfolios. We provide the documentation requirements at the application stage." },
  { question: "What's the minimum DSCR ratio?", answer: "Cliffco offers programs that go as low as 0.75 DSCR with compensating factors (higher down payment, stronger reserves, experienced investor profile). The most competitive pricing is at 1.25+ DSCR." },
  { question: "Can I get a DSCR loan from out of state?", answer: "Yes. A large share of Cliffco's DSCR borrowers live out of state, particularly New Yorkers and New Jerseyans buying Florida or Arizona investment properties. Cliffco is licensed in " + STATE_LICENSES.length + " states; we can lend in any of them on the property and any of them on the borrower's residence." },
];

const schema = [
  mortgageLoanSchema(p, { rateRange: { min: 7.0, max: 9.5 } }),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];
import AsymHero from "../../../components/asym/AsymHero.astro";
import Split from "../../../components/asym/Split.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const fits = [
  { href: "/locations/florida/", title: "Disney-area STR (Orlando metro)", body: "Polk County (Reunion, ChampionsGate, Davenport) and parts of Osceola allow short-term rentals. Cliffco's Florida team handles DSCR + STR projections daily." },
  { href: "/locations/new-york/long-island/", title: "Long Island long-term rentals", body: "Suffolk + Nassau small-multi and SFR rentals; Cliffco's home market." },
  { href: "/locations/arizona/", title: "Phoenix metro investor SFR", body: "Investor-friendly state, no income tax, deep SFR rental market." },
  { href: "/locations/new-jersey/", title: "North Jersey small-multi", body: "Bergen, Hudson, Essex 2-4 unit cash-flowers refinanced from local banks to DSCR for portfolio scaling." },
  { href: "/locations/florida/", title: "Florida statewide rental + STR", body: "Tampa, Jacksonville, Miami-Dade, Naples, Panhandle." },
  { href: "/locations/minnesota/", title: "Twin Cities rentals", body: "Minneapolis-St. Paul SFR and small-multi, originated from our Excelsior office." },
];
---

<Layout title={`${p.name} for Real Estate Investors | Cliffco`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <AsymHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Qualifies on", value: "Rental income, not personal income" },
      { label: "DSCR ratios accepted", value: "No ratio to 1.25+" },
      { label: "Vesting", value: "LLC or personal name" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get a DSCR pre-qual</a>
      <a href="/mortgage-guides/calculators/dscr/" class="btn btn-secondary">DSCR calculator</a>
    </Fragment>
  </AsymHero>

  <!-- LEAD FORM + QUICK MATH -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <FormCard title="Got a property in mind? Let's run the DSCR." sub="Tell us the address, the projected rent, and the down payment and we'll tell you what we can do." formSource="loan-dscr" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-8">
        <p class="eyebrow">Quick math</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">DSCR is a one-line formula.</h2>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <div class="mt-8 rounded-2xl bg-[var(--color-ink)] text-white p-7 sm:p-8">
          <p class="text-base sm:text-lg font-mono text-white leading-relaxed"><strong>DSCR</strong> = Gross Monthly Rent ÷ Monthly PITIA</p>
          <p class="mt-4 text-white/75 leading-relaxed">
            PITIA = Principal + Interest + Property Taxes + Insurance + HOA dues. For a $2,500/mo
            rental with $2,000/mo PITIA, DSCR = <strong class="text-white">1.25</strong>.
          </p>
          <a href="/mortgage-guides/calculators/dscr/" class="btn btn-primary mt-6 !bg-white !text-[var(--color-ink)] hover:!bg-white/85">Open the DSCR calculator →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHERE WE LEND -->
  <Split eyebrow="Where Cliffco lends DSCR" title="Strong fits." wide>
    <div class="grid sm:grid-cols-2 gap-4">
      {fits.map((f) => (
        <a href={f.href} class="group rounded-2xl border-2 border-[var(--color-ink)] p-6 no-underline text-[var(--color-ink)] hover:bg-[var(--color-ink)] hover:text-white transition-colors">
          <h3 class="text-lg font-semibold group-hover:!text-white">{f.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] group-hover:text-white/75 leading-relaxed">{f.body}</p>
        </a>
      ))}
    </div>
  </Split>

  <!-- FAQ -->
  <Split eyebrow="FAQ" title="What investors ask before their first DSCR deal.">
    <FaqList items={faq} />
  </Split>

  <CtaBand title="Pre-qual in 24 hours. Close in 21-30 days." text="Tell us the address, the projected rent, and the down payment. We'll tell you what we can do.">
    <a href="#contact" class="btn btn-primary">Get a DSCR pre-qual</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
