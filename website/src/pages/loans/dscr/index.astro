---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("dscr")!;
const today = new Date().toISOString().slice(0, 10);

const faq = [
  { question: "What is a DSCR loan?", answer: "A DSCR (Debt-Service Coverage Ratio) loan is a mortgage for real estate investors that qualifies the borrower based on the rental income of the subject property, not the borrower's personal income. The qualifying ratio is monthly rent divided by monthly principal-and-interest, taxes, insurance, and HOA (PITIA). Most DSCR programs accept ratios from 0.75 (with strong reserves) up to 1.25+ for best pricing." },
  { question: "How is DSCR calculated?", answer: "DSCR = Gross Monthly Rent ÷ Monthly PITIA. For a $2,500/mo rental with $2,000/mo PITIA, the DSCR is 1.25. Cliffco can use long-term lease income or short-term-rental projections (AirDNA-supported for STR markets like Orlando)." },
  { question: "Are Airbnb / short-term rentals eligible?", answer: "Yes. Cliffco's DSCR program accepts short-term-rental income for properties in markets where STR is allowed (e.g., Disney-area Polk County, FL). For new STR purchases without operating history, we use market projections from sources like AirDNA. For existing STRs, we use trailing 12-month operating statements." },
  { question: "Can I close in an LLC?", answer: "Yes. Cliffco's DSCR loans allow vesting in an LLC (or in a personal name), a common preference among investors building portfolios. We provide the documentation requirements at the application stage." },
  { question: "What's the minimum DSCR ratio?", answer: "Cliffco offers programs that go as low as 0.75 DSCR with compensating factors (higher down payment, stronger reserves, experienced investor profile). The most competitive pricing is at 1.25+ DSCR." },
  { question: "Can I get a DSCR loan from out of state?", answer: "Yes. A large share of Cliffco's DSCR borrowers live out of state, particularly New Yorkers and New Jerseyans buying Florida or Arizona investment properties. Cliffco is licensed in 32 states; we can lend in any of them on the property and any of them on the borrower's residence." },
];

const schema = [
  mortgageLoanSchema(p, { rateRange: { min: 7.0, max: 9.5 } }),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: today,
    authorSlug: "christopher-clifford",
  }),
];
---

<Layout title={`${p.name} for Real Estate Investors | Cliffco`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <section class="container-wide pt-12 pb-5">
    <p class="eyebrow">{p.category}</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">{p.name}</h1>
    <p class="lead mt-6">{p.oneLiner}</p>
  </section>

  <section class="bg-white pb-12">
    <div class="container-wide">
      <p class="lead">{p.directAnswer}</p>
</div>
    </div>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow">Quick math</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">DSCR is a one-line formula.</h2>
      </div>
      <div class="card">
        <p class="text-2xl font-mono"><strong>DSCR</strong> = Gross Monthly Rent ÷ Monthly PITIA</p>
        <p class="mt-4 text-[var(--color-text-muted)]">
          PITIA = Principal + Interest + Property Taxes + Insurance + HOA dues. For a $2,500/mo
          rental with $2,000/mo PITIA, DSCR = <strong>1.25</strong>.
        </p>
        <a href="/calculators/dscr/" class="btn btn-primary mt-6">Open the DSCR calculator →</a>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">Where Cliffco lends DSCR</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Strong fits.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <a href="/locations/florida/orlando/" class="card no-underline text-[var(--color-ink)]">
          <h3 class="text-lg font-semibold">Disney-area STR (Orlando metro)</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Polk County (Reunion, ChampionsGate, Davenport) and parts of Osceola allow short-term rentals. Cliffco's Orlando branch handles DSCR + STR projections daily.</p>
        </a>
        <a href="/locations/new-york/long-island/" class="card no-underline text-[var(--color-ink)]">
          <h3 class="text-lg font-semibold">Long Island long-term rentals</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Suffolk + Nassau small-multi and SFR rentals; Cliffco's home market.</p>
        </a>
        <a href="/locations/arizona/" class="card no-underline text-[var(--color-ink)]">
          <h3 class="text-lg font-semibold">Phoenix metro investor SFR</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Investor-friendly state, no income tax, deep SFR rental market.</p>
        </a>
        <a href="/locations/new-jersey/" class="card no-underline text-[var(--color-ink)]">
          <h3 class="text-lg font-semibold">North Jersey small-multi</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Bergen, Hudson, Essex 2—4 unit cash-flowers refinanced from local banks to DSCR for portfolio scaling.</p>
        </a>
        <a href="/locations/florida/" class="card no-underline text-[var(--color-ink)]">
          <h3 class="text-lg font-semibold">Florida statewide rental + STR</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Tampa, Jacksonville, Miami-Dade, Naples, Panhandle.</p>
        </a>
        <a href="/locations/minnesota/" class="card no-underline text-[var(--color-ink)]">
          <h3 class="text-lg font-semibold">Twin Cities rentals</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Minneapolis—St. Paul SFR and small-multi, originated from our Excelsior office.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <p class="eyebrow">Frequently asked</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Investor questions, answered.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Pre-qual in 24 hours. Close in 21—30 days.</h2>
      <p class="lead mt-4 text-white/85">Tell us the address, the projected rent, and the down payment. We'll tell you what we can do.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a DSCR pre-qual</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>
</Layout>
