---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { faqPageSchema, articleSchema } from "../../../lib/schema";

const today = new Date().toISOString().slice(0, 10);

const faq = [
  {
    question: "What is the difference between conventional, FHA, VA, and USDA loans?",
    answer: "Conventional loans meet Fannie Mae or Freddie Mac guidelines and are not government-insured - they typically require stronger credit and larger down payments but carry no government-mandated mortgage insurance at 20% down. FHA loans are insured by the Federal Housing Administration and allow lower credit scores and smaller down payments, but require mortgage insurance for the life of the loan. VA loans are guaranteed by the Department of Veterans Affairs for eligible service members and veterans, offering 0% down and no PMI. USDA loans are backed by the Department of Agriculture for eligible rural and suburban properties, also offering 0% down with income restrictions.",
  },
  {
    question: "Which loan program is right for me?",
    answer: "If you're a veteran or active-duty service member, start with VA - it's the most favorable program available. If your property is in an eligible rural or suburban area and you meet income limits, USDA is a strong option. If you have limited savings or a lower credit score, FHA's 3.5% down and flexible guidelines may be the right fit. Conventional is best for buyers with solid credit (620+) who want to avoid long-term mortgage insurance or are buying a second home or investment property.",
  },
  {
    question: "How much down payment do I need?",
    answer: "It depends on the program. Conventional: as little as 3% for first-time buyers, 5% for repeat buyers. FHA: 3.5% with a 580+ credit score, 10% for scores between 500–579. VA: 0% for eligible borrowers with full entitlement. USDA: 0% for eligible properties and borrowers. Keep in mind that putting less than 20% down on a conventional loan requires PMI.",
  },
  {
    question: "Do I need mortgage insurance?",
    answer: "Conventional: PMI is required if your down payment is under 20%, but can be removed once you reach 80% LTV. FHA: requires upfront MIP (1.75%) and annual MIP - typically for the life of the loan if you put less than 10% down. VA: no PMI, though a funding fee applies (waived for veterans with 10%+ disability rating). USDA: no traditional PMI, but a 1% upfront guarantee fee and 0.35% annual fee apply.",
  },
  {
    question: "What credit score do I need?",
    answer: "Conventional: minimum 620 FICO, best pricing at 740+. FHA: 580 for 3.5% down (500–579 with 10% down). VA: no official VA minimum; Cliffco requires 580. USDA: typically 640 for automated approval.",
  },
  {
    question: "Can I use these programs to buy a multi-family property?",
    answer: "Conventional allows 1–4 unit investment properties with higher down payment requirements. FHA allows 1–4 units as long as you occupy one unit as your primary residence. VA allows up to 4 units with owner-occupancy required. USDA is limited to single-family primary residences only.",
  },
];

const schema = [
  faqPageSchema(faq),
  articleSchema({
    headline: "Conventional, FHA, VA & USDA Loans",
    description: "Compare Cliffco's conventional, FHA, VA, and USDA loan programs side by side. Down payments, credit requirements, mortgage insurance, and which program fits your situation.",
    url: "/loans/conventional-government/",
    datePublished: "2026-04-15",
    dateModified: today,
    authorSlug: "christopher-clifford",
  }),
];

const programs = [
  {
    name: "Conventional",
    tag: "Fannie Mae / Freddie Mac",
    href: "/loans/conventional/",
    blurb: "Conforming and high-balance loans for buyers with solid credit. No government backing means less red tape and no lifetime mortgage insurance if you put 20% down.",
    specs: [
      { label: "Min down payment", value: "3% (first-time); 5% (repeat)" },
      { label: "Min FICO", value: "620 (best pricing 740+)" },
      { label: "Mortgage insurance", value: "PMI required under 20% down; removable at 80% LTV" },
      { label: "2026 loan limit", value: "$806,500 standard; up to $1,209,750 high-cost" },
      { label: "Best for", value: "Buyers with strong credit, second homes, investment properties" },
    ],
  },
  {
    name: "FHA",
    tag: "Federal Housing Administration",
    href: "/loans/fha/",
    blurb: "Government-insured loans designed for buyers with lower credit scores or limited savings. Flexible guidelines, but mortgage insurance typically stays for the life of the loan.",
    specs: [
      { label: "Min down payment", value: "3.5% (580+ FICO); 10% (500–579)" },
      { label: "Min FICO", value: "580 for 3.5% down" },
      { label: "Mortgage insurance", value: "1.75% UFMIP + annual MIP (typically life of loan)" },
      { label: "2026 loan limit", value: "$524,225 standard; up to $1,209,750 high-cost" },
      { label: "Best for", value: "First-time buyers, lower credit scores, high DTI" },
    ],
  },
  {
    name: "VA",
    tag: "Department of Veterans Affairs",
    href: "/loans/va/",
    blurb: "Zero-down financing for eligible veterans, active-duty service members, and surviving spouses. No PMI, no loan limit with full entitlement - one of the best mortgage programs available.",
    specs: [
      { label: "Down payment", value: "0% with full entitlement" },
      { label: "Mortgage insurance", value: "None (funding fee applies; waived for 10%+ disability)" },
      { label: "Funding fee", value: "2.15% first use; 3.3% subsequent (0% down)" },
      { label: "Loan limit", value: "No cap with full entitlement (as of 2020)" },
      { label: "Best for", value: "Veterans, active duty, surviving spouses" },
    ],
  },
  {
    name: "USDA",
    tag: "U.S. Department of Agriculture",
    href: "/loans/usda/",
    blurb: "Zero-down loans for eligible rural and suburban properties. Not just for farms - many areas outside major cities qualify. Income limits apply.",
    specs: [
      { label: "Down payment", value: "0%" },
      { label: "Guarantee fee", value: "1% upfront + 0.35% annual" },
      { label: "Income limit", value: "115% of area median income (varies by county)" },
      { label: "Property eligibility", value: "USDA-designated rural and suburban areas" },
      { label: "Best for", value: "Buyers in eligible areas who meet income limits" },
    ],
  },
];
import ContactForm from "../../../components/forms/ContactForm.astro";
---

<Layout
  title="Conventional, FHA, VA & USDA Loans | Cliffco Mortgage Bankers"
  description="Compare conventional, FHA, VA, and USDA loan programs side by side. Down payments, credit requirements, mortgage insurance, and which program fits your situation - explained by Cliffco."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: "Conventional / FHA / VA / USDA", href: "/loans/conventional-government/" },
  ]} />

  <section class="container-wide pt-12 pb-5">
    <p class="eyebrow">Loan Programs</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">Conventional, FHA, VA & USDA Loans</h1>
    <p class="lead mt-6">Four standard loan programs. One lender who can originate all of them.</p>
  </section>

  <section class="bg-white pb-12">
    <div class="container-wide">
      <p class="lead">
        Cliffco originates conventional, FHA, VA, and USDA loans across all 32 states where we're
        licensed. Each program has different down payment requirements, mortgage insurance rules,
        and eligibility criteria. The right one depends on your credit, your military status, where
        the property is located, and how much you're putting down.
      </p>
    </div>
  </section>

  <!-- PROGRAM CARDS -->
  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide">
      <p class="eyebrow">The programs</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Four programs, compared.</h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {programs.map((prog) => (
          <article class="card flex flex-col h-full">
            <div class="flex items-start justify-between gap-3 flex-wrap">
              <div>
                <h3 class="font-bold text-[var(--color-ink)]" style="font-size: var(--text-h3);">{prog.name}</h3>
                <p class="text-xs text-[var(--color-text-muted)] mt-0.5">{prog.tag}</p>
              </div>
              <a href={prog.href} class="text-xs font-semibold text-[var(--color-accent)] no-underline hover:underline shrink-0">Full details →</a>
            </div>
            <p class="mt-3 text-sm text-[var(--color-text)] leading-relaxed">{prog.blurb}</p>
            <dl class="mt-4 space-y-2 border-t border-[var(--color-mist-gray)] pt-4">
              {prog.specs.map((s) => (
                <div class="flex justify-between gap-4 text-sm">
                  <dt class="text-[var(--color-text-muted)] shrink-0">{s.label}</dt>
                  <dd class="text-[var(--color-ink)] text-right">{s.value}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">Frequently asked</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Common questions, answered.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Not sure which program fits? We'll figure it out together.</h2>
      <p class="lead mt-4 text-white/85">A licensed Cliffco loan officer responds in one business day.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a pre-qual</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <p class="eyebrow">Get in touch</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Ready to talk to a loan officer?</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">No credit pull. No commitment. Fill out the form and a loan officer will reach out within one business day.</p>
      <div class="mt-8">
        <ContactForm
          formTo="websiteleads@cliffcomortgage.com,cliffcorpteam@cliffcomortgage.com"
          formSource="loan-conventional-govt"
        />
      </div>
    </div>
  </section>
</Layout>
