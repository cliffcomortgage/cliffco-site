---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("heloc")!;

const faq = [
  { question: "What is a HELOC?", answer: "A home equity line of credit lets you borrow against the equity in your home, draw what you need, pay it back, and draw again. It usually sits behind your existing mortgage as a second lien, so your first mortgage and its rate stay exactly as they are. A first-lien option is also available if you own your home free and clear or want the line to replace your current mortgage." },
  { question: "Does a HELOC replace my current mortgage?", answer: "Usually not. In second-lien position your existing first mortgage and its rate are untouched, which is the main reason to choose a HELOC over a cash-out refinance when you already have a low rate." },
  { question: "Is the rate fixed or variable?", answer: "Variable. The rate is tied to the Wall Street Journal Prime Rate plus a margin, so it can change monthly as Prime moves, and it's subject to a floor and a lifetime cap that are set at closing. Your payment can go up or down over the life of the line." },
  { question: "How does the draw period work?", answer: "You have an interest-only draw period at the start, followed by a repayment period during which the balance is paid down and no new draws are allowed. Draw periods and overall terms vary by program, and your loan officer will confirm the exact structure before you commit." },
  { question: "How much do I have to draw at closing?", answer: "Most of the line. These programs require you to take a large initial draw when the loan closes, so you start paying interest on that amount right away. This isn't a line you open and leave sitting unused, so it's worth sizing it to what you actually plan to spend." },
  { question: "Can I draw again later?", answer: "Yes, after an initial waiting period following closing, and each additional draw has a minimum amount. Your loan officer will confirm both for your program." },
  { question: "How much can I borrow?", answer: "Lines start at $50,000. Your maximum depends on your equity, your credit profile, and the combined loan-to-value of your first mortgage plus the new line. There are also limits on the combined balance of all liens against the property." },
  { question: "What can I use the funds for?", answer: "Home renovations, consolidating higher-interest debt, education costs, and major purchases are all common. Because the line is secured by your home, it generally costs less than credit cards or personal loans, and your home is the collateral." },
  { question: "Are there prepayment penalties?", answer: "No. There is no prepayment penalty on our HELOC, so you can pay the balance down or off on your own schedule." },
  { question: "What does the property have to look like?", answer: "The home needs to be in average or better condition, confirmed with a property condition report. We also verify your income and employment before closing." },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-07-15",
    dateModified: "2026-07-15",
  }),
];

import TermSheetHero from "../../../components/asym/TermSheetHero.astro";
import TermSheet from "../../../components/asym/TermSheet.astro";
import Chapter from "../../../components/asym/Chapter.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const glance = [
  ["Line amounts", "From $50,000"],
  ["Rate structure", "Variable, tied to WSJ Prime"],
  ["Lien position", "Second lien, or first lien if you prefer"],
  ["Structure", "Interest-only draw period, then repayment"],
  ["Initial draw", "A large draw is required at closing"],
  ["Occupancy", "Primary home, second home, or investment property"],
  ["Prepayment penalty", "None"],
  ["Reserves", "Not required"],
];
---

<Layout title={`HELOC | Home Equity Line of Credit | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <TermSheetHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Line amounts", value: "From $50,000" },
      { label: "Rate", value: "Variable, WSJ Prime" },
      { label: "Prepayment penalty", value: "None" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
    <Fragment slot="note">See important terms below.</Fragment>
  </TermSheetHero>

  <TermSheet>
    <FormCard slot="form" title="See what your equity could do." sub="Tell us your home's approximate value and your current mortgage balance and we'll show you what a line could look like." formSource="loan-heloc" />

    <Chapter eyebrow="HELOC at a glance" title="Your equity, without touching your first mortgage.">
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {glance.map(([k, v]) => (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">{k}</dt>
              <dd class="text-[var(--color-text)]">{v}</dd>
            </div>
          ))}
        </dl>
      </Chapter>

  <!-- FAQ -->
  <Chapter eyebrow="FAQ" title="Common HELOC questions.">
    <FaqList items={faq} />
  </Chapter>

  <!-- HELOC VS CASH-OUT -->
  <Chapter eyebrow="HELOC or cash-out?" title="Comparing a HELOC to a cash-out refinance?">
    <p class="text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">If your first mortgage rate is low, a HELOC usually wins. If you'd benefit from restructuring the whole loan, cash-out may make more sense. We compare both for you.</p>
    <a href="/mortgage-guides/blog/cash-out-refinance-vs-heloc/" class="mt-6 btn btn-secondary text-sm">Read the comparison →</a>
  </Chapter>
  </TermSheet>


  <CtaBand title="Tap your equity. Keep your rate." text="Tell us what your home is worth and what you owe, and we'll show you what a line could look like.">
    <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>

  <section class="bg-white py-8" id="terms">
    <div class="container-wide">
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
        The HELOC's interest rate is variable, tied to the Wall Street Journal Prime Rate plus a margin, and is subject to a floor and a lifetime cap disclosed to you at closing; your rate and payment may increase or decrease over the life of the line. Approval is subject to verification of income and employment, and to verification that the property is in average or better condition with a property condition report. A substantial initial draw is required at closing, and interest accrues on the amount drawn. Additional draws are available after an initial waiting period and are subject to a minimum amount. Line amounts, terms, and availability vary by program, property type, and state. This is not a commitment to lend or extend credit. All loans are subject to credit and underwriting approval.
      </p>
    </div>
  </section>
</Layout>
