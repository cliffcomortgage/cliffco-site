---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("heloc")!;

const faq = [
  { question: "What is a HELOC?", answer: "A home equity line of credit (HELOC) is a loan secured by the equity in your home. It sits behind your existing mortgage as a second lien, which means your first mortgage, and its rate, stays exactly as it is. You draw funds from the line and repay them over the loan term." },
  { question: "How can a HELOC be approved in five minutes?", answer: "The application uses automated income, credit, and property verification instead of a manual underwriting queue. Approval may be granted in five minutes but is ultimately subject to verification of income and employment, as well as verification that the property is in at least average condition with a property condition report." },
  { question: "Does a HELOC replace my current mortgage?", answer: "No. A HELOC is a second lien, so your existing first mortgage and its rate are untouched. That makes a HELOC especially useful if you locked a low first-mortgage rate and don't want to give it up with a cash-out refinance." },
  { question: "Is the rate fixed or variable?", answer: "Cliffco's HELOC is a variable-rate line tied to the Wall Street Journal Prime Rate plus a margin, so your rate can adjust monthly as Prime moves (with a 4% floor and an 18% lifetime cap). That's standard for a HELOC." },
  { question: "How much can I borrow with a HELOC?", answer: "Lines range from $50,000 to $1,000,000. Your maximum depends on how much equity you have, your credit profile, and the combined loan-to-value ratio of your first mortgage plus the new line." },
  { question: "Is there a minimum draw amount?", answer: "Yes. At closing you're required to draw at least 80% of your approved line, with a minimum initial draw of $50,000." },
  { question: "What can I use HELOC funds for?", answer: "Common uses are home renovations, consolidating higher-interest debt, education costs, and major purchases. Because the line is secured by your home, the rate is typically far lower than credit cards or personal loans." },
  { question: "How fast can I receive the funds?", answer: "Funding can happen in as few as five business days after approval, assuming the loan closes with our remote online notary. Funding timelines may be longer for properties in counties that do not permit recording of e-signatures or that otherwise require an in-person closing." },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-07-15",
    dateModified: "2026-07-15",
  }),
];

import AsymHero from "../../../components/asym/AsymHero.astro";
import Split from "../../../components/asym/Split.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const glance = [
  ["Approval decision", "In as little as 5 minutes*"],
  ["Funding", "In as few as 5 business days*"],
  ["Line amounts", "$50,000–$1,000,000"],
  ["Rate structure", "Variable"],
  ["First mortgage", "Unchanged; the line is a second lien"],
  ["Process", "Fully online, remote notary closing"],
];
---

<Layout title={`HELOC | Home Equity Line of Credit | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <AsymHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Approval decision", value: "As little as 5 minutes*" },
      { label: "Funding", value: "As few as 5 business days*" },
      { label: "Line amounts", value: "$50K–$1M" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
    <Fragment slot="note">*See terms below.</Fragment>
  </AsymHero>

  <!-- LEAD FORM + AT A GLANCE -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <FormCard title="See what your equity could do." sub="Tell us your home's approximate value and your current mortgage balance and we'll show you what a line could look like." formSource="loan-heloc" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-8">
        <p class="eyebrow">HELOC at a glance</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">Your equity, without touching your first mortgage.</h2>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {glance.map(([k, v]) => (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">{k}</dt>
              <dd class="text-[var(--color-text)]">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <Split eyebrow="FAQ" title="Common HELOC questions.">
    <FaqList items={faq} />
  </Split>

  <!-- HELOC VS CASH-OUT -->
  <Split eyebrow="HELOC or cash-out?" title="Comparing a HELOC to a cash-out refinance?">
    <p class="text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">If your first mortgage rate is low, a HELOC usually wins. If you'd benefit from restructuring the whole loan, cash-out may make more sense. We compare both for you.</p>
    <a href="/mortgage-guides/blog/cash-out-refinance-vs-heloc/" class="mt-6 btn btn-secondary text-sm">Read the comparison →</a>
  </Split>

  <CtaBand title="Tap your equity. Keep your rate." text="Apply online and get an approval decision in minutes.">
    <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>

  <section class="bg-white py-8" id="terms">
    <div class="container-wide">
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
        *Approval may be granted in five minutes but is ultimately subject to verification of income and employment, as well as verification that the property is in at least average condition with a property condition report. Five business day funding timeline assumes closing the loan with our remote online notary. Funding timelines may be longer for loans secured by properties located in counties that do not permit recording of e-signatures or that otherwise require an in-person closing. The HELOC's interest rate is variable, tied to the Wall Street Journal Prime Rate plus a margin, subject to a 4% floor and an 18% lifetime cap (may vary by state); your rate and payment may increase or decrease over the life of the line.
      </p>
    </div>
  </section>
</Layout>
