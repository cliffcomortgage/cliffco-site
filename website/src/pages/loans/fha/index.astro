---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("fha")!;
const today = new Date().toISOString().slice(0, 10);

const faq = [
  { question: "What is an FHA loan?", answer: "An FHA loan is a mortgage insured by the Federal Housing Administration. Because FHA insures the lender against borrower default, lenders can offer more flexible qualification standards: lower credit scores, smaller down payments, and higher debt-to-income ratios than conventional programs allow. Cliffco is not affiliated with or acting on behalf of the FHA or any government entity." },
  { question: "What is the minimum down payment for an FHA loan?", answer: "3.5% for borrowers with a 580+ credit score. Borrowers with scores between 500 and 579 may still qualify with a 10% down payment. Below 500, FHA is not available." },
  { question: "What credit score do I need for an FHA loan?", answer: "The FHA program minimum is 500 (with 10% down). Most lenders, including Cliffco, require 580 for the 3.5% down option. Borrowers with 620+ FICO typically have a smoother path through underwriting." },
  { question: "Do FHA loans require mortgage insurance?", answer: "Yes. FHA loans require an upfront mortgage insurance premium (UFMIP) of 1.75% of the loan amount (typically financed into the loan) and an annual MIP collected monthly. Unlike PMI on conventional loans, FHA MIP generally remains for the life of the loan if the down payment is less than 10%." },
  { question: "Can I use an FHA loan to buy a multi-family property?", answer: "Yes, up to 4 units, as long as the borrower occupies one unit as their primary residence. FHA allows multi-family purchases, which is a common strategy for first-time buyers who want rental income to help offset mortgage costs." },
  { question: "What are the FHA loan limits for 2026?", answer: "FHA loan limits vary by county. The standard floor is $524,225 for a single-family home; the ceiling in high-cost areas (including parts of New York and New Jersey) is $1,209,750. Multi-family limits are higher. Your Cliffco loan officer can confirm the limit for your county." },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: today,
    authorSlug: "christopher-clifford",
  }),
];
import ContactForm from "../../../components/forms/ContactForm.astro";
---

<Layout title={`FHA Loans | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <section class="container-wide pt-12 pb-5">
    <p class="eyebrow">{p.category}</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">{p.name}</h1>
    <p class="lead mt-6">{p.oneLiner}</p>
  </section>

  <section class="bg-white pb-12">
    <div class="container-wide">
      <p class="lead">{p.directAnswer}</p>
    </div>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">At a glance</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">What to expect.</h2>
      </div>
      <dl class="space-y-3">
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Min down payment</dt><dd class="text-[var(--color-text-muted)]">3.5% (580+ FICO); 10% (500–579 FICO)</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Min FICO</dt><dd class="text-[var(--color-text-muted)]">500 (FHA min); 580 for 3.5% down</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>2026 loan limit (standard)</dt><dd class="text-[var(--color-text-muted)]">$524,225 (SFR); up to $1,209,750 (high-cost)</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Mortgage insurance</dt><dd class="text-[var(--color-text-muted)]">1.75% UFMIP + annual MIP (typically for life of loan)</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Property types</dt><dd class="text-[var(--color-text-muted)]">Primary residence, 1–4 units</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Max DTI</dt><dd class="text-[var(--color-text-muted)]">Up to 57% with strong compensating factors</dd></div>
      </dl>
    </div>
  </section>

  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <p class="eyebrow">Frequently asked</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">FHA loan questions, answered.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <div class="rounded-xl border border-[var(--color-mist-gray)] p-6 flex flex-col sm:flex-row gap-6 items-start sm:items-center justify-between">
        <div>
          <p class="font-semibold text-[var(--color-ink)]">Still need help with the down payment?</p>
          <p class="text-sm text-[var(--color-text-muted)] mt-1">FHA pairs well with many down payment assistance programs - grants, forgivable loans, and deferred second mortgages that can cover your 3.5%.</p>
        </div>
        <a href="/down-payment-assistance/" class="btn btn-secondary text-sm shrink-0">Explore DPA options →</a>
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Low down payment. Real loan officer.</h2>
      <p class="lead mt-4 text-white/85">Get pre-qualified for an FHA loan in one business day.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get a pre-qual</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <p class="eyebrow">Get in touch</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Ready to talk to a loan officer?</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">No credit pull. No commitment. Fill out the form and a loan officer will reach out within one business day.</p>
      <div class="mt-8">
        <ContactForm
          formTo="websiteleads@cliffcomortgage.com,cliffcorpteam@cliffcomortgage.com"
          formSource="loan-fha"
        />
      </div>
    </div>
  </section>
</Layout>
