---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("fha")!;

const faq = [
  { question: "What is an FHA loan?", answer: "An FHA loan is a mortgage insured by the Federal Housing Administration. Because FHA insures the lender against borrower default, lenders can offer more flexible qualification standards: lower credit scores, smaller down payments, and higher debt-to-income ratios than conventional programs allow. Cliffco is not affiliated with or acting on behalf of the FHA or any government entity." },
  { question: "What is the minimum down payment for an FHA loan?", answer: "3.5% for borrowers with a 580+ credit score. Borrowers with scores between 500 and 579 may still qualify with a 10% down payment. Below 500, FHA is not available." },
  { question: "What credit score do I need for an FHA loan?", answer: "The FHA program minimum is 500 (with 10% down). Most lenders, including Cliffco, require 580 for the 3.5% down option. Borrowers with 620+ FICO typically have a smoother path through underwriting." },
  { question: "Do FHA loans require mortgage insurance?", answer: "Yes. FHA loans require an upfront mortgage insurance premium (UFMIP) of 1.75% of the loan amount (typically financed into the loan) and an annual MIP collected monthly. Unlike PMI on conventional loans, FHA MIP generally remains for the life of the loan if the down payment is less than 10%." },
  { question: "Can I use an FHA loan to buy a multi-family property?", answer: "Yes, up to 4 units, as long as the borrower occupies one unit as their primary residence. FHA allows multi-family purchases, which is a common strategy for first-time buyers who want rental income to help offset mortgage costs." },
  { question: "What are the FHA loan limits for 2026?", answer: "FHA loan limits vary by county. The standard floor is $541,287 for a single-family home; the ceiling in high-cost areas (including parts of New York and New Jersey) is $1,249,125. Multi-family limits are higher. Your Cliffco loan officer can confirm the limit for your county." },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];

import AsymHero from "../../../components/asym/AsymHero.astro";
import Split from "../../../components/asym/Split.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const glance = [
  ["Min down payment", "3.5% (580+ FICO); 10% (500–579 FICO)"],
  ["Min FICO", "500 (FHA min); 580 for 3.5% down"],
  ["2026 loan limit (standard)", "$541,287 (SFR); up to $1,249,125 (high-cost)"],
  ["Mortgage insurance", "1.75% UFMIP + annual MIP (typically for life of loan)"],
  ["Property types", "Primary residence, 1–4 units"],
  ["Max DTI", "Up to 57% with strong compensating factors"],
];
---

<Layout title={`FHA Loans | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <AsymHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Down payment", value: "3.5% with 580+ FICO" },
      { label: "Min FICO", value: "500 (10% down)" },
      { label: "Max DTI", value: "Up to 57%" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </AsymHero>

  <!-- LEAD FORM + OVERVIEW -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <FormCard title="See what an FHA loan looks like for your situation." sub="Tell us your credit score, income, and target price and we'll show you what you'd qualify for." formSource="loan-fha" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-8">
        <p class="eyebrow">FHA at a glance</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">Low down payment. Flexible credit.</h2>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {glance.map(([k, v]) => (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">{k}</dt>
              <dd class="text-[var(--color-text)]">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <Split eyebrow="FAQ" title="Common FHA questions.">
    <FaqList items={faq} />
  </Split>

  <!-- DPA -->
  <Split eyebrow="Down payment help" title="Still need help with the down payment?">
    <p class="text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">FHA pairs well with many down payment assistance programs - grants, forgivable loans, and deferred second mortgages that can cover your 3.5%.</p>
    <a href="/down-payment-assistance/" class="mt-6 btn btn-secondary text-sm">Explore DPA options →</a>
  </Split>

  <CtaBand title="Low down payment. Real loan officer." text="Get pre-qualified for an FHA loan in one business day.">
    <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
