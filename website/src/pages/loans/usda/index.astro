---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("usda")!;

const faq = [
  { question: "What is a USDA loan?", answer: "A USDA Rural Development loan is a government-backed mortgage for eligible properties in rural and many suburban areas. The program offers 0% down payment, below-market rates, and reduced mortgage insurance costs. USDA loans are not just for farms: many suburban neighborhoods outside major cities qualify." },
  { question: "How do I know if a property is in an eligible area?", answer: "USDA publishes an online eligibility map at eligibility.sc.egov.usda.gov. Many areas outside major metros that feel suburban qualify, including parts of Long Island, New Jersey, upstate New York, and central Florida. Your Cliffco loan officer can check any address." },
  { question: "Are there income limits for USDA loans?", answer: "Yes. USDA sets income limits based on household size and county median income, typically 115% of the area median income (AMI). Limits vary significantly by location. In high-cost areas, the limits are higher than in rural areas. Your Cliffco loan officer can confirm eligibility based on your household income and the specific property county." },
  { question: "What is the USDA guarantee fee?", answer: "USDA loans include an upfront guarantee fee (1% of the loan amount, typically financed into the loan) and an annual fee of 0.35% of the outstanding balance. These are significantly lower than FHA mortgage insurance premiums, making USDA one of the most affordable low-down-payment programs available." },
  { question: "What credit score is required for a USDA loan?", answer: "There is no official USDA minimum, but most lenders require at least 640 FICO for automated underwriting approval. Lower scores may be eligible through manual underwriting with compensating factors." },
  { question: "Can I refinance with a USDA loan?", answer: "Yes. USDA offers a streamlined refinance program for existing USDA borrowers that can reduce the rate with minimal documentation, and a non-streamlined option for borrowers who want to roll in closing costs." },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];

import AsymHero from "../../../components/asym/AsymHero.astro";
import Split from "../../../components/asym/Split.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const glance = [
  ["Down payment", "0%"],
  ["Guarantee fee (upfront)", "1% (financeable)"],
  ["Annual fee", "0.35% of outstanding balance"],
  ["Income limit", "115% of area median income (varies by county)"],
  ["Property eligibility", "USDA-designated rural and suburban areas"],
  ["Min FICO (typical)", "640 for automated approval"],
];
---

<Layout title={`USDA Loans | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <AsymHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Down payment", value: "0%" },
      { label: "Income limit", value: "115% of area median" },
      { label: "Upfront guarantee fee", value: "1% (financeable)" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Check eligibility</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </AsymHero>

  <!-- LEAD FORM + OVERVIEW -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <FormCard title="Think a USDA loan might fit? Let's find out." sub="We'll check the property location and income limits for your area and tell you if you qualify." formSource="loan-usda" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-8">
        <p class="eyebrow">USDA at a glance</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">Zero down. For the right address.</h2>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {glance.map(([k, v]) => (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">{k}</dt>
              <dd class="text-[var(--color-text)]">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <Split eyebrow="FAQ" title="Is USDA right for your address?">
    <FaqList items={faq} />
  </Split>

  <CtaBand title="Zero down. Check if your address qualifies." text="A Cliffco loan officer can confirm property and income eligibility in minutes.">
    <a href="#contact" class="btn btn-primary">Check eligibility</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
