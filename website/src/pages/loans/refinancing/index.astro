---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("refinancing")!;

const faq = [
  {
    question: "When does refinancing make sense?",
    answer: "Refinancing typically makes sense when you can lower your rate by at least 0.5–1 point, reduce your term, switch from an ARM to a fixed rate, or access equity. The break-even calculation: divide your closing costs by the monthly savings to find how many months to recoup the cost. If you plan to stay past that point, a refi usually pencils out.",
  },
  {
    question: "What is a CEMA refinance and who can use it?",
    answer: "A Consolidation, Extension, and Modification Agreement (CEMA) is a New York-specific refinance structure that modifies your existing mortgage rather than paying it off and recording a new one. Because mortgage recording tax (up to 1.8% in NYC, 1% elsewhere in NY) only applies to new principal, a CEMA can save thousands. It requires lender cooperation and takes longer than a standard refi but is usually worth it for balances above $200K.",
  },
  {
    question: "Can I do a cash-out refinance if I'm self-employed?",
    answer: "Yes. If you can't qualify for a conventional cash-out refi using tax returns, Cliffco's Non-QM programs allow cash-out refinances using bank statements, P&L, 1099s, or asset depletion, up to 75–80% LTV on most programs.",
  },
  {
    question: "How long does a refinance take?",
    answer: "A conventional refinance typically closes in 21–45 days. Non-QM and CEMA refinances can take 30–60 days. Florida refinances involving title and insurance require additional lead time. Your Cliffco LO will give you a realistic timeline at the application stage.",
  },
  {
    question: "What's the maximum LTV for a cash-out refinance?",
    answer: "Conventional (Fannie/Freddie): up to 80% LTV on primary residences. FHA: up to 80% LTV. VA: up to 90% LTV for eligible veterans. Non-QM: typically 75–80% LTV, with some programs reaching 85% for strong borrower profiles. Investment properties generally max out at 75% LTV.",
  },
  {
    question: "Can I refinance a reverse mortgage?",
    answer: "Yes. HECM-to-HECM refinances allow existing reverse mortgage holders to refinance into a new HECM for better terms, a higher line of credit (if home values have risen), or to add a spouse to the loan. Cliffco's reverse mortgage team handles HECM-to-HECM refinances in all states where we're licensed.",
  },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];

import TermSheetHero from "../../../components/asym/TermSheetHero.astro";
import TermSheet from "../../../components/asym/TermSheet.astro";
import Chapter from "../../../components/asym/Chapter.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const refiTypes = [
  { name: "Rate-and-term refinance", body: "Lower your interest rate, shorten or extend your loan term, or switch from an adjustable-rate to a fixed-rate mortgage. The most common refinance type; available on conventional, FHA, VA, and Non-QM loans." },
  { name: "Cash-out refinance", body: "Replace your existing mortgage with a larger one and receive the difference in cash. Common uses: home improvements, debt consolidation, down payment on an investment property, or funding a business. Available on conventional (up to 80% LTV), VA (up to 90%), and Non-QM programs (up to 75–80%)." },
  { name: "CEMA refinance (New York)", body: "A Consolidation, Extension, and Modification Agreement saves New York borrowers mortgage recording tax (up to 1.8% in NYC, 1% elsewhere) by modifying the existing mortgage rather than recording a new one. Cliffco originates CEMAs statewide and is one of a shrinking number of lenders that still does them efficiently." },
  { name: "Non-QM refinance", body: "For self-employed borrowers, 1099 contractors, and anyone who can't document income conventionally. Cliffco refinances using bank statements, P&L, 1099s, or asset depletion, on both rate-and-term and cash-out transactions." },
  { name: "HECM-to-HECM reverse mortgage refinance", body: "Existing reverse mortgage holders can refinance into a new HECM to access a higher line of credit (if home values have risen), add a younger spouse to the loan, or secure better terms. Cliffco's reverse mortgage team handles HECM-to-HECM refinances in all states where we're licensed." },
];
const breakEven = [
  ["Closing costs", "$8,000"],
  ["Monthly savings", "$250"],
  ["Break-even point", "32 months (~2.7 years)"],
];
---

<Layout title={`Refinancing | Cliffco`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <TermSheetHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Refinance programs", value: "Five, for every borrower type" },
      { label: "Cash-out", value: "Up to 80% LTV conventional" },
      { label: "New York", value: "CEMA statewide" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get a refi quote</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </TermSheetHero>

  <TermSheet>
    <FormCard slot="form" title="Thinking about refinancing?" sub="Tell us your current rate, balance, and goals and we'll tell you if the numbers work." formSource="loan-refinancing" />

    <Chapter eyebrow="When to refinance" title="The break-even math.">
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">
          A refinance costs money upfront (closing costs typically 2–3% of the loan balance). The question is whether the monthly savings justify that cost before you sell or pay off the home.
        </p>
        <div class="mt-8 rounded-2xl bg-[var(--color-ink)] text-white p-7">
          <p class="eyebrow !text-white/55">Break-even example</p>
          <dl class="mt-4 border-t border-white/25">
            {breakEven.map(([k, v]) => (
              <div class="flex justify-between gap-4 py-3 border-b border-white/15">
                <dt class="text-white/70">{k}</dt><dd class="font-mono text-white">{v}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-4 text-xs text-white/60 leading-relaxed">If you plan to stay in the home past 32 months, the refinance saves money. If not, it may not be worth the closing costs.</p>
        </div>
      </Chapter>

  <!-- REFINANCE TYPES -->
  <Chapter eyebrow="Refinance types" title="Five refinance programs Cliffco originates.">
    <ol class="list-none m-0 p-0 border-t border-[var(--color-ink)]">
      {refiTypes.map((t, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-7 border-b border-black/15">
          <span class="font-mono text-sm text-[var(--color-text-muted)] pt-1">0{i + 1}</span>
          <div>
            <h3 class="text-lg font-semibold text-[var(--color-ink)]">{t.name}</h3>
            <p class="mt-2 text-[var(--color-text)] leading-relaxed">{t.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </Chapter>

  <!-- HELOC SPOTLIGHT (black band) -->
  <Chapter dark eyebrow="Also from Cliffco" title="HELOC: Use your equity, keep your rate.">
    <p class="text-white/85 leading-relaxed" style="font-size: 1.125rem;">
      Not ready to touch your first mortgage? A HELOC lets you access your equity as a revolving line of credit, with no cash-out refinance required.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/loans/heloc/" class="btn btn-primary !bg-white !text-[var(--color-ink)] hover:!bg-white/85">See the HELOC →</a>
      <a href="#contact" class="btn btn-secondary !border-white !text-white">Get Pre-Qualified</a>
    </div>
    <p class="mt-8 text-xs text-white/50 leading-relaxed">
      The HELOC's rate is variable, tied to the Wall Street Journal Prime Rate plus a margin, and subject to a floor and a lifetime cap disclosed at closing. A substantial initial draw is required at closing. Terms and availability vary by program, property type, and state. This is not a commitment to lend or extend credit.
    </p>
  </Chapter>

  <!-- FAQ -->
  <Chapter rule={false} eyebrow="FAQ" title="Questions to ask before you refinance.">
    <FaqList items={faq} />
  </Chapter>
  </TermSheet>


  <CtaBand title="Tell us your current loan. We'll run the numbers." text="A licensed Cliffco loan officer responds in one business day.">
    <a href="#contact" class="btn btn-primary">Get a refi quote</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
