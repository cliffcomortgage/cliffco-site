---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("itin-mortgage")!;

const faq = [
  {
    question: "What is an ITIN?",
    answer: "An Individual Taxpayer Identification Number (ITIN) is a tax processing number issued by the IRS to people who are required to have a US taxpayer identification number but are not eligible for a Social Security number. ITINs are issued regardless of immigration status.",
  },
  {
    question: "Can I get a mortgage with an ITIN instead of a Social Security number?",
    answer: "Yes. Cliffco's ITIN mortgage program is specifically designed for borrowers who have an ITIN but no SSN. Income is documented using bank statements or 1099s (the same Non-QM documentation available to self-employed US borrowers), with the ITIN substituting for the SSN throughout the application.",
  },
  {
    question: "Do I need to be a US citizen or permanent resident?",
    answer: "No. Cliffco's ITIN mortgage does not require US citizenship, a green card, or any specific visa status. ITIN loans are available to non-resident and resident foreign nationals, as well as individuals who file US taxes with an ITIN and have no Social Security number.",
  },
  {
    question: "What property types are eligible?",
    answer: "ITIN borrowers can purchase primary residences, second homes, and investment properties. Single-family homes, 2–4 unit properties, condos, and co-ops are all eligible property types.",
  },
  {
    question: "What down payment do I need?",
    answer: "Most ITIN programs require 15%–25% down depending on property type, FICO equivalent, and documentation strength. Primary residence purchases can qualify at 15% down with strong documentation; investment properties typically require 20%–25%.",
  },
  {
    question: "What if I have no US credit history?",
    answer: "Cliffco can build an alternative credit profile using 12 months of documented on-time payments across at least 3 recurring obligations, such as rent, utilities, phone, or internet. Your loan officer can confirm whether this option applies to your specific loan scenario.",
  },
  {
    question: "What's the difference between an ITIN mortgage and a foreign national loan?",
    answer: "ITIN mortgages are for borrowers who live in or have a financial presence in the US, file US taxes, and have an IRS-issued ITIN. Foreign national loans are for buyers who reside entirely outside the US, have no US financial footprint, and are purchasing investment or vacation property. If you live in the US and work here, ITIN is likely the right program.",
  },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-06-11",
    dateModified: "2026-07-15",
  }),
];
import TermSheetHero from "../../../components/asym/TermSheetHero.astro";
import TermSheet from "../../../components/asym/TermSheet.astro";
import Chapter from "../../../components/asym/Chapter.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const whoQualifies = [
  { title: "Immigrants and non-residents", body: "Foreign-born borrowers living in the US who file taxes with an ITIN and have no Social Security number, regardless of immigration status." },
  { title: "Self-employed ITIN holders", body: "Business owners and self-employed individuals who earn income in the US, file with an ITIN, and can document income through bank statements or 1099s." },
  { title: "First-time homebuyers", body: "Buyers purchasing a primary residence for the first time, regardless of immigration status. ITIN loans are available for primary homes, second homes, and investment properties." },
  { title: "Real estate investors", body: "Borrowers looking to purchase investment or rental properties using ITIN documentation. Multi-unit properties and condos are eligible." },
];
const numbers = [
  ["Min down payment", "15%–20% (primary) / 20–25% (investment)"],
  ["Credit requirement", "660+ FICO or alternative credit"],
  ["Income documentation", "12–24 months bank statements or 1099s"],
  ["Loan amounts", "$150K–$2.5M+"],
  ["Property types", "SFR, 2–4 unit, condo"],
  ["Occupancy", "Primary, second home, investment"],
];
---

<Layout title={`${p.name} | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <TermSheetHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Down payment", value: "From 15% (primary)" },
      { label: "Credit", value: "660+ FICO or alternative credit" },
      { label: "Occupancy", value: "Primary, second home, investment" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Start a pre-qual</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </TermSheetHero>

  <TermSheet>
    <FormCard slot="form" title="Questions about ITIN mortgage programs?" sub="Tell us your situation and we'll walk you through which ITIN loan programs are available in your state." formSource="loan-itin" />

    <Chapter eyebrow="The numbers" title="What to expect.">
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <p class="mt-4 text-[var(--color-text-muted)]">Final terms depend on documentation type, property use, FICO equivalent, and LTV.</p>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {numbers.map(([k, v]) => (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">{k}</dt>
              <dd class="text-[var(--color-text)]">{v}</dd>
            </div>
          ))}
        </dl>
        <p class="text-xs text-[var(--color-text-muted)] mt-4 leading-relaxed">The chart above is for illustrative purposes only. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice.</p>
      </Chapter>

  <!-- WHO QUALIFIES -->
  <Chapter eyebrow="Who qualifies" title="No SSN? You still have options." wide>
    <ol class="list-none m-0 p-0 grid sm:grid-cols-2 gap-4">
      {whoQualifies.map((w, i) => (
        <li class="rounded-2xl border-2 border-[var(--color-ink)] p-6">
          <span class="font-mono text-xs text-[var(--color-text-muted)]">0{i + 1}</span>
          <h3 class="mt-3 text-lg font-semibold text-[var(--color-ink)]">{w.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{w.body}</p>
        </li>
      ))}
    </ol>
  </Chapter>

  <!-- FAQ -->
  <Chapter eyebrow="FAQ" title="Questions about ITIN mortgages.">
    <FaqList items={faq} />
  </Chapter>

  <!-- RELATED -->
  <Chapter eyebrow="Related programs" title="Not sure which Non-QM program fits?">
    <p class="text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">ITIN mortgages are one of several Non-QM programs Cliffco originates. If you reside entirely outside the US and have no US financial presence, the foreign national program may be a better fit.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/loans/non-qm-self-employed/" class="btn btn-secondary">Non-QM overview →</a>
      <a href="/loans/foreign-national-mortgage/" class="btn btn-secondary">Foreign national mortgage →</a>
    </div>
  </Chapter>
  </TermSheet>


  <CtaBand title="Have an ITIN? Let's see what you qualify for." text="A Cliffco loan officer responds within one business day. No credit pull to start.">
    <a href="#contact" class="btn btn-primary">Start a pre-qual</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
