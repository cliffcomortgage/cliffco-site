---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("foreign-national-mortgage")!;

const faq = [
  {
    question: "What is a foreign national mortgage?",
    answer: "A foreign national mortgage is a Non-QM home loan for buyers who reside outside the United States. Unlike ITIN mortgages (for US-resident borrowers without an SSN), foreign national loans are designed for buyers with no US financial footprint: no US credit history, no US tax returns, and no Social Security number or ITIN. Income is documented using foreign income records, and assets are verified through foreign or international bank accounts.",
  },
  {
    question: "Do I need to visit the United States to close?",
    answer: "In most cases, yes. Remote closings for foreign national transactions are possible in certain states but depend on the title company and state law. Your Cliffco loan officer will outline the closing options available for the state where the property is located.",
  },
  {
    question: "Can foreign nationals buy investment properties?",
    answer: "Yes. Foreign national loan programs are for investment properties and second homes only. Primary residence purchases are not eligible: by definition, the borrower resides outside the US.",
  },
  {
    question: "Is a US bank account required?",
    answer: "Not necessarily to qualify, but you will need a US bank account to close the loan and fund the down payment through a domestic wire. Most buyers open a US account during the process. Reserves may be held in a foreign bank account that Cliffco can verify.",
  },
  {
    question: "What is the difference between a foreign national loan and an ITIN mortgage?",
    answer: "ITIN mortgages are for borrowers who live in the US and have an IRS-issued ITIN but no Social Security number. Foreign national loans are for buyers who reside entirely outside the US, have no US credit history, and typically purchase investment or vacation properties rather than a primary residence. If you live in the US and file US taxes, ITIN is likely the right program.",
  },
  {
    question: "Which countries are eligible?",
    answer: "Most countries are eligible. Citizens of Venezuela are not eligible for Cliffco programs, and we cannot lend to borrowers in OFAC-sanctioned countries or on federal exclusion lists. Some jurisdictions call for additional documentation. Your loan officer can confirm eligibility for your specific country of residence before you go any further.",
  },
  {
    question: "What documentation do I need?",
    answer: "Typically: a valid passport, visa documentation, 12–24 months of foreign bank statements or equivalent income documentation, a credit report from your home country if available, a letter of reference from your foreign bank, and documentation sourcing your down payment funds. Self-employed borrowers also need business ownership verification and income documentation from their home country. Most foreign national purchases qualify on the property's rental income rather than personal income documentation, and on that path the rent needs to cover the full monthly payment. Ask your loan officer which route fits your situation.",
  },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-06-11",
    dateModified: "2026-07-15",
  }),
];
import TermSheetHero from "../../../components/asym/TermSheetHero.astro";
import TermSheet from "../../../components/asym/TermSheet.astro";
import Chapter from "../../../components/asym/Chapter.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const whoQualifies = [
  { title: "International investors", body: "Foreign buyers purchasing US real estate as an investment or rental property. No US income, US credit history, or US residency required." },
  { title: "Vacation home buyers", body: "Non-resident buyers purchasing a second home in the US. Common in South Florida, New York, and Arizona, all markets where Cliffco is active." },
  { title: "Buyers from countries without credit bureaus", body: "No U.S. credit score is required. We can use credit from your home country instead: three open accounts with a two-year history and no late payments, a clean 12-month housing history, and reference letters from your bank where a formal credit report does not exist." },
  { title: "Self-employed foreign nationals", body: "Business owners outside the US can qualify using foreign tax documents, business bank statements, or income letters from their home country, with no US business registration required." },
];
const numbers = [
  ["Min down payment", "30% on a purchase; 40% on a cash-out refinance"],
  ["US credit required", "No"],
  ["US tax returns required", "No"],
  ["Reserves required", "6 months PITIA"],
  ["Loan amounts", "Up to $1.5M"],
  ["Qualifying basis", "The property's rental income must cover the payment"],
  ["Occupancy", "Investment, second home"],
];
---

<Layout title={`${p.name} | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <TermSheetHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Down payment", value: "From 30%" },
      { label: "US credit or tax returns", value: "Not required" },
      { label: "Occupancy", value: "Investment, second home" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Start a pre-qual</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </TermSheetHero>

  <TermSheet>
    <FormCard slot="form" title="Questions about buying U.S. property as a foreign national?" sub="Tell us about your visa status and target property and we'll show you which programs apply." formSource="loan-foreign-national" />

    <Chapter eyebrow="The numbers" title="What to expect.">
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <p class="mt-4 text-[var(--color-text-muted)]">Final terms depend on country of origin, documentation, LTV, and property type.</p>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {numbers.map(([k, v]) => (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">{k}</dt>
              <dd class="text-[var(--color-text)]">{v}</dd>
            </div>
          ))}
        </dl>
        <p class="text-xs text-[var(--color-text-muted)] mt-4 leading-relaxed">The chart above is for illustrative purposes only. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice.</p>
      </Chapter>

  <!-- WHO QUALIFIES -->
  <Chapter eyebrow="Who qualifies" title="You don't have to live here to own here." wide>
    <ol class="list-none m-0 p-0 grid sm:grid-cols-2 gap-4">
      {whoQualifies.map((w, i) => (
        <li class="rounded-2xl border-2 border-[var(--color-ink)] p-6">
          <span class="font-mono text-xs text-[var(--color-text-muted)]">0{i + 1}</span>
          <h3 class="mt-3 text-lg font-semibold text-[var(--color-ink)]">{w.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{w.body}</p>
        </li>
      ))}
    </ol>
  </Chapter>

  <!-- LEARN MORE (black band) -->
  <Chapter dark eyebrow="Learn more" title="How foreign national loans work.">
    <p class="text-white/85 leading-relaxed" style="font-size: 1.0625rem;">
      Our guide walks through the full process, from documentation to closing, including down payment sourcing, credit alternatives, reserve requirements, and what to expect at each stage if you've never bought US property before.
    </p>
    <div class="mt-8 border-t border-white/40">
      <p class="eyebrow !text-white/55 mt-6">In the guide</p>
      <ul class="mt-3 list-none m-0 p-0">
        <li class="py-3 border-b border-white/15 text-white">How foreign national loans are structured</li>
        <li class="py-3 border-b border-white/15 text-white">What documentation is required</li>
        <li class="py-3 border-b border-white/15 text-white">How income and credit are verified</li>
        <li class="py-3 border-b border-white/15 text-white">Down payment sourcing and reserve rules</li>
        <li class="py-3 border-b border-white/15 text-white">What to do, step by step</li>
      </ul>
    </div>
    <a href="/mortgage-guides/blog/foreign-national-loan-buy-property-us/" class="btn btn-secondary mt-8 !border-white !text-white">Read the complete guide →</a>
  </Chapter>

  <!-- FAQ -->
  <Chapter rule={false} eyebrow="FAQ" title="Questions foreign national buyers ask.">
    <FaqList items={faq} />
  </Chapter>
  </TermSheet>


  <CtaBand title="Buying from abroad starts with one call." text="A Cliffco loan officer responds within one business day. No US credit pull required to get started.">
    <a href="#contact" class="btn btn-primary">Start a pre-qual</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
