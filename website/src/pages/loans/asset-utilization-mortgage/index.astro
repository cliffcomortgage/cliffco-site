---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("asset-utilization-mortgage")!;

const faq = [
  {
    question: "What is an asset utilization mortgage?",
    answer: "An asset utilization mortgage (also called asset depletion) creates qualifying income from verified liquid assets rather than from a paycheck or business revenue. Cliffco divides total verified eligible assets by a program-defined number of months to arrive at a monthly qualifying income figure. Asset-derived income can stand alone or be combined with any other documented income, letting borrowers qualify (or qualify for more) based on what they have saved and invested, not only what they earn on paper.",
  },
  {
    question: "What assets count?",
    answer: "Cliffco accepts the following asset types: checking accounts, savings accounts, money market accounts, cash value of life insurance, stocks, bonds, and mutual funds (at 80% of market value), and retirement accounts (IRA, 401(k), pension). Retirement accounts are reduced by 30% to account for early withdrawal taxes and penalties. Cryptocurrency may also count if it meets seasoning requirements and has been liquidated into a checking or savings account. Net proceeds from the sale of real estate may be eligible if the property was owned for at least 6 months and the funds have been deposited. The type of account they are deposited into determines how they are treated for qualifying. Business accounts do not count.",
  },
  {
    question: "How is qualifying income calculated?",
    answer: "Cliffco takes total verified eligible assets, applies any applicable retirement account reduction, subtracts the required post-closing reserves, and divides the remaining balance by the program term (60–84 months). For example: $1,500,000 in verified assets, less $300,000 reserves, divided by 84 months = $14,286/month qualifying income.",
  },
  {
    question: "Do I need any other income?",
    answer: "Not necessarily. Many asset utilization programs qualify borrowers entirely on asset-derived income. If you also have Social Security, pension income, rental income, or other documented income, Cliffco combines it with the asset-derived figure to maximize your qualifying income.",
  },
  {
    question: "Is this a good fit for retirees?",
    answer: "Asset utilization is one of the strongest Non-QM programs for retirees. If you've built significant savings through brokerage accounts, IRAs, and bank accounts but your W-2 income is zero, this program sees the financial picture that a conventional underwriter would miss entirely.",
  },
  {
    question: "Do I actually have to deplete my assets?",
    answer: "No. Asset utilization is an income-calculation method used to qualify you for the loan. It does not create any obligation to liquidate your portfolio. Most borrowers in this program keep their assets fully intact and service the mortgage from ongoing cash flow, Social Security, dividends, or rental income.",
  },
  {
    question: "What if my assets are in a joint account?",
    answer: "Joint accounts with a non-borrowing spouse or domestic partner are eligible with the right documentation. If the joint holder is not contributing income or deposits to the account, a borrower affidavit is required to validate the balance. If the joint holder is contributing income or deposits, the source must be clearly identified (such as direct deposit, SSI, or trust income) and those amounts will be subtracted from the qualifying analysis. In all cases, a relationship letter must be present in the file.",
  },
];

const schema = [
  mortgageLoanSchema(p, { rateRange: { min: 6.5, max: 8.75 } }),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-06-11",
    dateModified: "2026-07-15",
  }),
];
import TermSheetHero from "../../../components/asym/TermSheetHero.astro";
import TermSheet from "../../../components/asym/TermSheet.astro";
import Chapter from "../../../components/asym/Chapter.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const whoQualifies = [
  { title: "Retirees", body: "Homeowners and buyers who have left the workforce and have substantial savings, IRA, or brokerage assets but no W-2 income to qualify conventionally." },
  { title: "Pre-retirees in transition", body: "Borrowers who have wound down a business, taken early retirement, or are between careers with substantial liquid savings but a gap in W-2 history." },
  { title: "High-net-worth buyers", body: "Wealthy borrowers whose income is structured to minimize W-2 receipts (dividends, capital gains, deferred compensation) but who hold significant investable assets." },
  { title: "Real estate investors", body: "Investors with substantial liquid assets who want to add a primary residence or second home without relying on complex rental income documentation." },
  { title: "Borrowers supplementing income", body: "Anyone who has savings, investments, or retirement accounts and needs extra qualifying power. Asset-derived income can be layered on top of W-2, rental, Social Security, or any other documented income to close a qualifying gap." },
];
const numbers = [
  ["Rate range", "6.50%–8.75%"],
  ["Min eligible assets (illustrative)", "$1M+"],
  ["Retirement account reduction", "30%"],
  ["Program term (divisor)", "60–84 months"],
  ["Max LTV", "up to 85% (primary) / up to 80% (investment)"],
  ["Min FICO", "660 (best pricing 720+)"],
  ["Loan amounts", "$200K–$3M+"],
  ["Property types", "SFR, condo, co-op, 2–4 unit"],
];
---

<Layout title={`${p.name} | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <TermSheetHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Qualifies on", value: "Verified liquid assets" },
      { label: "Max LTV", value: "Up to 85% (primary)" },
      { label: "Loan amounts", value: "$200K–$3M+" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Start a pre-qual</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </TermSheetHero>

  <TermSheet>
    <FormCard slot="form" title="Want to see what your assets qualify you for?" sub="Tell us your asset profile and we'll calculate your qualifying income." formSource="loan-asset-utilization" />

    <Chapter eyebrow="The numbers" title="What to expect.">
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <p class="mt-4 text-[var(--color-text-muted)]">Final terms depend on asset profile, FICO, LTV, and property type.</p>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {numbers.map(([k, v]) => (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">{k}</dt>
              <dd class="text-[var(--color-text)]">{v}</dd>
            </div>
          ))}
        </dl>
        <p class="text-xs text-[var(--color-text-muted)] mt-4 leading-relaxed">The chart above is for illustrative purposes only. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice.</p>
      </Chapter>

  <!-- WHO QUALIFIES -->
  <Chapter eyebrow="Who qualifies" title="Your savings are your income." wide>
    <ol class="list-none m-0 p-0 grid sm:grid-cols-2 gap-4">
      {whoQualifies.map((w, i) => (
        <li class="rounded-2xl border-2 border-[var(--color-ink)] p-6">
          <span class="font-mono text-xs text-[var(--color-text-muted)]">0{i + 1}</span>
          <h3 class="mt-3 text-lg font-semibold text-[var(--color-ink)]">{w.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{w.body}</p>
        </li>
      ))}
    </ol>
  </Chapter>

  <!-- WORKED EXAMPLE (black band) -->
  <Chapter dark eyebrow="How we calculate it" title="A worked asset utilization example.">
    <div class="worked space-y-4 text-white/85 leading-relaxed" style="font-size: 1.0625rem;">
      <p>Suppose you're retired with the following verified assets:</p>
      <ul class="calc">
        <li><strong>$600,000</strong> brokerage account (80% eligible = <strong>$480,000</strong>)</li>
        <li><strong>$800,000</strong> IRA (reduced 30% for taxes/penalties = <strong>$560,000</strong> eligible)</li>
        <li><strong>$100,000</strong> checking/savings (100% eligible)</li>
        <li>= <strong>$1,140,000 total eligible assets</strong></li>
      </ul>
      <p>After subtracting $200,000 for required post-closing reserves:</p>
      <ul class="calc">
        <li><strong>$940,000</strong> ÷ <strong>84 months</strong> = <strong>$11,190 / month qualifying income</strong></li>
      </ul>
      <p>
        That $11,190/month supports a mortgage qualification without any W-2, Social Security, or pension income required, and without any obligation to actually liquidate your portfolio.
      </p>
      <p class="fine"><em>Illustrative only. Retirement account reductions, program terms, and reserve requirements vary by program. Cliffco's underwriters determine final qualifying income based on documentation submitted.</em></p>
    </div>
  </Chapter>

  <!-- FAQ -->
  <Chapter rule={false} eyebrow="FAQ" title="How your assets become your income.">
    <FaqList items={faq} />
  </Chapter>
  </TermSheet>


  <CtaBand title="Have savings or investments? They may count toward qualifying income." text="A Cliffco loan officer will run the numbers for your specific asset profile. No credit pull to start.">
    <a href="#contact" class="btn btn-primary">Start a pre-qual</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>

<style>
  .worked :global(.calc) { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgb(255 255 255 / 0.4); }
  .worked :global(.calc li) { padding: 0.875rem 0; border-bottom: 1px solid rgb(255 255 255 / 0.15); color: #fff; font-family: var(--font-mono); font-size: 0.9375rem; }
  .worked :global(strong) { color: #fff; }
  .worked :global(.fine) { font-size: 0.875rem; color: rgb(255 255 255 / 0.55); }
</style>
