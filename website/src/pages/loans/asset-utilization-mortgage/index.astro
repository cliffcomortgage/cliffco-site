---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";
import ContactForm from "../../../components/forms/ContactForm.astro";

const p = product("asset-utilization-mortgage")!;
const today = new Date().toISOString().slice(0, 10);

const faq = [
  {
    question: "What is an asset utilization mortgage?",
    answer: "An asset utilization mortgage (also called asset depletion) creates qualifying income from verified liquid assets rather than from a paycheck or business revenue. Cliffco divides total verified eligible assets by a program-defined number of months to arrive at a monthly qualifying income figure. Asset-derived income can stand alone or be combined with any other documented income, letting borrowers qualify — or qualify for more — based on what they have saved and invested, not only what they earn on paper.",
  },
  {
    question: "What assets count?",
    answer: "Cliffco accepts the following asset types: checking accounts, savings accounts, money market accounts, cash value of life insurance, stocks, bonds, and mutual funds (at 80% of market value), and retirement accounts (IRA, 401(k), pension). Retirement accounts are reduced by 30% to account for early withdrawal taxes and penalties. Cryptocurrency may also count if it meets seasoning requirements and has been liquidated into a checking or savings account. Net proceeds from the sale of real estate may be eligible if the property was owned for at least 6 months and the funds have been deposited — the type of account they are deposited into determines how they are treated for qualifying. Business accounts do not count.",
  },
  {
    question: "How is qualifying income calculated?",
    answer: "Cliffco takes total verified eligible assets, applies any applicable retirement account reduction, subtracts the required post-closing reserves, and divides the remaining balance by the program term (60–84 months). For example: $1,500,000 in verified assets, less $300,000 reserves, divided by 84 months = $14,286/month qualifying income.",
  },
  {
    question: "Do I need any other income?",
    answer: "Not necessarily. Many asset utilization programs qualify borrowers entirely on asset-derived income. If you also have Social Security, pension income, rental income, or other documented income, Cliffco combines it with the asset-derived figure to maximize your qualifying income.",
  },
  {
    question: "Is this a good fit for retirees?",
    answer: "Asset utilization is one of the strongest Non-QM programs for retirees. If you've built significant savings through brokerage accounts, IRAs, and bank accounts but your W-2 income is zero, this program sees the financial picture that a conventional underwriter would miss entirely.",
  },
  {
    question: "Do I actually have to deplete my assets?",
    answer: "No. Asset utilization is an income-calculation method used to qualify you for the loan. It does not create any obligation to liquidate your portfolio. Most borrowers in this program keep their assets fully intact and service the mortgage from ongoing cash flow, Social Security, dividends, or rental income.",
  },
  {
    question: "What if my assets are in a joint account?",
    answer: "Joint accounts with a non-borrowing spouse or domestic partner are eligible with the right documentation. If the joint holder is not contributing income or deposits to the account, a borrower affidavit is required to validate the balance. If the joint holder is contributing income or deposits, the source must be clearly identified (such as direct deposit, SSI, or trust income) and those amounts will be subtracted from the qualifying analysis. In all cases, a relationship letter must be present in the file.",
  },
];

const schema = [
  mortgageLoanSchema(p, { rateRange: { min: 6.5, max: 8.75 } }),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-06-11",
    dateModified: today,
    authorSlug: "christopher-clifford",
  }),
];
---

<Layout title={`${p.name} | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <section class="container-wide pt-12 pb-5">
    <p class="eyebrow">{p.category}</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">{p.name}</h1>
    <p class="lead mt-6">{p.oneLiner}</p>
  </section>

  <section class="bg-white pb-12">
    <div class="container-wide">
      <p class="lead">{p.directAnswer}</p>
    </div>
  </section>

  <!-- WHO QUALIFIES -->
  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow">Who qualifies</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Your savings are your income.</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="card">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">Retirees</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Homeowners and buyers who have left the workforce and have substantial savings, IRA, or brokerage assets but no W-2 income to qualify conventionally.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">Pre-retirees in transition</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Borrowers who have wound down a business, taken early retirement, or are between careers with substantial liquid savings but a gap in W-2 history.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">High-net-worth buyers</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Wealthy borrowers whose income is structured to minimize W-2 receipts — dividends, capital gains, deferred compensation — but who hold significant investable assets.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">Real estate investors</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Investors with substantial liquid assets who want to add a primary residence or second home without relying on complex rental income documentation.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">Borrowers supplementing income</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Anyone who has savings, investments, or retirement accounts and needs extra qualifying power. Asset-derived income can be layered on top of W-2, rental, Social Security, or any other documented income to close a qualifying gap.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT'S CALCULATED -->
  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">How we calculate it</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">A worked asset utilization example.</h2>
      <p class="mt-6 max-w-2xl">Suppose you're retired with the following verified assets:</p>
      <ul class="mt-4 max-w-2xl">
        <li><strong>$600,000</strong> brokerage account (80% eligible = <strong>$480,000</strong>)</li>
        <li><strong>$800,000</strong> IRA (reduced 30% for taxes/penalties = <strong>$560,000</strong> eligible)</li>
        <li><strong>$100,000</strong> checking/savings (100% eligible)</li>
        <li>= <strong>$1,140,000 total eligible assets</strong></li>
      </ul>
      <p class="mt-4 max-w-2xl">After subtracting $200,000 for required post-closing reserves:</p>
      <ul class="mt-4 max-w-2xl">
        <li><strong>$940,000</strong> ÷ <strong>84 months</strong> = <strong>$11,190 / month qualifying income</strong></li>
      </ul>
      <p class="mt-4 max-w-2xl">
        That $12,619/month supports a mortgage qualification without any W-2, Social Security, or pension income required — and without any obligation to actually liquidate your portfolio.
      </p>
      <p class="text-sm text-[var(--color-text-muted)] mt-4 max-w-2xl">
        <em>Illustrative only. Retirement account reductions, program terms, and reserve requirements vary by program. Cliffco's underwriters determine final qualifying income based on documentation submitted.</em>
      </p>
    </div>
  </section>

  <!-- THE NUMBERS -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">The numbers</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">What to expect.</h2>
        <p class="mt-4 text-[var(--color-text-muted)]">Final terms depend on asset profile, FICO, LTV, and property type.</p>
      </div>
      <dl class="space-y-3">
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Rate range</dt><dd class="text-[var(--color-text-muted)]">6.50%–8.75%</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Min eligible assets (illustrative)</dt><dd class="text-[var(--color-text-muted)]">$1M+</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Retirement account reduction</dt><dd class="text-[var(--color-text-muted)]">30%</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Program term (divisor)</dt><dd class="text-[var(--color-text-muted)]">60–84 months</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Max LTV</dt><dd class="text-[var(--color-text-muted)]">up to 85% (primary) / up to 80% (investment)</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Min FICO</dt><dd class="text-[var(--color-text-muted)]">660 (best pricing 720+)</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Loan amounts</dt><dd class="text-[var(--color-text-muted)]">$200K–$3M+</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Property types</dt><dd class="text-[var(--color-text-muted)]">SFR, condo, co-op, 2–4 unit</dd></div>
        <p class="text-xs text-[var(--color-text-muted)] mt-4 leading-relaxed">The chart above is for illustrative purposes only. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice.</p>
      </dl>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">Frequently asked</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Asset utilization questions, answered.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Have savings or investments? They may count toward qualifying income.</h2>
      <p class="lead mt-4 text-white/85">A Cliffco loan officer will run the numbers for your specific asset profile. No credit pull to start.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Start a pre-qual</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <p class="eyebrow">Get in touch</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Want to see what your assets qualify you for?</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">No credit pull. Tell us your asset profile and we'll calculate your qualifying income.</p>
      <div class="mt-8">
        <ContactForm
          formTo="websiteleads@cliffcomortgage.com,cliffcorpteam@cliffcomortgage.com"
          formSource="loan-asset-utilization"
        />
      </div>
    </div>
  </section>
</Layout>
