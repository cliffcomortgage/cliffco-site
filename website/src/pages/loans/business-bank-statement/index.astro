---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("business-bank-statement")!;

const faq = [
  { question: "What is a business bank statement loan?", answer: "A business bank statement loan qualifies self-employed business owners using 12 or 24 months of business bank statements instead of tax returns or W-2s. The lender applies an expense ratio (typically 50%) to gross deposits to calculate qualifying income, making this ideal for profitable businesses whose tax returns understate actual cash flow." },
  { question: "Who qualifies for a business bank statement loan?", answer: "Business owners who file taxes as an LLC, S-Corp, sole proprietor, or partnership (and whose net income on tax returns is reduced by legitimate business deductions) are the ideal fit. If your business is profitable but your 1040 makes you look broke, this is your program." },
  { question: "How is qualifying income calculated?", answer: "Cliffco takes 12 (or 24) months of business bank statement deposits, subtracts a standard expense ratio (typically 50% for most business types; lower ratios apply for certain industries), and uses the resulting figure as gross monthly income for qualification. LLCs and S-Corps with CPA-prepared P&L statements may qualify for a lower expense ratio." },
  { question: "What credit score do I need?", answer: "Most business bank statement programs start at a 620-640 minimum FICO, with best pricing above 700-720. Lower scores are possible with strong compensating factors: higher down payment, strong reserves, or a lower LTV." },
  { question: "How does this differ from the personal bank statement program?", answer: "Personal bank statement loans use a 12 or 24 month average of deposits from the business bank statements to qualify. Personal bank statement loans use business account transfers only and are more appropriate when your business and personal finances are clearly separated." },
  { question: "How fast can Cliffco close a business bank statement loan?", answer: "Cliffco typically closes business bank statement loans in 21-30 days with a complete file: business bank statements, CPA/Borrower Business Narrative, and the subject property appraisal. Rush closings are possible for purchase contracts with tight timelines." },
];

const schema = [
  mortgageLoanSchema(p, { rateRange: { min: 7.0, max: 9.5 } }),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];
import TermSheetHero from "../../../components/asym/TermSheetHero.astro";
import TermSheet from "../../../components/asym/TermSheet.astro";
import Chapter from "../../../components/asym/Chapter.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const numbers = [
  ["Statement period", "12 or 24 months"],
  ["Rate range", "7.00%-9.50%"],
  ["Expense ratio", "typically 50% (varies by industry)"],
  ["Max LTV", "up to 90%"],
  ["Min FICO", "620 (best pricing 720+)"],
  ["Loan amounts", "$150K-$3M+"],
  ["Property types", "SFR, 2-4 unit, condo, PUD, co-ops"],
];
---

<Layout title={`${p.name} | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <TermSheetHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Statement period", value: "12 or 24 months" },
      { label: "Max LTV", value: "Up to 90%" },
      { label: "Loan amounts", value: "$150K–$3M+" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </TermSheetHero>

  <TermSheet>
    <FormCard slot="form" title="See what your business deposits qualify you for." sub="Tell us about your business and we'll run the numbers using your bank statements." formSource="loan-bank-statement" />

    <Chapter eyebrow="The numbers" title="What to expect.">
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {numbers.map(([k, v]) => (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">{k}</dt>
              <dd class="text-[var(--color-text)]">{v}</dd>
            </div>
          ))}
        </dl>
        <p class="text-xs text-[var(--color-text-muted)] mt-4 leading-relaxed">The chart above is for illustrative purposes only. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice.</p>
      </Chapter>

  <!-- PAIR WITH DSCR (black band) -->
  <Chapter dark eyebrow="Pair with DSCR" title="Own a business and investment properties? We can handle both.">
    <p class="text-white/85 leading-relaxed" style="font-size: 1.125rem;">
      Many of Cliffco's business bank statement borrowers are also real estate investors. We combine
      the business bank statement program for your primary residence with DSCR financing for your
      investment portfolio: one relationship, one underwriting team.
    </p>
    <a href="/loans/dscr/" class="btn btn-secondary mt-8 !border-white !text-white">See DSCR for investors →</a>
  </Chapter>

  <!-- FAQ -->
  <Chapter rule={false} eyebrow="FAQ" title="Common questions from business owners.">
    <FaqList items={faq} />
  </Chapter>
  </TermSheet>


  <CtaBand title="Self-employed and ready to buy?" text="Send us 12 months of business bank statements. Pre-qual in one business day.">
    <a href="#contact" class="btn btn-primary">Get Pre-Qualified</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
