---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("va")!;

const faq = [
  { question: "Who is eligible for a VA loan?", answer: "Active-duty service members, veterans with an honorable discharge, National Guard and Reserve members (with qualifying service), and surviving spouses of service members who died in the line of duty or from a service-connected disability may be eligible. Eligibility is confirmed through a Certificate of Eligibility (COE), which Cliffco can pull directly from the VA system." },
  { question: "Is there really no down payment required?", answer: "For most VA purchases, yes. Qualified borrowers can finance up to 100% of the home's value with no down payment and no PMI. A funding fee applies (typically 2.15%–3.3% for first use), which can be financed into the loan. Veterans with a VA disability rating of 10% or more are exempt from the funding fee." },
  { question: "What is the VA funding fee?", answer: "The VA funding fee helps sustain the program. For a first use with no down payment, it's 2.15% of the loan amount for most veterans (3.3% for subsequent use). With 5%+ down it drops to 1.5%, and 10%+ down reduces it further to 1.25%. Veterans receiving VA disability compensation are exempt entirely." },
  { question: "Is there a VA loan limit in 2026?", answer: "As of 2020, VA loan limits were removed for eligible borrowers with full VA entitlement. There is no cap on how much you can borrow, though lenders still apply their own underwriting standards. Borrowers with remaining entitlement (partial) may still be subject to county-level limits." },
  { question: "Can I use a VA loan to buy an investment property or second home?", answer: "No. VA loans are restricted to primary residences only. However, you can use a VA loan to buy a multi-family property (up to 4 units) as long as you occupy one unit." },
  { question: "Can I refinance with a VA loan?", answer: "Yes. VA offers two refinance options: the Interest Rate Reduction Refinance Loan (IRRRL), sometimes called the VA Streamline, which simplifies refinancing an existing VA loan; and the VA cash-out refinance, which allows eligible borrowers to access equity up to 90% LTV." },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];

import TermSheetHero from "../../../components/asym/TermSheetHero.astro";
import TermSheet from "../../../components/asym/TermSheet.astro";
import Chapter from "../../../components/asym/Chapter.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const glance = [
  ["Down payment", "0% for eligible borrowers with full entitlement"],
  ["Mortgage insurance", "None (VA funding fee applies instead)"],
  ["Funding fee", "2.15% (first use, 0% down); exempt for 10%+ disability"],
  ["Loan limit", "No cap with full entitlement (as of 2020)"],
  ["Eligible property types", "Primary residence, 1–4 units"],
  ["Min FICO (Cliffco)", "580 (program dependent)"],
];
---

<Layout title={`VA Loans | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <TermSheetHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Down payment", value: "0% with full entitlement" },
      { label: "Mortgage insurance", value: "None" },
      { label: "Min FICO (Cliffco)", value: "580" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get a VA pre-qual</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </TermSheetHero>

  <TermSheet>
    <FormCard slot="form" title="Served your country. Let's put your VA benefit to work." sub="We'll confirm your entitlement and show you what you can buy without a down payment." formSource="loan-va" />

    <Chapter eyebrow="VA benefit at a glance" title="No down payment. No mortgage insurance.">
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {glance.map(([k, v]) => (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">{k}</dt>
              <dd class="text-[var(--color-text)]">{v}</dd>
            </div>
          ))}
        </dl>
      </Chapter>

  <!-- FAQ -->
  <Chapter eyebrow="FAQ" title="Common VA loan questions.">
    <FaqList items={faq} />
  </Chapter>
  </TermSheet>


  <CtaBand title="You served. Zero down is your benefit." text="A Cliffco loan officer can pull your Certificate of Eligibility and pre-qual you in one business day.">
    <a href="#contact" class="btn btn-primary">Get a VA pre-qual</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
