---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { PRODUCTS, pillarProducts } from "../../data/products";

// Home purchase + refinance programs lead; specialty programs follow.
const HOME_CARDS: Record<string, string> = {
  conventional: "As little as 3% down",
  fha: "3.5% down",
  va: "0% down",
  usda: "0% down",
};
const isHomeLoan = (p: (typeof PRODUCTS)[number]) => p.category === "Conventional / Government";
const homeCards = PRODUCTS.filter((p) => p.slug in HOME_CARDS);
const homeMore = PRODUCTS.filter((p) => isHomeLoan(p) && !(p.slug in HOME_CARDS));
const specialty = pillarProducts();
const specialtyMore = PRODUCTS.filter((p) => !isHomeLoan(p) && !p.hasPillar);
import TermSheetHero from "../../components/asym/TermSheetHero.astro";
import TermSheet from "../../components/asym/TermSheet.astro";
import Chapter from "../../components/asym/Chapter.astro";
import CtaBand from "../../components/asym/CtaBand.astro";
import { COMPANY } from "../../data/company";
---

<Layout
  title="Mortgage Loan Programs | Conventional, FHA, VA, USDA & More | Cliffco"
  description="Cliffco's full loan menu: conventional, FHA, VA, and USDA loans for buying or refinancing a home, plus HELOCs, renovation loans, and specialty programs for self-employed borrowers, investors, and homeowners 62+."
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
  ]} />

  <TermSheetHero
    eyebrow="Loans"
    lead="Buying your first home, moving up, or refinancing? Start with the core programs below. And if your situation is less typical, we have specialty programs for that too."
    facts={homeCards.map((p) => ({ label: HOME_CARDS[p.slug], value: p.shortName }))}
  >
    Every loan we lend on.
    <Fragment slot="actions">
      <a href="#home-loans" class="btn btn-primary">See home loans</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </TermSheetHero>

  <TermSheet>

  <!-- HOME LOANS: buying or refinancing -->
  <Chapter id="home-loans" eyebrow="Buying or refinancing" title="Home loans for first-time and move-up buyers." wide>
    <div class="grid sm:grid-cols-2 gap-4">
      {homeCards.map((p, i) => (
        <a href={`/loans/${p.slug}/`} class={`group rounded-2xl p-7 flex flex-col h-full no-underline transition-colors ${i === 0 ? "bg-[var(--color-ink)] text-white" : "border-2 border-[var(--color-ink)] text-[var(--color-ink)] hover:bg-[var(--color-ink)] hover:text-white"}`}>
          <p class={`font-mono text-[11px] uppercase tracking-[0.12em] ${i === 0 ? "text-white/55" : "text-[var(--color-text-muted)] group-hover:text-white/55"}`}>{HOME_CARDS[p.slug]}</p>
          <h3 class={`mt-3 ${i === 0 ? "!text-white" : "group-hover:!text-white"}`} style="font-size: var(--text-h3); font-weight: 700;">{p.shortName}</h3>
          <p class={`mt-3 text-sm leading-relaxed flex-1 ${i === 0 ? "text-white/80" : "text-[var(--color-text-muted)] group-hover:text-white/80"}`}>{p.oneLiner}</p>
          <span class="mt-5 text-sm font-semibold">Learn more →</span>
        </a>
      ))}
    </div>
    <p class="mt-5">
      <a href="/loans/conventional-government/" class="text-sm font-semibold text-[var(--color-ink)]">Compare conventional, FHA, VA, and USDA side by side →</a>
    </p>
    <ul class="mt-8 list-none m-0 p-0 border-t border-[var(--color-ink)]">
      {homeMore.map((p) => (
        <li class="border-b border-black/15">
          <a href={`/loans/${p.slug}/`} class="group grid sm:grid-cols-[minmax(0,13rem)_1fr_auto] gap-x-6 gap-y-1 py-5 no-underline text-[var(--color-ink)]">
            <span class="font-semibold group-hover:underline">{p.shortName}</span>
            <span class="text-sm text-[var(--color-text-muted)] leading-relaxed">{p.oneLiner}</span>
            <span class="hidden sm:block text-sm font-semibold">→</span>
          </a>
        </li>
      ))}
    </ul>
  </Chapter>

  <!-- HELOC SPOTLIGHT (black band) -->
  <Chapter dark eyebrow="Featured Program" title="HELOC: Approved in 5 minutes. Funded in 5 days.*">
    <p class="text-white/85 leading-relaxed" style="font-size: 1.125rem;">
      Access your home equity as a revolving line of credit without refinancing your first mortgage. Instant approval decision, five-business-day funding.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/loans/heloc/" class="btn btn-primary !bg-white !text-[var(--color-ink)] hover:!bg-white/85">See the HELOC →</a>
      <a href="/contact/" class="btn btn-secondary !border-white !text-white">Talk to a loan officer</a>
    </div>
    <p class="mt-8 text-xs text-white/50 leading-relaxed">
      *Approval may be granted in five minutes but is ultimately subject to verification of income and employment, as well as verification that the property is in at least average condition with a property condition report. Five business day funding timeline assumes closing the loan with our remote online notary. Funding timelines may be longer for loans secured by properties located in counties that do not permit recording of e-signatures or that otherwise require an in-person closing.
    </p>
  </Chapter>

  <!-- SPECIALTY PROGRAMS -->
  <Chapter id="specialty" rule={false} eyebrow="Specialty programs" title="When your situation is less typical." wide>
    <div class="grid sm:grid-cols-2 gap-4">
      {specialty.map((p) => (
        <a href={`/loans/${p.slug}/`} class="group rounded-2xl p-7 flex flex-col h-full no-underline transition-colors border-2 border-[var(--color-ink)] text-[var(--color-ink)] hover:bg-[var(--color-ink)] hover:text-white">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] group-hover:text-white/55">{p.category}</p>
          <h3 class="mt-3 group-hover:!text-white" style="font-size: var(--text-h3); font-weight: 700;">{p.shortName}</h3>
          <p class="mt-3 text-sm leading-relaxed flex-1 text-[var(--color-text-muted)] group-hover:text-white/80">{p.oneLiner}</p>
          <span class="mt-5 text-sm font-semibold">Learn more →</span>
        </a>
      ))}
    </div>
    <ul class="mt-8 list-none m-0 p-0 border-t border-[var(--color-ink)]">
      {specialtyMore.map((p) => (
        <li class="border-b border-black/15">
          <a href={`/loans/${p.slug}/`} class="group grid sm:grid-cols-[minmax(0,13rem)_1fr_auto] gap-x-6 gap-y-1 py-5 no-underline text-[var(--color-ink)]">
            <span class="font-semibold group-hover:underline">{p.shortName}</span>
            <span class="text-sm text-[var(--color-text-muted)] leading-relaxed">{p.oneLiner}</span>
            <span class="hidden sm:block text-sm font-semibold">→</span>
          </a>
        </li>
      ))}
    </ul>
  </Chapter>
  </TermSheet>


  <CtaBand title="Not sure which loan fits?" text="Tell us what you're planning. A licensed Cliffco loan officer responds in one business day.">
    <a href="/get-started/" class="btn btn-primary">Get Started</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
