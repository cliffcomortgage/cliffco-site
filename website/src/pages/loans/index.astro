---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { PRODUCTS, priorityProducts } from "../../data/products";

const priority = priorityProducts();
const supporting = PRODUCTS.filter((p) => !p.isPriority);
---

<Layout
  title="Cliffco Mortgage Loans"
  description="Cliffco's loan products: non-QM and self-employed, reverse mortgage (HECM and proprietary), DSCR for investors, business bank statement loans, plus conventional, FHA, VA, USDA, and renovation."
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
  ]} />

  <section class="container-wide pt-12 pb-16">
    <p class="eyebrow">Loans</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">Every loan we lend on.</h1>
    <p class="lead mt-6">
      Cliffco's specialty is non-traditional mortgage scenarios: the loans most banks don't
      know how to underwrite. We also do conventional, FHA, VA, USDA, and renovation. Pick a
      product to learn more.
    </p>
  </section>

  <section class="bg-white pb-16">
    <div class="container-wide">
      <h2 class="text-2xl font-semibold text-[var(--color-ink)]">Our specialties</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {priority.map((p) => (
          <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
            <p class="eyebrow">{p.category}</p>
            <h3 class="mt-2" style="font-size: var(--text-h3);">{p.shortName}</h3>
            <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">{p.oneLiner}</p>
            <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
          </a>
        ))}
      </div>

      <!-- HELOC SPOTLIGHT -->
      <div class="mt-12 rounded-2xl bg-[var(--color-rich-black)] p-8 lg:p-10 grid lg:grid-cols-[2fr_1fr] gap-8 items-center">
        <div>
          <p class="eyebrow !text-[var(--color-ice-blue)]">Featured Program</p>
          <h2 class="mt-3 text-white" style="font-size: var(--text-h2);">HELOC: Approved in 5 minutes. Funded in 5 days.<sup class="text-sm">*</sup></h2>
          <p class="mt-4 text-white/85 leading-relaxed">
            Access your home equity as a revolving line of credit without refinancing your first mortgage. Instant approval decision, five-business-day funding.
          </p>
          <p class="mt-5 text-xs text-white/50 leading-relaxed">
            *Approval may be granted in five minutes but is ultimately subject to verification of income and employment, as well as verification that the property is in at least average condition with a property condition report. Five business day funding timeline assumes closing the loan with our remote online notary. Funding timelines may be longer for loans secured by properties located in counties that do not permit recording of e-signatures or that otherwise require an in-person closing.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get Pre-Qualified</a>
          <a href="/contact/" class="btn btn-secondary !border-white !text-white">Talk to a loan officer</a>
        </div>
      </div>

      <h2 class="mt-16 text-2xl font-semibold text-[var(--color-ink)]">Other loan programs</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {supporting.map((p) => (
          <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
            <h3 class="font-semibold">{p.shortName}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] flex-1">{p.oneLiner}</p>
            <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
