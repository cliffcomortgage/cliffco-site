---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { PRODUCTS, priorityProducts } from "../../data/products";

const priority = priorityProducts();
const supporting = PRODUCTS.filter((p) => !p.isPriority);
import TermSheetHero from "../../components/asym/TermSheetHero.astro";
import TermSheet from "../../components/asym/TermSheet.astro";
import Chapter from "../../components/asym/Chapter.astro";
import CtaBand from "../../components/asym/CtaBand.astro";
import { COMPANY } from "../../data/company";
---

<Layout
  title="Mortgage Loan Programs | Non-QM, DSCR, Reverse, FHA & More | Cliffco"
  description="Cliffco's full loan menu: Non-QM and self-employed, reverse mortgage (HECM and proprietary), DSCR for investors, business bank statement loans, conventional, FHA, VA, USDA, and renovation."
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
  ]} />

  <TermSheetHero
    eyebrow="Loans"
    lead="Cliffco's specialty is non-traditional mortgage scenarios: the loans most banks don't know how to underwrite. We also do conventional, FHA, VA, USDA, and renovation. Pick a product to learn more."
    facts={priority.map((p) => ({ label: p.category, value: p.shortName }))}
  >
    Every loan we lend on.
    <Fragment slot="actions">
      <a href="#specialties" class="btn btn-primary">See our specialties</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </TermSheetHero>

  <TermSheet>

  <!-- SPECIALTIES -->
  <Chapter id="specialties" eyebrow="Our specialties" title="The loans other banks turn away." wide>
    <div class="grid sm:grid-cols-2 gap-4">
      {priority.map((p, i) => (
        <a href={`/loans/${p.slug}/`} class={`group rounded-2xl p-7 flex flex-col h-full no-underline transition-colors ${i === 0 ? "bg-[var(--color-ink)] text-white" : "border-2 border-[var(--color-ink)] text-[var(--color-ink)] hover:bg-[var(--color-ink)] hover:text-white"}`}>
          <p class={`font-mono text-[11px] uppercase tracking-[0.12em] ${i === 0 ? "text-white/55" : "text-[var(--color-text-muted)] group-hover:text-white/55"}`}>{p.category}</p>
          <h3 class={`mt-3 ${i === 0 ? "!text-white" : "group-hover:!text-white"}`} style="font-size: var(--text-h3); font-weight: 700;">{p.shortName}</h3>
          <p class={`mt-3 text-sm leading-relaxed flex-1 ${i === 0 ? "text-white/80" : "text-[var(--color-text-muted)] group-hover:text-white/80"}`}>{p.oneLiner}</p>
          <span class="mt-5 text-sm font-semibold">Learn more →</span>
        </a>
      ))}
    </div>
  </Chapter>

  <!-- HELOC SPOTLIGHT (black band) -->
  <Chapter dark eyebrow="Featured Program" title="HELOC: Approved in 5 minutes. Funded in 5 days.*">
    <p class="text-white/85 leading-relaxed" style="font-size: 1.125rem;">
      Access your home equity as a revolving line of credit without refinancing your first mortgage. Instant approval decision, five-business-day funding.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/loans/heloc/" class="btn btn-primary !bg-white !text-[var(--color-ink)] hover:!bg-white/85">See the HELOC →</a>
      <a href="/contact/" class="btn btn-secondary !border-white !text-white">Talk to a loan officer</a>
    </div>
    <p class="mt-8 text-xs text-white/50 leading-relaxed">
      *Approval may be granted in five minutes but is ultimately subject to verification of income and employment, as well as verification that the property is in at least average condition with a property condition report. Five business day funding timeline assumes closing the loan with our remote online notary. Funding timelines may be longer for loans secured by properties located in counties that do not permit recording of e-signatures or that otherwise require an in-person closing.
    </p>
  </Chapter>

  <!-- OTHER PROGRAMS -->
  <Chapter rule={false} eyebrow="Everything else" title="Other loan programs.">
    <ul class="list-none m-0 p-0 border-t border-[var(--color-ink)]">
      {supporting.map((p) => (
        <li class="border-b border-black/15">
          <a href={`/loans/${p.slug}/`} class="group grid sm:grid-cols-[minmax(0,13rem)_1fr_auto] gap-x-6 gap-y-1 py-5 no-underline text-[var(--color-ink)]">
            <span class="font-semibold group-hover:underline">{p.shortName}</span>
            <span class="text-sm text-[var(--color-text-muted)] leading-relaxed">{p.oneLiner}</span>
            <span class="hidden sm:block text-sm font-semibold">→</span>
          </a>
        </li>
      ))}
    </ul>
  </Chapter>
  </TermSheet>


  <CtaBand title="Not sure which loan fits?" text="Tell us your situation. A licensed Cliffco loan officer responds in one business day.">
    <a href="/get-started/" class="btn btn-primary">Get Started</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
