---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { loanOfficer, nmlsConsumerAccessUrl } from "../../../data/loan-officers";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("fix-and-flip")!;
const reviewer = loanOfficer("christopher-clifford-65234")!;
const today = new Date().toISOString().slice(0, 10);

const faq = [
  { question: "What is a fix-and-flip loan?", answer: "A fix-and-flip loan (sometimes called a hard money loan or bridge loan) is short-term financing for the purchase and renovation of an investment property the borrower intends to sell or refinance. Pricing is based on the property's After-Repair Value (ARV) — typically up to 70%–75% of ARV — and Cliffco often finances 90% of the purchase price plus 100% of approved rehab." },
  { question: "How fast can Cliffco close a fix-and-flip loan?", answer: "For experienced investors with complete files, Cliffco closes fix-and-flip loans in 7–10 days. First-time flippers typically close in 14–21 days as we get to know the borrower and the project." },
  { question: "What is the 70% ARV rule?", answer: "The 70% ARV rule is investor shorthand: don't pay more than 70% of the After-Repair Value, minus the cost of repairs, for a flip purchase. Example — ARV $400,000 × 70% = $280,000; minus $60,000 of rehab = $220,000 maximum offer. The 30% gap covers profit, holding costs, and risk. Cliffco's loan amounts align with this discipline." },
  { question: "How do draw schedules work?", answer: "Renovation funds are held in escrow by Cliffco and released in stages as work is completed. A typical schedule has 3–5 draws tied to milestones (demo, framing/MEP, drywall/finishes, final). After each milestone, an inspector verifies progress and Cliffco releases the next draw — usually in 24–48 hours." },
  { question: "Can a first-time flipper qualify?", answer: "Yes — Cliffco lends to first-time flippers with strong files. Compensating factors include construction or general-contractor experience, a reasonable rehab scope (no ground-up new construction for first-timers), liquid reserves, and a partner or contractor with a track record. Pricing is slightly higher and LTV slightly tighter than for experienced flippers." },
  { question: "What's the exit strategy if I can't sell?", answer: "Cliffco's fix-and-flip loans pair naturally with our DSCR program: if the market shifts, the property can be refinanced into a long-term DSCR rental loan instead of sold. This BRRRR-style exit is how many of our investor clients keep building portfolios through any rate environment." },
];

const schema = [
  mortgageLoanSchema(p, { rateRange: { min: 8.5, max: 12.0 } }),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: today,
    dateModified: today,
    authorSlug: reviewer.slug,
  }),
];
---

<Layout title={`${p.name} | Cliffco Hard Money`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <section class="container-wide pt-12 pb-12">
    <p class="eyebrow">{p.category}</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">{p.name}</h1>
    <p class="lead mt-6 max-w-3xl">{p.oneLiner}</p>
  </section>

  <section class="bg-white pb-12">
    <div class="container-prose">
      <div class="direct-answer">{p.directAnswer}</div>
      <div class="reviewed-by mt-6">
        <div><strong>Last reviewed:</strong> {today}</div>
        <div><strong>Reviewed by:</strong> {reviewer.displayName}, {reviewer.title} · NMLS #{reviewer.nmls} · <a href={nmlsConsumerAccessUrl(reviewer.nmls)} rel="noopener">Verify ↗</a></div>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">The numbers</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">What to expect (illustrative).</h2>
      </div>
      <dl class="space-y-3">
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Term</dt><dd class="text-[var(--color-text-muted)]">6–18 months</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Rate range</dt><dd class="text-[var(--color-text-muted)]">8.50%–12.00%</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Origination points</dt><dd class="text-[var(--color-text-muted)]">1–4 points</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Max LTV (purchase)</dt><dd class="text-[var(--color-text-muted)]">up to 90%</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Max LTC (rehab)</dt><dd class="text-[var(--color-text-muted)]">up to 100% of approved scope</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Max LTARV</dt><dd class="text-[var(--color-text-muted)]">65–75%</dd></div>
        <div class="flex justify-between border-b border-[var(--color-mist-gray)] pb-2"><dt>Time to close</dt><dd class="text-[var(--color-text-muted)]">7–10 days (experienced)</dd></div>
      </dl>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide">
      <p class="eyebrow">Pair with DSCR</p>
      <h2 class="mt-3 max-w-3xl" style="font-size: var(--text-h2);">Buy → rehab → sell. Or buy → rehab → rent → refinance to a Cliffco DSCR (BRRRR).</h2>
      <p class="lead mt-4 max-w-3xl text-[var(--color-text-muted)]">
        Most fix-and-flip lenders only do hard money. Cliffco does both — so when the market shifts
        and your spring flip becomes a fall hold, you don't have to start a new lender relationship
        to refinance.
      </p>
      <a href="/loans/dscr/" class="btn btn-secondary mt-6">See DSCR refinance →</a>
    </div>
  </section>

  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-prose">
      <p class="eyebrow">Frequently asked</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Flipper questions, answered.</h2>
      <div class="mt-8 space-y-6">
        {faq.map((q) => (
          <details class="border-b border-[var(--color-mist-gray)] pb-4">
            <summary class="font-semibold text-[var(--color-ink)] cursor-pointer text-lg list-none">{q.question}</summary>
            <p class="mt-3 text-[var(--color-text)]">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Got a deal under contract?</h2>
      <p class="lead mt-4 text-white/85">Send the address, ARV, and rehab scope. Pre-qual in 24h.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Submit a flip deal</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>
</Layout>
