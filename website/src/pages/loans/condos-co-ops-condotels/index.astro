---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("condos-co-ops-condotels")!;

const faq = [
  {
    question: "What makes a condo non-warrantable?",
    answer: "A condo project is non-warrantable when it fails Fannie Mae or Freddie Mac guidelines. Common reasons: more than 50% of units are investor-owned, the HOA is in active litigation, commercial space exceeds 35% of the building, fewer than 51% of units are sold to owner-occupants, or the project has single-entity ownership issues. Non-warrantable condos cannot use conventional or FHA financing and require portfolio or Non-QM programs.",
  },
  {
    question: "What is a co-op and why is financing harder?",
    answer: "In a co-op, residents own shares in a corporation rather than real property. You don't get a deed; you get a proprietary lease. Financing requires co-op board approval (which can take weeks), review of the building's financials, and the lender to accept the proprietary lease as collateral. Many lenders avoid co-ops entirely. Cliffco has deep co-op experience from decades on Long Island and in the New York metro.",
  },
  {
    question: "What is a condotel?",
    answer: "A condotel is a unit inside a hotel-style building that operates as a short-term rental with front-desk services, revenue sharing, and often a mandatory hotel pool program. Because the unit functions as a commercial rental, most conventional lenders won't finance them. Cliffco's Non-QM programs can finance condotel purchases for investors comfortable with the property type.",
  },
  {
    question: "Can I use FHA financing to buy a condo?",
    answer: "Only if the condo project is on HUD's FHA-approved condominium list, or if the lender uses FHA spot approval for individual units. Many buildings aren't approved. Cliffco can check the HUD approval list and, if the building doesn't qualify, offer a portfolio or Non-QM alternative.",
  },
  {
    question: "Can I get a jumbo loan on a New York co-op?",
    answer: "Yes. Cliffco has extensive experience with New York co-op financing including jumbo co-op loans, proprietary-lease review, and co-op board package guidance. Our Long Island offices in Uniondale and Bay Shore handle co-op files regularly.",
  },
  {
    question: "Does Cliffco finance Florida condo non-warrantable units?",
    answer: "Yes. Post-Champlain Towers, Florida passed structural inspection requirements (SIRS) that have made many older Florida condos non-warrantable for conventional financing. Cliffco's Non-QM programs are a common solution for buyers and investors in those buildings.",
  },
];

const schema = [
  mortgageLoanSchema(p),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];

import AsymHero from "../../../components/asym/AsymHero.astro";
import Split from "../../../components/asym/Split.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const propertyTypes = [
  {
    name: "Non-warrantable condos",
    body: "Buildings that fail Fannie/Freddie guidelines due to investor concentration, litigation, commercial space, or single-entity ownership. Common in Florida (post-SIRS), NYC metro, and high-investor-ratio buildings nationwide.",
    points: ["Portfolio and Non-QM programs", "Purchase and cash-out refinance", "Primary, second home, and investment"],
  },
  {
    name: "Co-op apartments",
    body: "Share-based ownership in a cooperative corporation. Financing requires co-op board approval, proprietary lease review, and a lender experienced with co-op collateral. Common in New York City and the NYC suburbs.",
    points: ["Long Island and NYC metro focus", "Conventional and jumbo co-op loans", "Co-op board package guidance"],
  },
  {
    name: "Condotels",
    body: "Hotel-style buildings with mandatory rental pool programs, front-desk services, and short-term occupancy. Almost no conventional lender will touch them. Cliffco's Non-QM and portfolio programs can finance condotel units for investors.",
    points: ["Non-QM / portfolio financing", "Investment property focus", "Florida and resort markets"],
  },
];
---

<Layout title={`${p.name} | Cliffco`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <AsymHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "Non-warrantable condos", value: "Portfolio & Non-QM" },
      { label: "Co-op apartments", value: "Conventional & jumbo" },
      { label: "Condotels", value: "Investor financing" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Get started</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </AsymHero>

  <!-- LEAD FORM + WARRANTABLE VS NON-WARRANTABLE -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <FormCard title="Questions about financing a condo, co-op, or condotel?" sub="Tell us about the property and we'll confirm what financing is available for that building." formSource="loan-condos" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-8">
        <p class="eyebrow">Why this matters</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">Warrantable vs. non-warrantable: the key distinction.</h2>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <div class="mt-8 grid gap-4">
          <article class="rounded-2xl p-6 border-2 border-[var(--color-ink)]">
            <h3 class="font-semibold text-[var(--color-ink)]">Warrantable condos</h3>
            <p class="mt-2 text-sm text-[var(--color-text)] leading-relaxed">The project meets Fannie Mae and Freddie Mac requirements: owner-occupant majority, no significant litigation, limited commercial space, no single entity owning too many units. These can use conventional, FHA, and VA financing at standard rates.</p>
          </article>
          <article class="rounded-2xl p-6 bg-[var(--color-ink)] text-white">
            <h3 class="font-semibold !text-white">Non-warrantable condos</h3>
            <p class="mt-2 text-sm text-white/85 leading-relaxed">One or more Fannie/Freddie guidelines are not met. Standard conventional and FHA programs are unavailable. Rates are typically 0.25–0.75 points higher. Portfolio or Non-QM lending is required. Cliffco handles non-warrantable scenarios daily.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- PROPERTY TYPES -->
  <Split eyebrow="Property types we finance" title="When conventional lenders say no.">
    <ol class="list-none m-0 p-0 border-t border-[var(--color-ink)]">
      {propertyTypes.map((t, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-8 border-b border-black/15">
          <span class="font-mono text-sm text-[var(--color-text-muted)] pt-1">0{i + 1}</span>
          <div>
            <h3 class="text-xl font-semibold text-[var(--color-ink)]">{t.name}</h3>
            <p class="mt-3 text-[var(--color-text)] leading-relaxed">{t.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2 list-none m-0 p-0">
              {t.points.map((pt) => (
                <li class="font-mono text-[11px] uppercase tracking-[0.08em] border border-[var(--color-ink)] rounded-full px-3 py-1.5">{pt}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </Split>

  <!-- FAQ -->
  <Split eyebrow="FAQ" title="Condo, co-op, and condotel questions.">
    <FaqList items={faq} />
  </Split>

  <CtaBand title="Tell us the building. We'll tell you what we can do." text="A licensed Cliffco loan officer responds in one business day.">
    <a href="#contact" class="btn btn-primary">Get started</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
