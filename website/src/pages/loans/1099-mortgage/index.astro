---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../../data/company";
import { product } from "../../../data/products";
import { mortgageLoanSchema, faqPageSchema, articleSchema } from "../../../lib/schema";

const p = product("1099-mortgage")!;

const faq = [
  {
    question: "What is a 1099 mortgage?",
    answer: "A 1099 mortgage qualifies independent contractors, freelancers, and gig workers using their 1099 forms rather than W-2s or personal tax returns. Cliffco applies an expense factor to gross 1099 income to calculate qualifying income. If you earn $120K in 1099s and your tax return shows $40K after deductions, this program qualifies you on a number much closer to what you actually earn.",
  },
  {
    question: "What documentation do I need?",
    answer: "Typically 12 or 24 months of 1099 forms showing the gross income paid to you. Your income is calculated from the 1099 totals rather than the net income on your tax return. Some programs also require your most recent year or two of tax returns for identity and filing verification, but they are not used to calculate qualifying income. Proof of YTD supporting qualifying income required.",
  },
  {
    question: "How is qualifying income calculated?",
    answer: "Cliffco takes your gross 1099 income over 12 or 24 months, applies a standard expense factor of 10%, and uses the result as qualifying monthly income. For example: $130,000 in 1099s over 12 months, less a 10% expense factor = $117,000 annually, or $9,750/month qualifying income.",
  },
  {
    question: "What if I work for multiple clients?",
    answer: "Multiple clients are fine and common. Cliffco combines all 1099 income from all sources when calculating qualifying income. If you receive 1099s from five different clients, all five count toward your total. Proof of YTD supporting qualifying income required.",
  },
  {
    question: "Do I need 2 years of 1099 history?",
    answer: "Most programs require 2 full years of 1099 history. If you recently transitioned from W-2 employment to contracting in the same field, some programs may accept 12 months. Confirm with your loan officer. The longer your 1099 track record, the stronger your file.",
  },
  {
    question: "How is this different from a bank statement loan?",
    answer: "A bank statement loan uses deposits into a business or personal account to verify income, which is best for self-employed business owners. A 1099 loan uses the 1099 forms issued to you by clients, which is better for contractors paid directly by companies that issue 1099-NEC forms. Both bypass the tax return; which fits depends on how your income is structured.",
  },
  {
    question: "Can I qualify if I also have W-2 income?",
    answer: "Yes. If you have a mix of 1099 and W-2 income, Cliffco can combine both sources. The 1099 income is calculated using the expense factor; the W-2 income is taken at face value. Combined, they often produce a stronger qualifying income than either source alone.",
  },
];

const schema = [
  mortgageLoanSchema(p, { rateRange: { min: 6.75, max: 9.0 } }),
  faqPageSchema(faq),
  articleSchema({
    headline: p.name,
    description: p.directAnswer,
    url: `/loans/${p.slug}/`,
    datePublished: "2026-06-11",
    dateModified: "2026-07-15",
  }),
];
import AsymHero from "../../../components/asym/AsymHero.astro";
import Split from "../../../components/asym/Split.astro";
import FormCard from "../../../components/asym/FormCard.astro";
import FaqList from "../../../components/asym/FaqList.astro";
import CtaBand from "../../../components/asym/CtaBand.astro";

const whoQualifies = [
  { title: "Independent contractors", body: "Consultants, IT contractors, tradespeople, and anyone paid for work via 1099-NEC or 1099-MISC, with no employer tax withholding." },
  { title: "Gig workers and platform earners", body: "Drivers, delivery workers, content creators, and others whose income is distributed through platforms that issue 1099s rather than W-2s." },
  { title: "Freelancers with high deductions", body: "Freelancers who legitimately reduce taxable income through business deductions and whose tax return significantly understates actual earnings." },
  { title: "Contractors transitioning from W-2", body: "Recently self-employed borrowers who moved from a W-2 position to contracting in the same field, with 12+ months of 1099 history to document income." },
  { title: "Physicians and medical professionals", body: "MDs, doctors, and other medical professionals who work on a contract or locum tenens basis and receive 1099 income rather than a traditional W-2 salary." },
];
const numbers = [
  ["Rate range", "6.75%–9.00%"],
  ["1099 history required", "12–24 months"],
  ["Max LTV", "up to 85%"],
  ["Min FICO", "660 (best pricing 720+)"],
  ["Loan amounts", "$150K–$3M+"],
  ["Property types", "SFR, 2–4 unit, condo"],
];
---

<Layout title={`${p.name} | Cliffco Mortgage Bankers`} description={p.directAnswer} schema={schema}>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Loans", href: "/loans/" },
    { name: p.shortName, href: `/loans/${p.slug}/` },
  ]} />

  <AsymHero
    eyebrow={p.category}
    lead={p.oneLiner}
    facts={[
      { label: "History required", value: "12–24 months of 1099s" },
      { label: "Max LTV", value: "Up to 85%" },
      { label: "Loan amounts", value: "$150K–$3M+" },
    ]}
  >
    {p.name}
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">Start a pre-qual</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
  </AsymHero>

  <!-- LEAD FORM + THE NUMBERS -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <FormCard title="Have 1099s? Let's see what you qualify for." sub="Tell us about your contracting income and we'll run the numbers." formSource="loan-1099" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-8">
        <p class="eyebrow">The numbers</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">What to expect.</h2>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">{p.directAnswer}</p>
        <p class="mt-4 text-[var(--color-text-muted)]">Final terms depend on FICO, LTV, documentation period, and property type.</p>
        <dl class="mt-8 border-t border-[var(--color-ink)]">
          {numbers.map(([k, v]) => (
            <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
              <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">{k}</dt>
              <dd class="text-[var(--color-text)]">{v}</dd>
            </div>
          ))}
        </dl>
        <p class="text-xs text-[var(--color-text-muted)] mt-4 leading-relaxed">The chart above is for illustrative purposes only. Proof of YTD supporting qualifying income required. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice.</p>
      </div>
    </div>
  </section>

  <!-- WHO QUALIFIES -->
  <Split eyebrow="Who qualifies" title="Your 1099s tell the real story." wide>
    <ol class="list-none m-0 p-0 grid sm:grid-cols-2 gap-4">
      {whoQualifies.map((w, i) => (
        <li class="rounded-2xl border-2 border-[var(--color-ink)] p-6">
          <span class="font-mono text-xs text-[var(--color-text-muted)]">0{i + 1}</span>
          <h3 class="mt-3 text-lg font-semibold text-[var(--color-ink)]">{w.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{w.body}</p>
        </li>
      ))}
    </ol>
  </Split>

  <!-- WORKED EXAMPLE (black band) -->
  <Split dark eyebrow="How we calculate it" title="A worked 1099 income example.">
    <div class="worked space-y-4 text-white/85 leading-relaxed" style="font-size: 1.0625rem;">
      <p>
        Suppose you're a freelance consultant who earned $130,000 in 1099 income last year.
        Your tax return shows $55,000 of net income after business deductions.
        Here's how Cliffco calculates qualifying income on the 1099 program:
      </p>
      <ul class="calc">
        <li><strong>$130,000</strong> (gross 1099 income, 12 months)</li>
        <li><strong>× 90%</strong> (standard factor: 10% expense deduction)</li>
        <li>= <strong>$117,000 / year, or $9,750 / month qualifying income</strong></li>
      </ul>
      <p>
        That $9,750/month qualifies you for significantly more home than the $55K net income
        on your tax return would support, without requiring you to change how you run your business.
      </p>
      <p class="fine"><em>Illustrative only. Expense factors vary by program, documentation, and file strength. Cliffco's underwriters determine the applicable factor based on your documentation.</em></p>
    </div>
  </Split>

  <!-- FAQ -->
  <Split rule={false} eyebrow="FAQ" title="Questions 1099 contractors ask.">
    <FaqList items={faq} />
  </Split>

  <CtaBand title="Have 12 months of 1099s? Let's run the numbers." text="A Cliffco loan officer responds within one business day. No credit pull to start.">
    <a href="#contact" class="btn btn-primary">Start a pre-qual</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>

<style>
  .worked :global(.calc) { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgb(255 255 255 / 0.4); }
  .worked :global(.calc li) { padding: 0.875rem 0; border-bottom: 1px solid rgb(255 255 255 / 0.15); color: #fff; font-family: var(--font-mono); font-size: 0.9375rem; }
  .worked :global(strong) { color: #fff; }
  .worked :global(.fine) { font-size: 0.875rem; color: rgb(255 255 255 / 0.55); }
</style>
