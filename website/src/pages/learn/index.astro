---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";

const articles = [
  {
    category: "Reverse Mortgage",
    title: "Reverse Mortgages: Everything You Need to Know",
    description: "A complete guide to reverse mortgages (HECM) for homeowners 62 and older. Learn how they work, who qualifies, and when one makes sense.",
    href: "/learn/reverse-mortgage-guide/",
  },
  {
    category: "Non-QM",
    title: "Non-QM Loans: The Complete Guide",
    description: "What non-QM mortgages are, who they're for, and how to get one. Plain-English breakdown of bank statement, DSCR, P&L, and more.",
    href: "/learn/non-qm-loans-guide/",
  },
  {
    category: "Investment",
    title: "Investment Mortgages: A Complete Guide",
    description: "How investment property loans work, what they require, and which type fits your situation. From single-family rentals to small multi-family.",
    href: "/learn/what-is-an-investment-mortgage/",
  },
  {
    category: "DSCR",
    title: "DSCR Loans Explained: A Guide for Real Estate Investors",
    description: "How DSCR loans work, who qualifies, and why investors use them to grow portfolios without tying up personal income documents.",
    href: "/learn/dscr-loans-real-estate-investors-guide/",
  },
  {
    category: "First-Time Buyers",
    title: "Down Payment Assistance 101: Your Complete Guide",
    description: "How down payment assistance programs work, who qualifies, and how to apply in New York and New Jersey. Grants, forgivable loans, and more.",
    href: "/learn/down-payment-assistance-programs/",
  },
  {
    category: "Self-Employed",
    title: "7 Smart Tips to Get a Non-QM Mortgage When You're Self-Employed",
    description: "Practical advice for self-employed borrowers navigating the non-QM mortgage process with bank statements, 1099s, and P&L docs.",
    href: "/learn/non-qm-mortgage-self-employed/",
  },
];

const categories = ["All", ...new Set(articles.map((a) => a.category))];
---

<Layout
  title="Mortgage Guides, Explained Plainly | Cliffco Mortgage Bankers"
  description="Clear, jargon-free mortgage guides from Cliffco. Reverse mortgages, non-QM loans, DSCR, down payment assistance, and more — written for real people."
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Mortgage Guides", href: "/learn/" },
  ]} />

  <section class="container-wide pt-12 pb-10">
    <p class="eyebrow">Mortgage Guides</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">Mortgage guides, explained plainly.</h1>
    <p class="lead mt-6 max-w-3xl">
      Most mortgage content is written for other lenders. These guides are written for you. No filler,
      no fine-print traps — just honest explanations of how each loan type works and whether it fits
      your situation.
    </p>
  </section>

  <section class="bg-white pb-16">
    <div class="container-wide">
      <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="Filter by category">
        {categories.map((cat, i) => (
          <button
            class={`filter-pill${i === 0 ? " active" : ""}`}
            data-filter={cat === "All" ? "all" : cat}
            type="button"
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {articles.map((article) => (
          <a
            href={article.href}
            class="article-card card no-underline text-[var(--color-ink)] flex flex-col hover:shadow-md transition-shadow"
            data-category={article.category}
          >
            <p class="eyebrow text-sm">{article.category}</p>
            <h2 class="mt-2 text-xl font-semibold leading-snug">{article.title}</h2>
            <p class="mt-3 text-sm text-[var(--color-text-muted)] flex-1">{article.description}</p>
            <span class="mt-4 text-sm font-medium text-[var(--color-accent)]">Read article →</span>
          </a>
        ))}
      </div>

      <p id="no-results" class="hidden text-center text-[var(--color-text-muted)] text-sm mt-10">
        No guides in this category yet.
      </p>
    </div>
  </section>
</Layout>

<script>
  const pills = document.querySelectorAll(".filter-pill");
  const cards = document.querySelectorAll(".article-card");
  const noResults = document.getElementById("no-results");

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      pills.forEach((p) => p.classList.remove("active"));
      pill.classList.add("active");

      const filter = (pill as HTMLElement).dataset.filter;
      let visible = 0;

      cards.forEach((card) => {
        const show = filter === "all" || (card as HTMLElement).dataset.category === filter;
        (card as HTMLElement).style.display = show ? "" : "none";
        if (show) visible++;
      });

      noResults?.classList.toggle("hidden", visible > 0);
    });
  });
</script>
