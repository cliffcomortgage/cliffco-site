---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { COMPANY_VALUES } from "../../data/company-values";
import StoryHero from "../../components/asym/StoryHero.astro";
import TimelineItem from "../../components/asym/TimelineItem.astro";

const values = COMPANY_VALUES;

const loBenefits = [
  {
    title: "Modern Marketing",
    desc: "In-house marketing support with fast turnaround. Access to a dedicated studio for photos, video, podcasting, and live events, all designed to make you stand out in your market.",
  },
  {
    title: "Technology & AI",
    desc: "We thoughtfully implement AI to help your loans get to the closing table faster. We have powerful automations within sales and marketing that guide insights, decisions, and retention like never before.",
  },
  {
    title: "Mentorship & Training",
    desc: "The Cliffco Circle training portal gives you on-demand access to resources and coaching. Mentorship from leaders who have built books of business from the ground up.",
  },
  {
    title: "Wide Product Selection",
    desc: "Conventional, FHA, VA, USDA, jumbo, DSCR, Non-QM, reverse, renovation: a full product stack so you never have to turn a borrower away.",
  },
  {
    title: "Smart Partnerships",
    desc: "Referral networks, realtor relationships, and co-marketing opportunities built into the platform. You focus on borrowers; we help open the doors.",
  },
];

const corporateRoles = [
