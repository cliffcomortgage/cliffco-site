---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";

const calculators = [
  {
    slug: "payment-estimator",
    title: "Payment Estimator",
    audience: "Buyers & Move-ups",
    description: "See your full monthly payment (P&I, taxes, and insurance) at any purchase price, rate, and down payment.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V13.5zm0 2.25h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V18zm2.498-6.75h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V13.5zm0 2.25h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V18zm2.504-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V18zm2.498-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zM8.25 6h7.5v2.25h-7.5V6zM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.548 4.5 4.553v15.448c0 1.006.807 1.853 1.907 1.98C7.67 22.12 9.805 22.5 12 22.5s4.33-.38 5.593-.519c1.1-.127 1.907-.974 1.907-1.98V4.553c0-1.005-.807-1.853-1.907-1.98A48.507 48.507 0 0012 2.25z" />`,
    color: "blue",
  },
  {
    slug: "budget-builder",
    title: "Budget Builder",
    audience: "Buyers & Move-ups",
    description: "Find the mortgage payment that fits your real monthly budget, before you fall in love with a price point you can't sustain.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z" />`,
    color: "blue",
  },
  {
    slug: "mortgage-readiness",
    title: "Mortgage Readiness Checkup",
    audience: "Buyers & Move-ups",
    description: "Get a clear readiness snapshot and your next steps based on your credit, income, debts, and savings.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    color: "blue",
  },
  {
    slug: "rent-vs-buy",
    title: "Rent vs Buy",
    audience: "First-time buyers",
    description: "Find your break-even year and see exactly how much better or worse buying looks vs. renting at your specific numbers.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />`,
    color: "blue",
  },
  {
    slug: "affordability",
    title: "Affordability Review",
    audience: "First-time buyers",
    description: "Find the price range that works for both your income and your savings, with real down payment scenarios at your number.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    color: "blue",
  },
  {
    slug: "dscr",
    title: "DSCR Calculator",
    audience: "Real estate investors",
    description: "Enter rent and PITIA to see your debt service coverage ratio and whether the property qualifies for a DSCR loan.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />`,
    color: "green",
  },
  {
    slug: "self-employed-income",
    title: "Self-Employed Income",
    audience: "Self-employed & 1099",
    description: "Compare what you qualify for on tax returns vs. bank statements, side by side, in seconds.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />`,
    color: "purple",
  },
  {
    slug: "va-loan",
    title: "VA Loan Payment Estimator",
    audience: "Veterans & service members",
    description: "Estimate your VA loan payment including the funding fee and see how it compares to a conventional loan.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />`,
    color: "orange",
  },
  {
    slug: "refi-checkup",
    title: "Refi Checkup",
    audience: "Homeowners",
    description: "See your monthly savings, break-even point, and net benefit at 2 and 5 years before you refinance.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />`,
    color: "teal",
  },
  {
    slug: "reverse-mortgage",
    title: "Reverse Mortgage Estimator",
    audience: "Homeowners 62+",
    description: "Get a rough estimate of the equity you may be able to access through a HECM reverse mortgage.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />`,
    color: "warm",
  },
  {
    slug: "buydown",
    title: "Buydown Calculator",
    audience: "Buyers & sellers",
    description: "Calculate the exact cost of a 3-2-1, 2-1, or 1-0 temporary buydown. See year-by-year savings and total subsidy for each plan.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L9 12.75l4.286-4.286a11.948 11.948 0 014.306 6.43l.776 2.898m0 0 3.182-5.511m-3.182 5.51-5.511-3.181" />`,
    color: "purple",
  },
  {
    slug: "closing-costs",
    title: "Closing Costs Calculator",
    audience: "All buyers",
    description: "Get an itemized closing cost estimate by state, property type, and purchase price — including taxes, title, lender fees, and prepaids.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 14.25l6-6m4.5-3.493V21.75l-3.75-1.5-3.75 1.5-3.75-1.5-3.75 1.5V4.757c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0c1.1.128 1.907 1.077 1.907 2.185zM9.75 9h.008v.008H9.75V9zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm4.125 4.5h.008v.008h-.008V13.5zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />`,
    color: "green",
  },
];

const colorMap: Record<string, { bg: string; icon: string }> = {
  blue:   { bg: "bg-blue-50",   icon: "text-blue-600" },
  green:  { bg: "bg-green-50",  icon: "text-green-600" },
  purple: { bg: "bg-purple-50", icon: "text-purple-600" },
  orange: { bg: "bg-orange-50", icon: "text-orange-600" },
  teal:   { bg: "bg-teal-50",   icon: "text-teal-600" },
  warm:   { bg: "bg-amber-50",  icon: "text-amber-700" },
};
---

<Layout
  title="Mortgage Calculators | Cliffco Mortgage Bankers"
  description="Twelve free mortgage calculators: payment estimator, DSCR, buydown, closing costs, self-employed income, refi break-even, VA loan, reverse mortgage, rent vs buy, and more."
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Calculators", href: "/mortgage-guides/calculators/" },
  ]} />

  <section class="container-wide pt-14 pb-12">
    <p class="eyebrow">Free tools</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">Run the numbers before you apply.</h1>
    <p class="lead mt-5 max-w-2xl">
      Twelve calculators covering every common mortgage scenario: from first-time buyers and self-employed
      borrowers to investors, veterans, and homeowners considering a refinance, buydown, or reverse mortgage.
    </p>
  </section>

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide">
      <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {calculators.map((c) => {
          const colors = colorMap[c.color];
          return (
            <a
              href={`/mortgage-guides/calculators/${c.slug}/`}
              class="group bg-white rounded-2xl border border-[var(--color-mist-gray)] p-6 no-underline flex flex-col h-full hover:border-[var(--color-accent)]/40 hover:shadow-md transition-all duration-200"
            >
              <div class="flex items-start justify-between mb-4">
                <div class={`w-11 h-11 rounded-xl ${colors.bg} flex items-center justify-center shrink-0`}>
                  <svg class={`w-5 h-5 ${colors.icon}`} fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" set:html={c.icon} />
                </div>
                <span class="text-xs font-semibold text-[var(--color-text-muted)] bg-[var(--color-mist-gray)] px-2.5 py-1 rounded-full">{c.audience}</span>
              </div>
              <h2 class="font-semibold text-[var(--color-ink)] text-lg leading-snug">{c.title}</h2>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">{c.description}</p>
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-accent)] group-hover:gap-2 transition-all">
                Use calculator
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </a>
          );
        })}
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <div class="bg-white rounded-2xl border border-[var(--color-mist-gray)] p-6">
          <p class="eyebrow text-xs mb-2">ITIN loans</p>
          <p class="font-semibold text-[var(--color-ink)]">Buying without a Social Security number?</p>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">ITIN mortgage qualification isn't something a calculator can fully model. Talk to a specialist.</p>
          <a href="/get-started/" class="mt-4 inline-block text-sm font-semibold text-[var(--color-accent)]">Talk to a loan officer →</a>
        </div>
        <div class="bg-white rounded-2xl border border-[var(--color-mist-gray)] p-6">
          <p class="eyebrow text-xs mb-2">Foreign national loans</p>
          <p class="font-semibold text-[var(--color-ink)]">Investing in US property from abroad?</p>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Qualification depends on your country of origin, visa status, and asset documentation.</p>
          <a href="/get-started/" class="mt-4 inline-block text-sm font-semibold text-[var(--color-accent)]">Talk to a loan officer →</a>
        </div>
        <div class="bg-white rounded-2xl border border-[var(--color-mist-gray)] p-6">
          <p class="eyebrow text-xs mb-2">Not sure where to start?</p>
          <p class="font-semibold text-[var(--color-ink)]">Skip the calculator and talk to a real person.</p>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">A Cliffco loan officer can tell you exactly what you qualify for in 24 hours.</p>
          <a href="/get-started/" class="mt-4 inline-block text-sm font-semibold text-[var(--color-accent)]">Get started →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
