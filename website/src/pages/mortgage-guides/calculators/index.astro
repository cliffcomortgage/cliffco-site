---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
---

<Layout
  title="Mortgage Calculators | Cliffco Mortgage Bankers"
  description="Free mortgage calculators from Cliffco. Estimate payments, DSCR ratios, refinance savings, and more."
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Learn", href: "/mortgage-guides/" },
    { name: "Calculators", href: "/mortgage-guides/calculators/" },
  ]} />

  <section class="container-wide pt-12 pb-16">
    <p class="eyebrow">Calculators</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">Run the numbers before you apply.</h1>
    <p class="lead mt-6">
      Mortgage payment estimator, DSCR calculator, refinance break-even, and more (coming soon).
      In the meantime, a loan officer can run any scenario with you in minutes.
    </p>
    <div class="mt-8">
      <a href="/get-started/" class="btn btn-primary">Talk to a loan officer</a>
    </div>
  </section>
</Layout>
