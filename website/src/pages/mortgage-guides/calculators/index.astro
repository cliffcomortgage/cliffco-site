<style>
  .calc-input {
    width: 100%;
    border: 1px solid var(--color-soft-gray);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-ink);
    background: white;
    outline: none;
    transition: border-color 0.15s;
  }
  .calc-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }
</style>

<script>
  function fmt(n: number, decimals = 0): string {
    return n.toLocaleString("en-US", { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
  }
  function fmtMoney(n: number): string {
    return "$" + fmt(Math.round(n));
  }
  function monthlyPI(principal: number, annualRate: number, termYears: number): number {
    const r = annualRate / 100 / 12;
    const n = termYears * 12;
    if (r === 0) return principal / n;
    return principal * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
  }

  // 1. Payment Estimator
  (window as any).calcPayment = function() {
    const price = +(document.getElementById("pe-price") as HTMLInputElement).value;
    const downPct = +(document.getElementById("pe-down") as HTMLInputElement).value;
    const rate = +(document.getElementById("pe-rate") as HTMLInputElement).value;
    const term = +(document.getElementById("pe-term") as HTMLSelectElement).value;
    const taxes = +(document.getElementById("pe-taxes") as HTMLInputElement).value;
    const insurance = +(document.getElementById("pe-insurance") as HTMLInputElement).value;

    const loanAmount = price * (1 - downPct / 100);
    const pi = monthlyPI(loanAmount, rate, term);
    const ti = (taxes + insurance) / 12;
    const total = pi + ti;

    (document.getElementById("pe-pi") as HTMLElement).textContent = fmtMoney(pi);
    (document.getElementById("pe-ti") as HTMLElement).textContent = fmtMoney(ti);
    (document.getElementById("pe-total") as HTMLElement).textContent = fmtMoney(total);
    (document.getElementById("pe-loan-amount") as HTMLElement).textContent = `Loan amount: ${fmtMoney(loanAmount)} | Down payment: ${fmtMoney(price * downPct / 100)}`;
    (document.getElementById("pe-result") as HTMLElement).classList.remove("hidden");
  };

  // 2. DSCR Calculator
  (window as any).calcDSCR = function() {
    const rent = +(document.getElementById("dscr-rent") as HTMLInputElement).value;
    const pi = +(document.getElementById("dscr-pi") as HTMLInputElement).value;
    const taxes = +(document.getElementById("dscr-taxes") as HTMLInputElement).value;
    const ins = +(document.getElementById("dscr-ins") as HTMLInputElement).value;
    const hoa = +(document.getElementById("dscr-hoa") as HTMLInputElement).value;

    const obligation = pi + taxes + ins + hoa;
    const dscr = obligation > 0 ? rent / obligation : 0;
    const cashflow = rent - obligation;

    const ratioEl = document.getElementById("dscr-ratio") as HTMLElement;
    ratioEl.textContent = dscr.toFixed(2);
    ratioEl.className = "text-3xl font-bold mt-1 " + (dscr >= 1.25 ? "text-green-600" : dscr >= 1.0 ? "text-yellow-600" : "text-red-600");

    (document.getElementById("dscr-obligation") as HTMLElement).textContent = fmtMoney(obligation);

    const cfEl = document.getElementById("dscr-cashflow") as HTMLElement;
    cfEl.textContent = (cashflow >= 0 ? "+" : "") + fmtMoney(cashflow);
    cfEl.className = "text-2xl font-bold mt-1 " + (cashflow >= 0 ? "text-green-600" : "text-red-600");

    let verdict = "";
    if (dscr >= 1.25) verdict = "Strong cash flow. This property should qualify at standard DSCR pricing with most lenders.";
    else if (dscr >= 1.10) verdict = "Good coverage. Most lenders will approve at standard pricing at a 1.10+ ratio.";
    else if (dscr >= 1.0) verdict = "Breakeven coverage. Some lenders will approve, but you may need a stronger down payment or credit profile.";
    else verdict = "Below breakeven. This property may not qualify for a standard DSCR loan. A larger down payment or lower rate may help.";

    (document.getElementById("dscr-verdict") as HTMLElement).textContent = verdict;
    (document.getElementById("dscr-result") as HTMLElement).classList.remove("hidden");
  };

  // 3. Budget Builder
  (window as any).calcBudget = function() {
    const income = +(document.getElementById("bb-income") as HTMLInputElement).value;
    const expenses = +(document.getElementById("bb-expenses") as HTMLInputElement).value;
    const savings = +(document.getElementById("bb-savings") as HTMLInputElement).value;
    const rate = +(document.getElementById("bb-rate") as HTMLInputElement).value;

    const maxPayment = income - expenses - savings;
    const remaining = income - expenses - savings - maxPayment;

    // Reverse-engineer purchase price from max payment (assumes 20% down, taxes+insurance ≈ 15% of PI)
    const piCeiling = maxPayment * 0.85;
    const r = rate / 100 / 12;
    const n = 30 * 12;
    const loanFromPI = piCeiling / ((r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1));
    const purchasePrice = loanFromPI / 0.80;

    (document.getElementById("bb-max-payment") as HTMLElement).textContent = fmtMoney(Math.max(0, maxPayment));
    (document.getElementById("bb-purchase-price") as HTMLElement).textContent = fmtMoney(Math.max(0, purchasePrice));
    (document.getElementById("bb-remaining") as HTMLElement).textContent = fmtMoney(Math.max(0, remaining));
    (document.getElementById("bb-result") as HTMLElement).classList.remove("hidden");
  };

  // 4. Self-Employed Income Calculator
  (window as any).calcSelfEmployed = function() {
    const y1 = +(document.getElementById("se-y1") as HTMLInputElement).value;
    const y2 = +(document.getElementById("se-y2") as HTMLInputElement).value;
    const depreciation = +(document.getElementById("se-depreciation") as HTMLInputElement).value;
    const addbacks = +(document.getElementById("se-addbacks") as HTMLInputElement).value;
    const deposits = +(document.getElementById("se-deposits") as HTMLInputElement).value;
    const expenseRatio = +(document.getElementById("se-expense-ratio") as HTMLInputElement).value;

    const convAnnual = y2 < y1
      ? y2 + depreciation + addbacks
      : ((y1 + y2) / 2) + depreciation + addbacks;
    const convMonthly = convAnnual / 12;

    const bankMonthly = (deposits * (1 - expenseRatio / 100)) / 12;

    (document.getElementById("se-conventional") as HTMLElement).textContent = fmtMoney(convMonthly);
    (document.getElementById("se-bankstmt") as HTMLElement).textContent = fmtMoney(bankMonthly);

    const recEl = document.getElementById("se-recommendation") as HTMLElement;
    if (bankMonthly > convMonthly * 1.1) {
      recEl.textContent = "Bank Statement Loan";
    } else if (convMonthly > bankMonthly * 1.1) {
      recEl.textContent = "Conventional";
    } else {
      recEl.textContent = "Compare both";
    }

    (document.getElementById("se-result") as HTMLElement).classList.remove("hidden");
  };

  // 5. Mortgage Readiness Checkup
  (window as any).calcReadiness = function() {
    const credit = +(document.getElementById("mr-credit") as HTMLSelectElement).value;
    const employment = (document.getElementById("mr-employment") as HTMLSelectElement).value;
    const income = +(document.getElementById("mr-income") as HTMLInputElement).value;
    const debt = +(document.getElementById("mr-debt") as HTMLInputElement).value;
    const savings = +(document.getElementById("mr-savings") as HTMLInputElement).value;

    const maxDTI = credit >= 720 ? 0.45 : credit >= 660 ? 0.43 : 0.41;
    const maxTotalDebt = income * maxDTI;
    const availableForHousing = Math.max(0, maxTotalDebt - debt);

    let level = "";
    let steps: string[] = [];

    if (credit < 620) {
      level = "Not Yet Ready";
      steps = ["Your credit score needs to reach at least 620 before most lenders will approve a mortgage.", "Focus on paying down balances and removing errors from your credit report.", "Contact a Cliffco loan officer for a personalized credit improvement plan."];
    } else if (savings < 10000) {
      level = "Building";
      steps = ["You'll need more savings to cover a down payment and closing costs.", "Down payment programs may help if you're a first-time buyer.", "A Cliffco loan officer can show you what down payment assistance programs you qualify for."];
    } else if (employment === "self" || employment === "other") {
      level = "Ready (Non-QM Path)";
      steps = ["Your income type may not qualify for conventional financing.", "Non-QM loan programs (bank statement, 1099, DSCR) were built for your situation.", "Talk to a Cliffco Non-QM specialist to identify the best product."];
    } else if (credit >= 720 && availableForHousing > 1500) {
      level = "Strong";
      steps = ["You're in a solid position. Get pre-approved before you start shopping.", "Keep your credit stable, avoid new debt, and gather two years of tax returns.", "A pre-approval will tell you exactly what purchase price you qualify for."];
    } else {
      level = "Ready";
      steps = ["You have the foundation to move forward.", "Ask your loan officer about the right loan program for your credit and income.", "Getting pre-approved now puts you in the strongest position when you find the right home."];
    }

    (document.getElementById("mr-level") as HTMLElement).textContent = level;
    (document.getElementById("mr-dti-budget") as HTMLElement).textContent = fmtMoney(availableForHousing);

    const stepsEl = document.getElementById("mr-steps") as HTMLElement;
    stepsEl.innerHTML = "<strong>Your next steps:</strong><ul class='list-disc list-inside mt-2 space-y-1'>" + steps.map(s => `<li>${s}</li>`).join("") + "</ul>";

    (document.getElementById("mr-result") as HTMLElement).classList.remove("hidden");
  };

  // 6. Rent vs Buy
  (window as any).calcRentVsBuy = function() {
    const rent = +(document.getElementById("rvb-rent") as HTMLInputElement).value;
    const price = +(document.getElementById("rvb-price") as HTMLInputElement).value;
    const downPct = +(document.getElementById("rvb-down") as HTMLInputElement).value;
    const rate = +(document.getElementById("rvb-rate") as HTMLInputElement).value;
    const appreciation = +(document.getElementById("rvb-appreciation") as HTMLInputElement).value / 100;
    const rentGrowth = +(document.getElementById("rvb-rent-growth") as HTMLInputElement).value / 100;

    const downAmt = price * downPct / 100;
    const loan = price - downAmt;
    const pi = monthlyPI(loan, rate, 30);
    const closingCosts = price * 0.03;

    function yearBuyCost(yr: number): number {
      let total = downAmt + closingCosts;
      for (let m = 1; m <= yr * 12; m++) {
        total += pi;
      }
      const equity = downAmt + (price * Math.pow(1 + appreciation, yr) - price);
      return total - equity;
    }

    function yearRentCost(yr: number): number {
      let total = 0;
      let r = rent;
      for (let y = 0; y < yr; y++) {
        total += r * 12;
        r *= (1 + rentGrowth);
      }
      return total;
    }

    let breakEvenYr = 0;
    for (let yr = 1; yr <= 30; yr++) {
      if (yearBuyCost(yr) <= yearRentCost(yr)) {
        breakEvenYr = yr;
        break;
      }
    }

    const adv5 = yearRentCost(5) - yearBuyCost(5);
    const adv10 = yearRentCost(10) - yearBuyCost(10);

    (document.getElementById("rvb-breakeven") as HTMLElement).textContent = breakEvenYr > 0 ? `Year ${breakEvenYr}` : "After 30 years";

    const adv5El = document.getElementById("rvb-5yr") as HTMLElement;
    adv5El.textContent = (adv5 >= 0 ? "+" : "") + fmtMoney(adv5);
    adv5El.className = "text-2xl font-bold mt-1 " + (adv5 >= 0 ? "text-green-600" : "text-red-600");

    const adv10El = document.getElementById("rvb-10yr") as HTMLElement;
    adv10El.textContent = (adv10 >= 0 ? "+" : "") + fmtMoney(adv10);
    adv10El.className = "text-2xl font-bold mt-1 " + (adv10 >= 0 ? "text-green-600" : "text-red-600");

    (document.getElementById("rvb-result") as HTMLElement).classList.remove("hidden");
  };

  // 7. First-Time Buyer Affordability Review
  (window as any).calcAffordability = function() {
    const income = +(document.getElementById("af-income") as HTMLInputElement).value;
    const debt = +(document.getElementById("af-debt") as HTMLInputElement).value;
    const savings = +(document.getElementById("af-savings") as HTMLInputElement).value;
    const rate = +(document.getElementById("af-rate") as HTMLInputElement).value;

    const monthlyIncome = income / 12;
    const maxDTI = 0.43;
    const availableForHousing = (monthlyIncome * maxDTI) - debt;
    const pi = availableForHousing * 0.85;

    const r = rate / 100 / 12;
    const n = 30 * 12;
    const loanFromPI = pi / ((r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1));
    const priceFromIncome = loanFromPI / 0.80;

    const closingCostPct = 0.03;
    const maxPriceBySavings = savings / (0.20 + closingCostPct);
    const sweetSpot = Math.min(priceFromIncome, maxPriceBySavings);

    (document.getElementById("af-max-income") as HTMLElement).textContent = fmtMoney(priceFromIncome);
    (document.getElementById("af-max-savings") as HTMLElement).textContent = fmtMoney(maxPriceBySavings);
    (document.getElementById("af-sweet-spot") as HTMLElement).textContent = fmtMoney(sweetSpot);

    const scenarios = [
      { label: "3.5% down (FHA)", downPct: 0.035 },
      { label: "5% down", downPct: 0.05 },
      { label: "10% down", downPct: 0.10 },
      { label: "20% down", downPct: 0.20 },
    ];

    const scenariosEl = document.getElementById("af-scenarios") as HTMLElement;
    scenariosEl.innerHTML = "<strong>Monthly payment at your sweet spot price:</strong><div class='grid gap-2 mt-2 sm:grid-cols-2'>" +
      scenarios.map(s => {
        const down = sweetSpot * s.downPct;
        const loanAmt = sweetSpot - down;
        const payment = monthlyPI(loanAmt, rate, 30);
        const canAfford = savings >= down + sweetSpot * closingCostPct;
        return `<div class='p-3 bg-white rounded-lg border border-[var(--color-soft-gray)]'>
          <p class='font-medium text-sm'>${s.label}</p>
          <p class='text-lg font-bold text-[var(--color-accent)]'>${fmtMoney(payment)}/mo P&I</p>
          <p class='text-xs text-[var(--color-text-muted)]'>Down: ${fmtMoney(down)} ${canAfford ? "✓" : "(savings may be short)"}</p>
        </div>`;
      }).join("") + "</div>";

    (document.getElementById("af-result") as HTMLElement).classList.remove("hidden");
  };

  // 8. Reverse Mortgage Estimator
  (window as any).calcReverse = function() {
    const age = +(document.getElementById("rm-age") as HTMLInputElement).value;
    const value = +(document.getElementById("rm-value") as HTMLInputElement).value;
    const balance = +(document.getElementById("rm-balance") as HTMLInputElement).value;

    const hecmLimit = 1209750;
    const lendingLimit = Math.min(value, hecmLimit);
    const ageFactor = Math.min(0.75, 0.40 + (age - 62) * 0.01);
    const grossProceeds = lendingLimit * ageFactor;
    const netProceeds = Math.max(0, grossProceeds - balance);

    (document.getElementById("rm-gross") as HTMLElement).textContent = fmtMoney(grossProceeds);
    (document.getElementById("rm-net") as HTMLElement).textContent = fmtMoney(netProceeds);

    let note = "";
    if (value > hecmLimit) {
      note = `Note: HECM loans are limited to the 2025 FHA lending limit of $1,209,750. Your home value above that limit is not factored into HECM proceeds. A proprietary (jumbo) reverse mortgage may be available for higher-value homes.`;
    } else if (balance > grossProceeds * 0.6) {
      note = "Your existing mortgage balance is substantial relative to your estimated proceeds. You may still qualify, but less equity will remain after payoff.";
    }

    (document.getElementById("rm-note") as HTMLElement).textContent = note;
    (document.getElementById("rm-result") as HTMLElement).classList.remove("hidden");
  };

  // 9. Refi Checkup
  (window as any).calcRefi = function() {
    const balance = +(document.getElementById("rc-balance") as HTMLInputElement).value;
    const currentRate = +(document.getElementById("rc-current-rate") as HTMLInputElement).value;
    const newRate = +(document.getElementById("rc-new-rate") as HTMLInputElement).value;
    const closingCosts = +(document.getElementById("rc-costs") as HTMLInputElement).value;

    const currentPI = monthlyPI(balance, currentRate, 30);
    const newPI = monthlyPI(balance, newRate, 30);
    const monthlySavings = currentPI - newPI;
    const breakEvenMonths = monthlySavings > 0 ? Math.ceil(closingCosts / monthlySavings) : Infinity;

    const net2yr = monthlySavings * 24 - closingCosts;
    const net5yr = monthlySavings * 60 - closingCosts;

    const savingsEl = document.getElementById("rc-monthly-savings") as HTMLElement;
    savingsEl.textContent = fmtMoney(monthlySavings);
    savingsEl.className = "text-2xl font-bold mt-1 " + (monthlySavings > 0 ? "text-green-600" : "text-red-600");

    (document.getElementById("rc-breakeven") as HTMLElement).textContent =
      monthlySavings > 0 ? `${breakEvenMonths} months` : "No savings";

    const n2El = document.getElementById("rc-2yr") as HTMLElement;
    n2El.textContent = (net2yr >= 0 ? "+" : "") + fmtMoney(net2yr);
    n2El.className = "text-2xl font-bold mt-1 " + (net2yr >= 0 ? "text-green-600" : "text-red-600");

    const n5El = document.getElementById("rc-5yr") as HTMLElement;
    n5El.textContent = (net5yr >= 0 ? "+" : "") + fmtMoney(net5yr);
    n5El.className = "text-2xl font-bold mt-1 " + (net5yr >= 0 ? "text-green-600" : "text-red-600");

    let verdict = "";
    if (monthlySavings <= 0) {
      verdict = "A higher rate would increase your payment. Refinancing does not make sense at these rates.";
    } else if (breakEvenMonths <= 24) {
      verdict = `You break even in ${breakEvenMonths} months. This is a strong refinance case if you plan to stay in the home.`;
    } else if (breakEvenMonths <= 48) {
      verdict = `You break even in ${breakEvenMonths} months. Worthwhile if you plan to stay in the home for several years.`;
    } else {
      verdict = `Break-even is ${breakEvenMonths} months out. Consider whether you'll stay long enough to recoup the closing costs.`;
    }

    (document.getElementById("rc-verdict") as HTMLElement).textContent = verdict;
    (document.getElementById("rc-result") as HTMLElement).classList.remove("hidden");
  };

  // 10. VA Loan Payment Estimator
  (window as any).calcVA = function() {
    const price = +(document.getElementById("va-price") as HTMLInputElement).value;
    const downPct = +(document.getElementById("va-down") as HTMLSelectElement).value;
    const rate = +(document.getElementById("va-rate") as HTMLInputElement).value;
    const use = (document.getElementById("va-use") as HTMLSelectElement).value;

    const downAmt = price * downPct / 100;
    const baseLoan = price - downAmt;

    let feeRate = 0;
    if (use === "exempt") {
      feeRate = 0;
    } else if (use === "first") {
      feeRate = downPct >= 10 ? 0.014 : downPct >= 5 ? 0.015 : 0.023;
    } else {
      feeRate = downPct >= 10 ? 0.014 : downPct >= 5 ? 0.015 : 0.036;
    }

    const fundingFee = baseLoan * feeRate;
    const totalLoan = baseLoan + fundingFee;
    const vaPI = monthlyPI(totalLoan, rate, 30);
    const convPI = monthlyPI(baseLoan, rate, 30);
    const savings = convPI - vaPI;

    (document.getElementById("va-loan-amt") as HTMLElement).textContent = fmtMoney(totalLoan);
    (document.getElementById("va-funding-fee") as HTMLElement).textContent =
      use === "exempt" ? "Exempt ($0)" : fmtMoney(fundingFee);
    (document.getElementById("va-monthly-pi") as HTMLElement).textContent = fmtMoney(vaPI);

    const vsEl = document.getElementById("va-vs-conv") as HTMLElement;
    if (use === "exempt") {
      vsEl.textContent = fmtMoney(convPI - monthlyPI(baseLoan, rate, 30)) + " lower";
      vsEl.className = "text-2xl font-bold mt-1 text-green-600";
    } else {
      vsEl.textContent = savings >= 0
        ? fmtMoney(savings) + " lower"
        : fmtMoney(Math.abs(savings)) + " higher";
      vsEl.className = "text-2xl font-bold mt-1 " + (savings >= 0 ? "text-green-600" : "text-red-600");
    }

    (document.getElementById("va-result") as HTMLElement).classList.remove("hidden");
  };
</script>
