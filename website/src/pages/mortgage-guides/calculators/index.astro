---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
---

<Layout
  title="Mortgage Calculators | Cliffco Mortgage Bankers"
  description="Free mortgage calculators from Cliffco. Estimate payments, DSCR ratios, refinance break-even, self-employed income, rent vs buy, and more."
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Calculators", href: "/mortgage-guides/calculators/" },
  ]} />

  <section class="container-wide pt-12 pb-10">
    <p class="eyebrow">Calculators</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">Run the numbers before you apply.</h1>
    <p class="lead mt-6">
      Ten free calculators to help you understand what you qualify for, what you can afford,
      and whether the deal makes sense before you ever sit across from an underwriter.
    </p>
  </section>

  <section class="bg-white pb-20">
    <div class="container-wide space-y-16">

      <!-- 1. Payment Estimator -->
      <div id="payment-estimator" class="scroll-mt-24">
        <div class="border border-[var(--color-mist-gray)] rounded-2xl overflow-hidden">
          <div class="bg-[var(--color-mist-gray)] px-6 py-5">
            <p class="eyebrow text-xs mb-1">Calculator 1</p>
            <h2 class="text-2xl font-semibold text-[var(--color-ink)]">Payment Estimator</h2>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">See your full monthly payment at any purchase price, rate, and down payment.</p>
          </div>
          <div class="p-6">
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Home price ($)</label>
                <input id="pe-price" type="number" value="500000" min="50000" step="5000" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Down payment (%)</label>
                <input id="pe-down" type="number" value="20" min="3" max="50" step="1" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Interest rate (%)</label>
                <input id="pe-rate" type="number" value="7.0" min="1" max="15" step="0.125" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Loan term</label>
                <select id="pe-term" class="calc-input">
                  <option value="30">30-year fixed</option>
                  <option value="20">20-year fixed</option>
                  <option value="15">15-year fixed</option>
                </select>
              </div>
            </div>
            <div class="grid gap-4 md:grid-cols-2 mt-4">
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Annual property taxes ($)</label>
                <input id="pe-taxes" type="number" value="6000" min="0" step="100" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Annual homeowner's insurance ($)</label>
                <input id="pe-insurance" type="number" value="1800" min="0" step="100" class="calc-input" />
              </div>
            </div>
            <button onclick="calcPayment()" class="btn btn-primary mt-5">Calculate</button>
            <div id="pe-result" class="hidden mt-6 p-5 bg-[var(--color-mist-gray)] rounded-xl">
              <div class="grid gap-4 sm:grid-cols-3">
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Principal &amp; Interest</p>
                  <p id="pe-pi" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Taxes &amp; Insurance</p>
                  <p id="pe-ti" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Total Monthly</p>
                  <p id="pe-total" class="text-2xl font-bold text-[var(--color-accent)] mt-1"></p>
                </div>
              </div>
              <p id="pe-loan-amount" class="text-sm text-[var(--color-text-muted)] mt-3"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. DSCR Calculator -->
      <div id="dscr-calculator" class="scroll-mt-24">
        <div class="border border-[var(--color-mist-gray)] rounded-2xl overflow-hidden">
          <div class="bg-[var(--color-mist-gray)] px-6 py-5">
            <p class="eyebrow text-xs mb-1">Calculator 2</p>
            <h2 class="text-2xl font-semibold text-[var(--color-ink)]">DSCR Calculator</h2>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">Find out if your rental property generates enough income to qualify for a DSCR loan.</p>
          </div>
          <div class="p-6">
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Monthly gross rent ($)</label>
                <input id="dscr-rent" type="number" value="2500" min="0" step="50" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Monthly principal &amp; interest ($)</label>
                <input id="dscr-pi" type="number" value="1500" min="0" step="50" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Monthly taxes ($)</label>
                <input id="dscr-taxes" type="number" value="300" min="0" step="25" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Monthly insurance ($)</label>
                <input id="dscr-ins" type="number" value="150" min="0" step="25" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Monthly HOA ($)</label>
                <input id="dscr-hoa" type="number" value="0" min="0" step="25" class="calc-input" />
              </div>
            </div>
            <button onclick="calcDSCR()" class="btn btn-primary mt-5">Calculate DSCR</button>
            <div id="dscr-result" class="hidden mt-6 p-5 bg-[var(--color-mist-gray)] rounded-xl">
              <div class="grid gap-4 sm:grid-cols-3">
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">DSCR Ratio</p>
                  <p id="dscr-ratio" class="text-3xl font-bold mt-1"></p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Total Monthly Obligation</p>
                  <p id="dscr-obligation" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Monthly Cash Flow</p>
                  <p id="dscr-cashflow" class="text-2xl font-bold mt-1"></p>
                </div>
              </div>
              <p id="dscr-verdict" class="mt-3 text-sm font-medium"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Budget Builder -->
      <div id="budget-builder" class="scroll-mt-24">
        <div class="border border-[var(--color-mist-gray)] rounded-2xl overflow-hidden">
          <div class="bg-[var(--color-mist-gray)] px-6 py-5">
            <p class="eyebrow text-xs mb-1">Calculator 3</p>
            <h2 class="text-2xl font-semibold text-[var(--color-ink)]">Budget Builder</h2>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">Find the mortgage payment that fits your actual monthly budget, not just your pre-approval.</p>
          </div>
          <div class="p-6">
            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Monthly take-home pay ($)</label>
                <input id="bb-income" type="number" value="8000" min="0" step="100" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Monthly fixed expenses ($)</label>
                <input id="bb-expenses" type="number" value="3000" min="0" step="100" class="calc-input" />
                <p class="text-xs text-[var(--color-text-muted)] mt-1">Car payments, loans, subscriptions, food, utilities, etc.</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Monthly savings goal ($)</label>
                <input id="bb-savings" type="number" value="500" min="0" step="100" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Expected interest rate (%)</label>
                <input id="bb-rate" type="number" value="7.0" min="1" max="15" step="0.125" class="calc-input" />
              </div>
            </div>
            <button onclick="calcBudget()" class="btn btn-primary mt-5">Build My Budget</button>
            <div id="bb-result" class="hidden mt-6 p-5 bg-[var(--color-mist-gray)] rounded-xl">
              <div class="grid gap-4 sm:grid-cols-3">
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Comfortable Payment Ceiling</p>
                  <p id="bb-max-payment" class="text-2xl font-bold text-[var(--color-accent)] mt-1"></p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Estimated Purchase Price</p>
                  <p id="bb-purchase-price" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Left After Housing</p>
                  <p id="bb-remaining" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                </div>
              </div>
              <p class="text-xs text-[var(--color-text-muted)] mt-3">Estimated purchase price assumes 20% down payment and 30-year term. Add taxes and insurance to your ceiling before using this number to shop.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Self-Employed Income Calculator -->
      <div id="self-employed-calculator" class="scroll-mt-24">
        <div class="border border-[var(--color-mist-gray)] rounded-2xl overflow-hidden">
          <div class="bg-[var(--color-mist-gray)] px-6 py-5">
            <p class="eyebrow text-xs mb-1">Calculator 4</p>
            <h2 class="text-2xl font-semibold text-[var(--color-ink)]">Self-Employed Income Calculator</h2>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">Compare your qualifying income under conventional guidelines vs. a bank statement loan.</p>
          </div>
          <div class="p-6">
            <p class="text-sm font-medium text-[var(--color-ink)] mb-4">Conventional Path (Tax Returns)</p>
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Year 1 net income ($)</label>
                <input id="se-y1" type="number" value="80000" min="0" step="1000" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Year 2 net income ($)</label>
                <input id="se-y2" type="number" value="95000" min="0" step="1000" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Depreciation add-back ($)</label>
                <input id="se-depreciation" type="number" value="5000" min="0" step="500" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Other add-backs ($)</label>
                <input id="se-addbacks" type="number" value="0" min="0" step="500" class="calc-input" />
              </div>
            </div>
            <p class="text-sm font-medium text-[var(--color-ink)] mt-6 mb-4">Bank Statement Path</p>
            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">12-month total deposits ($)</label>
                <input id="se-deposits" type="number" value="180000" min="0" step="5000" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Expense ratio (%)</label>
                <input id="se-expense-ratio" type="number" value="40" min="0" max="90" step="5" class="calc-input" />
                <p class="text-xs text-[var(--color-text-muted)] mt-1">Lender-assigned ratio for your business type (typically 30–50%)</p>
              </div>
            </div>
            <button onclick="calcSelfEmployed()" class="btn btn-primary mt-5">Compare Paths</button>
            <div id="se-result" class="hidden mt-6 p-5 bg-[var(--color-mist-gray)] rounded-xl">
              <div class="grid gap-4 sm:grid-cols-3">
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Conventional Qualifying Income</p>
                  <p id="se-conventional" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                  <p class="text-xs text-[var(--color-text-muted)] mt-1">per month</p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Bank Statement Qualifying Income</p>
                  <p id="se-bankstmt" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                  <p class="text-xs text-[var(--color-text-muted)] mt-1">per month</p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Recommended Path</p>
                  <p id="se-recommendation" class="text-lg font-bold text-[var(--color-accent)] mt-1"></p>
                </div>
              </div>
              <p class="text-xs text-[var(--color-text-muted)] mt-3">This estimate is illustrative. A Cliffco loan officer will calculate your exact qualifying income using your specific documentation.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Mortgage Readiness Checkup -->
      <div id="mortgage-readiness" class="scroll-mt-24">
        <div class="border border-[var(--color-mist-gray)] rounded-2xl overflow-hidden">
          <div class="bg-[var(--color-mist-gray)] px-6 py-5">
            <p class="eyebrow text-xs mb-1">Calculator 5</p>
            <h2 class="text-2xl font-semibold text-[var(--color-ink)]">Mortgage Readiness Checkup</h2>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">Get a snapshot of where you stand before you apply.</p>
          </div>
          <div class="p-6">
            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Credit score range</label>
                <select id="mr-credit" class="calc-input">
                  <option value="760">760 or above</option>
                  <option value="740">740–759</option>
                  <option value="720">720–739</option>
                  <option value="700">700–719</option>
                  <option value="680">680–699</option>
                  <option value="660">660–679</option>
                  <option value="640">640–659</option>
                  <option value="620">620–639</option>
                  <option value="600">Below 620</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Employment status</label>
                <select id="mr-employment" class="calc-input">
                  <option value="w2">W-2 employed</option>
                  <option value="self">Self-employed / 1099</option>
                  <option value="retired">Retired / fixed income</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Gross monthly income ($)</label>
                <input id="mr-income" type="number" value="8000" min="0" step="500" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Monthly debt payments ($)</label>
                <input id="mr-debt" type="number" value="500" min="0" step="100" class="calc-input" />
                <p class="text-xs text-[var(--color-text-muted)] mt-1">Car loans, student loans, credit cards (minimum), other obligations</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Savings available ($)</label>
                <input id="mr-savings" type="number" value="60000" min="0" step="1000" class="calc-input" />
                <p class="text-xs text-[var(--color-text-muted)] mt-1">Liquid funds for down payment, closing costs, and reserves</p>
              </div>
            </div>
            <button onclick="calcReadiness()" class="btn btn-primary mt-5">Check My Readiness</button>
            <div id="mr-result" class="hidden mt-6 p-5 bg-[var(--color-mist-gray)] rounded-xl">
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Readiness Level</p>
                  <p id="mr-level" class="text-2xl font-bold mt-1"></p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Estimated Max DTI Budget</p>
                  <p id="mr-dti-budget" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                  <p class="text-xs text-[var(--color-text-muted)]">available for housing payment</p>
                </div>
              </div>
              <div id="mr-steps" class="mt-4 text-sm text-[var(--color-ink)]"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 6. Rent vs Buy -->
      <div id="rent-vs-buy" class="scroll-mt-24">
        <div class="border border-[var(--color-mist-gray)] rounded-2xl overflow-hidden">
          <div class="bg-[var(--color-mist-gray)] px-6 py-5">
            <p class="eyebrow text-xs mb-1">Calculator 6</p>
            <h2 class="text-2xl font-semibold text-[var(--color-ink)]">Rent vs Buy Calculator</h2>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">See when buying beats renting based on your actual numbers.</p>
          </div>
          <div class="p-6">
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Current monthly rent ($)</label>
                <input id="rvb-rent" type="number" value="2200" min="0" step="50" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Home purchase price ($)</label>
                <input id="rvb-price" type="number" value="400000" min="0" step="5000" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Down payment (%)</label>
                <input id="rvb-down" type="number" value="10" min="3" max="50" step="1" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Interest rate (%)</label>
                <input id="rvb-rate" type="number" value="7.0" min="1" max="15" step="0.125" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Annual home appreciation (%)</label>
                <input id="rvb-appreciation" type="number" value="3" min="0" max="15" step="0.5" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Annual rent increase (%)</label>
                <input id="rvb-rent-growth" type="number" value="3" min="0" max="10" step="0.5" class="calc-input" />
              </div>
            </div>
            <button onclick="calcRentVsBuy()" class="btn btn-primary mt-5">Compare</button>
            <div id="rvb-result" class="hidden mt-6 p-5 bg-[var(--color-mist-gray)] rounded-xl">
              <div class="grid gap-4 sm:grid-cols-3">
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Break-Even Point</p>
                  <p id="rvb-breakeven" class="text-2xl font-bold text-[var(--color-accent)] mt-1"></p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">5-Year Buy Advantage</p>
                  <p id="rvb-5yr" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">10-Year Buy Advantage</p>
                  <p id="rvb-10yr" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                </div>
              </div>
              <p class="text-xs text-[var(--color-text-muted)] mt-3">Includes equity build, appreciation, and rent savings vs. total cost of ownership. Does not include maintenance costs or tax benefits.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 7. First-Time Buyer Affordability Review -->
      <div id="affordability-review" class="scroll-mt-24">
        <div class="border border-[var(--color-mist-gray)] rounded-2xl overflow-hidden">
          <div class="bg-[var(--color-mist-gray)] px-6 py-5">
            <p class="eyebrow text-xs mb-1">Calculator 7</p>
            <h2 class="text-2xl font-semibold text-[var(--color-ink)]">First-Time Buyer Affordability Review</h2>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">Find the purchase price range that fits both your income and your savings.</p>
          </div>
          <div class="p-6">
            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Annual gross income ($)</label>
                <input id="af-income" type="number" value="100000" min="0" step="5000" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Monthly debt payments ($)</label>
                <input id="af-debt" type="number" value="400" min="0" step="50" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Down payment savings ($)</label>
                <input id="af-savings" type="number" value="40000" min="0" step="1000" class="calc-input" />
              </div>
              <div>
                <label class="block text-sm font-medium text-[var(--color-ink)] mb-1">Interest rate (%)</label>
                <input id="af-rate" type="number" value="7.0" min="1" max="15" step="0.125" class="calc-input" />
              </div>
            </div>
            <button onclick="calcAffordability()" class="btn btn-primary mt-5">Review Affordability</button>
            <div id="af-result" class="hidden mt-6 p-5 bg-[var(--color-mist-gray)] rounded-xl">
              <div class="grid gap-4 sm:grid-cols-3 mb-4">
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Max Purchase (Income-Based)</p>
                  <p id="af-max-income" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                </div>
                <div>
                  <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide">Max Purchase (Savings-Based)</p>
                  <p id="af-max-savings" class="text-2xl font-bold text-[var(--color-ink)] mt-1"></p>
                </div>
                <div>
