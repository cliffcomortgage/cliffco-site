---
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumbs from "../../../../components/layout/Breadcrumbs.astro";
import CalcAssumptions from "../../../../components/ui/CalcAssumptions.astro";
import { COMPANY } from "../../../../data/company";
import { RATE_ASSUMPTIONS } from "../../../../data/rate-assumptions";
const CALC_ASSUMPTIONS = [
  "Principal and interest amortized over <strong>30 years</strong>",
  `${RATE_ASSUMPTIONS.dscr30}% starting rate, higher than owner-occupied pricing`,
  "DSCR = monthly rent &divide; (principal + interest + taxes + insurance + HOA)",
  "Taxes, insurance and HOA are entered as <strong>monthly</strong> figures, not annual",
  "The verdict tiers come from Cliffco's own DSCR matrix dated 1-1-2026, which splits at a <strong>1.00</strong> ratio and carries a separate tier below it",
];

const CALC_OMITS = [
  "Vacancy, repairs, property management and capital expenses - real cash flow is lower than the figure shown",
  "Interest-only and ARM structures, which change the ratio",
  "Your credit score and loan size, which set the actual LTV - the matrix runs from 660 to 740+ and from $100,000 to $3,000,000",
  "State and property eligibility limits, which do apply and which a loan officer checks",
  "The 5 to 9 unit programme, which has a matrix of its own that this calculator does not use",
];

---

<Layout
  title="DSCR Calculator | Cliffco Mortgage Bankers"
  description="Calculate the debt service coverage ratio for any rental property. See whether the deal qualifies for a DSCR loan and how much cushion you have."
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Calculators", href: "/mortgage-guides/calculators/" },
    { name: "DSCR Calculator", href: "/mortgage-guides/calculators/dscr/" },
  ]} />

  <!-- Header -->
  <section class="bg-white">
    <div class="container-wide pt-12 lg:pt-16 pb-8">
      <p class="eyebrow">Calculator · For real estate investors</p>
      <h1 class="mt-4 max-w-4xl text-[var(--color-ink)]" style="font-size: clamp(2.125rem, 4vw, 3.25rem); line-height: 1.08; font-weight: 700; letter-spacing: -0.015em; font-family: var(--font-display);">DSCR Calculator</h1>
      <p class="mt-4 max-w-2xl text-[var(--color-text-muted)]" style="font-size: 1.125rem; line-height: 1.6;">Calculate the debt service coverage ratio for any rental property. See instantly whether the deal qualifies for a DSCR loan and how much cushion you have before lender minimums.</p>
    </div>
    <div class="container-wide"><div class="h-1.5 bg-[var(--color-ink)]"></div></div>
  </section>

  <!-- Instrument panel: controls (left) + readout (right) -->
  <section class="bg-white">
    <div class="container-wide py-10 lg:py-12 grid lg:grid-cols-12 gap-6 items-start">
      <div class="calc-controls lg:col-span-5 bg-[var(--color-ink)] text-white p-6 sm:p-8">
        <div class="calc-head">
            <h2 class="text-lg font-semibold text-white">DSCR Calculator</h2>
            <p class="text-sm text-white/60 mt-1">Results update as you type</p>
          </div>
        <div class="mt-6 space-y-5">
            <div>
              <label for="dc-rent" class="block text-sm font-medium text-[var(--color-ink)]">Monthly gross rent ($)</label>
              <input id="dc-rent" type="number" class="calc-input mt-1.5" value="3000" min="0" step="100" />
            </div>
            <div>
              <label for="dc-price" class="block text-sm font-medium text-[var(--color-ink)]">Purchase price ($)</label>
              <input id="dc-price" type="number" class="calc-input mt-1.5" value="400000" min="0" step="5000" />
            </div>
            <div>
              <label for="dc-down" class="block text-sm font-medium text-[var(--color-ink)]">Down payment (%)</label>
              <input id="dc-down" type="number" class="calc-input mt-1.5" value="25" min="0" max="100" step="1" />
              <p class="text-xs text-[var(--color-text-muted)] mt-1">Most DSCR programs require 20 to 25% down</p>
            </div>
            <div>
              <label for="dc-rate" class="block text-sm font-medium text-[var(--color-ink)]">Interest rate (%)</label>
              <input id="dc-rate" type="number" class="calc-input mt-1.5" value={RATE_ASSUMPTIONS.dscr30} min="2" max="20" step="0.125" />
            </div>
            <div>
              <label for="dc-taxes" class="block text-sm font-medium text-[var(--color-ink)]">Monthly property taxes ($)</label>
              <input id="dc-taxes" type="number" class="calc-input mt-1.5" value="400" min="0" step="25" />
            </div>
            <div>
              <label for="dc-ins" class="block text-sm font-medium text-[var(--color-ink)]">Monthly insurance ($)</label>
              <input id="dc-ins" type="number" class="calc-input mt-1.5" value="150" min="0" step="25" />
            </div>
            <div>
              <label for="dc-hoa" class="block text-sm font-medium text-[var(--color-ink)]">Monthly HOA ($)</label>
              <input id="dc-hoa" type="number" class="calc-input mt-1.5" value="0" min="0" step="25" />
            </div>
          </div>
      </div>
      <div aria-live="polite" class="calc-readout lg:col-span-7 lg:sticky lg:top-24 border-2 border-[var(--color-ink)] p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase font-mono tracking-widest text-[var(--color-text-muted)] mb-5">Your results</p>
            <div class="grid gap-5 sm:grid-cols-3">
              <div>
                <p class="text-xs font-medium text-[var(--color-text-muted)] uppercase font-mono tracking-wide mb-1">DSCR Ratio</p>
                <p id="dc-dscr" class="result-num primary">-</p>
              </div>
              <div>
                <p class="text-xs font-medium text-[var(--color-text-muted)] uppercase font-mono tracking-wide mb-1">Total Monthly PITIA</p>
                <p id="dc-obligation" class="result-num">-</p>
              </div>
              <div>
                <p class="text-xs font-medium text-[var(--color-text-muted)] uppercase font-mono tracking-wide mb-1">Monthly Cash Flow</p>
                <p id="dc-cashflow" class="result-num">-</p>
              </div>
            </div>
            <p id="dc-verdict" class="mt-4 text-sm font-medium"></p>
          </div>
    </div>
  </section>

  <CalcAssumptions items={CALC_ASSUMPTIONS} omits={CALC_OMITS} usesRate />

  <!-- How to use it -->
  <section class="bg-white">
    <div class="container-wide pb-14 lg:pb-20">
      <div class="calc-context grid lg:grid-cols-12 gap-6 lg:gap-10 border-t border-[var(--color-ink)] pt-8">
        <p class="lg:col-span-3 font-mono font-medium text-[11px] uppercase tracking-[0.14em] text-[var(--color-ink)]">How to read it</p>
        <div class="lg:col-span-8 lg:col-start-5">
          <h2 class="text-xl font-semibold text-[var(--color-ink)]">How DSCR works</h2>
          <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed">
            DSCR lenders underwrite the property, not the borrower's W-2. If the rent covers the debt, the deal qualifies. That makes these loans ideal for self-employed investors, those with complex tax returns, or anyone building a portfolio beyond conventional limits.
          </p>
          <ul class="mt-5 space-y-3">
            <li class="flex items-start gap-2 text-sm text-[var(--color-text-muted)]">
              <span class="mt-0.5 text-[var(--color-ink)] font-bold shrink-0">&#10003;</span>
              DSCR = gross monthly rent divided by total monthly PITIA (principal, interest, taxes, insurance, HOA)
            </li>
            <li class="flex items-start gap-2 text-sm text-[var(--color-text-muted)]">
              <span class="mt-0.5 text-[var(--color-ink)] font-bold shrink-0">&#10003;</span>
              Cliffco's matrix splits at a 1.00 ratio: at or above it you reach the highest LTVs, below it you still qualify at a lower LTV
            </li>
            <li class="flex items-start gap-2 text-sm text-[var(--color-text-muted)]">
              <span class="mt-0.5 text-[var(--color-ink)] font-bold shrink-0">&#10003;</span>
              Unlike conventional loans, your W-2 income and tax returns are not the deciding factor
            </li>
            <li class="flex items-start gap-2 text-sm text-[var(--color-text-muted)]">
              <span class="mt-0.5 text-[var(--color-ink)] font-bold shrink-0">&#10003;</span>
              A ratio below 1.00 is not a decline. It means a larger down payment, and Cliffco also writes No Ratio loans, where the rent is not measured at all
            </li>
          </ul>
          <p class="mt-6 text-xs text-[var(--color-text-muted)] leading-relaxed border-t border-black/15 pt-4">
            Estimate only. The ratio tiers shown are Cliffco's own, from our DSCR matrix dated
            1-1-2026. Where your deal lands inside a tier still depends on your credit score,
            loan amount, occupancy and property type, so a loan officer confirms the LTV and
            whether the deal qualifies.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white pb-14">
    <div class="container-wide">
      <div  class="mt-14 bg-[var(--color-ink)] p-8 flex flex-col sm:flex-row sm:items-center gap-6 justify-between">
        <div>
          <p class="text-white font-semibold text-lg">Run the numbers on a real deal.</p>
          <p class="text-white/70 text-sm mt-1">A Cliffco loan officer can quote DSCR pricing and confirm qualification same day.</p>
        </div>
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-ink)] shrink-0 whitespace-nowrap">Talk to a loan officer</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="text-white/80 hover:text-white no-underline text-sm font-semibold whitespace-nowrap shrink-0">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <!-- Back link -->
  <div class="border-t border-black/15 py-6 text-center">
    <a href="/mortgage-guides/calculators/" class="text-sm font-semibold text-[var(--color-ink)]">← See all calculators</a>
  </div>
</Layout>

<style>
  .calc-input {
    width: 100%;
    border: 1.5px solid var(--color-soft-gray, #e5e7eb);
    border-radius: 0.625rem;
    padding: 0.625rem 0.875rem;
    font-size: 0.9375rem;
    color: var(--color-ink);
    background: white;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    appearance: none;
    -webkit-appearance: none;
  }
  .calc-input:focus {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .result-num {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .result-num.primary {
    font-size: 3rem;
    color: var(--color-ink);
  }
</style>

<script>

  /**
   * Read a number box, honouring the max the markup already declares.
   *
   * Values past that bound used to flow straight into the maths: a rate of 1e9 overflowed the
   * amortisation factor to NaN, and a down payment over 100% produced negative payments. Only
   * the maximum is enforced - the minimum is left alone on purpose, because several
   * calculators rely on seeing a zero, or an age under 62, to suppress their result.
   */
  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el) return 0;
    const raw = parseFloat(el.value);
    if (!Number.isFinite(raw)) return 0;
    const max = parseFloat(el.max);
    return Number.isFinite(max) ? Math.min(raw, max) : raw;
  }

  function fmtDollar(n: number): string {
    return "$" + Math.round(Math.abs(n)).toLocaleString("en-US");
  }

  function calc() {
    const rent = num("dc-rent");
    const price = num("dc-price");
    const down = num("dc-down");
    const rate = num("dc-rate");
    const taxes = num("dc-taxes");
    const ins = num("dc-ins");
    const hoa = num("dc-hoa");

    const dscrEl = document.getElementById("dc-dscr");
    const obligationEl = document.getElementById("dc-obligation");
    const cashflowEl = document.getElementById("dc-cashflow");
    const verdictEl = document.getElementById("dc-verdict");

    if (price <= 0 || rate <= 0) {
      if (dscrEl) { dscrEl.textContent = "-"; dscrEl.className = "result-num primary"; }
      if (obligationEl) obligationEl.textContent = "-";
      if (cashflowEl) { cashflowEl.textContent = "-"; cashflowEl.className = "result-num"; }
      if (verdictEl) verdictEl.textContent = "";
      return;
    }

    const loanAmount = price * (1 - down / 100);
    const r = rate / 100 / 12;
    const n = 360;
    const pi = r > 0 ? loanAmount * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1) : loanAmount / n;
    const obligation = pi + taxes + ins + hoa;
    const dscr = obligation > 0 ? rent / obligation : 0;
    const cashflow = rent - obligation;

    /*
     * Colour follows Cliffco's matrix, which splits at 1.00. At or above it you are in the
     * top LTV grid, so that is a pass, not the amber the page used to show. Below 1.00 is a
     * priced tier of its own, so amber rather than red - it is a bigger down payment, not a
     * decline.
     */
    let dscrColor = "text-yellow-700";
    if (dscr >= 1.0) dscrColor = "text-green-700";

    if (dscrEl) {
      dscrEl.textContent = dscr > 0 ? dscr.toFixed(2) : "-";
      dscrEl.className = `result-num primary ${dscrColor}`;
    }

    if (obligationEl) obligationEl.textContent = fmtDollar(obligation);

    if (cashflowEl) {
      const prefix = cashflow >= 0 ? "+" : "-";
      cashflowEl.textContent = prefix + fmtDollar(cashflow);
      cashflowEl.className = `result-num ${cashflow >= 0 ? "text-green-700" : "text-red-600"}`;
    }

    if (verdictEl) {
      let verdict = "";
      if (dscr >= 1.25) {
        verdict = "Strong coverage. This clears every tier on Cliffco's DSCR matrix, including the 1.25 minimum that applies to loans between $100,000 and $150,000.";
        verdictEl.className = "mt-4 text-sm font-medium text-green-700";
      } else if (dscr >= 1.0) {
        verdict = "This qualifies in Cliffco's top DSCR tier. At a 1.00 ratio or better you reach the highest LTVs on our matrix, up to 85% on a purchase with a 740 score.";
        verdictEl.className = "mt-4 text-sm font-medium text-green-700";
      } else {
        verdict = "Under a 1.00 ratio, which is still eligible. Cliffco prices a tier specifically for DSCR below 1.00, at a lower LTV - up to 75% on a purchase with a 740 score. That is a larger down payment, not a decline. We also write No Ratio loans, where rental income is not measured at all.";
        verdictEl.className = "mt-4 text-sm font-medium text-yellow-700";
      }
      verdictEl.textContent = verdict;
    }
  }

  function init() {
    ["dc-rent", "dc-price", "dc-down", "dc-rate", "dc-taxes", "dc-ins", "dc-hoa"].forEach((id) => {
      document.getElementById(id)?.addEventListener("input", calc);
      document.getElementById(id)?.addEventListener("change", calc);
    });
    calc();
  }

  init();
</script>
