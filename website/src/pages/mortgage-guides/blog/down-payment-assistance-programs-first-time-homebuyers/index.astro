<style>
  .art-calc-input {
    width: 100%;
    border: 1px solid var(--color-soft-gray, #d1d5db);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-ink);
    background: white;
    outline: none;
    transition: border-color 0.15s;
  }
  .art-calc-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }
</style>

<script>
  const afBtn = document.getElementById("art-af-btn")!;
  afBtn.addEventListener("click", () => {
    const income = +(document.getElementById("art-af-income") as HTMLInputElement).value;
    const debt = +(document.getElementById("art-af-debt") as HTMLInputElement).value;
    const savings = +(document.getElementById("art-af-savings") as HTMLInputElement).value;
    const rate = +(document.getElementById("art-af-rate") as HTMLInputElement).value;

    const monthlyIncome = income / 12;
    const availableForHousing = (monthlyIncome * 0.43) - debt;
    const pi = availableForHousing * 0.85;
    const r = rate / 100 / 12;
    const n = 30 * 12;
    const loanFromPI = pi / ((r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1));
    const priceFromIncome = loanFromPI / 0.80;
    const maxPriceBySavings = savings / (0.20 + 0.03);
    const sweetSpot = Math.min(priceFromIncome, maxPriceBySavings);
    const fmt = (v: number) => "$" + Math.round(v).toLocaleString("en-US");

    (document.getElementById("art-af-inc") as HTMLElement).textContent = fmt(priceFromIncome);
    (document.getElementById("art-af-sav") as HTMLElement).textContent = fmt(maxPriceBySavings);
    (document.getElementById("art-af-spot") as HTMLElement).textContent = fmt(sweetSpot);

    const scenarios = [
      { label: "3.5% down (FHA)", downPct: 0.035 },
      { label: "5% down", downPct: 0.05 },
      { label: "10% down", downPct: 0.10 },
      { label: "20% down", downPct: 0.20 },
    ];

    function monthlyPICalc(principal: number, annualRate: number, termYears: number): number {
      const rv = annualRate / 100 / 12;
      const nv = termYears * 12;
      if (rv === 0) return principal / nv;
      return principal * (rv * Math.pow(1 + rv, nv)) / (Math.pow(1 + rv, nv) - 1);
    }

    (document.getElementById("art-af-scenarios") as HTMLElement).innerHTML =
      "<strong class='text-sm'>Monthly P&I at your sweet spot:</strong><div class='grid gap-2 mt-2 sm:grid-cols-2'>" +
      scenarios.map(s => {
        const down = sweetSpot * s.downPct;
        const payment = monthlyPICalc(sweetSpot - down, rate, 30);
        const canAfford = savings >= down + sweetSpot * 0.03;
        return `<div class='p-3 bg-white rounded-lg border border-[var(--color-mist-gray)]'>
          <p class='font-medium text-sm'>${s.label}</p>
          <p class='text-lg font-bold text-[var(--color-accent)]'>${fmt(payment)}/mo</p>
          <p class='text-xs text-[var(--color-text-muted)]'>Down: ${fmt(down)} ${canAfford ? "✓" : "(savings may be short)"}</p>
        </div>`;
      }).join("") + "</div>";

    (document.getElementById("art-af-result") as HTMLElement).classList.remove("hidden");
  });
</script>
