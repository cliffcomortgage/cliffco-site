<style>
  .art-calc-input {
    width: 100%;
    border: 1px solid var(--color-soft-gray, #d1d5db);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-ink);
    background: white;
    outline: none;
    transition: border-color 0.15s;
  }
  .art-calc-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }
</style>

<script>
  const rmBtn = document.getElementById("art-rm-btn")!;
  rmBtn.addEventListener("click", () => {
    const age = +(document.getElementById("art-rm-age") as HTMLInputElement).value;
    const value = +(document.getElementById("art-rm-value") as HTMLInputElement).value;
    const balance = +(document.getElementById("art-rm-bal") as HTMLInputElement).value;

    const hecmLimit = 1209750;
    const lendingLimit = Math.min(value, hecmLimit);
    const ageFactor = Math.min(0.75, 0.40 + (age - 62) * 0.01);
    const grossProceeds = lendingLimit * ageFactor;
    const netProceeds = Math.max(0, grossProceeds - balance);
    const fmt = (v: number) => "$" + Math.round(v).toLocaleString("en-US");

    (document.getElementById("art-rm-gross") as HTMLElement).textContent = fmt(grossProceeds);
    (document.getElementById("art-rm-net") as HTMLElement).textContent = fmt(netProceeds);

    let note = "";
    if (value > hecmLimit) {
      note = "Note: HECM loans are limited to the 2025 FHA lending limit of $1,209,750. Your home value above that limit is not factored into HECM proceeds. A proprietary (jumbo) reverse mortgage may be available for higher-value homes.";
    } else if (balance > grossProceeds * 0.6) {
      note = "Your existing mortgage balance is substantial relative to estimated proceeds. You may still qualify, but less equity will remain after payoff.";
    }

    (document.getElementById("art-rm-note") as HTMLElement).textContent = note;
    (document.getElementById("art-rm-result") as HTMLElement).classList.remove("hidden");
  });
</script>
