<style>
  .art-calc-input {
    width: 100%;
    border: 1px solid var(--color-soft-gray, #d1d5db);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-ink);
    background: white;
    outline: none;
    transition: border-color 0.15s;
  }
  .art-calc-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }
</style>

<script>
  const mrBtn = document.getElementById("art-mr-btn")!;
  mrBtn.addEventListener("click", () => {
    const credit = +(document.getElementById("art-mr-credit") as HTMLSelectElement).value;
    const emp = (document.getElementById("art-mr-emp") as HTMLSelectElement).value;
    const income = +(document.getElementById("art-mr-income") as HTMLInputElement).value;
    const debt = +(document.getElementById("art-mr-debt") as HTMLInputElement).value;
    const savings = +(document.getElementById("art-mr-savings") as HTMLInputElement).value;

    const maxDTI = credit >= 720 ? 0.45 : credit >= 660 ? 0.43 : 0.41;
    const availableForHousing = Math.max(0, income * maxDTI - debt);
    const fmt = (v: number) => "$" + Math.round(v).toLocaleString("en-US");

    let level = "";
    let steps: string[] = [];

    if (credit < 620) {
      level = "Not Yet Ready";
      steps = ["Your credit score needs to reach at least 620 before most lenders will approve a mortgage.", "Focus on paying down balances and removing errors from your credit report.", "Contact a Cliffco loan officer for a personalized credit improvement plan."];
    } else if (savings < 10000) {
      level = "Building";
      steps = ["You'll need more savings to cover a down payment and closing costs.", "Down payment programs may help if you're a first-time buyer.", "A Cliffco loan officer can show you what down payment assistance programs you qualify for."];
    } else if (emp === "self" || emp === "1099" || emp === "other") {
      level = "Ready (Non-QM Path)";
      steps = ["Your income type may not qualify for conventional financing.", "Non-QM loan programs (bank statement, 1099, DSCR) were built for your situation.", "Talk to a Cliffco Non-QM specialist to identify the best product."];
    } else if (credit >= 720 && availableForHousing > 1500) {
      level = "Strong";
      steps = ["You're in a solid position. Get pre-approved before you start shopping.", "Keep your credit stable, avoid new debt, and gather two years of tax returns.", "A pre-approval will tell you exactly what purchase price you qualify for."];
    } else {
      level = "Ready";
      steps = ["You have the foundation to move forward.", "Ask your loan officer about the right loan program for your credit and income.", "Getting pre-approved now puts you in the strongest position when you find the right home."];
    }

    (document.getElementById("art-mr-level") as HTMLElement).textContent = level;
    (document.getElementById("art-mr-budget") as HTMLElement).textContent = fmt(availableForHousing);
    (document.getElementById("art-mr-steps") as HTMLElement).innerHTML =
      "<strong>Your next steps:</strong><ul class='list-disc list-inside mt-2 space-y-1'>" +
      steps.map(s => `<li>${s}</li>`).join("") + "</ul>";
    (document.getElementById("art-mr-result") as HTMLElement).classList.remove("hidden");
  });
</script>
