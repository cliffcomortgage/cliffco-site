---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import { BLOG_ARTICLES } from "../../../data/blog-articles";
import { BLOG_PUBLISH_DATES } from "../../../data/blog-publish-dates";
import articleImagesRaw from "../../../data/article-images.json";

const articleImages = articleImagesRaw as Record<string, { url: string; alt: string; objectPosition?: string }>;
const articles = BLOG_ARTICLES;
const fmtDate = (iso?: string) =>
  iso ? new Date(iso + "T00:00:00").toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : null;
const categories = ["All", "Investors", "First-Time Buyers", "Reverse Mortgage", "Self-Employed", "Freelancers", "Non-Citizens", "Veterans", "Move-Up Buyers", "Refinancing"];
---

<Layout
  title="Mortgage Guides | Cliffco Mortgage Bankers"
  description="Clear, jargon-free mortgage guides and articles from Cliffco. Reverse mortgages, Non-QM loans, DSCR, down payment assistance, VA loans, and more, written for real people."
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Mortgage Guides", href: "/mortgage-guides/blog/" },
  ]} />

  <section class="bg-white">
    <div class="container-wide pt-12 lg:pt-16 pb-8 grid lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow">Mortgage Guides</p>
        <h1 class="mt-4 text-[var(--color-ink)]" style="font-size: clamp(2.25rem, 4vw, 3.5rem); line-height: 1.06; font-weight: 700; letter-spacing: -0.03em; font-family: var(--font-display);">Real answers to real mortgage questions.</h1>
        <p class="mt-5 max-w-2xl text-[var(--color-text-muted)]" style="font-size: 1.125rem; line-height: 1.6;">
          First-time buyer, real estate investor, retiree weighing a reverse mortgage: these guides give you the full picture, written by the people who actually close these loans every day.
        </p>
      </div>
      <p class="lg:col-span-3 lg:col-start-10 lg:text-right font-bold text-[var(--color-ink)] leading-none" style="font-family: var(--font-display); font-size: clamp(3rem, 6vw, 5rem); letter-spacing: -0.04em;">{articles.length}<span class="block mt-2 font-mono text-[11px] font-normal uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Articles</span></p>
    </div>
  </section>

  <section class="bg-white sticky top-[4.5rem] z-30 border-y-2 border-[var(--color-ink)]">
    <div class="container-wide py-3 flex gap-2 overflow-x-auto" role="group" aria-label="Filter by topic">
      {categories.map((cat, i) => (
        <button
          class={`filter-pill${i === 0 ? " active" : ""}`}
          data-filter={cat === "All" ? "all" : cat}
          type="button"
        >
          {cat}
        </button>
      ))}
    </div>
  </section>

  <section class="bg-white pb-16">
    <div class="container-wide">
      <ol class="list-none m-0 p-0">
        {articles.map((article) => {
          const img = articleImages[article.href];
          const slug = article.href.replace(/\/$/, "").split("/").pop() ?? "";
          const date = fmtDate(BLOG_PUBLISH_DATES[slug]);
          return (
            <li class="article-card border-b border-black/15" data-categories={article.category}>
              <a href={article.href} class="group grid grid-cols-[1fr_5.5rem] sm:grid-cols-[minmax(0,9rem)_1fr_7rem] lg:grid-cols-[minmax(0,10rem)_minmax(0,11rem)_1fr_8rem] gap-x-6 gap-y-1 py-6 no-underline text-[var(--color-ink)] items-start">
                <span class="hidden sm:block font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] pt-1">{date}</span>
                <span class="hidden lg:block font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink)] pt-1">{article.category}</span>
                <span class="min-w-0">
                  <span class="sm:hidden block font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] mb-1">{article.category}{date && ` · ${date}`}</span>
                  <span class="lg:hidden hidden sm:block font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--color-ink)] mb-1">{article.category}</span>
                  <h2 class="font-semibold leading-snug group-hover:underline" style="font-size: 1.1875rem;">{article.title}</h2>
                  <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed line-clamp-2">{article.description}</p>
                </span>
                {img && (
                  <span class="block aspect-square rounded-xl overflow-hidden border-2 border-[var(--color-ink)]">
                    <img src={img.url} alt={img.alt} class="w-full h-full object-cover" style={img.objectPosition ? `object-position: ${img.objectPosition}` : undefined} loading="lazy" />
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ol>

      <p id="no-results" class="hidden text-center text-[var(--color-text-muted)] text-sm mt-10">
        No articles in this category yet.
      </p>
    </div>
  </section>
</Layout>

<script>
  const pills = document.querySelectorAll(".filter-pill");
  const cards = document.querySelectorAll(".article-card");
  const noResults = document.getElementById("no-results");

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      pills.forEach((p) => p.classList.remove("active"));
      pill.classList.add("active");

      const filter = (pill as HTMLElement).dataset.filter;
      let visible = 0;

      cards.forEach((card) => {
        const cat = (card as HTMLElement).dataset.categories ?? "";
        const show = filter === "all" || cat === filter;
        (card as HTMLElement).style.display = show ? "" : "none";
        if (show) visible++;
      });

      noResults?.classList.toggle("hidden", visible > 0);
    });
  });
</script>

<style>
  :global(.filter-pill) { border-radius: 999px; border: 2px solid var(--color-ink); color: var(--color-ink); white-space: nowrap; font-weight: 600; }
  :global(.filter-pill:hover) { border-color: var(--color-ink); color: var(--color-ink); background: rgb(0 0 0 / 0.04); }
  :global(.filter-pill.active) { background: var(--color-ink); border-color: var(--color-ink); color: #fff; }
</style>
