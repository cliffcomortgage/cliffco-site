---

<Layout
  title="Mortgage Guides | Cliffco Mortgage Bankers"
  description="Clear, jargon-free mortgage guides and articles from Cliffco. Reverse mortgages, non-QM loans, DSCR, down payment assistance, VA loans, and more, written for real people."
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Mortgage Guides", href: "/mortgage-guides/blog/" },
  ]} />

  <section class="container-wide pt-12 pb-10">
    <p class="eyebrow">Mortgage Guides</p>
    <h1 class="mt-3" style="font-size: var(--text-display-lg);">Real answers to real mortgage questions.</h1>
    <p class="lead mt-6">
      Whether you're buying your first home, investing in rental property, or figuring out
      if a reverse mortgage makes sense for your retirement — these guides give you the full
      picture, written by the people who actually close these loans every day.
    </p>
  </section>

  <section class="bg-white pb-16">
    <div class="container-wide">
      <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="Filter by topic">
        {categories.map((cat, i) => (
          <button
            class={`filter-pill${i === 0 ? " active" : ""}`}
            data-filter={cat === "All" ? "all" : cat}
            type="button"
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {articles.map((article) => (
          <a
            href={article.href}
            class="article-card card no-underline text-[var(--color-ink)] flex flex-col hover:shadow-md transition-shadow"
            data-categories={article.category}
          >
            <p class="eyebrow text-sm">{article.category}</p>
            <h2 class="mt-2 text-xl font-semibold leading-snug">{article.title}</h2>
            <p class="mt-3 text-sm text-[var(--color-text-muted)] flex-1">{article.description}</p>
            <span class="mt-4 text-sm font-medium text-[var(--color-accent)]">Read article →</span>
          </a>
        ))}
      </div>

      <p id="no-results" class="hidden text-center text-[var(--color-text-muted)] text-sm mt-10">
        No articles in this category yet.
      </p>
    </div>
  </section>
</Layout>

<script>
  const pills = document.querySelectorAll(".filter-pill");
  const cards = document.querySelectorAll(".article-card");
  const noResults = document.getElementById("no-results");

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      pills.forEach((p) => p.classList.remove("active"));
      pill.classList.add("active");

      const filter = (pill as HTMLElement).dataset.filter;
      let visible = 0;

      cards.forEach((card) => {
        const cat = (card as HTMLElement).dataset.categories ?? "";
        const show = filter === "all" || cat === filter;
        (card as HTMLElement).style.display = show ? "" : "none";
        if (show) visible++;
      });

      noResults?.classList.toggle("hidden", visible > 0);
    });
  });
</script>
