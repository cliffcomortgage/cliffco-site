---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { BRANCHES } from "../../data/branches";
import { LOAN_OFFICERS } from "../../data/loan-officers";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";

const branch = BRANCHES.find((b) => b.slug === "excelsior-mn")!;
const los = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "excelsior-mn");

const schema = [
  localBusinessSchema(branch),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "Minnesota", url: "/locations/minnesota/" },
    { name: "Excelsior", url: "/excelsior-mn/" },
  ]),
];

import BranchPage from "../../components/asym/BranchPage.astro";

---

<Layout
  title="Excelsior, MN Mortgage Office | Cliffco Mortgage Bankers"
  description="Cliffco Mortgage Bankers Excelsior, MN office - 276 Water Street, Excelsior, MN 55331. Branch NMLS #2763960. Serving the Twin Cities and greater Minnesota."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "Minnesota", href: "/locations/minnesota/" },
    { name: "Excelsior", href: "/excelsior-mn/" },
  ]} />

  <BranchPage
    city="Excelsior"
    eyebrow="Excelsior, MN · Twin Cities"
    title="Excelsior Mortgage Office"
    lead={`Cliffco's Minnesota office serves the Twin Cities and greater Minnesota. Conventional, FHA, VA, and Non-QM mortgage loans with the full backing of a ${COMPANY.yearsInBusiness()}-year independent lender.`}
    addressName={branch.name}
    street={branch.street}
    cityLine={`${branch.city}, ${branch.region} ${branch.postalCode}`}
    nmlsLabel={`Branch #${branch.nmls}`}
    phone={{ e164: COMPANY.tollFreeE164, display: COMPANY.tollFree, label: "Toll Free" }}
    findTitle="Find us in Excelsior."
    about="Cliffco's Excelsior office sits on the shores of Lake Minnetonka in the Twin Cities suburbs. Our MN-based loan officer handles purchases and refinances statewide, with access to every Cliffco product including Non-QM, DSCR, and reverse mortgage programs."
    back={{ href: "/locations/minnesota/", label: "← All Minnesota offices" }}
    los={los}
    teamEyebrow="Loan officers at this office"
    teamTitle="Your Excelsior team."
    ctaTitle="Buying in Minnesota? Talk to our Excelsior team."
    formTitle="Buying or refinancing in Minnesota?"
    formSub="Tell us your situation and the Excelsior team will be in touch within one business day."
    formSource="branch-excelsior"
  >
    <Fragment slot="info">
      {branch.nmls && <p>Branch NMLS #{branch.nmls}</p>}
      <p>Licensed by the Minnesota Department of Commerce as MN-MO-65328.</p>
    </Fragment>
  </BranchPage>
</Layout>
