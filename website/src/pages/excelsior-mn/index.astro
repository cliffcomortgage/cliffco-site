---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { BRANCHES } from "../../data/branches";
import { LOAN_OFFICERS } from "../../data/loan-officers";
import Headshot from "../../components/ui/Headshot.astro";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";

const branch = BRANCHES.find((b) => b.slug === "excelsior-mn")!;
const los = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "excelsior-mn");

const schema = [
  localBusinessSchema(branch),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "Minnesota", url: "/locations/minnesota/" },
    { name: "Excelsior", url: "/excelsior-mn/" },
  ]),
];
import ContactForm from "../../components/forms/ContactForm.astro";
---

<Layout
  title="Excelsior, MN Mortgage Office | Cliffco Mortgage Bankers"
  description="Cliffco Mortgage Bankers Excelsior, MN office — 276 Water Street, Excelsior, MN 55331. Branch NMLS #2763960. Serving the Twin Cities and greater Minnesota."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "Minnesota", href: "/locations/minnesota/" },
    { name: "Excelsior", href: "/excelsior-mn/" },
  ]} />

  <section class="accent-gradient">
    <div class="container-wide py-16 lg:py-24">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Excelsior, MN · Twin Cities</p>
      <h1 class="mt-4 text-white max-w-3xl" style="font-size: var(--text-display-xl); line-height: 1.05; font-weight: 700; font-family: var(--font-sans);">
        Excelsior Mortgage Office
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">
        Cliffco's Minnesota office serves the Twin Cities and greater Minnesota. Conventional, FHA, VA, and Non-QM mortgage loans with the full backing of a 36-year independent lender.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">
          <span class="text-white/70 font-normal text-xs">Toll Free</span>&nbsp;{COMPANY.tollFree}
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide grid lg:grid-cols-2 gap-10 items-start">
      <div>
        <p class="eyebrow">Branch information</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Find us in Excelsior.</h2>
        <address class="not-italic mt-6 space-y-2 text-[var(--color-text)]">
          <p class="font-semibold text-[var(--color-ink)]">{branch.name}</p>
          <p>{branch.street}</p>
          <p>{branch.city}, {branch.region} {branch.postalCode}</p>
        </address>
        {branch.nmls && <p class="mt-4 text-sm text-[var(--color-text-muted)]">Branch NMLS #{branch.nmls}</p>}
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">Licensed by the Minnesota Department of Commerce as MN-MO-65328.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-primary text-sm">Call Toll Free: {COMPANY.tollFree}</a>
          <a href="/get-started/" class="btn btn-secondary text-sm">Start Application</a>
        </div>
      </div>
      <div class="card">
        <p class="eyebrow">About this office</p>
        <p class="mt-3 text-[var(--color-text)] leading-relaxed">
          Cliffco's Excelsior office sits on the shores of Lake Minnetonka in the Twin Cities suburbs. Our MN-based loan officer handles purchases and refinances statewide, with access to every Cliffco product including non-QM, DSCR, and reverse mortgage programs.
        </p>
        <a href="/locations/minnesota/" class="mt-4 inline-block text-sm font-semibold text-[var(--color-accent)] no-underline hover:underline">← All Minnesota offices</a>
      </div>
    </div>
  </section>

  {los.length > 0 && (
    <section class="section bg-[var(--color-mist-gray)]">
      <div class="container-wide">
        <p class="eyebrow">Loan officers at this office</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Your Excelsior team.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {los.map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              <span class="mt-auto pt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Ready to get started?</h2>
      <p class="lead mt-4 text-white/85">A licensed Cliffco loan officer responds in one business day.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <p class="eyebrow">Get in touch</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Ready to talk to a loan officer?</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">No credit pull. No commitment. Fill out the form and a loan officer will reach out within one business day.</p>
      <div class="mt-8">
        <ContactForm
          formTo="mpatternson@cliffcomortgage.com"
          formSource="branch-excelsior"
        />
      </div>
    </div>
  </section>
</Layout>
