---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import Headshot from "../components/ui/Headshot.astro";
import StoryHero from "../components/asym/StoryHero.astro";
import TimelineItem from "../components/asym/TimelineItem.astro";
import { COMPANY } from "../data/company";
import { BRANCHES } from "../data/branches";
import { LOAN_OFFICERS, loanOfficer, loanOfficersByBranch } from "../data/loan-officers";
import { STATE_LICENSES } from "../data/state-licenses";
import { LEADERSHIP_TEAM } from "../data/leadership-team";
import { COMPANY_VALUES } from "../data/company-values";

const yearsInBiz = COMPANY.yearsInBusiness();
const president = loanOfficer("christopher-clifford")!;
const seniorLeadership = LOAN_OFFICERS.filter((lo) =>
  ["christopher-clifford", "ryan-riddle", "adam-broder"].includes(lo.slug),
);
const lastName = (name: string) => name.trim().split(/\s+/).pop() ?? name;
const photoLeaders = LEADERSHIP_TEAM.filter((l) => l.hasPhoto)
  .slice()
  .sort((a, b) => lastName(a.name).localeCompare(lastName(b.name)));
const compactLeaders = LEADERSHIP_TEAM.filter((l) => !l.hasPhoto);
---

<Layout
  title={`About ${COMPANY.brandName}`}
  description={`Cliffco Mortgage Bankers is a ${yearsInBiz}-year independent, family-built mortgage lender (NMLS #${COMPANY.nmls}) headquartered in Uniondale, NY with ${BRANCHES.length} branches across NY, NJ, AZ, MN, and FL.`}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "About", href: "/about/" },
  ]} />

  <StoryHero eyebrow="About Cliffco" marker="Since 1989">
    {yearsInBiz} years in business, still family-owned, and still picking up the phone.
    <Fragment slot="lead">
      <p class="max-w-3xl text-[var(--color-text)]" style="font-size: 1.1875rem; line-height: 1.65;">
        Cliffco was founded in 1989 on Long Island as an alternative to the bank-driven mortgage process.
        The kind that turns away a self-employed borrower in 90 seconds without ever asking who they are
        or what they actually do for a living. {yearsInBiz} years later, that's still the work we do.
      </p>
      <p class="mt-6 max-w-3xl text-[var(--color-text-muted)] leading-relaxed">
        Cliffco Mortgage Bankers (NMLS #{COMPANY.nmls}) is a privately-held independent mortgage banker headquartered at
        {COMPANY.hq.street} in {COMPANY.hq.city}, {COMPANY.hq.region}. Founded in 1989, Cliffco
        is licensed in <strong class="text-[var(--color-ink)]">{STATE_LICENSES.length} states</strong> and operates through <strong class="text-[var(--color-ink)]">{BRANCHES.length} branches</strong>
        across New York, New Jersey, Arizona, Minnesota, and Florida. The company specializes
        in Non-QM and self-employed loans, reverse mortgages, DSCR loans for real estate investors,
        and business bank statement loans.
      </p>
    </Fragment>
  </StoryHero>

  <!-- MISSION / VISION / VALUES -->
  <TimelineItem marker="Why we exist" eyebrow="Vision · Mission · Values" title="Why we exist.">
    <div class="grid xl:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] gap-10 items-start">
      <div class="space-y-8">
        <div class="border-t-2 border-[var(--color-ink)] pt-4">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Vision</p>
          <p class="mt-2 text-2xl leading-snug text-[var(--color-ink)] font-semibold">
            We believe the mortgage industry can do better. Our vision is to lead as the nation’s most innovative and talent-nurturing firm, setting the benchmark for simplicity and collaboration in every partnership.
          </p>
        </div>
        <div class="border-t-2 border-[var(--color-ink)] pt-4">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Mission</p>
          <p class="mt-2 text-2xl leading-snug text-[var(--color-ink)] font-semibold">
            We exist to transform the dream of home ownership into reality while elevating the net worth and self worth of the families and team members we serve.
          </p>
        </div>
        <div class="border-t-2 border-[var(--color-ink)] pt-4">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Values</p>
          <ul class="mt-4 grid sm:grid-cols-2 gap-x-8 gap-y-5 m-0 p-0 list-none">
            {COMPANY_VALUES.map((v) => (
              <li>
                <strong class="block text-[var(--color-ink)]">{v.name}</strong>
                <span class="text-sm text-[var(--color-text-muted)]">{v.desc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="rounded-[1.75rem] overflow-hidden aspect-[3/4] max-w-[26.5rem]">
        <img
          src="/images/content%20images/about-us.jpg"
          alt="Cliffco team"
          class="w-full h-full object-cover"
          style="object-position: 70% center"
        />
      </div>
    </div>
  </TimelineItem>

  <!-- LEADERSHIP -->
  <TimelineItem marker="Leadership" eyebrow="Leadership" title="Leaders who started as loan officers, and never stopped.">
    <p class="-mt-4 max-w-3xl text-[var(--color-text-muted)] leading-relaxed" style="font-size: 1.0625rem;">
      Every leader at Cliffco is a licensed loan officer with an NMLS ID you can verify on
      <a href="https://www.nmlsconsumeraccess.org/" rel="noopener" class="text-[var(--color-ink)] underline underline-offset-2">NMLS Consumer Access</a>.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {seniorLeadership.map((lo) => (
        <a href={`/loan-officers/${lo.slug}/`} class="group rounded-2xl border-2 border-[var(--color-ink)] overflow-hidden no-underline text-[var(--color-ink)] flex flex-col h-full bg-white">
          {lo.hasPhoto && (
            <div class="border-b-2 border-[var(--color-ink)]">
              <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" />
            </div>
          )}
          <div class="p-5 flex flex-col flex-1">
            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)]">{lo.title}</p>
            <h3 class="mt-2 text-xl font-bold group-hover:underline">{lo.displayName}</h3>
            <p class="text-sm text-[var(--color-text-muted)]">NMLS #{lo.nmls}</p>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">Licensed in {lo.states.length} state{lo.states.length === 1 ? "" : "s"}.</p>
            <span class="mt-auto pt-4 text-sm font-semibold">View bio →</span>
          </div>
        </a>
      ))}
    </div>
  </TimelineItem>

  <!-- OPERATIONS LEADERSHIP -->
  <TimelineItem
    marker="Operations"
    eyebrow="Operations leadership"
    title="The people who keep Cliffco running."
    intro="Cliffco runs on long-tenured operations leaders in compliance, underwriting, and marketing. Their collective experience is what makes the brand promise stick."
  >
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {photoLeaders.map((leader) => (
        <article class="rounded-2xl border-2 border-[var(--color-ink)] overflow-hidden flex flex-col h-full bg-white">
          <div class="border-b-2 border-[var(--color-ink)]">
            <Headshot slug={leader.slug} name={leader.name} fluid shape="square" />
          </div>
          <div class="p-5">
            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)]">{leader.title}</p>
            <h3 class="mt-2 text-lg font-bold">{leader.name}</h3>
          </div>
        </article>
      ))}
    </div>
    {compactLeaders.length > 0 && (
      <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {compactLeaders.map((leader) => (
          <article class="rounded-2xl bg-[var(--color-ink)] text-white p-5">
            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/55">{leader.title}</p>
            <h3 class="mt-1 text-lg font-bold !text-white">{leader.name}</h3>
          </article>
        ))}
      </div>
    )}
  </TimelineItem>

  <!-- BRANCHES -->
  <TimelineItem marker="Today" eyebrow="Branches" title={`${BRANCHES.length} offices. Real people in each one.`} dark>
    <div class="grid gap-x-8 sm:grid-cols-2 xl:grid-cols-3 border-t border-white/30">
      {BRANCHES.map((b) => (
        <div class="py-5 border-b border-white/15">
          <h3 class="text-base font-semibold !text-white">{b.name}</h3>
          {b.metro && <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-white/55 mt-1">{b.metro}</p>}
          {b.street && (
            <address class="not-italic text-sm text-white/75 mt-2 leading-snug">
              {b.street}<br/>{b.city}, {b.region} {b.postalCode}
            </address>
          )}
          {b.phone && (
            <p class="text-sm mt-1">
              <a href={`tel:+1${b.phone.replace(/\D/g, "")}`} class="!text-white no-underline">{b.phone}</a>
            </p>
          )}
          {b.nmls && <p class="text-xs text-white/55 mt-2">Branch NMLS #{b.nmls}</p>}
          {loanOfficersByBranch(b.slug).length > 0 && (
            <p class="text-xs text-white/55 mt-1">
              {loanOfficersByBranch(b.slug).length} loan officer{loanOfficersByBranch(b.slug).length === 1 ? "" : "s"}.
            </p>
          )}
          {b.isFloridaDba && <p class="text-xs text-white mt-2 font-medium">Operates as Clout Mortgage, Inc.</p>}
        </div>
      ))}
    </div>
  </TimelineItem>

  <!-- LICENSING SUMMARY -->
  <TimelineItem marker={`${STATE_LICENSES.length}`} eyebrow="Licensing" title={`Licensed in ${STATE_LICENSES.length} states.`} last>
    <p class="-mt-4 max-w-3xl text-[var(--color-text-muted)] leading-relaxed" style="font-size: 1.0625rem;">
      Cliffco, Inc. is a Licensed Mortgage Banker by the New York State Department of Financial
      Services (LMBC109800), with active licenses in {STATE_LICENSES.length} states across the U.S.
    </p>
    <p class="mt-6 max-w-4xl font-mono text-xs uppercase tracking-[0.08em] leading-loose text-[var(--color-text)]">
      {STATE_LICENSES.map((s) => s.name).join(" · ")}
    </p>
    <a href="/licensing/" class="btn btn-secondary mt-8">See full state license details</a>
  </TimelineItem>
</Layout>
