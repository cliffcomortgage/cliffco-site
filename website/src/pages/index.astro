---
import Layout from "../layouts/Layout.astro";
import { COMPANY } from "../data/company";
import { LOCATIONS } from "../data/locations";
import { BRANCHES } from "../data/branches";
import { STATE_LICENSES } from "../data/state-licenses";

const officeLocations = LOCATIONS.filter((l) => !l.path.includes("/"));
const yearsInBiz = COMPANY.yearsInBusiness();

// Licensed states, grouped by region for an editorial layout. Any state not in
// the map falls into "Other" so a future license addition is never dropped.
const REGION_BY_CODE: Record<string, string> = {
  CT: "Northeast", DE: "Northeast", MD: "Northeast", MA: "Northeast", NJ: "Northeast",
  NY: "Northeast", PA: "Northeast", VT: "Northeast", DC: "Northeast",
  AL: "South", FL: "South", GA: "South", KY: "South", LA: "South",
  NC: "South", SC: "South", TN: "South", TX: "South", VA: "South",
  IL: "Midwest", IN: "Midwest", KS: "Midwest", MI: "Midwest", MN: "Midwest", OH: "Midwest",
  AK: "West", AZ: "West", CA: "West", CO: "West", NM: "West", OR: "West", WA: "West",
};
const REGION_ORDER = ["Northeast", "South", "Midwest", "West", "Other"];
const statesByRegion = REGION_ORDER.map((region) => ({
  region,
  states: [...STATE_LICENSES]
    .filter((s) => (REGION_BY_CODE[s.code] ?? "Other") === region)
    .map((s) => s.name)
    .sort((a, b) => a.localeCompare(b)),
})).filter((g) => g.states.length > 0);

// Hero path tiles + primary CTA
const heroTiles = [
  {
    label: "Buy a Home",
    href: "/get-started/buy/",
    iconPaths: ["M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"],
  },
  {
    label: "Refinance My Mortgage",
    href: "/get-started/refinance/",
    iconPaths: ["M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"],
  },
  {
    label: "Get Cash from My Home",
    href: "/get-started/cash-out/",
    iconPaths: ["M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"],
  },
];

// Colored quick-link cards under the trust bar
const quickThemes = {
  purple: { bg: "linear-gradient(150deg,#6633cc,#4b1fa6)", text: "text-white", desc: "text-white/80", badge: "bg-white/15 text-white", arrow: "text-white" },
  dark:   { bg: "linear-gradient(150deg,#1c1a20,#322a4a)", text: "text-white", desc: "text-white/75", badge: "bg-white/12 text-[var(--color-ice-blue)]", arrow: "text-[var(--color-ice-blue)]" },
  light:  { bg: "linear-gradient(150deg,#bde8f1,#e5f5f9)", text: "text-[var(--color-ink)]", desc: "text-[var(--color-text)]", badge: "bg-white text-[var(--color-accent)]", arrow: "text-[var(--color-accent)]" },
} as const;
const quickLinks = [
  { title: "Calculators", desc: "Estimate payments, affordability, and closing costs.", href: "/mortgage-guides/calculators/", theme: "purple" as const,
    iconPaths: ["M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V13.5zm0 2.25h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V18zm2.498-6.75h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V13.5zm0 2.25h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V18zm2.504-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V18zm2.498-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zM8.25 6h7.5v2.25h-7.5V6zM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.65 4.5 4.757V19.5a2.25 2.25 0 002.25 2.25h10.5a2.25 2.25 0 002.25-2.25V4.757c0-1.108-.806-2.057-1.907-2.185A48.507 48.507 0 0012 2.25z"] },
  { title: "Loan Programs", desc: "Explore every loan type Cliffco offers.", href: "/loans/", theme: "dark" as const,
    iconPaths: ["M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"] },
  { title: "Our Process", desc: "How we get you from first call to keys.", href: "/process/", theme: "light" as const,
    iconPaths: ["M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"] },
];
---

<Layout
  title={`${COMPANY.brandName} - Mortgages for the people other banks turn away`}
  description={`Cliffco Mortgage Bankers is a ${yearsInBiz}-year independent lender (NMLS #${COMPANY.nmls}) specializing in Non-QM, reverse, DSCR, and business bank statement loans across NY, NJ, AZ, MN, and FL.`}
>

  <!-- HERO -->
  <section class="accent-gradient hero-animated relative overflow-hidden">
    <div class="hero-blobs" aria-hidden="true">
      <span class="hero-blob hero-blob-1"></span>
      <span class="hero-blob hero-blob-2"></span>
    </div>
    <div class="container-wide py-24 lg:py-32 text-center flex flex-col items-center">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Family-built since 1989 · NMLS #{COMPANY.nmls}</p>

      <h1 class="mt-5 text-white md:whitespace-nowrap" style="font-size: clamp(2rem, 4.6vw, 4rem); line-height: 1.1; font-weight: 700; font-family: var(--font-sans);">
        When Big Banks Say No, <span class="text-[var(--color-ice-blue)]">We Say Yes.</span>
      </h1>

      <p class="mt-6 text-white/85 max-w-3xl" style="font-size: clamp(1.05rem, 1.35vw, 1.25rem); line-height: 1.55;">
        Complex scenarios don't scare us. Traditional Income Earners, Self-Employed, Business Owners, or Entrepreneurs - Our solutions work for all.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4 max-w-3xl">
        {heroTiles.map((t) => (
          <a href={t.href} class="hero-tile">
            <svg class="hero-tile-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
              {t.iconPaths.map((d) => (
                <path stroke-linecap="round" stroke-linejoin="round" d={d} />
              ))}
            </svg>
            <span>{t.label}</span>
          </a>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Start a Pre-Approval</a>
        <a href="/loan-officers/" class="btn btn-secondary !border-white !text-white hover:!bg-white/10">Find a Loan Officer</a>
      </div>
      <p class="mt-3 text-white/70 text-sm">No credit pull. No commitment. Takes 2 minutes.</p>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="bg-white border-b border-[var(--color-mist-gray)]">
    <div class="container-wide py-8">
      <dl class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-mist-gray)] rounded-lg overflow-hidden text-center">
        <div class="bg-white py-7 px-4">
          <dt class="flex items-center justify-center gap-2 text-[var(--color-text-muted)] text-sm uppercase tracking-wide">
            <svg class="w-4 h-4 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
            BBB Rating
          </dt>
          <dd class="font-bold text-[var(--color-ink)] text-3xl mt-2">A+</dd>
        </div>
        <div class="bg-white py-7 px-4">
          <dt class="flex items-center justify-center gap-2 text-[var(--color-text-muted)] text-sm uppercase tracking-wide">
            <svg class="w-4 h-4 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            Total Closed
          </dt>
          <dd class="font-bold text-[var(--color-ink)] text-3xl mt-2">$6B+</dd>
        </div>
        <div class="bg-white py-7 px-4">
          <dt class="flex items-center justify-center gap-2 text-[var(--color-text-muted)] text-sm uppercase tracking-wide">
            <svg class="w-4 h-4 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/></svg>
            Lending Since
          </dt>
          <dd class="font-bold text-[var(--color-ink)] text-3xl mt-2">1989</dd>
        </div>
        <div class="bg-white py-7 px-4">
          <dt class="flex items-center justify-center gap-2 text-[var(--color-text-muted)] text-sm uppercase tracking-wide">
            <svg class="w-4 h-4 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z"/></svg>
            Licensed In
          </dt>
          <dd class="font-bold text-[var(--color-ink)] text-3xl mt-2">{STATE_LICENSES.length} States</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- QUICK LINKS -->
  <section class="section bg-white">
    <div class="container-wide grid gap-6 md:grid-cols-3">
      {quickLinks.map((c) => {
        const t = quickThemes[c.theme];
        return (
          <a href={c.href} class="quicklink-card no-underline rounded-2xl p-8 flex flex-col" style={`background:${t.bg}`}>
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center ${t.badge}`}>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                {c.iconPaths.map((d) => <path stroke-linecap="round" stroke-linejoin="round" d={d} />)}
              </svg>
            </div>
            <h3 class={`mt-5 ${t.text}`} style="font-size: var(--text-h3);">{c.title}</h3>
            <p class={`mt-2 text-sm leading-relaxed flex-1 ${t.desc}`}>{c.desc}</p>
            <span class={`mt-6 text-sm font-semibold ${t.arrow}`}>Explore &rarr;</span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- WHO WE HELP - SITUATION CARDS -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <div class="max-w-3xl">
        <h2 class="mt-3" style="font-size: var(--text-h2);">If You Don't Fit the Mold, You Fit Here.</h2>
      </div>

      <div class="mt-10 grid md:grid-cols-2 gap-x-16">
        <a href="/self-employed-mortgage/" class="no-underline text-[var(--color-ink)] border-t border-[var(--color-ink)]/15 py-8 flex flex-col gap-3">
          <h3 style="font-size: var(--text-h3);">Self-Employed and Business Owners</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed flex-1">Can't show W-2 income? We work from your bank statements: 12 months, personal or business.</p>
          <span class="text-sm font-semibold text-[var(--color-accent)]">See my options →</span>
        </a>

        <a href="/real-estate-investor-mortgage/" class="no-underline text-[var(--color-ink)] border-t border-[var(--color-ink)]/15 py-8 flex flex-col gap-3">
          <h3 style="font-size: var(--text-h3);">Real Estate Investors</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed flex-1">Income from properties, not paystubs. DSCR loans built for your portfolio. No personal income required.</p>
          <span class="text-sm font-semibold text-[var(--color-accent)]">See my options →</span>
        </a>

        <a href="/reverse-mortgage/" class="no-underline text-[var(--color-ink)] border-t border-[var(--color-ink)]/15 py-8 flex flex-col gap-3">
          <h3 style="font-size: var(--text-h3);">Homeowners 62 and Older</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed flex-1">Tap your home's equity. Stay in your home on your terms.</p>
          <span class="text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
        </a>

        <a href="/denied-mortgage/" class="no-underline text-[var(--color-ink)] border-t border-[var(--color-ink)]/15 py-8 flex flex-col gap-3">
          <h3 style="font-size: var(--text-h3);">Denied Before?</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed flex-1">Tell us why you were denied. We find paths other lenders miss.</p>
          <span class="text-sm font-semibold text-[var(--color-accent)]">Get a second opinion →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- LOCATIONS -->
  <section class="section bg-white">
    <div class="container-wide">
      <div class="max-w-3xl">
        <h2 class="mt-3" style="font-size: var(--text-h2);">Six offices. Five states. Real local people.</h2>
        <p class="lead mt-4 text-[var(--color-text-muted)]">
          New York is home to two of our six offices, including our HQ in Uniondale. We've grown into the markets
          where people actually live, work, retire, and invest.
        </p>
      </div>

      <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-x-12">
        {officeLocations.map((l) => {
          const branches = BRANCHES.filter((b) => l.branchSlugs?.includes(b.slug));
          return (
            <a href={`/locations/${l.path}/`} class="no-underline text-[var(--color-ink)] border-t border-[var(--color-ink)]/15 py-8 flex flex-col gap-3">
              <h3 style="font-size: var(--text-h3);">{l.name}</h3>
              {branches.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {branches.map((b) => (
                    <span class="text-xs font-medium px-3 py-1 rounded-full bg-[var(--color-mist-gray)] text-[var(--color-text-muted)]">{b.displayCity ?? b.city}</span>
                  ))}
                </div>
              )}
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed flex-1 line-clamp-2">{l.blurb}</p>
              <span class="text-sm font-semibold text-[var(--color-accent)]">Visit market →</span>
            </a>
          );
        })}
      </div>

      <!-- Licensed states, grouped by region -->
      <div class="mt-14 border-t border-[var(--color-ink)]/15 pt-10">
        <div class="max-w-3xl">
          <h3 style="font-size: var(--text-h3);">Licensed in {STATE_LICENSES.length} states.</h3>
          <p class="mt-3 text-sm text-[var(--color-text-muted)]">
            Cliffco Mortgage Bankers (NMLS #{COMPANY.nmls}) originates residential mortgage loans in:
          </p>
        </div>

        <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
          {statesByRegion.map((g) => (
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-accent)]">{g.region}</p>
              <ul class="mt-3 space-y-1.5 list-none p-0 m-0">
                {g.states.map((s) => (
                  <li class="text-sm text-[var(--color-text)]">{s}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <a href="/licensing/" class="inline-block mt-8 text-sm font-semibold text-[var(--color-accent)]">See regulators and license numbers →</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="accent-gradient">
    <div class="container-wide py-16 grid gap-8 lg:grid-cols-[2fr_1fr] items-center">
      <div>
        <p class="eyebrow !text-[var(--color-ice-blue)]">Get started</p>
        <h2 class="mt-3 text-white" style="font-size: var(--text-h2);">Tell us your situation and we'll find a path forward.</h2>
        <p class="lead mt-4 text-white/85">
          A licensed Cliffco loan officer responds in one business day. No bots, no call center.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Start a Pre-Approval</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

<style>
  /* Colored quick-link cards */
  .quicklink-card {
    box-shadow: 0 8px 24px rgba(13,13,13,0.12);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .quicklink-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(13,13,13,0.20);
  }

  /* Ambient light: two faded purple blurs that wander around the hero on their
     own slow paths. Disabled under reduced-motion. */
  .hero-blobs {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    will-change: transform;
  }
  .hero-blob-1 {
    width: clamp(360px, 46vw, 640px);
    height: clamp(360px, 46vw, 640px);
    left: 2%;
    top: -8%;
    background: radial-gradient(circle, rgba(102,51,204,0.60), rgba(102,51,204,0) 68%);
    animation: heroBlob1 24s ease-in-out infinite alternate;
  }
  .hero-blob-2 {
    width: clamp(320px, 40vw, 560px);
    height: clamp(320px, 40vw, 560px);
    right: 0%;
    bottom: -12%;
    background: radial-gradient(circle, rgba(124,69,224,0.50), rgba(124,69,224,0) 68%);
    animation: heroBlob2 30s ease-in-out infinite alternate;
  }
  @keyframes heroBlob1 {
    0%   { transform: translate(0%, 0%) scale(1); }
    50%  { transform: translate(55%, 45%) scale(1.15); }
    100% { transform: translate(20%, 10%) scale(0.95); }
  }
  @keyframes heroBlob2 {
    0%   { transform: translate(0%, 0%) scale(1); }
    50%  { transform: translate(-45%, -35%) scale(1.10); }
    100% { transform: translate(-15%, -5%) scale(1.05); }
  }
  .hero-animated .hero-blobs { z-index: 0; }
  @media (prefers-reduced-motion: reduce) {
    .hero-blob { animation: none; }
  }

  /* Sleek solid pill hero tiles */
  .hero-tile {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    border-radius: 9999px;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    background: var(--color-accent);
    box-shadow: 0 8px 22px rgba(102,51,204,0.45);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .hero-tile:hover {
    transform: translateY(-2px);
    background: #7a45e0;
    box-shadow: 0 12px 30px rgba(102,51,204,0.6);
  }
  .hero-tile-icon {
    width: 20px;
    height: 20px;
    color: var(--color-ice-blue);
    flex: 0 0 auto;
  }
</style>
</Layout>
