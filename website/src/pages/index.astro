---
import Layout from "../layouts/Layout.astro";
import { COMPANY } from "../data/company";
import { priorityProducts } from "../data/products";
import { LOCATIONS } from "../data/locations";
import { loanOfficer } from "../data/loan-officers";

const products = priorityProducts();
const homeMarkets = LOCATIONS.filter((l) =>
  ["new-york/long-island", "florida/orlando", "new-jersey", "arizona", "minnesota"].includes(l.path),
);
const president = loanOfficer("christopher-clifford-65234")!;
const yearsInBiz = COMPANY.yearsInBusiness();
---

<Layout
  title={`${COMPANY.brandName} — Mortgages for the people other banks turn away`}
  description={`Cliffco Mortgage Bankers is a ${yearsInBiz}-year independent lender (NMLS #${COMPANY.nmls}) specializing in non-QM, reverse, DSCR, and fix-and-flip loans across NY, NJ, AZ, MN, and FL.`}
>

  <!-- HERO -->
  <section class="accent-gradient">
    <div class="container-wide py-20 lg:py-28 grid lg:grid-cols-[1.2fr_1fr] gap-12 items-center">
      <div>
        <p class="eyebrow !text-[var(--color-ice-blue)]">Family-built since 1989 · NMLS #{COMPANY.nmls}</p>
        <h1 class="mt-4 text-white" style="font-size: var(--text-display-xl); line-height: 1.05;">
          We get families home.<br/>
          <span class="text-[var(--color-ice-blue)]">Especially the ones other banks turned away.</span>
        </h1>
        <p class="lead mt-6 text-white/90 max-w-2xl">
          {yearsInBiz} years. {COMPANY.legalName}. Real loan officers, no call center, no hand-offs.
          Specialists in non-QM and self-employed loans, reverse mortgages, DSCR for investors,
          and fix-and-flip financing — across New York, New Jersey, Arizona, Minnesota, and Florida.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Talk to a real LO</a>
          <a href="/loans/" class="btn btn-secondary !border-white !text-white">See loan products</a>
        </div>
      </div>

      <aside class="bg-white text-[var(--color-text)] rounded-2xl p-8 shadow-2xl">
        <p class="eyebrow">Quick Pre-Qualification</p>
        <h2 class="mt-2" style="font-size: var(--text-h3);">Tell us your situation. We'll tell you what we can do.</h2>
        <p class="text-sm text-[var(--color-text-muted)] mt-2">
          Three questions. No credit pull. A licensed Cliffco loan officer responds in one business day.
        </p>
        <a href="/get-started/" class="btn btn-primary w-full mt-4">Start now →</a>
        <p class="mt-4 text-xs text-[var(--color-text-muted)]">
          Or call <a href={`tel:${COMPANY.hq.phoneE164}`} class="font-semibold text-[var(--color-ink)]">{COMPANY.hq.phone}</a>
        </p>
      </aside>
    </div>
  </section>

  <!-- DIRECT-ANSWER (inverted pyramid for AEO) -->
  <section class="section bg-white">
    <div class="container-prose">
      <p class="eyebrow">What we do</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">A {yearsInBiz}-year independent mortgage banker built for the borrowers banks pre-decline.</h2>
      <div class="direct-answer mt-6">
        Cliffco Mortgage Bankers (NMLS #{COMPANY.nmls}) is an independent mortgage banker
        founded in 1989 and licensed in 32 states. We specialize in <strong>non-QM and
        self-employed loans</strong>, <strong>reverse mortgages</strong>, <strong>DSCR loans for
        investors</strong>, and <strong>fix-and-flip financing</strong> — with eight branches
        across New York, New Jersey, Arizona, Minnesota, and Florida (where we operate as
        Swish Capital, Inc.). Real loan officers underwrite every file. No call centers.
        No handoffs. No shortcuts.
      </div>
    </div>
  </section>

  <!-- PRODUCT CARDS -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">What we lend on</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Four loans we know better than almost anyone.</h2>
        <p class="lead mt-4 text-[var(--color-text-muted)]">
          Most lenders bolt non-QM and DSCR on as a side product. We've been originating these
          scenarios since the day they existed — and writing them when other banks said no.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {products.map((p) => (
          <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
            <p class="eyebrow">{p.category}</p>
            <h3 class="mt-2" style="font-size: var(--text-h3);">{p.shortName}</h3>
            <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">{p.oneLiner}</p>
            <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a href="/loans/" class="text-sm font-medium">See conventional, FHA, VA, USDA, and renovation loans →</a>
      </div>
    </div>
  </section>

  <!-- LOCATIONS -->
  <section class="section bg-white">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Where we lend</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Eight offices. Five priority states. Real local people.</h2>
        <p class="lead mt-4 text-[var(--color-text-muted)]">
          Long Island is home — three of our eight offices are here. We've grown into the markets
          where the people actually live, work, retire, and invest.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {homeMarkets.map((l) => (
          <a href={`/locations/${l.path}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
            <h3 style="font-size: var(--text-h3);">{l.name}</h3>
            <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">{l.blurb.split(".")[0]}.</p>
            <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">Visit market →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- VALUES STRIP -->
  <section class="section bg-[var(--color-rich-black)] text-white">
    <div class="container-wide grid gap-10 lg:grid-cols-[1fr_2fr] items-start">
      <div>
        <p class="eyebrow !text-[var(--color-ice-blue)]">Our values</p>
        <h2 class="mt-3 text-white" style="font-size: var(--text-h2);">The four things we won't compromise on.</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <h3 class="text-white" style="font-size: var(--text-h3);">Family</h3>
          <p class="mt-2 text-white/75">We treat every borrower like family — because we've been one for {yearsInBiz} years.</p>
        </div>
        <div>
          <h3 class="text-white" style="font-size: var(--text-h3);">Integrity</h3>
          <p class="mt-2 text-white/75">We do the right thing when it's hard, when it's slow, and when no one's watching.</p>
        </div>
        <div>
          <h3 class="text-white" style="font-size: var(--text-h3);">Care</h3>
          <p class="mt-2 text-white/75">Real hands on every file. No call centers, no handoffs, no shortcuts.</p>
        </div>
        <div>
          <h3 class="text-white" style="font-size: var(--text-h3);">Possibility</h3>
          <p class="mt-2 text-white/75">Other banks see a "no." We see a story worth working with.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LEADERSHIP / FOUNDER STRIP -->
  <section class="section bg-white">
    <div class="container-wide grid gap-10 lg:grid-cols-[1fr_1fr] items-center">
      <div class="bg-[var(--color-mist-gray)] rounded-2xl aspect-[4/3] flex items-center justify-center text-[var(--color-text-muted)]">
        <span class="text-sm">[ Leadership photo — to be added ]</span>
      </div>
      <div>
        <p class="eyebrow">Leadership</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">{yearsInBiz} years isn't a marketing line.</h2>
        <p class="lead mt-4 text-[var(--color-text-muted)]">
          Cliffco was founded in 1989 and has been independently owned ever since. Our President,
          {president.displayName} (NMLS #{president.nmls}), is personally licensed in 29 of our 32
          states — which means he can pick up a complex file and underwrite it himself.
        </p>
        <a href="/about/" class="btn btn-secondary mt-6">Read our story</a>
      </div>
    </div>
  </section>

  <!-- TRUST / CTA -->
  <section class="accent-gradient">
    <div class="container-wide py-16 grid gap-8 lg:grid-cols-[2fr_1fr] items-center">
      <div>
        <p class="eyebrow !text-[var(--color-ice-blue)]">Get started</p>
        <h2 class="mt-3 text-white" style="font-size: var(--text-h2);">Tell us your situation. We'll tell you what we can do.</h2>
        <p class="lead mt-4 text-white/85">
          A licensed Cliffco loan officer responds in one business day. No bots, no call center.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Start a pre-qual</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>
</Layout>
