---
import Layout from "../layouts/Layout.astro";
import Headshot from "../components/ui/Headshot.astro";
import { COMPANY } from "../data/company";
import { priorityProducts } from "../data/products";
import { loanOfficer } from "../data/loan-officers";
import { LOCATIONS } from "../data/locations";
import { BRANCHES } from "../data/branches";
import { FEATURED_REVIEWS } from "../data/reviews";

const products = priorityProducts();
const officeLocations = LOCATIONS.filter((l) => !l.path.includes("/"));
const president = loanOfficer("christopher-clifford")!;
const yearsInBiz = COMPANY.yearsInBusiness();

const productIcons: Record<string, string> = {
  "non-qm-self-employed": `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>`,
  "reverse-mortgage": `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>`,
  "dscr": `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>`,
  "business-bank-statement": `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z" /></svg>`,
};
---

<Layout
  title={`${COMPANY.brandName} - Mortgages for the people other banks turn away`}
  description={`Cliffco Mortgage Bankers is a ${yearsInBiz}-year independent lender (NMLS #${COMPANY.nmls}) specializing in Non-QM, reverse, DSCR, and business bank statement loans across NY, NJ, AZ, MN, and FL.`}
>

  <!-- HERO -->
  <section class="accent-gradient relative overflow-hidden">
    <img
      src="/images/content%20images/Purchasing%20Refinance%20Hero.png"
      alt=""
      aria-hidden="true"
      class="absolute bottom-0 right-0 hidden lg:block w-auto object-contain object-bottom pointer-events-none select-none"
      style="height:820px;right:3%;bottom:-120px;"
      loading="eager"
    />
    <div class="container-wide py-20 lg:py-28 relative z-10">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Family-built since 1989 · NMLS #{COMPANY.nmls}</p>
      <h1 class="mt-4 text-white max-w-3xl" style="font-size: var(--text-display-xl); line-height: 1.05; font-weight: 700; font-family: var(--font-sans);">
        When Big Banks Say No,<br/>
        <span class="text-[var(--color-ice-blue)]">We Say Let's Talk.</span>
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">
        Most lenders have rules where we have solutions. Bank statements, DSCR, reverse, and Non-QM loans mean your income doesn't have to look perfect to qualify.
      </p>

      <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-2xl">
        <a href="/self-employed-mortgage/" class="bg-white/10 hover:bg-white/20 border border-white/30 rounded-xl px-4 py-3 text-white font-medium flex items-center justify-center no-underline transition-colors text-sm whitespace-nowrap">I'm Self-Employed</a>
        <a href="/real-estate-investor-mortgage/" class="bg-white/10 hover:bg-white/20 border border-white/30 rounded-xl px-4 py-3 text-white font-medium text-center no-underline transition-colors text-sm">I'm an Investor</a>
        <a href="/reverse-mortgage/" class="bg-white/10 hover:bg-white/20 border border-white/30 rounded-xl px-4 py-3 text-white font-medium text-center no-underline transition-colors text-sm">I'm 62+</a>
        <a href="/denied-mortgage/" class="bg-white/10 hover:bg-white/20 border border-white/30 rounded-xl px-4 py-3 text-white font-medium text-center no-underline transition-colors text-sm">I Was Denied</a>
        <a href="/purchasing-refinancing/" class="bg-white/10 hover:bg-white/20 border border-white/30 rounded-xl px-4 py-3 text-white font-medium text-center no-underline transition-colors text-sm">I'm Purchasing</a>
      </div>

      <div class="mt-8">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Check My Eligibility</a>
        <p class="mt-3 text-white/70 text-sm">No credit pull. No commitment. Takes 2 minutes.</p>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="bg-white border-b border-[var(--color-mist-gray)]">
    <div class="container-wide py-6">
      <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-px bg-[var(--color-mist-gray)] rounded-xl overflow-hidden text-center">
        <div class="bg-white py-5 px-4">
          <dt class="flex items-center justify-center gap-1.5 text-[var(--color-text-muted)] text-xs uppercase tracking-wider">
            <svg class="w-3 h-3 text-[var(--color-accent)] shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292z"/></svg>
            Experience.com
          </dt>
          <dd class="font-semibold text-[var(--color-ink)] text-base mt-1.5">4.9★ <span data-countup data-target="3617" data-format="comma">3,617</span></dd>
        </div>
        <div class="bg-white py-5 px-4">
          <dt class="flex items-center justify-center gap-1.5 text-[var(--color-text-muted)] text-xs uppercase tracking-wider">
            <svg class="w-3 h-3 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
            BBB Rating
          </dt>
          <dd class="font-semibold text-[var(--color-ink)] text-base mt-1.5">A+</dd>
        </div>
        <div class="bg-white py-5 px-4 col-span-2 sm:col-span-1">
          <dt class="flex items-center justify-center gap-1.5 text-[var(--color-text-muted)] text-xs uppercase tracking-wider">
            <svg class="w-3 h-3 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            Total Closed
          </dt>
          <dd class="font-semibold text-[var(--color-ink)] text-base mt-1.5">$6B+</dd>
        </div>
        <div class="bg-white py-5 px-4">
          <dt class="flex items-center justify-center gap-1.5 text-[var(--color-text-muted)] text-xs uppercase tracking-wider">
            <svg class="w-3 h-3 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/></svg>
            Est.
          </dt>
          <dd class="font-semibold text-[var(--color-ink)] text-base mt-1.5">1989</dd>
        </div>
        <div class="bg-white py-5 px-4">
          <dt class="flex items-center justify-center gap-1.5 text-[var(--color-text-muted)] text-xs uppercase tracking-wider">
            <svg class="w-3 h-3 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z"/></svg>
            Licensed In
          </dt>
          <dd class="font-semibold text-[var(--color-ink)] text-base mt-1.5"><span data-countup data-target="32">32</span> States</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section bg-white">
    <div class="container-wide grid lg:grid-cols-2 gap-12 items-center">
      <div class="rounded-2xl overflow-hidden aspect-[4/3] bg-[var(--color-mist-gray)]">
        <img
          src="/images/content%20images/what-we-do.jpg"
          alt="Cliffco loan officer sitting with a family"
          class="w-full h-full object-cover"
        />
      </div>
      <div>
        <p class="eyebrow">What we do</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">In business over 40 years serving borrowers big banks overlook.</h2>
        <p class="mt-6" style="font-size: var(--text-lead); line-height: 1.55; color: var(--color-text);">
          Cliffco Mortgage Bankers (NMLS #{COMPANY.nmls}) is an independent mortgage banker
          founded in 1989 and licensed in 32 states. We specialize in <strong>Non-QM and
          self-employed loans</strong>, <strong>reverse mortgages</strong>, <strong>DSCR loans for
          investors</strong>, and <strong>business bank statement loans</strong>. We have nine branches
          across New York, New Jersey, Arizona, Minnesota, and Florida. Every file is underwritten
          in-house. No call centers. No handoffs. No shortcuts.
        </p>
      </div>
    </div>
  </section>

  <!-- WHO WE HELP - SITUATION CARDS -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Who we help</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">If You Don't Fit the Mold, You Fit Here.</h2>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <a href="/self-employed-mortgage/" class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
          <div class="w-11 h-11 rounded-xl bg-[var(--color-accent)]/10 flex items-center justify-center mb-4 text-[var(--color-accent)]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" /></svg>
          </div>
          <h3 style="font-size: var(--text-h3);">Self-Employed and Business Owners</h3>
          <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">Can't show W-2 income? We work from your bank statements: 12 months, personal or business.</p>
          <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">See my options →</span>
        </a>

        <a href="/real-estate-investor-mortgage/" class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
          <div class="w-11 h-11 rounded-xl bg-[var(--color-accent)]/10 flex items-center justify-center mb-4 text-[var(--color-accent)]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" /></svg>
          </div>
          <h3 style="font-size: var(--text-h3);">Real Estate Investors</h3>
          <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">Income from properties, not paystubs. DSCR loans built for your portfolio. No personal income required.</p>
          <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">See my options →</span>
        </a>

        <a href="/reverse-mortgage/" class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
          <div class="w-11 h-11 rounded-xl bg-[var(--color-accent)]/10 flex items-center justify-center mb-4 text-[var(--color-accent)]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
          </div>
          <h3 style="font-size: var(--text-h3);">Homeowners 62 and Older</h3>
          <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">Tap your home's equity. Stay in your home on your terms.</p>
          <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
        </a>

        <a href="/denied-mortgage/" class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
          <div class="w-11 h-11 rounded-xl bg-[var(--color-accent)]/10 flex items-center justify-center mb-4 text-[var(--color-accent)]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
          </div>
          <h3 style="font-size: var(--text-h3);">Denied Before?</h3>
          <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">Tell us why you were denied. We find paths other lenders miss.</p>
          <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">Get a second opinion →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- LOAN PROGRAMS -->
  <section class="section bg-white">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Our niche</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">The four loan types we've spent decades mastering.</h2>
        <p class="lead mt-4 text-[var(--color-text-muted)]">
          Most lenders bolt on Non-QM and DSCR as a side product. We've been originating these
          scenarios since the day they existed, writing them when other banks said no.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {products.map((p) => (
          <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
            <div class="w-11 h-11 rounded-xl bg-[var(--color-accent)]/10 flex items-center justify-center mb-4 text-[var(--color-accent)]" set:html={productIcons[p.slug] ?? ""}></div>
            <h3 style="font-size: var(--text-h3);">{p.shortName}</h3>
            <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">{p.oneLiner}</p>
            <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a href="/loans/" class="text-sm font-medium">See conventional, FHA, VA, USDA, and renovation loans →</a>
      </div>
    </div>
  </section>

  <!-- HELOC SPOTLIGHT -->
  <section class="accent-gradient">
    <div class="container-wide py-12 lg:py-16">
      <div class="grid lg:grid-cols-[2fr_1fr] gap-8 items-center">
        <div>
          <p class="eyebrow !text-[var(--color-ice-blue)]">Featured Program</p>
          <h2 class="mt-3 text-white" style="font-size: var(--text-h2);">HELOC: Approved in 5 minutes. Funded in 5 days.<sup class="text-sm">*</sup></h2>
          <p class="lead mt-4 text-white/85">
            Access your home equity without refinancing your first mortgage. Our HELOC program delivers an approval decision in five minutes and funding in as few as five business days.
          </p>
          <p class="mt-6 text-xs text-white/50 leading-relaxed max-w-2xl">
            *Approval may be granted in five minutes but is ultimately subject to verification of income and employment, as well as verification that the property is in at least average condition with a property condition report. Five business day funding timeline assumes closing the loan with our remote online notary. Funding timelines may be longer for loans secured by properties located in counties that do not permit recording of e-signatures or that otherwise require an in-person closing.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get Pre-Qualified</a>
          <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section bg-[var(--color-rich-black)] text-white">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow !text-[var(--color-ice-blue)]">How it works</p>
        <h2 class="mt-3 text-white" style="font-size: var(--text-h2);">A simple process, no matter how complex your situation.</h2>
      </div>

      <div class="mt-10 grid gap-10 md:grid-cols-3">
        <div>
          <p class="text-[var(--color-ice-blue)] font-bold" style="font-size: var(--text-display-lg);">01</p>
          <div class="mt-3 w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center text-[var(--color-ice-blue)]">
