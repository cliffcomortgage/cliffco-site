---
import Layout from "../layouts/Layout.astro";
import { COMPANY } from "../data/company";

const yearsInBiz = COMPANY.yearsInBusiness();

// Hero path tiles + primary CTA
const heroTiles = [
  {
    label: "Buy a Home",
    href: "/get-started/buy/",
    iconPaths: ["M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"],
  },
  {
    label: "Refinance My Mortgage",
    href: "/get-started/refinance/",
    iconPaths: ["M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"],
  },
  {
    label: "Get Cash from My Home",
    href: "/get-started/cash-out/",
    iconPaths: ["M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"],
  },
];
---

<Layout
  title={`${COMPANY.brandName} - Mortgages for the people other banks turn away`}
  description={`Cliffco Mortgage Bankers is a ${yearsInBiz}-year independent lender (NMLS #${COMPANY.nmls}) specializing in Non-QM, reverse, DSCR, and business bank statement loans across NY, NJ, AZ, MN, and FL.`}
>

  <!-- HERO -->
  <section class="bg-white flex items-center" style="min-height: calc(100svh - 72px);">
    <div class="container-wide py-16 text-center flex flex-col items-center">
      <h1 class="text-[var(--color-ink)]" style="font-size: clamp(1.75rem, 3.4vw, 2.75rem); line-height: 1.15; font-weight: 700; font-family: var(--font-sans);">
        The mortgage process should be black and white.
      </h1>

      <p class="mt-5 text-[var(--color-text-muted)] max-w-2xl" style="font-size: clamp(0.95rem, 1.1vw, 1.0625rem); line-height: 1.55;">
        Clarity and simplicity that cuts through the noise.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4 max-w-3xl">
        {heroTiles.map((t) => (
          <a href={t.href} class="hero-tile">
            <svg class="hero-tile-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
              {t.iconPaths.map((d) => (
                <path stroke-linecap="round" stroke-linejoin="round" d={d} />
              ))}
            </svg>
            <span>{t.label}</span>
          </a>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/get-started/" class="btn btn-primary hero-btn-primary hero-btn">Start a Pre-Approval</a>
        <a href="/loan-officers/" class="btn btn-secondary hero-btn">Find a Loan Officer</a>
      </div>
      <p class="mt-3 text-[var(--color-text-muted)] text-xs">No credit pull. No commitment. Takes 2 minutes.</p>
    </div>
  </section>

<style>
  /* Monochrome hero tiles (no purple/blue) */
  .hero-tile {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    background: var(--color-rich-black);
    box-shadow: 0 8px 22px rgba(13,13,13,0.25);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .hero-tile:hover {
    transform: translateY(-2px);
    background: #262626;
    box-shadow: 0 12px 30px rgba(13,13,13,0.35);
  }
  .hero-btn {
    padding: 0.7rem 1.4rem;
    font-size: 0.875rem;
    min-height: 40px;
  }
  .hero-tile-icon {
    width: 20px;
    height: 20px;
    color: #fff;
    flex: 0 0 auto;
  }

  /* Override .btn-primary's default purple hover for this monochrome hero */
  .hero-btn-primary:hover {
    background: #262626 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tile { transition: none; }
  }
</style>
</Layout>
