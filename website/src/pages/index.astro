---
import Layout from "../layouts/Layout.astro";
import { COMPANY } from "../data/company";

const yearsInBiz = COMPANY.yearsInBusiness();
---

<Layout
  title={`${COMPANY.brandName} - Home Loans for First-Time & Move-Up Buyers`}
  description={`Buying your first home, moving up, or refinancing? Cliffco Mortgage Bankers is a ${yearsInBiz}-year independent lender (NMLS #${COMPANY.nmls}) with conventional, FHA, VA, and down payment assistance programs.`}
>

  <!-- HERO -->
  <section class="bg-white flex items-center" style="min-height: calc(100svh - 72px);">
    <div class="container-wide py-16 text-center flex flex-col items-center">
      <h1 class="text-[var(--color-ink)]" style="font-size: clamp(1.875rem, 3.5vw, 2.8rem); line-height: 1.15; font-weight: 700; font-family: var(--font-display);">
        The mortgage process should be black and white.
      </h1>

      {/* The site's one Sky box. The caption is the brand's signature - bold Archivo with
          exactly one word in black on Sky - and the guide allows one box per surface, so
          this is the only place on the site it appears. Same words as before. */}
      <p class="caption mt-5 text-[var(--color-ink)] max-w-2xl" style="font-size: clamp(1.15rem, 1.55vw, 1.3rem); font-weight: 600;">
        Clarity and <span class="sky-box">simplicity</span> that cuts through the noise.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/get-started/" class="btn btn-secondary hero-btn">Get Started</a>
      </div>
      <p class="mt-3 text-[var(--color-text-muted)] text-base">No credit pull. No commitment. Takes 2 minutes.</p>
      <p class="mt-1 text-[var(--color-text-muted)] text-sm">{COMPANY.legalName} NMLS #{COMPANY.nmls}</p>
    </div>
  </section>

<style>
  .hero-btn {
    padding: 0.95rem 1.9rem;
    font-size: 1.0625rem;
    min-height: 52px;
  }
</style>
</Layout>
