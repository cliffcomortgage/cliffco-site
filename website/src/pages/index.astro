---
import Layout from "../layouts/Layout.astro";
import Headshot from "../components/ui/Headshot.astro";
import { COMPANY } from "../data/company";
import { priorityProducts } from "../data/products";
import { loanOfficer } from "../data/loan-officers";
import { LOCATIONS } from "../data/locations";
import { BRANCHES } from "../data/branches";
import { FEATURED_REVIEWS } from "../data/reviews";

const products = priorityProducts();
const officeLocations = LOCATIONS.filter((l) => !l.path.includes("/"));
const president = loanOfficer("christopher-clifford-65234")!;
const yearsInBiz = COMPANY.yearsInBusiness();
---

<Layout
  title={`${COMPANY.brandName} — Mortgages for the people other banks turn away`}
  description={`Cliffco Mortgage Bankers is a ${yearsInBiz}-year independent lender (NMLS #${COMPANY.nmls}) specializing in non-QM, reverse, DSCR, and business bank statement loans across NY, NJ, AZ, MN, and FL.`}
>

  <!-- HERO -->
  <section class="accent-gradient">
    <div class="container-wide py-20 lg:py-28">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Family-built since 1989 · NMLS #{COMPANY.nmls}</p>
      <h1 class="mt-4 text-white max-w-3xl" style="font-size: var(--text-display-xl); line-height: 1.05; font-weight: 700; font-family: var(--font-sans);">
        You Were Told No.<br/>
        <span class="text-[var(--color-ice-blue)]">We Start There.</span>
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">
        Most lenders have one playbook. We have multiple. Bank statements, DSCR, reverse, non-QM. Your income doesn't have to look perfect to qualify.
      </p>

      <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3 max-w-2xl">
        <a href="/self-employed-mortgage/" class="bg-white/10 hover:bg-white/20 border border-white/30 rounded-xl px-4 py-3 text-white font-medium text-center no-underline transition-colors text-sm">I'm Self-Employed</a>
        <a href="/real-estate-investor-mortgage/" class="bg-white/10 hover:bg-white/20 border border-white/30 rounded-xl px-4 py-3 text-white font-medium text-center no-underline transition-colors text-sm">I'm an Investor</a>
        <a href="/reverse-mortgage/" class="bg-white/10 hover:bg-white/20 border border-white/30 rounded-xl px-4 py-3 text-white font-medium text-center no-underline transition-colors text-sm">I'm 62+</a>
        <a href="/denied-mortgage/" class="bg-white/10 hover:bg-white/20 border border-white/30 rounded-xl px-4 py-3 text-white font-medium text-center no-underline transition-colors text-sm">I Was Denied</a>
      </div>

      <div class="mt-8">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">See What's Possible</a>
        <p class="mt-3 text-white/70 text-sm">No credit pull. No commitment. Takes 2 minutes.</p>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="bg-white border-b border-[var(--color-mist-gray)]">
    <div class="container-wide py-5">
      <dl class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 text-center text-sm">
        <div>
          <dt class="text-[var(--color-text-muted)] text-xs uppercase tracking-wider">Experience.com</dt>
          <dd class="font-semibold text-[var(--color-ink)] mt-0.5">4.9&#9733;&nbsp;&nbsp;3,617 reviews</dd>
        </div>
        <div class="hidden md:block w-px h-8 bg-[var(--color-mist-gray)]" aria-hidden="true"></div>
        <div>
          <dt class="text-[var(--color-text-muted)] text-xs uppercase tracking-wider">BBB Rating</dt>
          <dd class="font-semibold text-[var(--color-ink)] mt-0.5">A+</dd>
        </div>
        <div class="hidden md:block w-px h-8 bg-[var(--color-mist-gray)]" aria-hidden="true"></div>
        <div>
          <dt class="text-[var(--color-text-muted)] text-xs uppercase tracking-wider">Total Closed</dt>
          <dd class="font-semibold text-[var(--color-ink)] mt-0.5">$6B+</dd>
        </div>
        <div class="hidden md:block w-px h-8 bg-[var(--color-mist-gray)]" aria-hidden="true"></div>
        <div>
          <dt class="text-[var(--color-text-muted)] text-xs uppercase tracking-wider">Est.</dt>
          <dd class="font-semibold text-[var(--color-ink)] mt-0.5">1989</dd>
        </div>
        <div class="hidden md:block w-px h-8 bg-[var(--color-mist-gray)]" aria-hidden="true"></div>
        <div>
          <dt class="text-[var(--color-text-muted)] text-xs uppercase tracking-wider">Licensed In</dt>
          <dd class="font-semibold text-[var(--color-ink)] mt-0.5">32 States</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section bg-white">
    <div class="container-wide grid lg:grid-cols-2 gap-12 items-center">
      <div class="rounded-2xl overflow-hidden aspect-[4/3] bg-[var(--color-mist-gray)]">
        <img
          src="/images/content%20images/what-we-do.jpg"
          alt="Cliffco loan officer sitting with a family"
          class="w-full h-full object-cover"
        />
      </div>
      <div>
        <p class="eyebrow">What we do</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">A {yearsInBiz}-year mortgage bank built for borrowers other banks turn away.</h2>
        <p class="mt-6" style="font-size: var(--text-lead); line-height: 1.55; color: var(--color-text);">
          Cliffco Mortgage Bankers (NMLS #{COMPANY.nmls}) is an independent mortgage banker
          founded in 1989 and licensed in 32 states. We specialize in <strong>non-QM and
          self-employed loans</strong>, <strong>reverse mortgages</strong>, <strong>DSCR loans for
          investors</strong>, and <strong>business bank statement loans</strong>. We have nine branches
          across New York, New Jersey, Arizona, Minnesota, and Florida. Every file is underwritten
          in-house. No call centers. No handoffs. No shortcuts.
        </p>
      </div>
    </div>
  </section>

  <!-- WHO WE HELP — SITUATION CARDS -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Who we help</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Built for the borrower other lenders can't figure out.</h2>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <a href="/self-employed-mortgage/" class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
          <h3 style="font-size: var(--text-h3);">Self-Employed and Business Owners</h3>
          <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">Can't show W-2 income? We work from your bank statements: 12 months, personal or business.</p>
          <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">See my options →</span>
        </a>

        <a href="/real-estate-investor-mortgage/" class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
          <h3 style="font-size: var(--text-h3);">Real Estate Investors</h3>
          <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">Income from properties, not paystubs. DSCR loans built for your portfolio. No personal income required.</p>
          <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">See my options →</span>
        </a>

        <a href="/reverse-mortgage/" class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
          <h3 style="font-size: var(--text-h3);">Homeowners 62 and Older</h3>
          <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">Tap your home's equity. Stay in your home. On your terms.</p>
          <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
        </a>

        <a href="/denied-mortgage/" class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
          <h3 style="font-size: var(--text-h3);">Denied Before?</h3>
          <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">Tell us why you were denied. We find paths other lenders miss.</p>
          <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">Get a second opinion →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- LOAN PROGRAMS -->
  <section class="section bg-white">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Our niche</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Four loans we know better than almost anyone.</h2>
        <p class="lead mt-4 text-[var(--color-text-muted)]">
          Most lenders bolt non-QM and DSCR on as a side product. We've been originating these
          scenarios since the day they existed, writing them when other banks said no.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {products.map((p) => (
          <a href={`/loans/${p.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
            <h3 style="font-size: var(--text-h3);">{p.shortName}</h3>
            <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">{p.oneLiner}</p>
            <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a href="/loans/" class="text-sm font-medium">See conventional, FHA, VA, USDA, and renovation loans →</a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section bg-[var(--color-rich-black)] text-white">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow !text-[var(--color-ice-blue)]">How it works</p>
        <h2 class="mt-3 text-white" style="font-size: var(--text-h2);">Simple process. Complex situations welcome.</h2>
      </div>

      <div class="mt-10 grid gap-10 md:grid-cols-3">
        <div>
          <p class="text-[var(--color-ice-blue)] font-bold" style="font-size: var(--text-display-lg);">01</p>
          <h3 class="mt-4 text-white" style="font-size: var(--text-h3);">Tell us your situation</h3>
          <p class="mt-2 text-white/75">No credit pull. No commitment. Just a conversation about where you are and where you want to go.</p>
        </div>
        <div>
          <p class="text-[var(--color-ice-blue)] font-bold" style="font-size: var(--text-display-lg);">02</p>
          <h3 class="mt-4 text-white" style="font-size: var(--text-h3);">We find your path</h3>
          <p class="mt-2 text-white/75">A real mortgage specialist reviews your file within 24 hours and identifies the right program, not a bot.</p>
        </div>
        <div>
          <p class="text-[var(--color-ice-blue)] font-bold" style="font-size: var(--text-display-lg);">03</p>
          <h3 class="mt-4 text-white" style="font-size: var(--text-h3);">Close with confidence</h3>
          <p class="mt-2 text-white/75">We manage every step from application to keys. You focus on what's next.</p>
        </div>
      </div>

      <div class="mt-10">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Tell us your situation</a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <p class="eyebrow">From our borrowers</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Real stories. Real loans. Real people.</h2>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {FEATURED_REVIEWS.map((r) => (
          <figure class="card flex flex-col m-0">
            <blockquote class="flex-1 m-0 p-0 border-0">
              <p class="text-[var(--color-text)] leading-relaxed">"{r.quote}"</p>
            </blockquote>
            <figcaption class="mt-6 pt-4 border-t border-[var(--color-mist-gray)]">
              <p class="font-semibold text-[var(--color-ink)] text-sm">{r.author}</p>
              <p class="text-xs text-[var(--color-text-muted)] mt-0.5">{r.platform}</p>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a href="/reviews/" class="text-sm font-medium">Read all reviews →</a>
      </div>
    </div>
  </section>

  <!-- LOCATIONS -->
  <section class="section bg-white">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Where we lend</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Nine offices. Five priority states. Real local people.</h2>
        <p class="lead mt-4 text-[var(--color-text-muted)]">
          New York is home to four of our eight offices, including our HQ in Uniondale. We've grown into the markets
          where people actually live, work, retire, and invest.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {officeLocations.map((l) => {
          const branches = BRANCHES.filter((b) => l.branchSlugs?.includes(b.slug));
          return (
            <a href={`/locations/${l.path}/`} class="card no-underline text-[var(--color-ink)] flex flex-col h-full">
              <h3 style="font-size: var(--text-h3);">{l.name}</h3>
              {branches.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {branches.map((b) => (
                    <span class="text-xs font-medium px-3 py-1 rounded-full bg-[var(--color-mist-gray)] text-[var(--color-text-muted)]">{b.displayCity ?? b.city}</span>
                  ))}
                </div>
              )}
              <p class="mt-4 text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">{l.blurb.split(".")[0]}.</p>
              <span class="mt-5 text-sm font-semibold text-[var(--color-accent)]">Visit market →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section bg-[var(--color-rich-black)] text-white">
    <div class="container-wide grid gap-10 lg:grid-cols-[1fr_2fr] items-start">
      <div>
        <p class="eyebrow !text-[var(--color-ice-blue)]">Our values</p>
        <h2 class="mt-3 text-white" style="font-size: var(--text-h2);">The four things we won't compromise on.</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <h3 class="text-white" style="font-size: var(--text-h3);">Family</h3>
          <p class="mt-2 text-white/75">We treat every borrower like family, because we've been one for {yearsInBiz} years.</p>
        </div>
        <div>
          <h3 class="text-white" style="font-size: var(--text-h3);">Integrity</h3>
          <p class="mt-2 text-white/75">We do the right thing when it's hard, when it's slow, and when no one's watching.</p>
        </div>
        <div>
          <h3 class="text-white" style="font-size: var(--text-h3);">Care</h3>
          <p class="mt-2 text-white/75">Real hands on every file. No call centers, no handoffs, no shortcuts.</p>
        </div>
        <div>
          <h3 class="text-white" style="font-size: var(--text-h3);">Possibility</h3>
          <p class="mt-2 text-white/75">Other banks see a "no." We see a story worth working with.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LEADERSHIP -->
  <section class="section bg-white">
    <div class="container-wide grid gap-10 lg:grid-cols-[1fr_1fr] items-center">
      <div>
        <Headshot slug={president.slug} name={president.displayName} size={520} shape="rounded" />
      </div>
      <div>
        <p class="eyebrow">Leadership</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">{yearsInBiz} years isn't a marketing line.</h2>
        <p class="lead mt-4 text-[var(--color-text-muted)]">
          Cliffco was founded in 1989 and has been independently owned ever since. Our President,
          <a href={`/loan-officers/${president.slug}/`}>{president.displayName}</a> (NMLS #{president.nmls}),
          is personally licensed in 29 of our 32 states. When a complex file comes in, he can
          step in personally and see it through.
        </p>
        <a href="/about/" class="btn btn-secondary mt-6">Read our story</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="accent-gradient">
    <div class="container-wide py-16 grid gap-8 lg:grid-cols-[2fr_1fr] items-center">
      <div>
        <p class="eyebrow !text-[var(--color-ice-blue)]">Get started</p>
        <h2 class="mt-3 text-white" style="font-size: var(--text-h2);">Tell us your situation. We'll tell you what we can do.</h2>
        <p class="lead mt-4 text-white/85">
          A licensed Cliffco loan officer responds in one business day. No bots, no call center.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Start a pre-qual</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>
</Layout>
