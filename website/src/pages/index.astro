---
import Layout from "../layouts/Layout.astro";
import { COMPANY } from "../data/company";
import { LOCATIONS } from "../data/locations";
import { BRANCHES } from "../data/branches";
import { STATE_LICENSES } from "../data/state-licenses";

const officeLocations = LOCATIONS.filter((l) => !l.path.includes("/"));
const licensedStates = [...STATE_LICENSES].map((s) => s.name).sort();
const yearsInBiz = COMPANY.yearsInBusiness();

// Hero path tiles + primary CTA
const heroTiles = [
  { label: "Buy a Home", href: "/purchasing-refinancing/" },
  { label: "Refinance My Mortgage", href: "/loans/refinancing/" },
  { label: "Get Cash from My Home", href: "/loans/heloc/" },
];
---

<Layout
  title={`${COMPANY.brandName} - Mortgages for the people other banks turn away`}
  description={`Cliffco Mortgage Bankers is a ${yearsInBiz}-year independent lender (NMLS #${COMPANY.nmls}) specializing in Non-QM, reverse, DSCR, and business bank statement loans across NY, NJ, AZ, MN, and FL.`}
>

  <!-- HERO -->
  <section
    class="accent-gradient relative overflow-hidden"
    style="background:
      radial-gradient(1000px 520px at 50% -8%, rgba(102,51,204,0.55), transparent 60%),
      radial-gradient(900px 520px at 15% 115%, rgba(189,232,241,0.18), transparent 55%),
      radial-gradient(760px 460px at 90% 108%, rgba(102,51,204,0.26), transparent 58%),
      linear-gradient(160deg, #0d0d0d 0%, #1c1a20 100%);"
  >
    <div class="container-wide py-24 lg:py-32 text-center flex flex-col items-center">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Family-built since 1989 · NMLS #{COMPANY.nmls}</p>

      <h1 class="mt-5 text-white md:whitespace-nowrap" style="font-size: clamp(2rem, 4.6vw, 4rem); line-height: 1.1; font-weight: 700; font-family: var(--font-sans);">
        When Big Banks Say No, <span class="text-[var(--color-ice-blue)]">We Say Yes.</span>
      </h1>

      <p class="mt-6 text-white/85 max-w-3xl" style="font-size: clamp(1.05rem, 1.35vw, 1.25rem); line-height: 1.55;">
        Complex scenarios don't scare us. Traditional Income Earners, Self-Employed, Business Owners, or Entrepreneurs - Our solutions work for all.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4 max-w-3xl">
        {heroTiles.map((t) => (
          <a href={t.href} class="hero-tile">{t.label}</a>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Start a Pre-Approval</a>
        <a href="/loan-officers/" class="btn btn-secondary !border-white !text-white hover:!bg-white/10">Find a Loan Officer</a>
      </div>
      <p class="mt-3 text-white/70 text-sm">No credit pull. No commitment. Takes 2 minutes.</p>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="bg-white border-b border-[var(--color-mist-gray)]">
    <div class="container-wide py-8">
      <dl class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-mist-gray)] rounded-lg overflow-hidden text-center">
        <div class="bg-white py-7 px-4">
          <dt class="flex items-center justify-center gap-2 text-[var(--color-text-muted)] text-sm uppercase tracking-wide">
            <svg class="w-4 h-4 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
            BBB Rating
          </dt>
          <dd class="font-bold text-[var(--color-ink)] text-3xl mt-2">A+</dd>
        </div>
        <div class="bg-white py-7 px-4">
          <dt class="flex items-center justify-center gap-2 text-[var(--color-text-muted)] text-sm uppercase tracking-wide">
            <svg class="w-4 h-4 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            Total Closed
          </dt>
          <dd class="font-bold text-[var(--color-ink)] text-3xl mt-2">$6B+</dd>
        </div>
        <div class="bg-white py-7 px-4">
          <dt class="flex items-center justify-center gap-2 text-[var(--color-text-muted)] text-sm uppercase tracking-wide">
            <svg class="w-4 h-4 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/></svg>
            Lending Since
          </dt>
          <dd class="font-bold text-[var(--color-ink)] text-3xl mt-2">1989</dd>
        </div>
        <div class="bg-white py-7 px-4">
          <dt class="flex items-center justify-center gap-2 text-[var(--color-text-muted)] text-sm uppercase tracking-wide">
            <svg class="w-4 h-4 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z"/></svg>
            Licensed In
          </dt>
          <dd class="font-bold text-[var(--color-ink)] text-3xl mt-2">{licensedStates.length} States</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- WHO WE HELP - SITUATION CARDS -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <div class="max-w-3xl">
        <h2 class="mt-3" style="font-size: var(--text-h2);">If You Don't Fit the Mold, You Fit Here.</h2>
      </div>

      <div class="mt-10 grid md:grid-cols-2 gap-x-16">
        <a href="/self-employed-mortgage/" class="no-underline text-[var(--color-ink)] border-t border-[var(--color-ink)]/15 py-8 flex flex-col gap-3">
          <h3 style="font-size: var(--text-h3);">Self-Employed and Business Owners</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed flex-1">Can't show W-2 income? We work from your bank statements: 12 months, personal or business.</p>
          <span class="text-sm font-semibold text-[var(--color-accent)]">See my options →</span>
        </a>

        <a href="/real-estate-investor-mortgage/" class="no-underline text-[var(--color-ink)] border-t border-[var(--color-ink)]/15 py-8 flex flex-col gap-3">
          <h3 style="font-size: var(--text-h3);">Real Estate Investors</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed flex-1">Income from properties, not paystubs. DSCR loans built for your portfolio. No personal income required.</p>
          <span class="text-sm font-semibold text-[var(--color-accent)]">See my options →</span>
        </a>

        <a href="/reverse-mortgage/" class="no-underline text-[var(--color-ink)] border-t border-[var(--color-ink)]/15 py-8 flex flex-col gap-3">
          <h3 style="font-size: var(--text-h3);">Homeowners 62 and Older</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed flex-1">Tap your home's equity. Stay in your home on your terms.</p>
          <span class="text-sm font-semibold text-[var(--color-accent)]">Learn more →</span>
        </a>

        <a href="/denied-mortgage/" class="no-underline text-[var(--color-ink)] border-t border-[var(--color-ink)]/15 py-8 flex flex-col gap-3">
          <h3 style="font-size: var(--text-h3);">Denied Before?</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed flex-1">Tell us why you were denied. We find paths other lenders miss.</p>
          <span class="text-sm font-semibold text-[var(--color-accent)]">Get a second opinion →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- LOCATIONS -->
  <section class="section bg-white">
    <div class="container-wide">
      <div class="max-w-3xl">
        <h2 class="mt-3" style="font-size: var(--text-h2);">Six offices. Five states. Real local people.</h2>
        <p class="lead mt-4 text-[var(--color-text-muted)]">
          New York is home to two of our six offices, including our HQ in Uniondale. We've grown into the markets
          where people actually live, work, retire, and invest.
        </p>
      </div>

      <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-x-12">
        {officeLocations.map((l) => {
          const branches = BRANCHES.filter((b) => l.branchSlugs?.includes(b.slug));
          return (
            <a href={`/locations/${l.path}/`} class="no-underline text-[var(--color-ink)] border-t border-[var(--color-ink)]/15 py-8 flex flex-col gap-3">
              <h3 style="font-size: var(--text-h3);">{l.name}</h3>
              {branches.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {branches.map((b) => (
                    <span class="text-xs font-medium px-3 py-1 rounded-full bg-[var(--color-mist-gray)] text-[var(--color-text-muted)]">{b.displayCity ?? b.city}</span>
                  ))}
                </div>
              )}
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed flex-1 line-clamp-2">{l.blurb}</p>
              <span class="text-sm font-semibold text-[var(--color-accent)]">Visit market →</span>
            </a>
          );
        })}
      </div>

      <!-- Licensed states -->
      <div class="mt-14 border-t border-[var(--color-ink)]/15 pt-10">
        <h3 style="font-size: var(--text-h3);">Licensed in {licensedStates.length} states.</h3>
        <p class="mt-3 text-sm text-[var(--color-text-muted)] max-w-3xl">
          Cliffco Mortgage Bankers (NMLS #{COMPANY.nmls}) is licensed to lend in:
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          {licensedStates.map((s) => (
            <span class="text-sm font-medium px-3 py-1.5 rounded-full bg-[var(--color-mist-gray)] text-[var(--color-text)]">{s}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="accent-gradient">
    <div class="container-wide py-16 grid gap-8 lg:grid-cols-[2fr_1fr] items-center">
      <div>
        <p class="eyebrow !text-[var(--color-ice-blue)]">Get started</p>
        <h2 class="mt-3 text-white" style="font-size: var(--text-h2);">Tell us your situation and we'll find a path forward.</h2>
        <p class="lead mt-4 text-white/85">
          A licensed Cliffco loan officer responds in one business day. No bots, no call center.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Start a Pre-Approval</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

<style>
  /* Glossy, glass hero tiles */
  .hero-tile {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(180deg, rgba(255,255,255,0.20), rgba(255,255,255,0.06));
    border: 1px solid rgba(255,255,255,0.38);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.40), 0 8px 24px rgba(0,0,0,0.28);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, border-color 0.18s ease;
  }
  .hero-tile:hover {
    transform: translateY(-2px);
    background: linear-gradient(180deg, rgba(255,255,255,0.32), rgba(255,255,255,0.14));
    border-color: rgba(189,232,241,0.85);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.55), 0 14px 32px rgba(102,51,204,0.45);
  }
</style>
</Layout>
