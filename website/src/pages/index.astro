---
import Layout from "../layouts/Layout.astro";
import { COMPANY } from "../data/company";

const yearsInBiz = COMPANY.yearsInBusiness();
---

<Layout
  title={`${COMPANY.brandName} - Mortgages for the people other banks turn away`}
  description={`Cliffco Mortgage Bankers is a ${yearsInBiz}-year independent lender (NMLS #${COMPANY.nmls}) specializing in Non-QM, reverse, DSCR, and business bank statement loans across NY, NJ, AZ, MN, and FL.`}
>

  <!-- HERO -->
  <section class="bg-white flex items-center" style="min-height: calc(100svh - 72px);">
    <div class="container-wide py-16 text-center flex flex-col items-center">
      <h1 class="text-[var(--color-ink)]" style="font-size: clamp(1.925rem, 3.75vw, 3.025rem); line-height: 1.15; font-weight: 700; font-family: var(--font-sans);">
        The mortgage process should be black and white.
      </h1>

      <p class="mt-5 text-[var(--color-text-muted)] max-w-2xl" style="font-size: clamp(1.05rem, 1.2vw, 1.175rem); line-height: 1.55;">
        Clarity and simplicity that cuts through the noise.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/get-started/" class="btn btn-secondary hero-btn">Get Started</a>
      </div>
      <p class="mt-3 text-[var(--color-text-muted)] text-sm">No credit pull. No commitment. Takes 2 minutes.</p>
      <p class="mt-1 text-[var(--color-text-muted)] text-xs">{COMPANY.legalName} NMLS #{COMPANY.nmls}</p>
    </div>
  </section>

<style>
  .hero-btn {
    padding: 0.85rem 1.65rem;
    font-size: 1rem;
    min-height: 48px;
  }
</style>
</Layout>
