---
import { STATE_LICENSES } from "../../data/state-licenses";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { articleSchema } from "../../lib/schema";
import { averageRating } from "../../data/reviews";
import { BRANCHES } from "../../data/branches";

const avgRating = averageRating().toFixed(1);

const yearsInBiz = COMPANY.yearsInBusiness();
const branchCount = BRANCHES.length;

const schema = [
  articleSchema({
    headline: "Why Cliffco Mortgage Bankers",
    description: `${yearsInBiz} years of mortgage lending, ${STATE_LICENSES.length} states, ${branchCount} branches, and loans for first-time buyers, move-up buyers, and refinances, plus the specialty programs many lenders don't offer. What makes Cliffco different.`,
    url: "/why-cliffco/",
    datePublished: "2026-04-15",
    dateModified: "2026-10-07",
  }),
];

const stats = [
  { stat: `${yearsInBiz}+`, label: "Years in business" },
  { stat: String(STATE_LICENSES.length), label: "Licensed states" },
  { stat: "$6B+", label: "Mortgages closed" },
  { stat: `${avgRating}★`, label: "Average rating" },
];

const difference = [
  {
    heading: "Every Core Home Loan",
    body: "Conventional with as little as 3% down, FHA, VA, USDA, and down payment assistance. First home or next home, we'll match you with the program that fits your budget and explain why it fits.",
  },
  {
    heading: "Transparent Process",
    body: "You'll know your options, your rate, and your timeline before you commit to anything. No bait-and-switch. No surprises at the closing table. Cliffco loan officers work for you, not for a quota.",
  },
  {
    heading: "Expertise When It's Complicated",
    body: "Self-employed, buying a rental, or 62 and older? We also offer 15+ alternative loan products, including bank statement programs, DSCR, reverse mortgages, and non-warrantable condo financing, so a less typical situation doesn't mean starting over somewhere else.",
  },
  {
    heading: "Licensed Coast to Coast",
    body: `${STATE_LICENSES.length} states. ${branchCount} branch offices. In New York, New Jersey, Arizona, Florida, Minnesota, or beyond, you work with a real loan officer who knows your market, your state's rules, and your specific loan type.`,
  },
];

const serve = [
  { label: "First-time homebuyers", href: "/first-time-homebuyer/", desc: "FHA, conventional with 3% down, VA, and guidance at every step from pre-approval to keys." },
  { label: "Move-up buyers and refinances", href: "/purchasing-refinancing/", desc: "Buying your next home or refinancing the one you're in, with conventional, FHA, and VA loans." },
  { label: "Down payment assistance", href: "/down-payment-assistance/", desc: "Programs that can cover your down payment, closing costs, or both." },
  { label: "Self-employed and business owners", href: "/self-employed-mortgage/", desc: "Qualify with 12 months of bank statements instead of tax returns." },
  { label: "Real estate investors", href: "/real-estate-investor-mortgage/", desc: "DSCR loans based on property cash flow, not your salary." },
  { label: "Homeowners 62 and older", href: "/reverse-mortgage/", desc: "Tap your equity without selling or making monthly payments." },
  { label: "Denied somewhere else", href: "/denied-mortgage/", desc: "Turned down by another lender? We'll take a second look." },
];

const heroImg = "/images/content%20images/golden-hour-moving-boxes";
---

<Layout
  title="Why Cliffco Mortgage Bankers | Independent Home Lender Since 1989"
  description={`Buying your first home, your next one, or refinancing, Cliffco has been getting families home since 1989. ${STATE_LICENSES.length} states, ${branchCount} branches, $6B+ closed. What sets us apart.`}
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Why Cliffco", href: "/why-cliffco/" },
  ]} />

  <!-- HERO: text left, photo bleeds off the right edge and starts lower -->
  <section class="relative bg-white overflow-hidden">
    <div class="container-wide relative z-10 pt-10 pb-12 lg:pt-20 lg:pb-28 lg:min-h-[620px]">
      <div class="lg:w-[46%]">
        <p class="eyebrow">About Cliffco · Since {COMPANY.founded}</p>
        <h1 class="mt-5 text-[var(--color-ink)]" style="font-size: clamp(2.5rem, 5.4vw, 4.75rem); line-height: 1.02; font-weight: 700; letter-spacing: -0.03em; font-family: var(--font-display);">
          {yearsInBiz} years.<br />One focus: you.
        </h1>
        <p class="mt-7 max-w-md text-[var(--color-text-muted)]" style="font-size: 1.125rem; line-height: 1.6;">
          Buying your first home, moving up, or refinancing, we keep the mortgage clear and simple from pre-approval to closing. And when your situation is less typical, we have the programs for that too.
        </p>
        <div class="mt-9 flex flex-wrap gap-3 items-center">
          <a href="/get-started/" class="btn btn-primary">Talk to a Loan Officer</a>
          <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
        </div>
      </div>
    </div>

    <div class="relative mx-6 mb-10 aspect-[4/3] lg:m-0 lg:aspect-auto lg:absolute lg:top-16 lg:bottom-0 lg:right-0 lg:w-[50vw]">
      <img
        src={`${heroImg}-1536.webp`}
        srcset={`${heroImg}-800.webp 800w, ${heroImg}-1536.webp 1536w`}
        sizes="(min-width: 1024px) 50vw, 100vw"
        width="1536" height="1024"
        alt="A young couple laughing on the floor of their new home, surrounded by moving boxes"
        class="w-full h-full object-cover rounded-2xl lg:rounded-none lg:rounded-tl-[2.5rem]"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute left-4 -bottom-6 lg:-left-10 lg:bottom-16 bg-[var(--color-ink)] text-white px-6 py-5 rounded-xl shadow-xl">
        <p class="text-3xl font-bold leading-none" style="font-family: var(--font-display);">$6B+</p>
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/70 mt-2">in mortgages closed</p>
      </div>
    </div>
  </section>

  <!-- STATS: label on the left, numbers offset right, last column left empty -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-12 lg:py-14 grid grid-cols-2 lg:grid-cols-12 gap-x-6 gap-y-8 items-end">
      <p class="eyebrow col-span-2 lg:col-span-3 self-start">By the numbers</p>
      {stats.map((item) => (
        <div class="lg:col-span-2">
          <p class="text-5xl font-bold leading-none text-[var(--color-ink)]" style="font-family: var(--font-display); letter-spacing: -0.02em;">{item.stat}</p>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] mt-3">{item.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- THE CLIFFCO DIFFERENCE: sticky heading left, numbered list offset right -->
  <section class="bg-white">
    <div class="container-wide py-20 lg:py-28 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4 lg:sticky lg:top-28 self-start">
        <p class="eyebrow">The Cliffco difference</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">Simple when it's simple. Skilled when it's not.</h2>
      </div>
      <ol class="lg:col-span-7 lg:col-start-6 list-none m-0 p-0 border-t border-[var(--color-ink)]">
        {difference.map((item, i) => (
          <li class="grid grid-cols-[3rem_1fr] gap-4 py-8 border-b border-black/15">
            <span class="font-mono text-sm text-[var(--color-text-muted)] pt-1">0{i + 1}</span>
            <div>
              <h3 class="text-xl font-semibold text-[var(--color-ink)]">{item.heading}</h3>
              <p class="mt-3 text-[var(--color-text)] leading-relaxed">{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- REVIEWS: black band, white card overlapping the office photo -->
  <section class="bg-[var(--color-ink)]">
    <div class="container-wide py-20 lg:py-28 grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7">
        <img src="/images/content%20images/Uniondale_Why%20Cliffco.jpg" alt="Cliffco Mortgage Bankers Uniondale headquarters" class="w-full aspect-[4/3] object-cover rounded-2xl" loading="lazy" />
      </div>
      <div class="lg:col-span-5 lg:-ml-28 relative z-10 bg-white rounded-2xl p-8 lg:p-10 -mt-20 mx-4 lg:m-0">
        <p class="eyebrow">Reviews</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">3,617 reviews. 4.9 stars.</h2>
        <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">
          Cliffco is rated 4.9 out of 5 on Experience.com with over 3,600 verified borrower reviews. We also hold an A+ rating from the Better Business Bureau.
        </p>
        <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">
          Most reviews mention the same things: a loan officer who answered the phone, explained what was happening, and delivered what they promised. That's the standard we hold ourselves to.
        </p>
        <dl class="mt-6 grid grid-cols-3 border border-[var(--color-ink)] rounded-xl divide-x divide-[var(--color-ink)]">
          <div class="px-1 py-3 text-center"><dd class="text-2xl font-bold" style="font-family: var(--font-display);">4.9★</dd><dt class="font-mono text-[10px] uppercase tracking-[0.1em] text-[var(--color-text-muted)] mt-1 [overflow-wrap:anywhere]">Experience<wbr />.com</dt></div>
          <div class="px-1 py-3 text-center"><dd class="text-2xl font-bold" style="font-family: var(--font-display);">A+</dd><dt class="font-mono text-[10px] uppercase tracking-[0.1em] text-[var(--color-text-muted)] mt-1 [overflow-wrap:anywhere]">BBB</dt></div>
          <div class="px-1 py-3 text-center"><dd class="text-2xl font-bold" style="font-family: var(--font-display);">5.0★</dd><dt class="font-mono text-[10px] uppercase tracking-[0.1em] text-[var(--color-text-muted)] mt-1 [overflow-wrap:anywhere]">Zillow</dt></div>
        </dl>
        <p class="mt-6">
          <a href="/reviews/" class="text-sm font-semibold text-[var(--color-ink)]">Read borrower reviews →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- OUR STORY: heading left, narrow copy column far right -->
  <section class="bg-white">
    <div class="container-wide py-20 lg:py-28 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4">
        <p class="eyebrow">Our story</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">Founded on Long Island. Still here.</h2>
      </div>
      <div class="lg:col-span-6 lg:col-start-7 space-y-5 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">
        <p>Cliffco was founded in {COMPANY.founded} on Long Island, where we remain headquartered today. For {yearsInBiz} years, we've helped families buy their first homes, move up to their next ones, and refinance into better terms. Along the way, we built deep expertise in the loans that don't fit the standard mold: self-employed borrowers, real estate investors, and seniors who want to stay in their homes.</p>
        <p>We grew into {STATE_LICENSES.length} states and {branchCount} offices by building a reputation for clear answers, honest advice, and loans that close. That reputation travels. About half our business today comes from referrals.</p>
        <p>Christopher Clifford, our President (NMLS #65234), has been with Cliffco since the beginning. The company he leads today is built on the same conviction it started with: every family deserves a clear path to homeownership, whatever their financial life looks like.</p>
      </div>
    </div>
  </section>

  <!-- WHO WE SERVE: heading left, scannable list right -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-20 lg:py-28 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4 lg:sticky lg:top-28 self-start">
        <p class="eyebrow">Who we help</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">First home, next home, and everything in between.</h2>
      </div>
      <ul class="lg:col-span-8 list-none m-0 p-0 border-t border-[var(--color-ink)]">
        {serve.map((item) => (
          <li class="border-b border-black/15">
            <a href={item.href} class="serve-row group grid grid-cols-[1fr_auto] items-center gap-6 py-6 no-underline text-[var(--color-ink)]">
              <span>
                <span class="block text-lg font-semibold">{item.label}</span>
                <span class="block mt-1 text-sm text-[var(--color-text-muted)]">{item.desc}</span>
              </span>
              <span class="text-xl transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA: black band, left-aligned copy, buttons pushed right -->
  <section class="bg-[var(--color-ink)]">
    <div class="container-wide py-16 lg:py-20 grid lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow !text-white/60">Get started</p>
        <h2 class="mt-4 !text-white" style="font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.05; font-weight: 700;">Let's get you home.</h2>
        <p class="mt-4 text-white/75" style="font-size: 1.125rem;">Tell us what you're planning. A Cliffco loan officer responds within one business day.</p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 flex flex-wrap gap-3 lg:justify-end">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-ink)] hover:!bg-white/85">Get Started</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white hover:!bg-white hover:!text-[var(--color-ink)]">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>
</Layout>
