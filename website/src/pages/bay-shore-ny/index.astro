---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { BRANCHES } from "../../data/branches";
import { LOAN_OFFICERS } from "../../data/loan-officers";
import Headshot from "../../components/ui/Headshot.astro";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";

const branch = BRANCHES.find((b) => b.slug === "bay-shore-ny")!;
const los = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "bay-shore-ny");

const schema = [
  localBusinessSchema(branch),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "New York", url: "/locations/new-york/" },
    { name: "Long Island", url: "/locations/new-york/long-island/" },
    { name: "Bay Shore", url: "/bay-shore-ny/" },
  ]),
];
import ContactForm from "../../components/forms/ContactForm.astro";
---

<Layout
  title="Bay Shore, NY Mortgage Office | Cliffco Mortgage Bankers"
  description="Cliffco Mortgage Bankers Bay Shore office - 50 Park Avenue, 2nd Floor, Suite 1, Bay Shore, NY 11706. Branch NMLS #2733073. Local loan officers serving Suffolk County and Long Island."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "New York", href: "/locations/new-york/" },
    { name: "Long Island", href: "/locations/new-york/long-island/" },
    { name: "Bay Shore", href: "/bay-shore-ny/" },
  ]} />

  <section class="accent-gradient">
    <div class="container-wide py-16 lg:py-24">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Bay Shore, NY · Suffolk County</p>
      <h1 class="mt-4 text-white max-w-3xl" style="font-size: var(--text-display-xl); line-height: 1.1; font-weight: 400; font-family: var(--font-sans);">
        Bay Shore Mortgage Office
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">
        Our Bay Shore branch serves Suffolk County and the South Shore of Long Island. Licensed loan officers on-site for purchase, refinance, and investment loans.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">
          <span class="text-white/70 font-normal text-xs">Toll Free</span>&nbsp;{COMPANY.tollFree}
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide grid lg:grid-cols-2 gap-10 items-start">
      <div>
        <p class="eyebrow">Branch information</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Find us in Bay Shore.</h2>
        <address class="not-italic mt-6 space-y-2 text-[var(--color-text)]">
          <p class="font-semibold text-[var(--color-ink)]">{branch.name}</p>
          <p>{branch.street}</p>
          <p>{branch.city}, {branch.region} {branch.postalCode}</p>
        </address>
        {branch.nmls && <p class="mt-4 text-sm text-[var(--color-text-muted)]">Branch NMLS #{branch.nmls}</p>}
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-primary text-sm">Call Toll Free: {COMPANY.tollFree}</a>
          <a href="/get-started/" class="btn btn-secondary text-sm">Start Application</a>
        </div>
      </div>
      <div class="card">
        <p class="eyebrow">About this office</p>
        <p class="mt-3 text-[var(--color-text)] leading-relaxed">
          The Bay Shore office is home to the Zambelli family team: three generations of Long Island mortgage professionals. This office specializes in Suffolk County purchases, refinances, SONYMA programs, and family buyouts.
        </p>
        <p class="mt-4 text-sm text-[var(--color-text-muted)]">Part of Cliffco's Long Island branch network alongside our Uniondale headquarters.</p>
        <a href="/locations/new-york/long-island/" class="mt-4 inline-block text-sm font-semibold text-[var(--color-accent)] no-underline hover:underline">← All Long Island offices</a>
      </div>
    </div>
  </section>

  {los.length > 0 && (
    <section class="section bg-[var(--color-mist-gray)]">
      <div class="container-wide">
        <p class="eyebrow">Loan officers at this office</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">Your Bay Shore team.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {los.map((lo) => (
            <a href={`/loan-officers/${lo.slug}/`} class="card no-underline text-[var(--color-ink)] flex flex-col">
              {lo.hasPhoto && (
                <div class="mb-4 -mx-6 -mt-6">
                  <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="rounded-t-xl" />
                </div>
              )}
              <p class="eyebrow">{lo.title}</p>
              <h3 class="mt-1 text-base font-semibold">{lo.displayName}</h3>
              <p class="text-xs text-[var(--color-text-muted)] mt-1">NMLS #{lo.nmls}</p>
              {lo.languages && lo.languages.length > 1 && (
                <p class="text-xs text-[var(--color-accent)] mt-2 font-medium">{lo.languages.join(" · ")}</p>
              )}
              <span class="mt-auto pt-3 text-sm font-semibold text-[var(--color-accent)]">View bio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Buying or investing in Suffolk County? We're here.</h2>
      <p class="lead mt-4 text-white/85">A licensed Cliffco loan officer responds in one business day.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get Pre-Qualified</a>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.tollFree}</a>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide max-w-2xl">
      <h2 class="mt-3" style="font-size: var(--text-h2);">Buying or refinancing in Suffolk County?</h2>
      <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">Tell us your situation and the Bay Shore team will be in touch within one business day.</p>
      <div class="mt-8">
        <ContactForm
          formTo="zambelliL@cliffcomortgage.com,websiteleads@cliffcomortgage.com"
          formSource="branch-bayshore"
        />
      </div>
    </div>
  </section>
</Layout>
