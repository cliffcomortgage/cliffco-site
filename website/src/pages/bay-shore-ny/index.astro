---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { BRANCHES } from "../../data/branches";
import { LOAN_OFFICERS } from "../../data/loan-officers";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";

const branch = BRANCHES.find((b) => b.slug === "bay-shore-ny")!;
const los = LOAN_OFFICERS.filter((lo) => lo.branchSlug === "bay-shore-ny");

const schema = [
  localBusinessSchema(branch),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "New York", url: "/locations/new-york/" },
    { name: "Long Island", url: "/locations/new-york/long-island/" },
    { name: "Bay Shore", url: "/bay-shore-ny/" },
  ]),
];

import BranchPage from "../../components/asym/BranchPage.astro";

---

<Layout
  title="Bay Shore, NY Mortgage Office | Cliffco Mortgage Bankers"
  description="Cliffco Mortgage Bankers Bay Shore office - 50 Park Avenue, 2nd Floor, Suite 1, Bay Shore, NY 11706. Branch NMLS #2733073. Local loan officers serving Suffolk County and Long Island."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "New York", href: "/locations/new-york/" },
    { name: "Long Island", href: "/locations/new-york/long-island/" },
    { name: "Bay Shore", href: "/bay-shore-ny/" },
  ]} />

  <BranchPage
    city="Bay Shore"
    eyebrow="Bay Shore, NY · Suffolk County"
    title="Bay Shore Mortgage Office"
    lead="Our Bay Shore branch serves Suffolk County and the South Shore of Long Island. Licensed loan officers on-site for purchase, refinance, and investment loans."
    addressName={branch.name}
    street={branch.street}
    cityLine={`${branch.city}, ${branch.region} ${branch.postalCode}`}
    nmlsLabel={`Branch #${branch.nmls}`}
    phone={{ e164: COMPANY.tollFreeE164, display: COMPANY.tollFree, label: "Toll Free" }}
    findTitle="Find us in Bay Shore."
    about="The Bay Shore office is home to the Zambelli family team: three generations of Long Island mortgage professionals. This office specializes in Suffolk County purchases, refinances, SONYMA programs, and family buyouts."
    aboutNote="Part of Cliffco's Long Island branch network alongside our Uniondale headquarters."
    back={{ href: "/locations/new-york/long-island/", label: "← All Long Island offices" }}
    los={los}
    teamEyebrow="Loan officers at this office"
    teamTitle="Your Bay Shore team."
    ctaTitle="Buying or investing in Suffolk County? We're here."
    formTitle="Buying or refinancing in Suffolk County?"
    formSub="Tell us your situation and the Bay Shore team will be in touch within one business day."
    formSource="branch-bayshore"
  >
    <Fragment slot="info">
      {branch.nmls && <p>Branch NMLS #{branch.nmls}</p>}
    </Fragment>
  </BranchPage>
</Layout>
