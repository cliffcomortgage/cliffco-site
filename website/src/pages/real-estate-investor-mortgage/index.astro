---
import { STATE_LICENSES } from "../../data/state-licenses";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { faqPageSchema, articleSchema } from "../../lib/schema";


const faq = [
  {
    question: "What is a DSCR loan?",
    answer: "A DSCR (Debt Service Coverage Ratio) loan qualifies you based on the rental income of the property, not your personal income. If the property's monthly rent covers the mortgage payment, you may qualify regardless of your personal tax returns or W-2 income.",
  },
  {
    question: "What DSCR ratio do I need to qualify?",
    answer: "For long-term rentals, Cliffco goes as low as a 0.75 DSCR, with a larger down payment required below 1.0. Short-term rentals and first-time investors need at least a 1.0, meaning rent covers the full monthly payment. The best pricing typically starts at 1.25. Your Cliffco loan officer can run the numbers for your specific property.",
  },
  {
    question: "Can I borrow through an LLC or corporation?",
    answer: "Yes. DSCR loans are available to both individual borrowers and business entities including LLCs, S-Corps, and C-Corps. Many investors prefer entity borrowing for liability protection, and Cliffco works with both.",
  },
  {
    question: "Is there a limit on how many properties I can finance?",
    answer: "Cliffco will purchase a maximum of 10 loans per borrower with an aggregate loan amount up to $7.5M. For investment and second home properties, the borrower may have up to 20 total financed residential properties, including their primary residence. There is no maximum for owner-occupied properties. Cliffco works with investors at all stages, from a first rental purchase to multi-property portfolios.",
  },
  {
    question: "What property types qualify for DSCR loans?",
    answer: "Single-family residences (1 to 4 units), condos, townhomes, and in some cases short-term rental properties qualify. Properties must be non-owner-occupied investment properties.",
  },
  {
    question: "Do I need to verify personal income?",
    answer: "No personal income documentation is required for DSCR loans. No tax returns, no W-2s, no pay stubs. The loan is underwritten entirely on the property's rental income and cash flow.",
  },
];

const schema = [
  faqPageSchema(faq),
  articleSchema({
    headline: "Real Estate Investor Mortgage: DSCR Loans",
    description: "DSCR loans for real estate investors: qualify based on your rental property's cash flow, not your personal income. No tax returns or W-2s required. Portfolio and entity borrowing available.",
    url: "/real-estate-investor-mortgage/",
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];
import AsymHero from "../../components/asym/AsymHero.astro";
import Split from "../../components/asym/Split.astro";
import FormCard from "../../components/asym/FormCard.astro";
import FaqList from "../../components/asym/FaqList.astro";
import CtaBand from "../../components/asym/CtaBand.astro";

const params = [
  ["Min DSCR ratio", "0.75 (higher ratio = better pricing)"],
  ["Max LTV (purchase)", "Up to 80%"],
  ["Max LTV (cash-out refi)", "Up to 75%"],
  ["Loan amount", "$100K to $3M+"],
  ["Property types", "1 to 4 unit non-owner-occupied"],
  ["Entity borrowing", "Yes (LLC, S-Corp, C-Corp)"],
  ["Personal income verification", "Not required"],
  ["Loan terms", "30-year fixed, ARM, 40-year interest-only"],
  ["Portfolio limit", "Max 10 loans per borrower, up to $7.5M aggregate. Max 20 financed properties for investment/second home. No limit for owner-occupied."],
];
const compare = [
  ["Income verification", "Rental income only, no personal income required", "Full personal income documentation required"],
  ["Tax returns", "Not required", "2 years required"],
  ["Portfolio limit", "Max 10 loans / $7.5M aggregate; max 20 financed properties (investment/2nd home)", "Max 10 financed properties (Fannie/Freddie)"],
  ["Entity borrowing", "Yes", "Generally not allowed"],
  ["Qualification basis", "Property cash flow (DSCR ratio)", "Personal DTI"],
];
---

<Layout
  title="Real Estate Investor Mortgage: DSCR Loans | Cliffco"
  description="Qualify for investment property financing using your property's rental income. DSCR loans from Cliffco require no personal income verification and no tax returns."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Real Estate Investor Mortgage", href: "/real-estate-investor-mortgage/" },
  ]} />

  <AsymHero
    eyebrow="DSCR Lending · Portfolio Financing"
    lead="DSCR loans let the rental income do the qualifying work. No personal income verification. No tax returns. Your portfolio is the collateral. Your cash flow is the qualification."
    image={{ src: "/images/content%20images/Investor%20Hero.webp", cutout: true }}
    tag={{ stat: "$100K–$3M+", label: "DSCR loan amounts" }}
  >
    Qualify With Your Property's Cash Flow.<br />Not Your Income.
    <Fragment slot="actions">
      <a href="/mortgage-guides/calculators/dscr/" class="btn btn-primary">Run a DSCR Scenario</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
    <Fragment slot="note">No credit pull. No commitment. A loan officer responds in one business day.</Fragment>
  </AsymHero>

  <!-- LEAD FORM + WHO QUALIFIES -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <FormCard title="Tell us about your next investment property." sub="Tell us the deal and we'll show you which financing structure fits." formSource="investor" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-8">
        <p class="eyebrow">Who qualifies</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">Built for the serious investor.</h2>
        <ul class="mt-8 list-none m-0 p-0 border-t border-[var(--color-ink)]">
          {[
            "First-time rental property buyers",
            "Multi-property portfolio investors",
            "Self-employed investors with complex income",
            "Investors borrowing through LLCs, S-Corps, or C-Corps",
            "Foreign national investors",
            "Investors who've maxed out conventional investment property loans",
            "Short-term rental operators (program dependent)",
          ].map((item) => (
            <li class="flex gap-4 items-start py-4 border-b border-black/15">
              <span class="font-mono text-sm text-[var(--color-ink)] pt-0.5" aria-hidden="true">✓</span>
              <span class="text-[var(--color-text)]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- WHAT IS DSCR -->
  <Split eyebrow="The qualification method" title="What is DSCR and how does it work?">
    <div class="space-y-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">
      <p>DSCR stands for Debt Service Coverage Ratio. It is the ratio of a property's monthly rental income to its monthly mortgage payment (principal, interest, taxes, insurance, and HOA if applicable).</p>
      <p>A DSCR of 1.0 means the rent exactly covers the payment. A DSCR of 1.25 means the rent is 25% higher than the payment. Lenders use this ratio, not your personal W-2 or tax return, to determine whether the property can sustain itself.</p>
    </div>
    <div class="mt-8 rounded-2xl bg-[var(--color-ink)] text-white p-6 sm:p-8">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/60">Example</p>
      <p class="mt-3 text-white/85">Monthly rent: $2,500 &nbsp;|&nbsp; Monthly payment: $2,000</p>
      <p class="mt-2 text-2xl font-bold" style="font-family: var(--font-display);">DSCR: 2,500 / 2,000 = 1.25 ✓ Qualifies</p>
    </div>
    <p class="mt-6"><a href="/mortgage-guides/calculators/dscr/" class="text-sm font-semibold text-[var(--color-ink)]">Run your own DSCR calculation →</a></p>
  </Split>

  <!-- LOAN PARAMETERS -->
  <Split eyebrow="Loan parameters" title="What to expect.">
    <img slot="aside" src="/images/content%20images/Investment%20Property.jpg" alt="Investment property" class="hidden lg:block mt-10 rounded-2xl w-full aspect-[4/5] object-cover" loading="lazy" />
    <dl class="border-t border-[var(--color-ink)]">
      {params.map(([dt, dd]) => (
        <div class="grid sm:grid-cols-[minmax(0,14rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
          <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] pt-1">{dt}</dt>
          <dd class="font-medium text-[var(--color-ink)]">{dd}</dd>
        </div>
      ))}
    </dl>
  </Split>

  <!-- COMPARISON -->
  <Split eyebrow="Program comparison" title="DSCR vs. traditional investment loan.">
    <div class="grid sm:grid-cols-2 gap-4">
      <article class="rounded-2xl bg-[var(--color-ink)] text-white p-6">
        <p class="eyebrow !text-white/60">DSCR Loan (Cliffco)</p>
        <h3 class="mt-2 text-lg font-semibold !text-white">Qualifies on property income</h3>
        <dl class="mt-5 space-y-4 text-sm">
          {compare.map(([dt, dscr]) => (
            <div><dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-white/55">{dt}</dt><dd class="mt-1 text-white">{dscr}</dd></div>
          ))}
        </dl>
      </article>
      <article class="rounded-2xl border-2 border-[var(--color-ink)] p-6">
        <p class="eyebrow">Traditional Investment Loan</p>
        <h3 class="mt-2 text-lg font-semibold">Qualifies on personal income</h3>
        <dl class="mt-5 space-y-4 text-sm">
          {compare.map(([dt, , trad]) => (
            <div><dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--color-text-muted)]">{dt}</dt><dd class="mt-1 text-[var(--color-ink)]">{trad}</dd></div>
          ))}
        </dl>
      </article>
    </div>
  </Split>

  <!-- FAQ -->
  <Split eyebrow="FAQ" title="How DSCR lending works.">
    <FaqList items={faq} />
  </Split>

  <CtaBand
    title="Run your numbers. Consult us on your next investment."
    text={`Cliffco originates DSCR loans across ${STATE_LICENSES.length} states. A loan officer responds in one business day.`}
  >
    <a href="/mortgage-guides/calculators/dscr/" class="btn btn-primary">Run a DSCR Scenario</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
