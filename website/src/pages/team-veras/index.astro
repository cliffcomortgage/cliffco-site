---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { LOAN_OFFICERS, loanOfficer } from "../../data/loan-officers";
import Headshot from "../../components/ui/Headshot.astro";
import { faqPageSchema, articleSchema } from "../../lib/schema";

const today = new Date().toISOString().slice(0, 10);

const teamSlugs = ["francisco-veras", "keyla-cruz", "nadia-geyer", "wenceslao-romero", "yaisha-romero"];
const teamMembers = teamSlugs.map(s => LOAN_OFFICERS.find(lo => lo.slug === s)!).filter(Boolean);
const francisco = loanOfficer("francisco-veras")!;

const faq = [
  {
    question: "What is an ITIN loan and who qualifies?",
    answer: "An ITIN mortgage allows borrowers who have an Individual Taxpayer Identification Number but no Social Security number to qualify for a home loan. ITIN loans are designed for immigrants, non-permanent residents, and individuals who pay US taxes but are not eligible for an SSN. Documentation typically includes two years of ITIN tax returns, proof of income, and evidence of at least two years of US residency or work history. Team Veras originates ITIN loans regularly and can guide you through the specific requirements.",
  },
  {
    question: "What is a Foreign National loan?",
    answer: "A foreign national loan allows non-US citizens who live and work abroad to purchase or refinance US real estate. No Social Security number is required. Borrowers qualify using a foreign passport, visa documentation if applicable, and evidence of foreign income or assets. These programs are available for primary residences, second homes, and investment properties. Team Veras specializes in serving international clients purchasing Florida real estate.",
  },
  {
    question: "What down payment assistance programs are available for first-time buyers in Florida?",
    answer: "Florida has several active programs for first-time buyers, including the Florida Housing Finance Corporation (FHFC) programs that provide down payment and closing cost assistance. CHENOA Fund also operates in Florida, covering FHA down payment requirements. Program availability and funding change frequently. Team Veras tracks which programs are currently active and which your income and property qualify for.",
  },
  {
    question: "Does Team Veras serve Spanish-speaking clients?",
    answer: "Yes. Several team members are fluent in Spanish, including Francisco Veras and Keyla Cruz, who has over 23 years of experience serving Spanish-speaking homebuyers. The team conducts business entirely in Spanish for clients who prefer it and is deeply connected to the Hispanic and immigrant communities in Central Florida.",
  },
  {
    question: "Can an ITIN borrower qualify for FHA or conventional loans?",
    answer: "FHA loans require a valid SSN, so ITIN borrowers are not eligible for FHA financing. ITIN borrowers can qualify for Non-QM programs specifically designed for this profile. Conventional ITIN programs are available through select lenders and require strong credit and significant down payments, typically 20 to 30%. Team Veras will identify the right program for your specific situation.",
  },
  {
    question: "Is Cliffco licensed in Florida?",
    answer: "Yes. Cliffco operates in Florida as Swish Capital, Inc. The team is based at our Orlando branch and originates loans throughout the state. All Team Veras members are licensed in Florida and several are also licensed in additional states.",
  },
];

const schema = [
  faqPageSchema(faq),
  articleSchema({
    headline: "Team Veras | Cliffco Mortgage Bankers",
    description: "Team Veras at Cliffco Mortgage Bankers in Orlando, FL. ITIN loans, foreign national mortgages, and first-time homebuyer programs. Bilingual English and Spanish.",
    url: "/team-veras/",
    datePublished: today,
    dateModified: today,
    authorSlug: "francisco-veras",
  }),
];
---

<Layout
  title="Team Veras | ITIN, Foreign National & First-Time Buyer Specialists | Cliffco"
  description="Team Veras at Cliffco Mortgage Bankers in Orlando, FL. ITIN loans, foreign national mortgages, and first-time homebuyer programs. Bilingual English and Spanish. Swish Capital, Inc."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Team Veras", href: "/team-veras/" },
  ]} />

  <!-- ═══ HERO ═════════════════════════════════════════════════ -->
  <section class="accent-gradient">
    <div class="container-wide pt-20 pb-16 lg:pt-28 lg:pb-20">
      <div class="text-center">
        <img
          src="/images/team%20logos/Team%20Veras_White@4x.png"
          alt="Team Veras"
          class="mx-auto mb-8 select-none"
          style="max-height:108px;width:auto;"
          loading="eager"
        />
        <p class="text-[var(--color-ice-blue)] text-xs tracking-[0.3em] uppercase font-light mb-5">Cliffco Mortgage Bankers · Orlando, Florida · Swish Capital, Inc.</p>
        <h1 class="text-white" style="font-size:clamp(2.25rem,5vw,4rem);font-weight:200;letter-spacing:-0.04em;line-height:1.08;">
          ITIN, Foreign National, and<br/>
          <em style="font-style:italic;font-weight:300;color:rgba(189,232,241,0.9);">First-Time Homebuyer specialists.</em>
        </h1>
        <p class="mt-6 text-white/65 font-light leading-relaxed max-w-xl mx-auto" style="font-size:1.05rem;">
          Team Veras serves clients who face barriers most lenders won't work around. No SSN? Buying from abroad? First-time buyer who needs guidance? This is the team that says yes when others stop asking.
        </p>
        <div class="mt-14 flex justify-center gap-4 flex-wrap">
          <a href={francisco.links?.applyNow ?? "/get-started/"} target="_blank" rel="noopener"
            style="background:#fff;color:#0d0d0d;text-decoration:none;padding:0.875rem 2.25rem;border-radius:999px;font-weight:600;font-size:0.9375rem;letter-spacing:0.02em;">
            Work With The Team
          </a>
          {francisco.links?.directPhone && (
            <a href={`tel:${francisco.links.directPhone.replace(/[^+\d]/g, "")}`}
              style="background:transparent;color:rgba(255,255,255,0.8);text-decoration:none;padding:0.875rem 2.25rem;border-radius:999px;font-weight:400;font-size:0.9375rem;border:1px solid rgba(255,255,255,0.25);">
              {francisco.links.directPhone}
            </a>
          )}
        </div>
      </div>

      <!-- Stats -->
      <div class="mt-16 pt-14 border-t border-white/15 grid sm:grid-cols-3 gap-10 sm:gap-0 sm:divide-x divide-white/15">
        {[
          { stat: "30+", label: "Years of experience", sub: "Francisco Veras · Branch Manager" },
          { stat: "3", label: "Specialty programs", sub: "ITIN · Foreign National · First-Time Buyer" },
          { stat: "2", label: "Languages", sub: "English · Spanish" },
        ].map(d => (
          <div class="sm:px-16 first:pl-0 last:pr-0 text-center sm:text-left">
            <p style="font-size:clamp(1.75rem,4vw,2.75rem);font-weight:200;letter-spacing:-0.04em;color:#fff;line-height:1;">{d.stat}</p>
            <p class="text-white/65 font-light text-sm mt-3">{d.label}</p>
            <p class="text-white/40 text-xs mt-1.5 tracking-wide">{d.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ THE TEAM ══════════════════════════════════════════════ -->
  <section style="padding-block:6rem;" class="bg-white">
    <div class="container-wide">
      <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-text-muted)] font-light mb-4">The team</p>
      <h2 style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:300;letter-spacing:-0.03em;color:var(--color-ink);">Meet Team Veras.</h2>
      <p class="mt-4 text-[var(--color-text-muted)] font-light leading-relaxed max-w-xl" style="font-size:1.05rem;">
        A bilingual team based in Orlando, Florida, built around the communities that conventional lenders typically turn away. Deeply connected to Central Florida's Hispanic and immigrant communities.
      </p>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {teamMembers.map((lo) => (
          <a href={`/loan-officers/${lo.slug}/`} class="group no-underline text-[var(--color-ink)] flex flex-col">
            {lo.hasPhoto && (
              <div class="rounded-xl overflow-hidden aspect-square bg-[var(--color-mist-gray)] mb-4">
                <Headshot slug={lo.slug} name={lo.displayName} fluid shape="square" class="group-hover:scale-105 transition-transform duration-500" />
              </div>
            )}
            <div class="border-t border-[var(--color-mist-gray)] pt-3">
              <p class="font-medium text-[var(--color-ink)] text-sm">{lo.displayName}</p>
              <p class="text-xs text-[var(--color-text-muted)] font-light mt-0.5">{lo.title}</p>
              <p class="text-xs text-[var(--color-text-muted)]/60 mt-0.5">NMLS #{lo.nmls}</p>
              <span class="mt-2 text-xs font-medium text-[var(--color-accent)] inline-block">View profile →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SPECIALTIES ═══════════════════════════════════════════ -->
  <section style="padding-block:6rem;" class="bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-text-muted)] font-light mb-4">What we do best</p>
      <h2 style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:300;letter-spacing:-0.03em;color:var(--color-ink);">Three programs.<br/>One team that knows how to get them closed.</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-3">
        {[
          {
            name: "ITIN Loans",
            range: "No SSN required",
            href: "/loans/non-qm-self-employed/",
            body: "Homeownership for borrowers with an Individual Taxpayer Identification Number and no Social Security number. ITIN tax returns, proof of income, and US residency history required. Non-QM programs available with as little as 10 to 20% down.",
          },
          {
            name: "Foreign National Loans",
            range: "Buying from abroad",
            href: "/loans/non-qm-self-employed/",
            body: "Purchase or refinance US real estate without US citizenship or residency. Foreign passport, visa documentation, and evidence of foreign income or assets. Primary residences, second homes, and investment properties in Florida.",
          },
          {
            name: "First-Time Homebuyer",
            range: "FHA · DPA · SONYMA",
            href: "/first-time-homebuyer/",
            body: "FHA loans from 3.5% down, Florida Housing Finance Corporation programs, CHENOA Fund, and other down payment assistance options. Team Veras tracks which programs are currently funded and guides first-time buyers through every step.",
          },
        ].map(spec => (
          <a href={spec.href} class="group card no-underline text-[var(--color-ink)] flex flex-col gap-3 h-full">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-medium text-[var(--color-ink)]" style="font-size:1.1rem;letter-spacing:-0.01em;">{spec.name}</h3>
              <span class="text-xs font-semibold text-[var(--color-accent)] bg-[var(--color-accent)]/8 px-2.5 py-1 rounded-full shrink-0 mt-0.5">{spec.range}</span>
            </div>
            <p class="text-sm text-[var(--color-text-muted)] font-light leading-relaxed flex-1">{spec.body}</p>
            <span class="text-xs font-medium text-[var(--color-accent)] mt-auto group-hover:translate-x-1 inline-block transition-transform">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══════════════════════════════════════════════════ -->
  <section style="padding-block:6rem;" class="bg-white">
    <div class="container-wide max-w-3xl">
      <p class="text-xs tracking-[0.25em] uppercase text-[var(--color-text-muted)] font-light mb-4">Frequently asked</p>
      <h2 style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:300;letter-spacing:-0.03em;color:var(--color-ink);">Questions about ITIN, foreign national, and first-time buyer loans.</h2>
      <div class="mt-10 space-y-2">
        {faq.map((item) => (
          <details class="bg-[var(--color-mist-gray)]/40 rounded-xl border border-[var(--color-mist-gray)] overflow-hidden group">
            <summary class="flex items-center justify-between px-6 py-5 font-medium text-[var(--color-ink)] cursor-pointer list-none text-sm">
              {item.question}
              <svg class="w-4 h-4 shrink-0 text-[var(--color-accent)] transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="px-6 pb-6 text-sm text-[var(--color-text)] font-light leading-relaxed bg-white border-t border-[var(--color-mist-gray)] pt-4">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══════════════════════════════════════════════════ -->
  <section class="accent-gradient">
    <div class="container-wide py-20 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-[var(--color-ice-blue)] text-xs tracking-[0.3em] uppercase font-light mb-5">Hablamos español · We speak your language</p>
          <h2 style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:200;letter-spacing:-0.04em;color:#fff;line-height:1.1;">
            Every family deserves<br/>
            <span style="font-weight:300;color:rgba(255,255,255,0.6);">a path to homeownership.</span>
          </h2>
          <p class="mt-5 text-white/55 font-light leading-relaxed" style="font-size:1rem;">
            No credit pull. No pressure. A conversation with Team Veras starts with where you are and ends with a clear plan to get you into a home.
          </p>
          <p class="mt-4 text-white/35 text-xs leading-relaxed">Cliffco operates in Florida as Swish Capital, Inc. NMLS #{COMPANY.nmls}.</p>
        </div>
        <div class="flex flex-col items-center gap-4">
          <div style="width:100%;max-width:260px;">
            <img
              src="/images/team%20logos/Team%20Veras_White@4x.png"
              alt="Team Veras"
              class="w-full h-auto mb-7 select-none"
              style="max-height:108px;object-fit:contain;object-position:center;"
              loading="lazy"
            />
            <a href={francisco.links?.applyNow ?? "/get-started/"} target="_blank" rel="noopener"
              style="display:block;width:100%;text-align:center;background:#fff;color:#0d0d0d;text-decoration:none;padding:0.875rem 1.5rem;border-radius:999px;font-weight:600;font-size:0.9375rem;letter-spacing:0.01em;">
              Start Your Journey
            </a>
          </div>
          <div class="flex flex-col gap-2 items-center text-center">
            {francisco.links?.email && (
              <a href={`mailto:${francisco.links.email}`}
                style="color:rgba(255,255,255,0.4);font-size:0.8125rem;font-weight:300;text-decoration:none;"
                class="hover:text-white transition-colors">
                {francisco.links.email}
              </a>
            )}
            {francisco.links?.directPhone && (
              <a href={`tel:${francisco.links.directPhone.replace(/[^+\d]/g, "")}`}
                style="color:rgba(255,255,255,0.4);font-size:0.8125rem;font-weight:300;text-decoration:none;"
                class="hover:text-white transition-colors">
                {francisco.links.directPhone}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
