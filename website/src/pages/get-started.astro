---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../data/company";

const scenarios = [
  {
    value: "non-qm",
    headline: "Self-employed or 1099",
    description: "Your tax returns understate your actual income. Bank statements or a P&L tell a better story.",
  },
  {
    value: "dscr",
    headline: "Real estate investor",
    description: "You want to qualify based on what the property earns — not your personal income.",
  },
  {
    value: "reverse",
    headline: "Homeowner age 62 or older",
    description: "You want to access your home equity without taking on a monthly mortgage payment.",
  },
  {
    value: "business-bank-statement",
    headline: "Business owner",
    description: "You run an LLC, S-Corp, or sole proprietorship and want to use business deposits as income.",
  },
  {
    value: "non-qm",
    headline: "Turned down by another lender",
    description: "A bank said no. Cliffco specializes in the borrowers conventional lenders can't figure out.",
  },
  {
    value: "conventional",
    headline: "W-2 income, standard situation",
    description: "Traditional employment, solid credit — buying, refinancing, or renovating.",
  },
];
---

<Layout
  title="Get Started"
  description={`Tell Cliffco your situation. A licensed loan officer (NMLS #${COMPANY.nmls}) responds within one business day. No call center, no bots.`}
  noindex={true}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Get Started", href: "/get-started/" },
  ]} />

  <!-- SCENARIO SELECTOR -->
  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide">
      <p class="eyebrow">Get started</p>
      <h1 class="mt-3" style="font-size: var(--text-display-lg);">What's your situation?</h1>
      <p class="lead mt-4">Pick the one that fits — we'll route you to the right loan officer.</p>

      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {scenarios.map((s, i) => (
          <button
            type="button"
            class="scenario-card card text-left cursor-pointer transition-all border-2 border-transparent hover:border-[var(--color-accent)]"
            data-value={s.value}
            data-index={i}
          >
            <p class="font-semibold text-[var(--color-ink)]">{s.headline}</p>
            <p class="mt-2 text-sm text-[var(--color-text-muted)]">{s.description}</p>
          </button>
        ))}
      </div>

      <p class="mt-6 text-sm text-[var(--color-text-muted)]">
        Not sure? Skip ahead and describe your situation in the notes field.
        <a href="#form-section" class="font-medium text-[var(--color-accent)] ml-1">Go to form →</a>
      </p>
    </div>
  </section>

  <!-- FORM -->
  <section id="form-section" class="container-wide pt-12 pb-16 grid gap-12 lg:grid-cols-[1.2fr_1fr] items-start">
    <div>
      <p class="eyebrow">Your details</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Tell us a bit more. We'll follow up in one business day.</h2>
      <p class="mt-4 text-[var(--color-text-muted)]">
        No bots, no call center, no third-party hand-off. A real Cliffco loan officer responds by
        phone or email, your choice.
      </p>

      <form action="/api/lead" method="post" class="mt-8 space-y-6 max-w-2xl">

        <!-- Selected scenario summary (shown after card click) -->
        <div id="scenario-summary" class="hidden rounded-lg bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/30 px-4 py-3">
          <p class="text-sm font-medium text-[var(--color-ink)]">
            Selected: <span id="scenario-label" class="text-[var(--color-accent)]"></span>
            <button type="button" id="clear-scenario" class="ml-3 text-xs text-[var(--color-text-muted)] underline">change</button>
          </p>
        </div>

        <div>
          <label for="name" class="block text-sm font-medium text-[var(--color-ink)]">Your name</label>
          <input id="name" name="name" type="text" required class="mt-2 w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] focus:border-[var(--color-accent)] focus:outline-none"/>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="email" class="block text-sm font-medium text-[var(--color-ink)]">Email</label>
            <input id="email" name="email" type="email" required class="mt-2 w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] focus:border-[var(--color-accent)] focus:outline-none"/>
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-[var(--color-ink)]">Phone</label>
            <input id="phone" name="phone" type="tel" required class="mt-2 w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] focus:border-[var(--color-accent)] focus:outline-none"/>
          </div>
        </div>

        <div>
          <label for="state" class="block text-sm font-medium text-[var(--color-ink)]">Property state</label>
          <select id="state" name="state" required class="mt-2 w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] focus:border-[var(--color-accent)] focus:outline-none bg-white">
            <option value="">Select…</option>
            <option value="NY">New York</option>
            <option value="NJ">New Jersey</option>
            <option value="AZ">Arizona</option>
            <option value="MN">Minnesota</option>
            <option value="FL">Florida</option>
            <option value="other">Another state Cliffco is licensed in</option>
          </select>
        </div>

        <div>
          <label for="product" class="block text-sm font-medium text-[var(--color-ink)]">What you're working on</label>
          <select id="product" name="product" required class="mt-2 w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] focus:border-[var(--color-accent)] focus:outline-none bg-white">
            <option value="">Select…</option>
            <option value="non-qm">Non-QM / self-employed loan</option>
            <option value="reverse">Reverse mortgage (62+)</option>
            <option value="dscr">DSCR investor loan</option>
            <option value="business-bank-statement">Business bank statement loan</option>
            <option value="conventional">Conventional / FHA / VA / USDA / renovation</option>
            <option value="not-sure">Not sure — help me figure it out</option>
          </select>
        </div>

        <div>
          <label for="notes" class="block text-sm font-medium text-[var(--color-ink)]">Anything we should know?</label>
          <textarea id="notes" name="notes" rows="4" class="mt-2 w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] focus:border-[var(--color-accent)] focus:outline-none"></textarea>
        </div>

        <div class="rounded-lg bg-[var(--color-mist-gray)] p-4 space-y-3">
          <label class="flex items-start gap-3 text-sm">
            <input type="checkbox" name="tcpa_consent" value="yes" required class="mt-1"/>
            <span>
              I expressly consent to receive calls, texts, and emails from {COMPANY.legalName}
              (and Swish Capital, Inc. for Florida properties) at the phone number and email I
              provided, including via automated technology, regarding my loan inquiry. Consent
              is not required to obtain credit. Reply STOP to opt out of texts. See our
              <a href="/legal/sms-consent/">SMS Consent</a> and <a href="/legal/privacy/">Privacy Policy</a>.
            </span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary">Submit — a Cliffco LO will follow up</button>
      </form>

      <p class="mt-6 text-xs text-[var(--color-text-muted)]">
        Cliffco does not collect Social Security Number, full income, or bank account
        information through this form. Those are collected later, securely, only when you
        decide to formally apply for a loan.
      </p>
    </div>

    <aside class="bg-[var(--color-mist-gray)] rounded-2xl p-6 sticky top-24">
      <p class="eyebrow">Or call us</p>
      <p class="mt-3 text-2xl font-semibold text-[var(--color-ink)]">
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="no-underline text-[var(--color-ink)]">{COMPANY.hq.phone}</a>
      </p>
      <p class="mt-2 text-sm text-[var(--color-text-muted)]">Monday–Friday, 9 am–6 pm ET.</p>

      <hr class="my-6 border-[var(--color-soft-gray)]"/>

      <p class="text-sm text-[var(--color-text-muted)]">
        Already know your loan officer? Visit their bio page directly to schedule a call.
      </p>
      <a href="/loan-officers/" class="text-sm font-semibold text-[var(--color-accent)] mt-2 inline-block">Browse loan officers →</a>
    </aside>
  </section>
</Layout>

<script>
  const cards = document.querySelectorAll<HTMLButtonElement>('.scenario-card');
  const productSelect = document.getElementById('product') as HTMLSelectElement;
  const summary = document.getElementById('scenario-summary')!;
  const summaryLabel = document.getElementById('scenario-label')!;
  const clearBtn = document.getElementById('clear-scenario')!;
  const formSection = document.getElementById('form-section')!;

  const ACTIVE_CLASSES = [
    'border-[var(--color-accent)]',
    'bg-[var(--color-accent)]/5',
  ];

  function selectCard(card: HTMLButtonElement) {
    // Clear all cards
    cards.forEach((c) => {
      c.classList.remove(...ACTIVE_CLASSES);
      c.setAttribute('aria-pressed', 'false');
    });

    // Highlight selected card
    card.classList.add(...ACTIVE_CLASSES);
    card.setAttribute('aria-pressed', 'true');

    // Set product dropdown
    const value = card.dataset.value ?? '';
    productSelect.value = value;

    // Show summary strip in form
    summaryLabel.textContent = card.querySelector('p')?.textContent ?? '';
    summary.classList.remove('hidden');

    // Scroll to form
    formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  cards.forEach((card) => {
    card.setAttribute('aria-pressed', 'false');
    card.addEventListener('click', () => selectCard(card));
  });

  clearBtn.addEventListener('click', () => {
    cards.forEach((c) => {
      c.classList.remove(...ACTIVE_CLASSES);
      c.setAttribute('aria-pressed', 'false');
    });
    productSelect.value = '';
    summary.classList.add('hidden');
    document.querySelector<HTMLElement>('.scenario-card')
      ?.closest('section')
      ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
