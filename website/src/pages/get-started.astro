---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../data/company";

const situations = [
  { id: "self-employed", label: "I'm Self-Employed", description: "Business owner, 1099 contractor, or freelancer — your income doesn't show up well on tax returns." },
  { id: "investor", label: "I'm a Real Estate Investor", description: "Qualify based on rental income, not personal income. DSCR loans built for your portfolio." },
  { id: "62plus", label: "I'm 62 or Older", description: "Access your home equity without monthly payments. Stay in your home on your terms." },
  { id: "denied", label: "I Was Denied Elsewhere", description: "A conventional lender said no. Non-QM programs exist for exactly your situation." },
  { id: "buying", label: "I'm Buying a Home", description: "First-time buyer or move-up — conventional, FHA, VA, USDA, or renovation." },
  { id: "refinancing", label: "I'm Refinancing", description: "Lower your rate, change your term, or access equity. Let's look at your options." },
];

const incomeTypes = [
  { id: "w2", label: "W-2 / Salary", description: "Employed full-time, receive regular paystubs" },
  { id: "self-employed", label: "Self-Employed / 1099", description: "Business owner, freelancer, or contractor" },
  { id: "rental", label: "Rental / Investment Income", description: "Income from properties you own" },
  { id: "retirement", label: "Retirement / Fixed Income", description: "Social Security, pension, or distributions" },
];

const purposes = [
  { id: "buying", label: "Buying a Home" },
  { id: "refinancing", label: "Refinancing" },
  { id: "investing", label: "Investing in Property" },
  { id: "exploring", label: "Just Exploring Options" },
];
---

<Layout
  title="Get Started | Cliffco Mortgage Bankers"
  description={`Tell Cliffco your situation. A licensed loan officer (NMLS #${COMPANY.nmls}) responds within one business day. No call center, no bots.`}
  noindex={true}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Get Started", href: "/get-started/" },
  ]} />

  <section class="bg-[var(--color-mist-gray)] section">
    <div class="container-wide">
      <div class="max-w-2xl mx-auto">

        <!-- Progress indicator -->
        <div class="mb-8">
          <div class="flex justify-between items-center mb-2">
            <p id="step-label" class="text-sm font-semibold text-[var(--color-ink)]">Step 1 of 4 — Your Situation</p>
            <p class="text-xs text-[var(--color-text-muted)]">No credit pull. No commitment.</p>
          </div>
          <div class="h-1.5 bg-white rounded-full overflow-hidden">
            <div id="progress-bar" class="h-full bg-[var(--color-accent)] rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>

        <!-- STEP 1: Situation -->
        <div data-step="1">
          <h1 class="mt-0" style="font-size: var(--text-display-lg);">What's your situation?</h1>
          <p class="lead mt-2 text-[var(--color-text-muted)]">Pick the one that fits best.</p>

          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {situations.map((s) => (
              <button
                type="button"
                data-situation={s.id}
                class="situation-tile card text-left cursor-pointer border-2 border-transparent hover:border-[var(--color-accent)] transition-colors"
              >
                <p class="font-semibold text-[var(--color-ink)]">{s.label}</p>
                <p class="mt-1 text-sm text-[var(--color-text-muted)]">{s.description}</p>
              </button>
            ))}
          </div>

          <div class="mt-8 flex justify-end">
            <button id="next-1" class="btn btn-primary" disabled>Next: Income type →</button>
          </div>
        </div>

        <!-- STEP 2: Income type -->
        <div data-step="2" class="hidden">
          <h1 class="mt-0" style="font-size: var(--text-display-lg);">How do you earn income?</h1>
          <p class="lead mt-2 text-[var(--color-text-muted)]">Pick the one that best describes your primary income source.</p>

          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {incomeTypes.map((t) => (
              <button
                type="button"
                data-income={t.id}
                class="income-tile card text-left cursor-pointer border-2 border-transparent hover:border-[var(--color-accent)] transition-colors"
              >
                <p class="font-semibold text-[var(--color-ink)]">{t.label}</p>
                <p class="mt-1 text-sm text-[var(--color-text-muted)]">{t.description}</p>
              </button>
            ))}
          </div>

          <div class="mt-8 flex justify-between">
            <button type="button" class="btn btn-secondary back-btn">← Back</button>
            <button id="next-2" class="btn btn-primary" disabled>Next: Quick numbers →</button>
          </div>
        </div>

        <!-- STEP 3: Quick qualifiers -->
        <div data-step="3" class="hidden">
          <h1 class="mt-0" style="font-size: var(--text-display-lg);">A few quick numbers.</h1>
          <p class="lead mt-2 text-[var(--color-text-muted)]">No commitment. This helps us match you to the right program.</p>

          <div class="mt-6 space-y-8">
            <div>
              <p class="font-semibold text-[var(--color-ink)] mb-3">What are you looking to do?</p>
              <div class="grid grid-cols-2 gap-3">
                {purposes.map((p) => (
                  <button
                    type="button"
                    data-purpose={p.id}
                    class="purpose-tile px-4 py-3 rounded-xl border border-[var(--color-mist-gray)] bg-white text-sm font-medium text-[var(--color-ink)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors cursor-pointer text-center"
                  >
                    {p.label}
                  </button>
                ))}
              </div>
            </div>

            <div>
              <label for="credit-range" class="block font-semibold text-[var(--color-ink)] mb-2">Estimated credit score range</label>
              <select id="credit-range" class="w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] bg-white focus:border-[var(--color-accent)] focus:outline-none">
                <option value="">Select a range…</option>
                <option value="760+">760 or above (Excellent)</option>
                <option value="700-759">700 to 759 (Good)</option>
                <option value="640-699">640 to 699 (Fair)</option>
                <option value="580-639">580 to 639 (Below average)</option>
                <option value="below-580">Below 580</option>
                <option value="unknown">Not sure</option>
              </select>
            </div>

            <div>
              <label for="price-range" class="block font-semibold text-[var(--color-ink)] mb-2">Estimated purchase / loan amount</label>
              <select id="price-range" class="w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] bg-white focus:border-[var(--color-accent)] focus:outline-none">
                <option value="">Select a range…</option>
                <option value="under-250k">Under $250,000</option>
                <option value="250k-500k">$250,000 to $500,000</option>
                <option value="500k-750k">$500,000 to $750,000</option>
                <option value="750k-1m">$750,000 to $1,000,000</option>
                <option value="over-1m">Over $1,000,000</option>
                <option value="unknown">Not sure yet</option>
              </select>
            </div>
          </div>

          <div class="mt-8 flex justify-between">
            <button type="button" class="btn btn-secondary back-btn">← Back</button>
            <button id="next-3" class="btn btn-primary">Next: Contact info →</button>
          </div>
        </div>

        <!-- STEP 4: Contact info -->
        <div data-step="4" class="hidden">
          <h1 class="mt-0" style="font-size: var(--text-display-lg);">Almost there.</h1>
          <p class="lead mt-2 text-[var(--color-text-muted)]">Where should a Cliffco loan officer reach you?</p>

          <form action="/api/lead" method="post" class="mt-6 space-y-5">

            <!-- Hidden: quiz answers -->
            <input type="hidden" id="h-situation" name="situation" />
            <input type="hidden" id="h-income" name="income_type" />
            <input type="hidden" id="h-purpose" name="purpose" />
            <input type="hidden" id="h-credit" name="credit_range" />
            <input type="hidden" id="h-price" name="price_range" />

            <div>
              <label for="name" class="block text-sm font-medium text-[var(--color-ink)]">Your name</label>
              <input id="name" name="name" type="text" required autocomplete="name"
                class="mt-2 w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] focus:border-[var(--color-accent)] focus:outline-none" />
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="phone" class="block text-sm font-medium text-[var(--color-ink)]">Phone</label>
                <input id="phone" name="phone" type="tel" required autocomplete="tel"
                  class="mt-2 w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] focus:border-[var(--color-accent)] focus:outline-none" />
                <p class="mt-1 text-xs text-[var(--color-text-muted)]">No credit pull. We won't share your number.</p>
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-[var(--color-ink)]">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email"
                  class="mt-2 w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] focus:border-[var(--color-accent)] focus:outline-none" />
              </div>
            </div>

            <div>
              <label for="state" class="block text-sm font-medium text-[var(--color-ink)]">Property state</label>
              <select id="state" name="state" required
                class="mt-2 w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] focus:border-[var(--color-accent)] focus:outline-none bg-white">
                <option value="">Select…</option>
                <option value="NY">New York</option>
                <option value="NJ">New Jersey</option>
                <option value="AZ">Arizona</option>
                <option value="MN">Minnesota</option>
                <option value="FL">Florida</option>
                <option value="other">Another state Cliffco is licensed in</option>
              </select>
            </div>

            <div>
              <label for="notes" class="block text-sm font-medium text-[var(--color-ink)]">Anything we should know? <span class="font-normal text-[var(--color-text-muted)]">(optional)</span></label>
              <textarea id="notes" name="notes" rows="3"
                class="mt-2 w-full px-4 py-3 rounded-lg border border-[var(--color-mist-gray)] focus:border-[var(--color-accent)] focus:outline-none"></textarea>
            </div>

            <div class="rounded-lg bg-white border border-[var(--color-mist-gray)] p-4">
              <label class="flex items-start gap-3 text-sm cursor-pointer">
                <input type="checkbox" name="tcpa_consent" value="yes" required class="mt-1 shrink-0" />
                <span class="text-[var(--color-text)]">
                  I expressly consent to receive calls, texts, and emails from {COMPANY.legalName}
                  (and Swish Capital, Inc. for Florida properties) at the phone number and email I
                  provided, including via automated technology, regarding my loan inquiry. Consent
                  is not required to obtain credit. Reply STOP to opt out of texts. See our
                  <a href="/legal/sms-consent/">SMS Consent</a> and <a href="/legal/privacy/">Privacy Policy</a>.
                </span>
              </label>
            </div>

            <div class="flex flex-col sm:flex-row gap-3">
              <button type="button" class="btn btn-secondary back-btn shrink-0">← Back</button>
              <button type="submit" class="btn btn-primary flex-1">Submit — a Cliffco LO will follow up</button>
            </div>

            <div class="text-center pt-2">
              <p class="text-sm text-[var(--color-text-muted)]">
                Prefer to call? <a href={`tel:${COMPANY.tollFreeE164}`} class="font-semibold text-[var(--color-ink)]">{COMPANY.tollFree}</a>
              </p>
              <p class="text-xs text-[var(--color-text-muted)] mt-3">
                {COMPANY.brandName} · NMLS #{COMPANY.nmls} · Licensed in 32 states ·
                Cliffco does not collect Social Security Numbers or bank account information through this form.
              </p>
            </div>
          </form>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  .situation-tile.active,
  .income-tile.active {
    border-color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 5%, white);
  }
  .purpose-tile.active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 5%, white);
  }
</style>

<script>
  let currentStep = 1;
  const totalSteps = 4;

  const selections: Record<string, string> = {
    situation: "",
    incomeType: "",
    purpose: "",
  };

  const stepLabels = [
    "Step 1 of 4 — Your Situation",
    "Step 2 of 4 — Your Income",
    "Step 3 of 4 — Quick Numbers",
    "Step 4 of 4 — Contact Info",
  ];

  function goToStep(n: number) {
    document.querySelector(`[data-step="${currentStep}"]`)?.classList.add("hidden");
    document.querySelector(`[data-step="${n}"]`)?.classList.remove("hidden");
    currentStep = n;
    updateProgress();
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function updateProgress() {
    const pct = ((currentStep - 1) / (totalSteps - 1)) * 100;
    const bar = document.getElementById("progress-bar") as HTMLElement;
    if (bar) bar.style.width = pct + "%";
    const label = document.getElementById("step-label");
    if (label) label.textContent = stepLabels[currentStep - 1];
  }

  // Step 1 tiles
  document.querySelectorAll<HTMLButtonElement>("[data-situation]").forEach((tile) => {
    tile.addEventListener("click", () => {
      document.querySelectorAll("[data-situation]").forEach((t) => t.classList.remove("active"));
      tile.classList.add("active");
      selections.situation = tile.dataset.situation ?? "";
      const next = document.getElementById("next-1") as HTMLButtonElement;
      if (next) next.disabled = false;
    });
  });

  // Step 2 tiles
  document.querySelectorAll<HTMLButtonElement>("[data-income]").forEach((tile) => {
    tile.addEventListener("click", () => {
      document.querySelectorAll("[data-income]").forEach((t) => t.classList.remove("active"));
      tile.classList.add("active");
      selections.incomeType = tile.dataset.income ?? "";
      const next = document.getElementById("next-2") as HTMLButtonElement;
      if (next) next.disabled = false;
    });
  });

  // Step 3 purpose tiles
  document.querySelectorAll<HTMLButtonElement>("[data-purpose]").forEach((tile) => {
    tile.addEventListener("click", () => {
      document.querySelectorAll("[data-purpose]").forEach((t) => t.classList.remove("active"));
      tile.classList.add("active");
      selections.purpose = tile.dataset.purpose ?? "";
    });
  });

  // Next buttons
  document.getElementById("next-1")?.addEventListener("click", () => goToStep(2));
  document.getElementById("next-2")?.addEventListener("click", () => goToStep(3));
  document.getElementById("next-3")?.addEventListener("click", () => {
    // Populate hidden fields
    (document.getElementById("h-situation") as HTMLInputElement).value = selections.situation;
    (document.getElementById("h-income") as HTMLInputElement).value = selections.incomeType;
    (document.getElementById("h-purpose") as HTMLInputElement).value = selections.purpose;
    (document.getElementById("h-credit") as HTMLInputElement).value =
      (document.getElementById("credit-range") as HTMLSelectElement)?.value ?? "";
    (document.getElementById("h-price") as HTMLInputElement).value =
      (document.getElementById("price-range") as HTMLSelectElement)?.value ?? "";
    goToStep(4);
  });

  // Back buttons
  document.querySelectorAll<HTMLButtonElement>(".back-btn").forEach((btn) => {
    btn.addEventListener("click", () => goToStep(currentStep - 1));
  });

  // Initialize progress
  updateProgress();
</script>
