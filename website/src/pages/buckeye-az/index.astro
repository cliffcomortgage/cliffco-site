---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { BRANCHES } from "../../data/branches";
import { LOAN_OFFICERS } from "../../data/loan-officers";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";

const branch = BRANCHES.find((b) => b.slug === "buckeye-az")!;
// No loan officers are shown as based at Buckeye; list everyone licensed in Arizona instead.
const los = LOAN_OFFICERS.filter((lo) => lo.states.includes("AZ"));

/*
 * Arizona issues originators their own licence on top of the company's, and it has to be
 * displayed. The six with bio pages come from the data so this block cannot drift from
 * them. Timothy Alan King II has no Cliffco loan-officer record and no page of his own, so
 * he is listed only here, with the note compliance requires.
 */
const AZ_BRANCH_LICENSE = "Arizona Mortgage Banker Branch License License/Registration #: BK-BR-1045709";
const azOriginators = [
  ...los
    .filter((lo) => lo.stateLicenses?.AZ)
    .map((lo) => ({ name: lo.displayName, nmls: lo.nmls, license: lo.stateLicenses!.AZ, note: null as string | null })),
  { name: "Timothy Alan King II", nmls: "1458438", license: "LO-0950923", note: "does not originate for Cliffco, Inc." },
].sort((a, b) => a.name.localeCompare(b.name));

const schema = [
  localBusinessSchema(branch),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "Arizona", url: "/locations/arizona/" },
    { name: "Buckeye", url: "/buckeye-az/" },
  ]),
];

import BranchPage from "../../components/asym/BranchPage.astro";

---

<Layout
  title="Buckeye, AZ Mortgage Office | Cliffco Mortgage Bankers"
  description="Cliffco Mortgage Bankers Buckeye office - 21610 W Hillcrest Road, Buckeye, AZ 85396. Branch NMLS #2476150. Serving the Phoenix metro and greater Arizona."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Locations", href: "/locations/" },
    { name: "Arizona", href: "/locations/arizona/" },
    { name: "Buckeye", href: "/buckeye-az/" },
  ]} />

  <BranchPage
    city="Buckeye"
    eyebrow="Buckeye, AZ · Phoenix Metro"
    title="Buckeye Mortgage Office"
    lead="Cliffco's Buckeye branch serves the greater Phoenix metro and statewide Arizona. A multilingual team helping first-time and move-up buyers, veterans, and homeowners refinancing, with DSCR, Non-QM, and bank statement programs when you need them."
    addressName={branch.name}
    street={branch.street}
    cityLine={`${branch.city}, ${branch.region} ${branch.postalCode}`}
    nmlsLabel={`Branch #${branch.nmls}`}
    phone={{ e164: COMPANY.tollFreeE164, display: COMPANY.tollFree, label: "Toll Free" }}
    findTitle="Find us in Buckeye."
    about="Our Buckeye team is multilingual (fluent in English, Mandarin, and Spanish) and serves first-time buyers, move-up buyers, and homeowners refinancing across Arizona, California, and Texas, along with self-employed borrowers and real estate investors who need a specialty program."
    back={{ href: "/locations/arizona/", label: "← All Arizona offices" }}
    los={los}
    teamEyebrow="Licensed in Arizona"
    teamTitle="Arizona-licensed loan officers."
    teamIntro="These loan officers are based at other Cliffco offices but are fully licensed to originate loans in Arizona."
    ctaTitle="Buying or investing in the Phoenix metro? We're here."
    formTitle="Buying or investing in the Phoenix metro?"
    formSub="Tell us your situation and the Buckeye team will be in touch within one business day."
    formSource="branch-buckeye"
  >
    <Fragment slot="info">
      {branch.nmls && <p>Branch NMLS #{branch.nmls}</p>}
      <p>Arizona Mortgage Banker License License/Registration #: BK-1045708</p>
    </Fragment>
  </BranchPage>

  <!--
    ARIZONA LICENSING — the branch licence, and every originator licensed in Arizona with
    their individual AZ licence number. Required on this page; the company licence sits in
    the footer as well.
  -->
  <section class="bg-white border-t border-black/15" aria-label="Arizona licensing">
    <div class="container-wide py-10">
      <p class="eyebrow">Arizona licensing</p>

      <p class="mt-3 text-sm text-[var(--color-text)]">{AZ_BRANCH_LICENSE}</p>

      <p class="mt-6 font-sans font-medium text-[11px] uppercase tracking-[0.14em] text-[var(--color-ink)]">
        Arizona-licensed loan originators
      </p>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {azOriginators.map((o) => (
          <li class="border-l-2 border-[var(--color-ink)] pl-3">
            <p class="text-sm font-semibold text-[var(--color-ink)]">{o.name}</p>
            <p class="text-xs text-[var(--color-text-muted)]">NMLS #{o.nmls}</p>
            <p class="text-xs text-[var(--color-text-muted)]">
              AZ Loan Originator License #{o.license}{o.note && <span> ({o.note})</span>}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
