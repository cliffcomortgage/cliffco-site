---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
import { faqPageSchema, articleSchema } from "../../lib/schema";


const faq = [
  {
    question: "What is a bank statement mortgage?",
    answer: "A bank statement mortgage lets you qualify using 12 to 24 months of bank deposits instead of tax returns or W-2s. Lenders analyze your average monthly deposits to calculate qualifying income. This program was built specifically for self-employed borrowers whose tax returns understate their actual cash flow.",
  },
  {
    question: "How many months of bank statements do I need?",
    answer: "Most programs require 12 months, though some allow 24 months, which can be beneficial if your income has grown over time. Cliffco works with both personal and business bank statements.",
  },
  {
    question: "What if my business income varies month to month?",
    answer: "Lenders average your monthly deposits over the full statement period. Some variation is expected and accepted. What matters is your consistent average, not any single month's performance.",
  },
  {
    question: "Can I qualify if my tax returns show a loss or very low income?",
    answer: "Yes, in many cases. Bank statement programs look at actual deposits, not taxable income. If your business generates strong cash flow but your accountant has minimized taxable income through deductions, you may still qualify.",
  },
  {
    question: "What credit score do I need for a bank statement loan?",
    answer: "Cliffco's bank statement programs typically require a minimum 620 FICO, though some scenarios can work with scores as low as 580 with compensating factors such as a larger down payment or strong reserves.",
  },
  {
    question: "How is my income calculated from bank statements?",
    answer: "For personal bank statements, lenders typically use 100% of average monthly deposits. For business bank statements, lenders apply an expense factor (typically 50-75%) to account for operating costs. Your loan officer will calculate both and use whichever is more favorable.",
  },
];

const schema = [
  faqPageSchema(faq),
  articleSchema({
    headline: "Self-Employed Mortgage Loans: Bank Statement Qualifying",
    description: "Bank statement mortgages for self-employed borrowers, business owners, and 1099 contractors. Qualify using 12 months of bank deposits instead of tax returns.",
    url: "/self-employed-mortgage/",
    datePublished: "2026-04-15",
    dateModified: "2026-07-15",
  }),
];

import AsymHero from "../../components/asym/AsymHero.astro";
import Split from "../../components/asym/Split.astro";
import FormCard from "../../components/asym/FormCard.astro";
import FaqList from "../../components/asym/FaqList.astro";
import CtaBand from "../../components/asym/CtaBand.astro";

const steps = [
  { h: "Share your bank statements", b: "12 months of personal or business bank statements. We analyze actual deposits, not tax return figures." },
  { h: "We calculate your qualifying income", b: "Your loan officer averages your monthly deposits and identifies the program with the best fit for your situation." },
  { h: "Close in 30 to 45 days", b: "Underwriting is done in-house. No handoffs, no call centers. Your file gets personal attention from start to close." },
];
const details = [
  ["Down payment", "10 to 25% (program dependent)"],
  ["Min FICO", "620"],
  ["Loan amount", "Up to $3.5 million"],
  ["Property types", "Primary, second home, investment"],
  ["Loan terms", "30-year fixed, interest only options available"],
  ["Tax returns required", "Not required (program dependent)"],
];
---

<Layout
  title="Self-Employed Mortgage Loans | Bank Statement Qualifying | Cliffco"
  description="Qualify for a mortgage using 12 months of bank statements, no tax returns required. Cliffco's bank statement loan programs are built for business owners, sole proprietors, and 1099 contractors."
  schema={schema}
>
  <Breadcrumbs trail={[
    { name: "Home", href: "/" },
    { name: "Self-Employed Mortgage", href: "/self-employed-mortgage/" },
  ]} />

  <AsymHero
    eyebrow="Non-QM Lending · Bank Statement Qualifying"
    lead="Conventional lenders require W-2s. We require 12 months of bank statements. If your tax returns don't tell the whole story, Cliffco has a path forward."
    image={{ src: "/images/content%20images/Self%20Employed%20Hero.webp", cutout: true }}
    tag={{ stat: "12 mo.", label: "of bank statements" }}
  >
    You Built a Business.<br />Your Mortgage Should Reflect That.
    <Fragment slot="actions">
      <a href="#contact" class="btn btn-primary">See If I Qualify</a>
      <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
    </Fragment>
    <Fragment slot="note">No credit pull. No commitment. A loan officer responds in one business day.</Fragment>
  </AsymHero>

  <!-- LEAD FORM + WHO QUALIFIES -->
  <section class="bg-white border-t border-[var(--color-ink)]">
    <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <FormCard title="Self-employed and wondering what you qualify for?" sub="Tell us how you document income and we'll find the program that works." formSource="self-employed" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-8">
        <p class="eyebrow">Who qualifies</p>
        <h2 class="mt-4" style="font-size: var(--text-h2); font-weight: 700;">This program was built for you specifically.</h2>
        <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed" style="font-size: 1.0625rem;">
          Conventional mortgage guidelines were written for W-2 employees. If you don't fit that mold, bank statement qualifying changes the equation entirely.
        </p>
        <ul class="mt-8 list-none m-0 p-0 border-t border-[var(--color-ink)]">
          {[
            "Sole proprietors and single-member LLC owners",
            "S-Corp and C-Corp owners",
            "1099 contractors and freelancers",
            "Seasonal business owners",
            "Restaurant, retail, and service business owners",
            "Real estate agents and commissioned salespeople",
            "Borrowers whose tax returns show less income than they actually earn",
          ].map((item) => (
            <li class="flex gap-4 items-start py-4 border-b border-black/15">
              <span class="font-mono text-sm text-[var(--color-ink)] pt-0.5" aria-hidden="true">✓</span>
              <span class="text-[var(--color-text)]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <Split eyebrow="The process" title="Three steps. No tax returns required.">
    <ol class="list-none m-0 p-0 border-t border-[var(--color-ink)]">
      {steps.map((s, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-8 border-b border-black/15">
          <span class="font-mono text-sm text-[var(--color-text-muted)] pt-1">0{i + 1}</span>
          <div>
            <h3 class="text-xl font-semibold text-[var(--color-ink)]">{s.h}</h3>
            <p class="mt-3 text-[var(--color-text)] leading-relaxed">{s.b}</p>
          </div>
        </li>
      ))}
    </ol>
  </Split>

  <!-- WHAT YOU NEED + LOAN DETAILS -->
  <Split eyebrow="Document checklist" title="What to have ready.">
    <ul slot="aside" class="mt-8 list-none m-0 p-0 space-y-4">
      {[
        "12 to 24 months of bank statements (personal or business)",
        "Proof of self-employment: business license, CPA letter, or business bank statements",
        "Minimum 10 to 20% down payment (program dependent)",
        "3 to 6 months of reserves (PITI)",
      ].map((item) => (
        <li class="flex gap-3 items-start text-[var(--color-text)]">
          <span class="font-mono text-[var(--color-ink)] shrink-0" aria-hidden="true">→</span>
          {item}
        </li>
      ))}
    </ul>
    <h3 class="text-xl font-semibold text-[var(--color-ink)]">Loan details.</h3>
    <dl class="mt-6 border-t border-[var(--color-ink)]">
      {details.map(([dt, dd]) => (
        <div class="grid sm:grid-cols-[minmax(0,12rem)_1fr] gap-x-6 gap-y-1 py-4 border-b border-black/15">
          <dt class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] pt-1">{dt}</dt>
          <dd class="font-medium text-[var(--color-ink)]">{dd}</dd>
        </div>
      ))}
    </dl>
  </Split>

  <!-- FAQ (picture left, questions right) -->
  <Split eyebrow="FAQ" title="How bank statement qualifying works.">
    <img slot="aside" src="/images/content%20images/Self%20Employed%20Mortgage.jpg" alt="Self-employed business owner reviewing bank statement mortgage qualification with Cliffco" class="mt-10 rounded-2xl w-full aspect-[4/3] object-cover" loading="lazy" />
    <FaqList items={faq} />
  </Split>

  <CtaBand
    title="Bank statements don't lie. Let's build your loan around them."
    text="A Cliffco loan officer specializing in bank statement programs responds in one business day."
  >
    <a href="#contact" class="btn btn-primary">Tell us your situation</a>
    <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary">{COMPANY.tollFree}</a>
  </CtaBand>
</Layout>
