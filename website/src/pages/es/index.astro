---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import { COMPANY } from "../../data/company";
const yearsInBiz = COMPANY.yearsInBusiness();
---

<Layout
  title={`${COMPANY.brandName} - Préstamos hipotecarios para familias`}
  description={`Cliffco Mortgage Bankers (NMLS #${COMPANY.nmls}) es un banco hipotecario independiente con ${yearsInBiz} años de experiencia, especializado en préstamos non-QM, hipotecas inversas, DSCR y préstamos de estado de cuenta bancaria empresarial. Equipo bilingüe en Orlando, Ft. Lauderdale, Phoenix y Long Island.`}
  locale="es-US"
  alternateLocales={[
    { hreflang: "en-US", href: "https://cliffcomortgage.com/" },
    { hreflang: "x-default", href: "https://cliffcomortgage.com/" },
  ]}
>
  <Breadcrumbs trail={[
    { name: "Inicio (EN)", href: "/" },
    { name: "Español", href: "/es/" },
  ]} />

  <section class="accent-gradient">
    <div class="container-wide py-20 lg:py-28">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Familia desde 1989 · NMLS #{COMPANY.nmls}</p>
      <h1 class="mt-4 text-white" style="font-size: var(--text-display-xl); line-height: 1.05;">
        Llevamos a las familias a casa.<br/>
        <span class="text-[var(--color-ice-blue)]">Especialmente a las que otros bancos rechazaron.</span>
      </h1>
      <p class="lead mt-6 text-white/90 max-w-2xl">
        {yearsInBiz} años. {COMPANY.legalName}. Oficiales de préstamos reales, sin call centers
        ni transferencias. Especialistas en préstamos non-QM y para trabajadores independientes,
        hipotecas inversas, DSCR para inversionistas y financiamiento préstamos de estado de cuenta bancaria empresarial.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Hable con un oficial bilingüe</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-prose">
      <p class="eyebrow">Quiénes somos</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Un banco hipotecario familiar de {yearsInBiz} años, ahora con equipo bilingüe.</h2>
      <div class="direct-answer mt-6">
        Cliffco Mortgage Bankers (NMLS #{COMPANY.nmls}) es un banco hipotecario independiente
        fundado en 1989 y licenciado en 32 estados. Contamos con oficiales de préstamos bilingües en nuestras oficinas de Orlando, Ft. Lauderdale,
        Phoenix (Scottsdale) y Long Island, atendiendo a clientes hispanohablantes en todo el país.
      </div>
      <p class="mt-6 text-[var(--color-text-muted)]">
        Estamos publicando contenido completo en español pillar por pillar. Por ahora, comuníquese
        con nosotros y le conectaremos con un oficial bilingüe que entienda su situación -
        préstamos para trabajadores independientes con declaraciones de banco, ITIN, DSCR para
        inversionistas, hipoteca inversa, o préstamos de estado de cuenta bancaria empresarial.
      </p>
      <p class="mt-4 text-sm text-[var(--color-text-muted)]"><em>Note: Spanish content is being rolled out in phases. Full pillars launching Q2/Q3 2026.</em></p>
    </div>
  </section>

  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Cuéntenos su situación.</h2>
      <p class="lead mt-4 text-white/85">Un oficial bilingüe le responderá en un día hábil.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Comenzar</a>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="btn btn-secondary !border-white !text-white">{COMPANY.hq.phone}</a>
      </div>
    </div>
  </section>
</Layout>
