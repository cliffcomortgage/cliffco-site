---
/**
 * Homebuyer Advantage Program - splash, /homebuyer-advantage/
 *
 * Asks one question and sends each audience to its own page (Sivon, 2026-11-10):
 *   "I'm an employee" -> /homebuyer-advantage/employees/  (Financial Discovery Call form)
 *   "I'm a company"   -> /homebuyer-advantage/companies/  (partnership inquiry form)
 * The two cards mirror their destinations: white for employees, black for companies.
 *
 * Partner flyers, QR codes and employee emails should link to /employees/ directly so people
 * skip this step; the splash is for anyone who lands on the program's main URL. UTMs on a link
 * here are carried onto the chosen page (advantage-client.ts), so attribution survives the click.
 *
 * Noindex (LandingLayout's default) and out of the sitemap. ALL COPY ON THIS PAGE IS NEW and
 * marked COMPLIANCE REVIEW; it restates only facts from the spec.
 */
import LandingLayout from "../../layouts/LandingLayout.astro";
import AdvantageDisclaimer from "../../components/advantage/AdvantageDisclaimer.astro";
import { ADVANTAGE_PHONE, ADVANTAGE_OFFICE } from "../../data/homebuyer-advantage";

// COMPLIANCE REVIEW: page title and meta description
const title = "Homebuyer Advantage Program | Cliffco Mortgage Bankers";
const description =
  "The Cliffco Homebuyer Advantage Program: a $10,000 lender credit toward closing costs, free homebuyer education and a dedicated team, offered through participating employers and unions.";

const arrow = "M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3";
---

<LandingLayout
  title={title}
  description={description}
  phone={ADVANTAGE_PHONE.display}
  phoneE164={ADVANTAGE_PHONE.e164}
  office={ADVANTAGE_OFFICE}
>
  <!-- COMPLIANCE REVIEW: splash eyebrow, headline, intro and both choice cards (all new) -->
  <section class="bg-white flex-1" style="padding-block: clamp(3rem, 7vw, 6rem);">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Cliffco Homebuyer Advantage Program</p>
        <h1 class="mt-5" style="font-size: clamp(2.125rem, 2.6vw + 1.1rem, 3.25rem); line-height: 1.1;">
          A homebuying benefit offered through participating employers and unions
        </h1>
        <p class="lead mt-6 max-w-[62ch]">
          The program gives employees and members of participating organizations a $10,000 lender credit toward closing costs, free homebuyer education, and a dedicated Cliffco team. Choose the option that fits you to see the details for your situation.
        </p>
      </div>

      <div class="mt-10 lg:mt-14 grid md:grid-cols-2 gap-5">
        <a href="/homebuyer-advantage/employees/" data-audience="employee"
           class="adv-choice group flex flex-col justify-between gap-10 border-2 border-[var(--color-ink)] bg-white p-7 sm:p-10 no-underline text-[var(--color-ink)] hover:bg-[var(--color-airy-gray)] transition-colors">
          <span>
            <span class="eyebrow">For employees and members</span>
            <span class="block mt-4 font-bold" style="font-size: var(--text-h2); line-height: 1.1; letter-spacing: -0.015em;">I'm an employee</span>
            <span class="block mt-4 text-lg leading-relaxed text-[var(--color-text)]">My employer or union partners with Cliffco, and I'd like to see what the program offers me and set up my Financial Discovery Call.</span>
          </span>
          <span class="inline-flex items-center gap-3 font-semibold">
            See the employee page
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 transition-transform group-hover:translate-x-1" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
          </span>
        </a>

        <a href="/homebuyer-advantage/companies/" data-audience="company"
           class="adv-choice on-black group flex flex-col justify-between gap-10 border-2 border-[var(--color-ink)] bg-[var(--color-ink)] p-7 sm:p-10 no-underline text-white hover:bg-[var(--color-graphite)] transition-colors">
          <span>
            <span class="eyebrow">For HR and union leaders</span>
            <span class="block mt-4 font-bold" style="font-size: var(--text-h2); line-height: 1.1; letter-spacing: -0.015em;">I'm a company</span>
            <span class="block mt-4 text-lg leading-relaxed text-[var(--color-soft-gray)]">We'd like to offer the Homebuyer Advantage Program to our employees or members, and we want to know how partnering works.</span>
          </span>
          <span class="inline-flex items-center gap-3 font-semibold">
            See the partnership page
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 transition-transform group-hover:translate-x-1" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
          </span>
        </a>
      </div>

      <p class="mt-6 text-sm"><a href="#disclaimer" class="text-[var(--color-text-muted)]">See disclaimer</a></p>
    </div>
  </section>

  <AdvantageDisclaimer />
</LandingLayout>

<script>
  import { initAdvantage } from "../../lib/advantage-client";
  initAdvantage();
</script>
