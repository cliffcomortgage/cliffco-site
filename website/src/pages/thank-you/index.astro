---
import Layout from "../../layouts/Layout.astro";
import { COMPANY } from "../../data/company";

const nextSteps = [
  { step: "01", heading: "Your loan officer reviews your submission", body: "A licensed Cliffco loan officer (a real person, not a bot) reads your information and identifies which programs fit your situation." },
  { step: "02", heading: "You hear from us within one business day", body: "We'll call or email depending on your preference. The goal is to give you an honest assessment: what programs are available, what the approximate rate looks like, and what you'd need to move forward." },
  { step: "03", heading: "No pressure, no commitment", body: "This first conversation is informational. We don't pull your credit until you explicitly authorize it. You can decide whether to proceed on your own timeline." },
];
const readMore = [
  { label: "I'm Buying My First Home", href: "/first-time-homebuyer/", desc: "Low down payment options and what to expect at every step." },
  { label: "I'm Purchasing or Refinancing", href: "/purchasing-refinancing/", desc: "Conventional, FHA, and VA loans for your next home or a better rate." },
  { label: "Down Payment Assistance", href: "/down-payment-assistance/", desc: "Programs that can cover your down payment, closing costs, or both." },
  { label: "I'm Self-Employed", href: "/self-employed-mortgage/", desc: "How bank statement loans work and what you'd need to qualify." },
  { label: "I'm a Real Estate Investor", href: "/real-estate-investor-mortgage/", desc: "DSCR loans: qualifying on cash flow, not salary." },
  { label: "I'm 62 or Older", href: "/reverse-mortgage/", desc: "Access your equity without selling or making monthly payments." },
  { label: "I Was Denied Elsewhere", href: "/denied-mortgage/", desc: "Turned down by another lender? We'll take a second look." },
  { label: "Our Process", href: "/process/", desc: "Step-by-step: from first call to closing day." },
  { label: "Mortgage Calculators", href: "/mortgage-guides/calculators/", desc: "Estimate your payment, buying power, or closing costs." },
];
---

<Layout
  title="We Got Your Message | Cliffco Mortgage Bankers"
  description="Thank you for reaching out to Cliffco. A loan officer will be in touch within one business day."
  noindex={true}
>
  <section class="bg-white">
    <div class="container-wide pt-20 pb-14 lg:pt-28 lg:pb-16 text-center">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-[var(--color-ink)] mb-6">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </div>
      <h1 class="text-[var(--color-ink)]" style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.05; font-weight: 700; letter-spacing: -0.03em; font-family: var(--font-display);">
        We Got It.
      </h1>
      <p class="mt-5 text-[var(--color-text-muted)] max-w-xl mx-auto" style="font-size: 1.125rem; line-height: 1.6;">
        A Cliffco loan officer will review your information and reach out within one business day.
      </p>
      <p class="mt-3 text-sm text-[var(--color-text-muted)]">Can't wait? Call us directly at <a href={`tel:${COMPANY.tollFreeE164}`} class="text-[var(--color-ink)] font-semibold no-underline hover:underline">{COMPANY.tollFree}</a>.</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-wide max-w-3xl pb-16 lg:pb-20">
      <div class="border-t-2 border-[var(--color-ink)] pt-8">
        <p class="eyebrow">What happens next</p>
        <h2 class="mt-3" style="font-size: var(--text-h2); font-weight: 700;">Here's what to expect.</h2>
      </div>
      <ol class="mt-8 list-none m-0 p-0">
        {nextSteps.map((s) => (
          <li class="grid grid-cols-[3rem_1fr] gap-4 py-5 border-b border-black/15">
            <span class="font-mono text-sm text-[var(--color-text-muted)] pt-0.5">{s.step}</span>
            <div>
              <h3 class="font-semibold text-[var(--color-ink)]" style="font-size: 1.0625rem;">{s.heading}</h3>
              <p class="mt-1 text-[var(--color-text)] leading-relaxed">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-[var(--color-ink)] text-white">
    <div class="container-wide py-16 lg:py-20">
      <p class="eyebrow !text-white/55">While you wait</p>
      <h2 class="mt-3 !text-white" style="font-size: var(--text-h2); font-weight: 700;">Learn more about your options.</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {readMore.map((item) => (
          <a href={item.href} class="group rounded-2xl border-2 border-white/40 hover:border-white p-6 no-underline flex flex-col gap-2 transition-colors">
            <h3 class="font-semibold !text-white" style="font-size: 1.0625rem;">{item.label}</h3>
            <p class="text-sm text-white/70">{item.desc}</p>
            <span class="text-sm font-semibold text-white mt-auto pt-2">Read more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
