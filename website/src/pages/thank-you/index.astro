---
import Layout from "../../layouts/Layout.astro";
import { COMPANY } from "../../data/company";
---

<Layout
  title="We Got Your Message | Cliffco Mortgage Bankers"
  description="Thank you for reaching out to Cliffco. A loan officer will be in touch within one business day."
  noindex={true}
>
  <section class="accent-gradient">
    <div class="container-wide py-20 lg:py-28 text-center">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-white/20 mb-6">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </div>
      <h1 class="text-white" style="font-size: var(--text-display-xl); line-height: 1.1; font-weight: 700; font-family: var(--font-sans);">
        We Got It.
      </h1>
      <p class="lead mt-5 text-white/90 max-w-xl mx-auto">
        A Cliffco loan officer will review your information and reach out within one business day.
      </p>
      <p class="mt-3 text-white/70 text-sm">Can't wait? Call us directly at <a href={`tel:${COMPANY.tollFreeE164}`} class="text-white font-semibold no-underline hover:underline">{COMPANY.tollFree}</a>.</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">What happens next</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Here's what to expect.</h2>
      <div class="mt-8 space-y-6">
        {[
          {
            step: "01",
            heading: "Your loan officer reviews your submission",
            body: "A licensed Cliffco loan officer (a real person, not a bot) reads your information and identifies which programs fit your situation.",
          },
          {
            step: "02",
            heading: "You hear from us within one business day",
            body: "We'll call or email depending on your preference. The goal is to give you an honest assessment: what programs are available, what the approximate rate looks like, and what you'd need to move forward.",
          },
          {
            step: "03",
            heading: "No pressure, no commitment",
            body: "This first conversation is informational. We don't pull your credit until you explicitly authorize it. You can decide whether to proceed on your own timeline.",
          },
        ].map((s) => (
          <div class="flex gap-5 items-start">
            <span class="text-3xl font-bold text-[var(--color-accent)] opacity-30 shrink-0 w-10 text-right">{s.step}</span>
            <div>
              <h3 class="font-semibold text-[var(--color-ink)]">{s.heading}</h3>
              <p class="mt-1 text-[var(--color-text)] leading-relaxed">{s.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-mist-gray)]">
    <div class="container-wide">
      <p class="eyebrow">While you wait</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Learn more about your options.</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { label: "I'm Self-Employed", href: "/self-employed-mortgage/", desc: "How bank statement loans work and what you'd need to qualify." },
          { label: "I'm a Real Estate Investor", href: "/real-estate-investor-mortgage/", desc: "DSCR loans: qualifying on cash flow, not salary." },
          { label: "I Was Denied Elsewhere", href: "/denied-mortgage/", desc: "Non-QM programs built for exactly your situation." },
          { label: "I'm 62 or Older", href: "/reverse-mortgage/", desc: "Access your equity without selling or making monthly payments." },
          { label: "Our Process", href: "/process/", desc: "Step-by-step: from first call to closing day." },
          { label: "Mortgage Calculators", href: "/mortgage-guides/calculators/", desc: "Estimate your payment, DSCR ratio, or buying power." },
        ].map((item) => (
          <a href={item.href} class="card no-underline text-[var(--color-ink)] flex flex-col gap-2 hover:border-[var(--color-accent)] transition-colors">
            <h3 class="font-semibold">{item.label}</h3>
            <p class="text-sm text-[var(--color-text-muted)]">{item.desc}</p>
            <span class="text-sm font-semibold text-[var(--color-accent)] mt-auto pt-2">Read more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
