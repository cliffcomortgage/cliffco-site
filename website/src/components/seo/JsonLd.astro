---
/**
 * Renders one or more JSON-LD blocks. Accepts either a single object or an array.
 * Use the helpers in src/lib/schema.ts to generate the objects.
 */
type Props = { data: object | object[] };
const { data } = Astro.props;
const blocks = Array.isArray(data) ? data : [data];
---

{blocks.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
