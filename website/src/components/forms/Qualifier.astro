---
/**
 * Guided pre-approval qualifier. Renders a single flow's question steps
 * (from qualifier-flows.ts), one screen at a time, then a contact-intake step,
 * and submits every answer to /api/lead (HubSpot + SMTP2GO), routed to the
 * corporate inbox. Purely client-driven navigation; SSR-rendered panels.
 *
 * A right-hand "Pre-Approval Sections" panel lists every section up front
 * (including the goal-selection step the borrower already completed on the
 * prior page) so nothing about the flow is a surprise - per the black/white,
 * full-transparency direction for the site.
 */
import type { Flow } from "../../data/qualifier-flows";
import { STATE_LICENSES } from "../../data/state-licenses";
import { LOAN_OFFICERS } from "../../data/loan-officers";

interface Props {
  flow: Flow;
}
const { flow } = Astro.props;
const licensedStates = [...STATE_LICENSES].map((s) => s.name).sort();

const stateNameByCode = Object.fromEntries(STATE_LICENSES.map((s) => [s.code, s.name]));
// Compact LO directory for the client-side search step - name, nmls, title,
// and both the state codes and full names (so "ny" and "new york" both work).
const loDirectory = LOAN_OFFICERS.map((lo) => ({
  slug: lo.slug,
  name: lo.displayName,
  nmls: lo.nmls,
  title: lo.title,
  states: lo.states,
  stateNames: lo.states.map((c) => stateNameByCode[c] ?? c),
}));

// Total steps = question steps + contact step
const total = flow.steps.length + 1;
const contactIndex = flow.steps.length;

// Metadata the client script needs to build a readable lead summary
const qmeta = flow.steps.map((s) => ({
  id: s.id,
  title: s.title,
  labels: s.type === "lo-search" ? {} : Object.fromEntries(s.options.map((o) => [o.value, o.label])),
}));

// Sidebar sections: de-duplicated, in order, one entry per unique section
// label (has_lo + lo_search share "Loan Officer" so they collapse to one).
// "Goal Selection" is prepended for the flow-picker page the borrower
// already completed, and "Contact Info" appended for the final step.
const flowSections = flow.steps.filter((s, i) => i === 0 || s.section !== flow.steps[i - 1].section).map((s) => s.section);
const sections = ["Goal Selection", ...flowSections, "Contact Info"];

const cardBase =
  "q-card w-full text-left px-5 py-4 rounded-xl border-2 border-black/15 bg-white text-[var(--color-ink)] font-medium cursor-pointer transition-colors hover:border-[var(--color-ink)]";
const inputClass =
  "w-full rounded-lg border border-black/30 bg-white text-[var(--color-ink)] px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-ink)]";
---

<div class="q-wrap" data-flow={flow.key} data-flow-label={flow.label} data-total={total}>

  <!-- Top bar: back link, flow label, percent complete -->
  <div class="flex items-center justify-between gap-4 mb-3">
    <div class="flex items-center gap-4">
      <button id="q-back" type="button" hidden
        class="shrink-0 text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-ink)] cursor-pointer">
        ← Back
      </button>
      <span class="text-sm font-semibold text-[var(--color-ink)]">{flow.label}</span>
    </div>
    <span id="q-pct" class="shrink-0 text-sm text-[var(--color-text-muted)] tabular-nums">0% complete</span>
  </div>
  <div class="h-2 rounded-full bg-white border border-black overflow-hidden mb-10">
    <div id="q-bar" class="h-full bg-[var(--color-ink)] transition-[width] duration-300" style="width: 0%;"></div>
  </div>

  <div class="grid lg:grid-cols-[1fr_280px] gap-8 items-start">
    <!-- Main question panel -->
    <div class="q-panel bg-white border border-black/15 rounded-2xl p-6 sm:p-10">

      <!-- Question steps -->
      {flow.steps.map((s, i) => (
        <div class="q-step" data-index={i} data-qid={s.id} hidden={i !== 0}>
          <h2 class="mt-0" style="font-size: clamp(1.6rem, 2.8vw, 2.4rem); line-height: 1.15; font-weight: 700;">{s.title}</h2>
          {s.subtitle && <p class="mt-3 text-[var(--color-text-muted)]">{s.subtitle}</p>}

          {s.type === "cards" && (
            <div class={`mt-8 grid gap-3 ${s.cols === 2 ? "sm:grid-cols-2" : "sm:grid-cols-2"}`}>
              {s.options.map((o) => (
                <button type="button" class={cardBase} data-qid={s.id} data-value={o.value}>{o.label}</button>
              ))}
            </div>
          )}

          {s.type === "select" && (
            <div class="mt-8 max-w-sm">
              <select class={`q-select ${inputClass}`} data-qid={s.id}>
                <option value="">{s.placeholder}</option>
                {s.options.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
              <button type="button" class="q-continue btn btn-primary mt-6 disabled:opacity-50" disabled>Continue</button>
            </div>
          )}

          {s.type === "lo-search" && (
            <div class="mt-8">
              <input
                type="text"
                class={`q-lo-input ${inputClass}`}
                placeholder="Search by name or state (e.g. “Sarah” or “Texas”)"
                autocomplete="off"
              />
              <div class="q-lo-results mt-4 space-y-2" hidden></div>
              <p class="q-lo-empty mt-4 text-sm text-[var(--color-text-muted)] hidden">No match yet - try a different name or state.</p>
              <button type="button" class="q-lo-skip mt-6 text-sm font-semibold text-[var(--color-ink)] underline underline-offset-2">
                I don't know who yet - skip this
              </button>
            </div>
          )}
        </div>
      ))}

      <!-- Contact intake step -->
      <div class="q-step" data-index={contactIndex} data-contact hidden>
        <h2 class="mt-0" style="font-size: clamp(1.6rem, 2.8vw, 2.4rem); line-height: 1.15; font-weight: 700;">Almost there. Where should we send your results?</h2>
        <p class="mt-3 text-[var(--color-text-muted)]">A licensed Cliffco loan officer will review your answers and reach out within one business day. No bots, no call center.</p>

        <div id="q-form" class="mt-8 space-y-5">
          <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;">
            <label for="q-website">Website</label>
            <input id="q-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input id="q-loaded" name="_loaded" type="hidden" value="" />

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="q-fname" class="block text-xs font-medium text-[var(--color-text-muted)] mb-1">First name <span class="text-red-700">*</span></label>
              <input id="q-fname" name="first_name" type="text" required autocomplete="given-name" placeholder="Jane" class={inputClass} />
            </div>
            <div>
              <label for="q-lname" class="block text-xs font-medium text-[var(--color-text-muted)] mb-1">Last name <span class="text-red-700">*</span></label>
              <input id="q-lname" name="last_name" type="text" required autocomplete="family-name" placeholder="Smith" class={inputClass} />
            </div>
          </div>
          <div>
            <label for="q-email" class="block text-xs font-medium text-[var(--color-text-muted)] mb-1">Email <span class="text-red-700">*</span></label>
            <input id="q-email" name="email" type="email" required autocomplete="email" placeholder="jane@example.com" class={inputClass} />
          </div>
          <div>
            <label for="q-phone" class="block text-xs font-medium text-[var(--color-text-muted)] mb-1">Phone <span class="text-red-700">*</span></label>
            <input id="q-phone" name="phone" type="tel" required autocomplete="tel" placeholder="(555) 000-0000" class={inputClass} />
          </div>

          <div class="flex items-start gap-3">
            <input type="checkbox" id="q-tcpa" name="tcpa_consent" value="yes" required class="mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 accent-[var(--color-ink)]" />
            <label for="q-tcpa" class="text-xs leading-relaxed text-[var(--color-text-muted)]">
              By submitting this form I consent to be contacted by Cliffco, Inc. (NMLS #65328) regarding my inquiry via calls, texts, and emails, including via automated technology. Consent is not required to obtain credit. Reply STOP to opt out of texts.
            </label>
          </div>

          <p class="q-error hidden text-sm text-red-700 font-medium"></p>
          <button type="button" id="q-submit" class="btn btn-primary w-full disabled:opacity-60">See My Results</button>
        </div>
      </div>

      <!-- Screen-reader announcements for errors and success. Outside the steps so it stays
           in the accessibility tree when the steps are hidden on success. -->
      <p class="q-live sr-only" role="status" aria-live="polite"></p>

      <!-- Success -->
      <div class="q-success" hidden>
        <div class="w-12 h-12 rounded-full bg-white border-2 border-black flex items-center justify-center text-[var(--color-ink)]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
        </div>
        <h2 class="mt-5" style="font-size: clamp(1.6rem, 2.8vw, 2.4rem); line-height: 1.15; font-weight: 700;">Thank you. We've got your info.</h2>
        <p class="mt-3 text-[var(--color-text-muted)] max-w-lg">A licensed Cliffco loan officer will review your answers and reach out within one business day.</p>
        <a href="/" class="btn btn-secondary mt-8 inline-flex">Back to home</a>
      </div>
    </div>

    <!-- Sidebar: all sections, up front -->
    <aside class="space-y-4">
      <div class="border border-black/15 rounded-2xl p-5">
        <p class="font-mono text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)] mb-4">Pre-Approval Sections</p>
        <ul id="q-sections" class="space-y-1 list-none p-0 m-0">
          <li class="q-section-row q-section-done">
            <a href="/get-started/" class="flex items-center gap-3 py-1.5 no-underline text-[var(--color-ink)]">
              <span class="q-section-dot" aria-hidden="true">✓</span>
              <span class="text-sm font-medium">Goal Selection</span>
            </a>
          </li>
          {sections.slice(1).map((label) => (
            <li class="q-section-row" data-section={label}>
              <span class="flex items-center gap-3 py-1.5">
                <span class="q-section-dot" aria-hidden="true"></span>
                <span class="text-sm">{label}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="border border-black/15 rounded-2xl p-5">
        <p class="font-mono text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)] mb-2">Next up</p>
        <p id="q-next-title" class="text-sm font-semibold text-[var(--color-ink)]"></p>
        <p class="mt-2 text-xs text-[var(--color-text-muted)]">Takes about 2 minutes. No credit pull.</p>
      </div>
    </aside>
  </div>
</div>

<script define:vars={{ flowKey: flow.key, flowLabel: flow.label, qmeta, total, loDirectory }}>
  (() => {
    const wrap = document.querySelector(".q-wrap");
    if (!wrap) return;
    const steps = Array.from(wrap.querySelectorAll(".q-step"));
    const bar = wrap.querySelector("#q-bar");
    const pct = wrap.querySelector("#q-pct");
    const backBtn = wrap.querySelector("#q-back");
    const successEl = wrap.querySelector(".q-success");
    const loaded = wrap.querySelector("#q-loaded");
    const sectionRows = Array.from(wrap.querySelectorAll(".q-section-row[data-section]"));
    const nextTitleEl = wrap.querySelector("#q-next-title");
    if (loaded) loaded.value = String(Date.now());

    const answers = {};
    let current = 0;

    const track = (event, props = {}) =>
      window.posthog?.capture?.(event, { flow: flowKey, ...props });

    // The lo_search step only shows when the prior "has_lo" answer is Yes.
    function isSkipped(i) {
      const step = steps[i];
      return step && step.getAttribute("data-qid") === "lo_search" && answers.has_lo !== "Yes";
    }

    function show(i) {
      current = i;
      steps.forEach((s, idx) => (s.hidden = idx !== i));
      steps[i].querySelectorAll(".cf-reveal").forEach((el) => el.classList.add("cf-visible"));
      const p = Math.round(((i + 1) / total) * 100);
      if (bar) bar.style.width = p + "%";
      if (pct) pct.textContent = p + "% complete";
      if (backBtn) backBtn.hidden = i === 0;
      updateSidebar(i);
      // restore any prior selection on card steps
      const qid = steps[i].getAttribute("data-qid");
      if (qid && answers[qid]) {
        steps[i].querySelectorAll(".q-card").forEach((c) =>
          c.classList.toggle("q-card-active", c.getAttribute("data-value") === answers[qid])
        );
        const sel = steps[i].querySelector(".q-select");
        if (sel) { sel.value = answers[qid]; const cont = steps[i].querySelector(".q-continue"); if (cont) cont.disabled = false; }
      }
      const topRel = wrap.getBoundingClientRect().top;
      if (topRel < 0) window.scrollTo({ top: window.scrollY + topRel - 20, behavior: "smooth" });
    }

    function updateSidebar(i) {
      const step = steps[i];
      const isContact = step?.hasAttribute("data-contact");
      const label = isContact ? "Contact Info" : currentSectionLabel(i);
      sectionRows.forEach((row) => {
        const rowLabel = row.getAttribute("data-section");
        row.classList.remove("q-section-active", "q-section-done");
        const rowIndex = sectionRows.indexOf(row);
        const currentSectionIndex = sectionRows.findIndex((r) => r.getAttribute("data-section") === label);
        if (rowLabel === label) row.classList.add("q-section-active");
        else if (currentSectionIndex !== -1 && rowIndex < currentSectionIndex) row.classList.add("q-section-done");
      });
      if (nextTitleEl) nextTitleEl.textContent = label ?? "";
    }

    // The server already grouped sections for the sidebar; mirror that here
    // using the same section rows in document order (excluding Goal Selection).
    function currentSectionLabel(i) {
      // Distance-based fallback: find which section "bucket" index i belongs
      // to by walking steps in order and advancing the bucket pointer each
      // time the underlying qid's section changes. We reconstruct using the
      // data-qid -> section via qmeta order isn't section-aware, so instead
      // count qid transitions against the sectionRows list directly.
      let bucket = 0;
      let lastQid = null;
      for (let idx = 0; idx <= i; idx++) {
        const qid = steps[idx].getAttribute("data-qid");
        const contact = steps[idx].hasAttribute("data-contact");
        if (contact) { bucket = sectionRows.length - 1; break; }
        if (idx > 0 && qidSectionChanged(lastQid, qid)) bucket++;
        lastQid = qid;
      }
      return sectionRows[Math.min(bucket, sectionRows.length - 1)]?.getAttribute("data-section") ?? null;
    }
    // has_lo and lo_search share one section; every other consecutive pair of
    // steps is a new section (matches the server-side de-dup rule).
    function qidSectionChanged(prevQid, qid) {
      if (prevQid === "has_lo" && qid === "lo_search") return false;
      return true;
    }

    function next() {
      let n = current + 1;
      while (n < steps.length && isSkipped(n)) n++;
      if (n < steps.length) show(n);
    }

    // Card selection -> record + auto-advance
    wrap.querySelectorAll(".q-card").forEach((card) => {
      card.addEventListener("click", () => {
        const qid = card.getAttribute("data-qid");
        answers[qid] = card.getAttribute("data-value");
        // Changing "has_lo" away from Yes must drop any LO picked earlier,
        // or the lead would still route to them.
        if (qid === "has_lo" && answers.has_lo !== "Yes") {
          delete answers.lo_search;
          delete answers.lo_slug;
        }
        card.parentElement.querySelectorAll(".q-card").forEach((c) => c.classList.remove("q-card-active"));
        card.classList.add("q-card-active");
        track("qualifier_answer", { step: qid });
        setTimeout(next, 180);
      });
    });

    // Select dropdowns -> enable Continue, then advance
    wrap.querySelectorAll(".q-select").forEach((sel) => {
      const cont = sel.parentElement.querySelector(".q-continue");
      sel.addEventListener("change", () => { if (cont) cont.disabled = !sel.value; });
      if (cont) cont.addEventListener("click", () => {
        if (!sel.value) return;
        answers[sel.getAttribute("data-qid")] = sel.value;
        track("qualifier_answer", { step: sel.getAttribute("data-qid") });
        next();
      });
    });

    // Loan officer search step
    wrap.querySelectorAll(".q-step[data-qid='lo_search']").forEach((stepEl) => {
      const input = stepEl.querySelector(".q-lo-input");
      const results = stepEl.querySelector(".q-lo-results");
      const empty = stepEl.querySelector(".q-lo-empty");
      const skip = stepEl.querySelector(".q-lo-skip");

      function render(matches) {
        results.innerHTML = "";
        if (!matches.length) {
          results.hidden = true;
          empty.classList.toggle("hidden", input.value.trim().length === 0);
          return;
        }
        empty.classList.add("hidden");
        results.hidden = false;
        matches.slice(0, 20).forEach((lo) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "q-card w-full text-left px-5 py-3 rounded-xl border-2 border-black/15 bg-white cursor-pointer hover:border-[var(--color-ink)]";
          btn.innerHTML = `<span class="font-semibold text-[var(--color-ink)]">${lo.name}</span>` +
            `<span class="block text-xs text-[var(--color-text-muted)] mt-0.5">${lo.title} · NMLS #${lo.nmls}</span>` +
            `<span class="block text-xs text-[var(--color-text-muted)] mt-0.5">Licensed in ${lo.states.join(", ")}</span>`;
          btn.addEventListener("click", () => {
            answers.lo_search = `${lo.name} (NMLS #${lo.nmls})`;
            answers.lo_slug = lo.slug;
            stepEl.querySelectorAll(".q-card").forEach((c) => c.classList.remove("q-card-active"));
            btn.classList.add("q-card-active");
            track("qualifier_lo_selected", { lo: lo.slug });
            setTimeout(next, 220);
          });
          results.appendChild(btn);
        });
      }

      input?.addEventListener("input", () => {
        const q = input.value.trim().toLowerCase();
        if (!q) { render([]); return; }
        const stateMatches = loDirectory.filter((lo) =>
          lo.states.some((c) => c.toLowerCase() === q) ||
          lo.stateNames.some((n) => n.toLowerCase().includes(q))
        );
        render(stateMatches.length ? stateMatches : loDirectory.filter((lo) => lo.name.toLowerCase().includes(q)));
      });

      skip?.addEventListener("click", () => {
        answers.lo_search = "Not found / skipped";
        delete answers.lo_slug;
        track("qualifier_lo_skip");
        next();
      });
    });

    if (backBtn) backBtn.addEventListener("click", () => {
      let p = current - 1;
      while (p >= 0 && isSkipped(p)) p--;
      if (p >= 0) show(p);
    });

    // Build a readable summary of all answers for the lead notes
    function summary() {
      const lines = [];
      for (const q of qmeta) {
        if (q.id === "state") continue; // sent as its own field
        if (q.id === "has_lo" || q.id === "lo_search") continue; // handled below
        const v = answers[q.id];
        if (v) lines.push(`${q.title} ${q.labels[v] ?? v}`);
      }
      if (answers.has_lo === "Yes") {
        lines.unshift(`Already working with: ${answers.lo_search ?? "Not specified"}`);
      } else if (answers.has_lo === "No") {
        lines.unshift("Not currently working with a Cliffco loan officer.");
      }
      return lines.join("\n");
    }

    // Contact submit
    // Not a <form>/submit — a button click — so HubSpot's collected-forms
    // script can't auto-capture it as a duplicate. We post via the API below.
    const form = wrap.querySelector("#q-form");
    const submitBtn = wrap.querySelector("#q-submit");
    const liveEl = wrap.querySelector(".q-live");
    const announce = (msg) => { if (!liveEl) return; liveEl.textContent = ""; setTimeout(() => { liveEl.textContent = msg; }, 50); };
    async function submitForm() {
      const errEl = form.querySelector(".q-error");
      const btn = submitBtn;
      const first = form.querySelector("#q-fname").value.trim();
      const last = form.querySelector("#q-lname").value.trim();
      const email = form.querySelector("#q-email").value.trim();
      const phone = form.querySelector("#q-phone").value.trim();
      const tcpa = form.querySelector("#q-tcpa").checked;
      errEl.classList.add("hidden");

      // Name the missing fields and move focus to the first one
      const missing = [["q-fname", "first name", first], ["q-lname", "last name", last], ["q-email", "email", email], ["q-phone", "phone", phone]]
        .filter((m) => !m[2]);
      if (missing.length || !tcpa) {
        const names = missing.map((m) => m[1]);
        const list = names.length < 3 ? names.join(" and ") : names.slice(0, -1).join(", ") + ", and " + names[names.length - 1];
        errEl.textContent = names.length
          ? "Please add your " + list + (tcpa ? "." : ", and check the box agreeing to be contacted.")
          : "Please check the box agreeing to be contacted.";
        errEl.classList.remove("hidden");
        announce(errEl.textContent);
        form.querySelector("#" + (missing.length ? missing[0][0] : "q-tcpa")).focus();
        return;
      }

      const fd = new FormData();
      fd.set("name", `${first} ${last}`);
      fd.set("email", email);
      fd.set("phone", phone);
      fd.set("tcpa_consent", "yes");
      fd.set("form_to", "websiteleads@cliffcomortgage.com,cliffcorpteam@cliffcomortgage.com");
      fd.set("form_source", `qualifier-${flowKey}`);
      fd.set("program", flowLabel);
      if (answers.state) fd.set("state", answers.state);
      if (answers.income_type) fd.set("income_type", answers.income_type);
      if (answers.credit_range) fd.set("credit_range", answers.credit_range);
      if (answers.purpose) fd.set("purpose", answers.purpose);
      if (answers.has_lo === "Yes" && answers.lo_slug) fd.set("lo_slug", answers.lo_slug);
      fd.set("notes", summary());
      fd.set("website", form.querySelector("#q-website").value.trim());
      fd.set("_loaded", loaded ? loaded.value : "");
      fd.set("page_uri", window.location.href);
      const hutk = document.cookie.match(/(?:^|; )hubspotutk=([^;]*)/);
      if (hutk) fd.set("hutk", hutk[1]);

      btn.disabled = true;
      btn.textContent = "Sending…";
      try {
        const res = await fetch("/api/lead/", { method: "POST", body: fd });
        const json = await res.json();
        if (res.ok && json.success) {
          track("qualifier_submitted");
          if (window.cliffcoTrack) window.cliffcoTrack.lead({ source: "qualifier-" + flowKey, product: flowLabel, email: email, phone: phone });
          steps.forEach((s) => (s.hidden = true));
          if (bar) bar.style.width = "100%";
          if (pct) pct.textContent = "100% complete";
          if (backBtn) backBtn.hidden = true;
          if (successEl) { successEl.hidden = false; announce(successEl.innerText.trim().split("\n")[0]); }
          window.scrollTo({ top: wrap.getBoundingClientRect().top + window.scrollY - 90, behavior: "smooth" });
        } else {
          errEl.textContent = json.error ?? "Something went wrong. Please try again or call (800) 834-4040.";
          errEl.classList.remove("hidden");
          announce(errEl.textContent);
          btn.disabled = false;
          btn.textContent = "See My Results";
        }
      } catch {
        errEl.textContent = "Network error. Check your connection and try again, or call (800) 834-4040.";
        errEl.classList.remove("hidden");
        announce(errEl.textContent);
        btn.disabled = false;
        btn.textContent = "See My Results";
      }
    }
    submitBtn?.addEventListener("click", submitForm);
    form?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && e.target && e.target.tagName === "INPUT") { e.preventDefault(); submitForm(); }
    });

    show(0);
    track("qualifier_started");
  })();
</script>

