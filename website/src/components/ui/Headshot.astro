---
/**
 * Loan-officer headshot - AVIF → WebP → JPEG fallback, square crop.
 * Use `priority` for an LCP-eligible photo (hero / above-fold);
 * defaults to lazy loading otherwise.
 *
 * Source images live in /public/team/{slug}.{avif,webp,jpg}, generated by
 * scripts/import-headshots.mjs from OneDrive headshots.
 */
interface Props {
  slug: string;
  name: string;
  /** "rounded" (default) or "square" */
  shape?: "rounded" | "square" | "circle";
  /** Pixel size - defaults to 320px display. Ignored when fluid=true. */
  size?: number;
  priority?: boolean;
  /** When true, fills 100% of parent width (use inside an aspect-square wrapper) */
  fluid?: boolean;
  /** Tailwind class overrides */
  class?: string;
}
const { slug, name, shape = "rounded", size = 320, priority = false, fluid = false, class: className = "" } = Astro.props;
const radius = shape === "circle" ? "rounded-full" : shape === "rounded" ? "rounded-lg" : "";
const loading = priority ? "eager" : "lazy";
const fetchpriority = priority ? "high" : "auto";
const sizeStyle = fluid ? "aspect-ratio: 1 / 1; width: 100%;" : `aspect-ratio: 1 / 1; width: ${size}px;`;
---

<picture class={`block overflow-hidden ${radius} ${className}`} style={sizeStyle}>
  <source srcset={`/team/${slug}.avif`} type="image/avif" />
  <source srcset={`/team/${slug}.webp`} type="image/webp" />
  <img
    src={`/team/${slug}.jpg`}
    alt={`${name} - Cliffco Mortgage Bankers`}
    width={size}
    height={size}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding={priority ? "sync" : "async"}
    class="w-full h-full object-cover block"
  />
</picture>
