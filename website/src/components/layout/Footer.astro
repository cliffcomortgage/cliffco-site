---
import { COMPANY } from "../../data/company";
import { FOOTER_MAIN_DISCLOSURE, FOOTER_TEXAS_DISCLOSURE } from "../../data/disclosures";

const year = new Date().getFullYear();
const yearsInBiz = year - COMPANY.founded;
---

<footer class="bg-[var(--color-rich-black)] text-white pt-16 pb-8">
  <div class="container-wide grid gap-x-8 gap-y-10 grid-cols-2 md:grid-cols-3 xl:grid-cols-[1.6fr_1fr_1fr_1fr_1fr_1fr]">

    <!-- Brand -->
    <div class="col-span-2 md:col-span-3 xl:col-span-1">
      <p class="font-[var(--font-logo)] font-semibold tracking-[0.18em] text-base">{COMPANY.legalName.toUpperCase()}</p>
      <p class="mt-3 text-sm text-white/70 leading-relaxed">
        {yearsInBiz} years getting families home. NMLS #{COMPANY.nmls}.
      </p>
      <address class="mt-4 not-italic text-sm text-white/80 leading-relaxed">
        {COMPANY.hq.street}<br/>
        {COMPANY.hq.city}, {COMPANY.hq.region} {COMPANY.hq.postalCode}<br/>
        <a href={`tel:${COMPANY.tollFreeE164}`} class="text-white/90 no-underline hover:underline">{COMPANY.tollFree}</a><br/>
        <a href={`tel:${COMPANY.hq.phoneE164}`} class="text-white/70 no-underline hover:underline">{COMPANY.hq.phone}</a>
      </address>
      <div class="mt-4 flex gap-3">
        <a href={COMPANY.socials.linkedin} class="text-white/70 hover:text-white no-underline" rel="noopener" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href={COMPANY.socials.facebook} class="text-white/70 hover:text-white no-underline" rel="noopener" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href={COMPANY.socials.instagram} class="text-white/70 hover:text-white no-underline" rel="noopener" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
          </svg>
        </a>
      </div>
      <a
        href="https://portal.willowservicing.com"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-block text-xs font-semibold border border-white/30 text-white/80 hover:border-white hover:text-white no-underline rounded px-3 py-1.5 transition-colors"
      >
        Make First Payment ↗
      </a>
    </div>

    <!-- Who We Serve -->
    <div>
      <p class="eyebrow text-white/70 mb-3">Who We Serve</p>
      <ul class="m-0 p-0 list-none space-y-2">
        <li><a href="/self-employed-mortgage/" class="text-sm text-white/80 hover:text-white no-underline">I'm Self-Employed</a></li>
        <li><a href="/real-estate-investor-mortgage/" class="text-sm text-white/80 hover:text-white no-underline">I'm a Real Estate Investor</a></li>
        <li><a href="/reverse-mortgage/" class="text-sm text-white/80 hover:text-white no-underline">I'm 62 or Older</a></li>
        <li><a href="/denied-mortgage/" class="text-sm text-white/80 hover:text-white no-underline">I Was Denied Elsewhere</a></li>
        <li><a href="/first-time-homebuyer/" class="text-sm text-white/80 hover:text-white no-underline">I'm Buying My First Home</a></li>
      </ul>
    </div>

    <!-- Loan Programs -->
    <div>
      <p class="eyebrow text-white/70 mb-3">Loan Programs</p>
      <ul class="m-0 p-0 list-none space-y-2">
        <li><a href="/loans/business-bank-statement/" class="text-sm text-white/80 hover:text-white no-underline">Bank Statement Loans</a></li>
        <li><a href="/loans/dscr/" class="text-sm text-white/80 hover:text-white no-underline">DSCR Loans</a></li>
        <li><a href="/loans/reverse-mortgage/" class="text-sm text-white/80 hover:text-white no-underline">Reverse Mortgage</a></li>
        <li><a href="/loans/non-qm-self-employed/" class="text-sm text-white/80 hover:text-white no-underline">Non-QM Loans</a></li>
        <li><a href="/loans/" class="text-sm text-white/80 hover:text-white no-underline">Conventional / FHA / VA</a></li>
        <li><a href="/loans/refinancing/" class="text-sm text-white/80 hover:text-white no-underline">Refinancing</a></li>
        <li><a href="/mortgage-rates/" class="text-sm text-white/80 hover:text-white no-underline">Mortgage Rates</a></li>
      </ul>
    </div>

    <!-- Tools & Resources -->
    <div>
      <p class="eyebrow text-white/70 mb-3">Tools & Resources</p>
      <ul class="m-0 p-0 list-none space-y-2">
        <li><a href="/mortgage-guides/calculators/" class="text-sm text-white/80 hover:text-white no-underline">Calculators</a></li>
        <li><a href="/mortgage-guides/calculators/dscr/" class="text-sm text-white/80 hover:text-white no-underline">DSCR Calculator</a></li>
        <li><a href="/mortgage-guides/blog/" class="text-sm text-white/80 hover:text-white no-underline">Blog</a></li>
        <li><a href="/mortgage-guides/glossary/" class="text-sm text-white/80 hover:text-white no-underline">Mortgage Glossary</a></li>
      </ul>
    </div>

    <!-- Company -->
    <div>
      <p class="eyebrow text-white/70 mb-3">Company</p>
      <ul class="m-0 p-0 list-none space-y-2">
        <li><a href="/about/" class="text-sm text-white/80 hover:text-white no-underline">About Cliffco</a></li>
        <li><a href="/why-cliffco/" class="text-sm text-white/80 hover:text-white no-underline">Why Cliffco</a></li>
        <li><a href="/process/" class="text-sm text-white/80 hover:text-white no-underline">Our Process</a></li>
        <li><a href="/loan-officers/" class="text-sm text-white/80 hover:text-white no-underline">Loan Officers</a></li>
        <li><a href="/reviews/" class="text-sm text-white/80 hover:text-white no-underline">Reviews</a></li>
        <li><a href="/locations/" class="text-sm text-white/80 hover:text-white no-underline">Our Locations</a></li>
        <li><a href="/careers/" class="text-sm text-white/80 hover:text-white no-underline">Careers</a></li>
        <li><a href="/contact/" class="text-sm text-white/80 hover:text-white no-underline">Contact</a></li>
      </ul>
    </div>

    <!-- Legal -->
    <div>
      <p class="eyebrow text-white/70 mb-3">Legal</p>
      <ul class="m-0 p-0 list-none space-y-2">
        <li><a href="/licensing/" class="text-sm text-white/80 hover:text-white no-underline">State Licensing</a></li>
        <li><a href={COMPANY.nmlsConsumerAccessUrl} class="text-sm text-white/80 hover:text-white no-underline" target="_blank" rel="noopener noreferrer">NMLS Consumer Access</a></li>
        <li><a href="/legal/privacy/" class="text-sm text-white/80 hover:text-white no-underline">Privacy Policy</a></li>
        <li><a href="/legal/ccpa/" class="text-sm text-white/80 hover:text-white no-underline">CCPA</a></li>
        <li><a href="/legal/sms-consent/" class="text-sm text-white/80 hover:text-white no-underline">SMS Consent</a></li>
        <li><a href="/legal/accessibility/" class="text-sm text-white/80 hover:text-white no-underline">Accessibility</a></li>
        <li><a href="/legal/texas-complaints/" class="text-sm text-white/80 hover:text-white no-underline">Texas Complaints</a></li>
      </ul>
    </div>

  </div>

  <hr class="my-12 border-white/10" />

  <div class="container-wide grid gap-6 lg:grid-cols-[auto_1fr] items-start">
    <div class="flex items-center gap-3 text-white/70 text-xs">
      <span role="img" class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-white/30" aria-label="Equal Housing Lender">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><path d="M3 11l9-8 9 8v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V11z"/><path d="M2 11l10-8.5L22 11"/></svg>
      </span>
      <span class="leading-tight">Equal Housing<br/>Lender</span>
    </div>

    <div class="text-xs text-white/60 leading-relaxed">
      <p>{FOOTER_MAIN_DISCLOSURE}</p>
      <p class="mt-3">{FOOTER_TEXAS_DISCLOSURE}</p>
      <p class="mt-3 text-white/50">© {year} {COMPANY.legalName}. All rights reserved. Cliffco operates in Florida as Swish Capital, Inc.</p>
    </div>
  </div>
</footer>
