---
import JsonLd from "../seo/JsonLd.astro";
import { breadcrumbSchema } from "../../lib/schema";

interface Props {
  trail: { name: string; href: string }[];
}
const { trail } = Astro.props;
const schema = breadcrumbSchema(trail.map((t) => ({ name: t.name, url: t.href })));
---

<JsonLd data={schema} />
