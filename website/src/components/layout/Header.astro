---
import { Image } from "astro:assets";
import { COMPANY } from "../../data/company";
import logoBlack from "../../assets/logo-black.png";
---

<header class="border-b border-[var(--color-mist-gray)] bg-white sticky top-0 z-40">
  <div class="container-wide flex items-center justify-between gap-6 py-4">
    <a href="/" class="flex items-center no-underline" aria-label={`${COMPANY.legalName} home`}>
      <Image src={logoBlack} alt={COMPANY.legalName} class="h-[30px] w-auto" widths={[153, 306, 459, 612]} sizes="153px" />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-7 m-0 p-0 list-none">

        <li class="relative group">
          <button type="button" class="font-medium text-[var(--color-ink)] py-2 cursor-pointer" aria-haspopup="true">
            Who We Help
            <span aria-hidden="true" class="ml-1 text-xs">▾</span>
          </button>
          <div class="absolute left-0 top-full pt-2 hidden group-hover:block group-focus-within:block">
            <div class="bg-white border border-[var(--color-mist-gray)] rounded-lg shadow-xl p-4 min-w-[240px]">
              <ul class="m-0 p-0 list-none space-y-1">
                <li><a href="/self-employed-mortgage/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-1">I'm Self-Employed</a></li>
                <li><a href="/real-estate-investor-mortgage/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-1">I'm a Real Estate Investor</a></li>
                <li><a href="/reverse-mortgage/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-1">I'm 62 or Older</a></li>
                <li><a href="/denied-mortgage/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-1">I Was Denied Elsewhere</a></li>
                <li><a href="/first-time-homebuyer/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-1">I'm Buying My First Home</a></li>
              </ul>
            </div>
          </div>
        </li>

        <li class="relative group">
          <button type="button" class="font-medium text-[var(--color-ink)] py-2 cursor-pointer" aria-haspopup="true">
            Loan Programs
            <span aria-hidden="true" class="ml-1 text-xs">▾</span>
          </button>
          <div class="absolute left-0 top-full pt-2 hidden group-hover:block group-focus-within:block">
            <div class="bg-white border border-[var(--color-mist-gray)] rounded-lg shadow-xl p-4 min-w-[220px]">
              <ul class="m-0 p-0 list-none space-y-1">
                <li><a href="/loans/business-bank-statement/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-1">Bank Statement Loans</a></li>
                <li><a href="/loans/dscr/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-1">DSCR Loans</a></li>
                <li><a href="/loans/reverse-mortgage/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-1">Reverse Mortgage</a></li>
                <li><a href="/loans/non-qm-self-employed/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-1">Non-QM Loans</a></li>
                <li><a href="/loans/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-1">Conventional / FHA / VA</a></li>
                <li><a href="/loans/refinancing/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-1">Refinancing</a></li>
              </ul>
            </div>
          </div>
        </li>

        <li class="relative group">
          <button type="button" class="font-medium text-[var(--color-ink)] py-2 cursor-pointer" aria-haspopup="true">
            Learning Center
            <span aria-hidden="true" class="ml-1 text-xs">▾</span>
          </button>
          <div class="absolute left-0 top-full pt-2 hidden group-hover:block group-focus-within:block">
            <div class="bg-white border border-[var(--color-mist-gray)] rounded-lg shadow-xl p-4 min-w-[200px]">
              <ul class="m-0 p-0 list-none space-y-1">
                <li><a href="/mortgage-guides/blog/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-0.5">Blog</a></li>
                <li><a href="/mortgage-guides/calculators/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-0.5">Calculators</a></li>
                <li><a href="/mortgage-guides/glossary/" class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)] block py-0.5">Mortgage Glossary</a></li>
              </ul>
            </div>
          </div>
        </li>

        <li><a href="/about/" class="font-medium no-underline text-[var(--color-ink)]">About</a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <!-- Phone text: tablet and up -->
      <a href={`tel:${COMPANY.tollFreeE164}`} class="hidden md:inline text-sm font-medium text-[var(--color-ink)] no-underline">
        {COMPANY.tollFree}
      </a>
      <!-- Phone icon: mobile only -->
      <a href={`tel:${COMPANY.tollFreeE164}`} class="md:hidden p-2 text-[var(--color-ink)]" aria-label={`Call ${COMPANY.tollFree}`}>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
      </a>
      <a href="/get-started/" class="btn btn-primary text-sm">Apply Now</a>
    </div>
  </div>
</header>
