---
import { Image } from "astro:assets";
import { COMPANY } from "../../data/company";
import { priorityProducts, PRODUCTS } from "../../data/products";
import { LOCATIONS } from "../../data/locations";
import logoBlack from "../../assets/logo-black.png";

const products = priorityProducts();
const supporting = PRODUCTS.filter((p) => !p.isPriority);
const featuredLocations = LOCATIONS.filter((l) =>
  ["new-york/long-island", "florida/orlando", "new-jersey", "arizona", "minnesota"].includes(l.path),
);
---

<header class="border-b border-[var(--color-mist-gray)] bg-white sticky top-0 z-40">
  <div class="container-wide flex items-center justify-between gap-6 py-4">
    <a href="/" class="flex items-center no-underline" aria-label={`${COMPANY.legalName} home`}>
      <Image src={logoBlack} alt={COMPANY.legalName} class="h-10 w-auto" height={40} width={153} />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-7 m-0 p-0 list-none">
        <li class="relative group">
          <button type="button" class="font-medium text-[var(--color-ink)] py-2 cursor-pointer" aria-haspopup="true">
            Loans
            <span aria-hidden="true" class="ml-1 text-xs">▾</span>
          </button>
          <div class="absolute left-0 top-full pt-2 hidden group-hover:block group-focus-within:block">
            <div class="bg-white border border-[var(--color-mist-gray)] rounded-lg shadow-xl p-4 grid grid-cols-2 gap-x-6 gap-y-1 min-w-[480px]">
              <div>
                <p class="eyebrow mb-2">Priority Products</p>
                <ul class="m-0 p-0 list-none space-y-1">
                  {products.map((p) => (
                    <li><a href={`/loans/${p.slug}/`} class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)]">{p.shortName}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="eyebrow mb-2">Other Loans</p>
                <ul class="m-0 p-0 list-none space-y-1">
                  {supporting.map((p) => (
                    <li><a href={`/loans/${p.slug}/`} class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)]">{p.shortName}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </li>

        <li class="relative group">
          <button type="button" class="font-medium text-[var(--color-ink)] py-2 cursor-pointer" aria-haspopup="true">
            Locations
            <span aria-hidden="true" class="ml-1 text-xs">▾</span>
          </button>
          <div class="absolute left-0 top-full pt-2 hidden group-hover:block group-focus-within:block">
            <div class="bg-white border border-[var(--color-mist-gray)] rounded-lg shadow-xl p-4 min-w-[280px]">
              <ul class="m-0 p-0 list-none space-y-1">
                {featuredLocations.map((l) => (
                  <li><a href={`/locations/${l.path}/`} class="text-sm no-underline text-[var(--color-ink)] hover:text-[var(--color-accent)]">{l.name}</a></li>
                ))}
                <li class="pt-2 mt-2 border-t border-[var(--color-mist-gray)]">
                  <a href="/locations/" class="text-xs uppercase tracking-wider no-underline text-[var(--color-accent)]">All locations →</a>
                </li>
              </ul>
            </div>
          </div>
        </li>

        <li><a href="/learn/" class="font-medium no-underline text-[var(--color-ink)]">Learn</a></li>
        <li><a href="/about/" class="font-medium no-underline text-[var(--color-ink)]">About</a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={`tel:${COMPANY.hq.phoneE164}`} class="hidden md:inline text-sm font-medium text-[var(--color-ink)] no-underline">
        {COMPANY.hq.phone}
      </a>
      <a href="/get-started/" class="btn btn-primary text-sm">Get Started</a>
    </div>
  </div>
</header>
