---
/**
 * Blog article body, editorial layout: a narrow reading column with a drop cap
 * on the opening paragraph, and a "talk to a loan officer" box pinned in the
 * right margin. On phones the box drops below the article.
 */
import { COMPANY } from "../../data/company";
---

<article class="bg-white">
  <div class="container-wide py-14 lg:py-20 grid lg:grid-cols-12 gap-12">
    <div class="article-prose container-prose lg:col-span-7 lg:col-start-2">
      <slot />
    </div>
    <aside class="lg:col-span-3 lg:col-start-10 lg:sticky lg:top-28 self-start">
      <div class="rounded-2xl bg-[var(--color-ink)] text-white p-6">
        <p class="eyebrow !text-white/55">Talk to a loan officer</p>
        <p class="mt-3 text-sm text-white/85 leading-relaxed">
          Every situation is different. A licensed Cliffco loan officer can tell you where you stand, usually in one conversation.
        </p>
        <div class="mt-5 flex flex-col gap-2">
          <a href="/get-started/" class="btn btn-primary !bg-white !text-[var(--color-ink)] hover:!bg-white/85 text-sm">Get Started</a>
          <a href={`tel:${COMPANY.tollFreeE164}`} class="btn btn-secondary !border-white !text-white text-sm">{COMPANY.tollFree}</a>
        </div>
      </div>
      <a href="/mortgage-guides/blog/" class="mt-6 inline-block text-sm font-semibold text-[var(--color-ink)]">← All articles</a>
    </aside>
  </div>
</article>

<style>
  .article-prose {
    max-width: 68ch;
    margin-inline: auto;
    padding-inline: 0;
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .article-prose > :global(h2) {
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  /* Drop cap on the opening paragraph (after the bold kicker line, when there is one). */
  .article-prose > :global(p:first-child:not(.font-bold):not(.lead))::first-letter,
  .article-prose > :global(p.font-bold:first-child + p)::first-letter {
    float: left;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 4.25em;
    line-height: 0.82;
    margin: 0.06em 0.1em 0 0;
    color: var(--color-ink);
  }
  /* Embedded calculators: undo the prose spacing on their own headings. */
  .article-prose > div :global(h2) { margin-top: 0.25rem; margin-bottom: 0; }
  .article-prose > div :global(p.eyebrow) { margin-top: 0; }
</style>
