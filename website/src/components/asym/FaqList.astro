---
/** Black-ruled FAQ accordion for the asymmetric layout. */
interface Props {
  items: readonly { question: string; answer: string }[];
}
const { items } = Astro.props;
---

<div class="border-t border-[var(--color-ink)]">
  {items.map((q) => (
    <details class="group border-b border-black/15">
      <summary class="flex items-start justify-between gap-6 py-5 cursor-pointer list-none">
        <span class="font-semibold text-[var(--color-ink)] text-lg">{q.question}</span>
        <span class="font-mono text-lg leading-7 text-[var(--color-ink)] shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <p class="pb-6 -mt-1 text-[var(--color-text)] leading-relaxed">{q.answer}</p>
    </details>
  ))}
</div>
