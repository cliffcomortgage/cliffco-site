---
/**
 * Legal page layout ("plain document"): compact header with the last-updated
 * date, then a narrow reading column with numbered sections, and a small rail
 * linking the other legal pages. Default slot = the document body.
 */
interface Props {
  title: string;
  updated?: string;
}
const { title, updated } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, "/");
const legalPages = [
  { href: "/legal/privacy/", label: "Privacy Policy" },
  { href: "/legal/ccpa/", label: "CCPA" },
  { href: "/legal/sms-consent/", label: "SMS Consent" },
  { href: "/legal/accessibility/", label: "Accessibility" },
  { href: "/legal/texas-complaints/", label: "Texas Complaints" },
  { href: "/licensing/", label: "State Licensing" },
];
---

<section class="bg-white">
  <div class="container-wide pt-12 lg:pt-16 pb-8">
    <p class="eyebrow">Legal</p>
    <h1 class="mt-4 max-w-4xl text-[var(--color-ink)]" style="font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1.1; font-weight: 700; letter-spacing: -0.03em; font-family: var(--font-display);">{title}</h1>
    {updated && <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Last updated: {updated}</p>}
  </div>
  <div class="container-wide"><div class="h-px bg-[var(--color-ink)]"></div></div>
  <div class="container-wide py-10 lg:py-14 grid lg:grid-cols-12 gap-10">
    <article class="legal-doc container-prose lg:col-span-8">
      <slot />
    </article>
    <nav class="lg:col-span-3 lg:col-start-10 lg:sticky lg:top-28 self-start border-t-2 border-[var(--color-ink)] pt-4" aria-label="Legal pages">
      <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-ink)]">Legal</p>
      <ul class="mt-3 list-none m-0 p-0">
        {legalPages.map((l) => (
          <li>
            <a href={l.href} class={`block py-1.5 text-sm no-underline ${path === l.href ? "font-semibold text-[var(--color-ink)]" : "text-[var(--color-text-muted)] hover:text-[var(--color-ink)]"}`}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<style>
  .legal-doc {
    max-width: 72ch;
    margin-inline: 0;
    padding-inline: 0;
    line-height: 1.75;
    counter-reset: legal;
  }
  .legal-doc > :global(h2) {
    counter-increment: legal;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    padding-top: 1rem;
    border-top: 1px solid rgb(0 0 0 / 0.15);
  }
  .legal-doc > :global(h2)::before {
    content: counter(legal) ". ";
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .legal-doc :global(a) { color: var(--color-ink); text-decoration: underline; text-underline-offset: 2px; }
</style>
