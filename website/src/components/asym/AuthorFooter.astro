---
/**
 * Closing band for author posts: a black "written by" card with a square
 * headshot and bio on the left, the contact form on the right.
 */
import Headshot from "../ui/Headshot.astro";
import FormCard from "./FormCard.astro";
import type { LoanOfficer } from "../../data/loan-officers";

interface Props {
  author: LoanOfficer;
  bio: string;
  formTitle: string;
  formSub: string;
  formTo: string;
  formSource: string;
}
const { author, bio, formTitle, formSub, formTo, formSource } = Astro.props;
---

<section class="bg-[var(--color-ink)] text-white">
  <div class="container-wide py-16 lg:py-24 grid lg:grid-cols-12 gap-10 items-start">
    <div class="lg:col-span-5">
      <p class="eyebrow !text-white/55">Written by</p>
      <div class="mt-5 flex gap-5 items-start">
        {author.hasPhoto && (
          <div class="w-28 shrink-0 rounded-xl overflow-hidden border-2 border-white/20">
            <Headshot slug={author.slug} name={author.displayName} fluid shape="square" />
          </div>
        )}
        <div>
          <h2 class="!text-white" style="font-size: var(--text-h3); font-weight: 700;">{author.displayName}</h2>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/60 mt-1">{author.title} · NMLS #{author.nmls}</p>
        </div>
      </div>
      <p class="mt-6 text-white/80 leading-relaxed">{bio}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`/loan-officers/${author.slug}/`} class="btn btn-primary !bg-white !text-[var(--color-ink)] hover:!bg-white/85 text-sm">View {author.firstName.split(" ")[0]}'s profile</a>
        <a href="/the-fallarino-group/" class="btn btn-secondary !border-white !text-white text-sm">The Fallarino Group</a>
      </div>
    </div>
    <div class="lg:col-span-6 lg:col-start-7">
      <FormCard eyebrow={`Talk to ${author.firstName.split(" ")[0]}`} title={formTitle} sub={formSub} formTo={formTo} formSource={formSource} />
    </div>
  </div>
</section>
