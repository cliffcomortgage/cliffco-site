---
/**
 * Company-story header (About, Careers, Process — the "timeline" layout):
 * a wide statement headline, then the lead and actions offset to the right of
 * a short mono marker that sits where the timeline line will start below.
 * Default slot = h1 content. Slots: "lead", "actions", "note".
 */
interface Props {
  eyebrow: string;
  marker?: string;
  lead?: string;
}
const { eyebrow, marker, lead } = Astro.props;
---

<section class="bg-white">
  <div class="container-wide pt-12 lg:pt-20">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-5 max-w-5xl text-[var(--color-ink)]" style="font-size: clamp(2.25rem, 4.4vw, 3.75rem); line-height: 1.06; font-weight: 700; letter-spacing: -0.03em; font-family: var(--font-display);">
      <slot />
    </h1>
  </div>
  <div class="container-wide mt-10 lg:mt-14 grid grid-cols-[5.5rem_1fr] sm:grid-cols-[8rem_1fr] lg:grid-cols-[11rem_1fr]">
    <div class="pt-1 pr-4 text-right">
      {marker && <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-ink)]">{marker}</span>}
    </div>
    <div class="border-l-2 border-[var(--color-ink)] pl-6 sm:pl-10 pb-14 lg:pb-20">
      {lead && <p class="max-w-3xl text-[var(--color-text)]" style="font-size: 1.1875rem; line-height: 1.65;">{lead}</p>}
      <slot name="lead" />
      {Astro.slots.has("actions") && <div class="mt-8 flex flex-wrap gap-3"><slot name="actions" /></div>}
      {Astro.slots.has("note") && <p class="mt-4 text-sm text-[var(--color-text-muted)]"><slot name="note" /></p>}
    </div>
  </div>
</section>
