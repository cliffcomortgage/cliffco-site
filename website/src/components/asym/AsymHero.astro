---
/**
 * Asymmetric page hero (the Why Cliffco style): copy on the left, a black
 * panel bleeding off the right edge of the screen, offset lower than the
 * headline, holding either a photo (fills the panel) or a transparent
 * cutout (stands at the bottom of the panel). Optional black/white tag
 * overlaps the panel's left edge.
 *
 * `framed` shows a square photo (e.g. a headshot) standing inside the panel.
 * Without an image, pass `facts` and the panel shows them as large white
 * type instead (used by the loan program pages).
 *
 * Slots: default = h1 content, "actions" = buttons, "note" = small print.
 */
interface Props {
  eyebrow: string;
  lead?: string;
  image?: { src: string; alt?: string; cutout?: boolean; framed?: boolean; srcset?: string; position?: string };
  /** "md" = smaller h1 for long titles (blog articles). */
  size?: "lg" | "md";
  facts?: { label: string; value: string }[];
  tag?: { stat: string; label: string };
}
const { eyebrow, lead, image, facts, tag, size = "lg" } = Astro.props;
const h1Size = size === "md" ? "clamp(1.875rem, 3.3vw, 3.125rem)" : "clamp(2.25rem, 4.6vw, 4.25rem)";
const decorative = !image?.alt;
---

<section class="relative bg-white overflow-hidden">
  <div class="container-wide relative z-10 pt-10 pb-12 lg:pt-20 lg:pb-28 lg:min-h-[600px]">
    <div class="lg:w-[48%]">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-5 text-[var(--color-ink)]" style={`font-size: ${h1Size}; line-height: ${size === "md" ? 1.1 : 1.04}; font-weight: 700; letter-spacing: -0.03em; font-family: var(--font-display);`}>
        <slot />
      </h1>
      {lead && (
        <p class="mt-7 max-w-lg text-[var(--color-text-muted)]" style="font-size: 1.125rem; line-height: 1.6;">{lead}</p>
      )}
      {Astro.slots.has("actions") && (
        <div class="mt-9 flex flex-wrap gap-3 items-center"><slot name="actions" /></div>
      )}
      {Astro.slots.has("note") && (
        <p class="mt-4 text-sm text-[var(--color-text-muted)]"><slot name="note" /></p>
      )}
    </div>
  </div>

  <div class={`relative mx-6 mb-12 lg:m-0 lg:absolute lg:top-14 lg:bottom-0 lg:right-0 lg:w-[46vw] bg-[var(--color-ink)] rounded-2xl lg:rounded-none lg:rounded-tl-[2.5rem] ${!image ? "" : image.cutout || image.framed ? "h-[340px] lg:h-auto" : "aspect-[4/3] lg:aspect-auto"}`}>
    {!image ? (
      <dl class="relative px-7 py-9 sm:px-10 lg:absolute lg:inset-0 lg:pl-[12%] lg:pr-[10%] lg:py-14 flex flex-col justify-center gap-6 lg:gap-8">
        {facts?.map((f) => (
          <div class="border-t border-white/25 pt-4">
            <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-white/55">{f.label}</dt>
            <dd class="mt-2 text-white font-bold leading-tight" style="font-family: var(--font-display); font-size: clamp(1.375rem, 2.1vw, 2rem); letter-spacing: -0.02em;">{f.value}</dd>
          </div>
        ))}
      </dl>
    ) : image.framed ? (
      <img
        src={image.src}
        srcset={image.srcset}
        alt={image.alt ?? ""}
        aria-hidden={decorative ? "true" : undefined}
        class="absolute bottom-0 left-1/2 -translate-x-1/2 lg:translate-x-0 lg:left-[16%] h-[88%] aspect-square object-cover rounded-t-2xl"
        width="800" height="800"
        loading="eager"
        fetchpriority="high"
      />
    ) : image.cutout ? (
      <img
        src={image.src}
        alt={image.alt ?? ""}
        aria-hidden={decorative ? "true" : undefined}
        class="absolute bottom-0 left-1/2 -translate-x-1/2 lg:left-[44%] h-full w-auto max-w-none object-contain object-bottom pointer-events-none select-none"
        width="1080" height="1080"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <img
        src={image.src}
        srcset={image.srcset}
        sizes="(min-width: 1024px) 46vw, 100vw"
        alt={image.alt ?? ""}
        aria-hidden={decorative ? "true" : undefined}
        class="w-full h-full object-cover rounded-2xl lg:rounded-none lg:rounded-tl-[2.5rem]"
        style={image.position ? `object-position: ${image.position}` : undefined}
        loading="eager"
        fetchpriority="high"
      />
    )}
    {tag && (
      <div class="absolute left-4 -bottom-6 lg:-left-10 lg:bottom-16 bg-white text-[var(--color-ink)] border-2 border-[var(--color-ink)] px-6 py-5 rounded-xl shadow-xl">
        <p class="text-3xl font-bold leading-none" style="font-family: var(--font-display);">{tag.stat}</p>
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] mt-2">{tag.label}</p>
      </div>
    )}
  </div>
</section>
