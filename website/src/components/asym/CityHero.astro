---
/**
 * Location/branch header: the place name set enormous across the full width,
 * a short subtitle, then a mono "info strip" (address, phone, NMLS...).
 * The h1 = word + sub, so the page title still reads naturally for SEO.
 * Slots: "actions" = buttons, "note" = small print (e.g. the FL DBA line).
 */
interface Props {
  eyebrow: string;
  word: string;
  sub?: string;
  lead?: string;
  facts?: { label: string; value: string }[];
}
const { eyebrow, word, sub, lead, facts = [] } = Astro.props;
// Scale the word so long names (Ft. Lauderdale) still fit on one line.
const em = Math.max(word.length, 6) * 0.6;
const size = `min(11vw, 7.5rem, calc((min(100vw, 80rem) - 3rem) / ${em.toFixed(2)}))`;
const cols = facts.length >= 4 ? "md:grid-cols-4" : facts.length === 3 ? "md:grid-cols-3" : "md:grid-cols-2";
---

<section class="bg-white overflow-hidden">
  <div class="container-wide pt-12 lg:pt-16">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-4 text-[var(--color-ink)]" style="font-family: var(--font-display);">
      <span class="block font-extrabold" style={`font-size: ${size}; line-height: 0.9; letter-spacing: -0.05em;`}>{word}</span>
      {sub && <span class="block mt-6 lg:mt-8 font-semibold" style="font-size: clamp(1.25rem, 2vw, 1.75rem); letter-spacing: -0.01em;">{sub}</span>}
    </h1>
  </div>
  <div class="mt-8 border-y-2 border-[var(--color-ink)]">
    <div class="container-wide">
      {facts.length > 0 && (
        <dl class={`grid grid-cols-1 sm:grid-cols-2 ${cols}`}>
          {facts.map((f, i) => (
            <div class={`py-5 sm:pr-6 ${i > 0 ? "border-t sm:border-t-0 md:border-l border-black/20 md:pl-6" : ""}`}>
              <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">{f.label}</dt>
              <dd class="mt-1.5 font-semibold text-[var(--color-ink)]" style="font-size: 1.0625rem;">{f.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
  <div class="container-wide py-10 lg:py-12 grid lg:grid-cols-12 gap-8 items-center">
    {lead && <p class="lg:col-span-7 text-[var(--color-text-muted)]" style="font-size: 1.125rem; line-height: 1.6;">{lead}</p>}
    {Astro.slots.has("actions") && (
      <div class="lg:col-span-5 flex flex-wrap gap-3 lg:justify-end"><slot name="actions" /></div>
    )}
    {Astro.slots.has("note") && <p class="lg:col-span-12 text-sm text-[var(--color-text-muted)]"><slot name="note" /></p>}
  </div>
</section>
