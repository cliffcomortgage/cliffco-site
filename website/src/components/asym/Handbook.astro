---
/**
 * Long-form guide layout ("handbook"): compact header with a thick rule, a
 * sticky numbered table of contents built from the guide's <h2>s (highlights
 * the section in view), a black reading-progress bar, and chapters numbered
 * 01, 02, 03 in the reading column. Default slot = the guide body.
 */
import articleImages from "../../data/article-images.json";

interface Props {
  title: string;
  eyebrow?: string;
}
const { title, eyebrow = "Mortgage Guide" } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
let pathname = Astro.url.pathname;
if (base && pathname.startsWith(base)) pathname = pathname.slice(base.length);
if (!pathname.endsWith("/")) pathname += "/";
const images = articleImages as Record<string, { url: string; alt: string; objectPosition?: string }>;
const image = images[pathname];
---

<div class="hb-progress fixed top-0 left-0 h-[3px] bg-[var(--color-ink)] z-50 w-0" aria-hidden="true"></div>

<header class="bg-white">
  <div class="container-wide pt-12 lg:pt-16 pb-8">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-4 max-w-4xl text-[var(--color-ink)]" style="font-size: clamp(2.125rem, 4vw, 3.375rem); line-height: 1.08; font-weight: 700; letter-spacing: -0.03em; font-family: var(--font-display);">{title}</h1>
  </div>
  <div class="container-wide"><div class="h-1.5 bg-[var(--color-ink)]"></div></div>
</header>

<div class="bg-white">
  <div class="container-wide py-10 lg:py-14 grid lg:grid-cols-12 gap-10 lg:gap-12">
    <aside class="lg:col-span-3 lg:sticky lg:top-28 self-start">
      <details class="hb-mobile lg:hidden border-2 border-[var(--color-ink)] rounded-xl">
        <summary class="px-4 py-3 font-mono text-[11px] uppercase tracking-[0.14em] cursor-pointer list-none">Contents</summary>
        <ol class="hb-toc list-none m-0 px-4 pb-3"></ol>
      </details>
      <div class="hidden lg:block">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-ink)]">Contents</p>
        <ol class="hb-toc mt-4 list-none m-0 p-0 border-l-2 border-black/15"></ol>
        <div class="mt-8 rounded-2xl bg-[var(--color-ink)] text-white p-5">
          <p class="text-sm text-white/85 leading-relaxed">Questions about your situation? A licensed Cliffco loan officer can help.</p>
          <a href="/get-started/" class="mt-4 btn btn-primary !bg-white !text-[var(--color-ink)] hover:!bg-white/85 text-sm w-full justify-center">Get Started</a>
        </div>
      </div>
    </aside>

    <article class="hb-body container-prose lg:col-span-8 lg:col-start-5">
      {image && (
        <div class="mb-10 rounded-[1.5rem] overflow-hidden aspect-[16/9]">
          <img src={image.url} alt={image.alt} class="w-full h-full object-cover" style={image.objectPosition ? `object-position: ${image.objectPosition}` : undefined} loading="eager" fetchpriority="high" />
        </div>
      )}
      <slot />
    </article>
  </div>
</div>

<style>
  .hb-body {
    max-width: 70ch;
    margin-inline: 0;
    padding-inline: 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    counter-reset: hb;
  }
  .hb-body > :global(h2) {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.2;
    counter-increment: hb;
    scroll-margin-top: 6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    border-top: 2px solid var(--color-ink);
    padding-top: 1.25rem;
  }
  .hb-body > :global(h2)::before {
    content: counter(hb, decimal-leading-zero);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
  }
  .hb-toc :global(a) {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.25rem;
    padding: 0.4rem 0 0.4rem 0.875rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .hb-toc :global(a span) { font-family: var(--font-mono); font-size: 0.75rem; }
  .hb-toc :global(a:hover) { color: var(--color-ink); }
  .hb-toc :global(a.is-active) { color: var(--color-ink); font-weight: 600; border-left-color: var(--color-ink); }
</style>

<script>
  const body = document.querySelector<HTMLElement>(".hb-body");
  const tocs = document.querySelectorAll<HTMLOListElement>(".hb-toc");
  const bar = document.querySelector<HTMLElement>(".hb-progress");
  if (body) {
    const heads = [...body.querySelectorAll<HTMLHeadingElement>(":scope > h2")];
    const slug = (t: string) => t.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    heads.forEach((h, i) => {
      if (!h.id) h.id = slug(h.textContent ?? `section-${i + 1}`);
      tocs.forEach((toc) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `#${h.id}`;
        a.dataset.target = h.id;
        a.innerHTML = `<span>${String(i + 1).padStart(2, "0")}</span>`;
        a.append(document.createTextNode(h.textContent ?? ""));
        li.append(a);
        toc.append(li);
      });
    });
    const links = document.querySelectorAll<HTMLAnchorElement>(".hb-toc a");
    const setActive = (id: string) => links.forEach((l) => l.classList.toggle("is-active", l.dataset.target === id));
    const io = new IntersectionObserver((entries) => {
      const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible[0]) setActive((visible[0].target as HTMLElement).id);
    }, { rootMargin: "-20% 0px -70% 0px" });
    heads.forEach((h) => io.observe(h));
    const onScroll = () => {
      if (!bar) return;
      const r = body.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      const pct = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.width = `${pct * 100}%`;
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
