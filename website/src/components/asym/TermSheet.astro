---
/**
 * Loan program body: numbered <Chapter>s on the left, contact form (slot "form")
 * on the right. Both columns scroll with the page as one - the form was previously
 * pinned with its own max-height and overflow, which gave the page a second
 * scrollbar. On phones the form comes first, right under the header.
 */
const hasForm = Astro.slots.has("form");
---

<section class="bg-white">
  <div class="container-wide py-12 lg:py-16 grid lg:grid-cols-12 gap-10 lg:gap-14">
    {hasForm && (
      <div class="termsheet-form lg:col-span-5 xl:col-span-4 lg:col-start-8 xl:col-start-9 lg:row-start-1 self-start">
        <slot name="form" />
      </div>
    )}
    <div class={`termsheet-chapters lg:row-start-1 ${hasForm ? "lg:col-span-7" : "lg:col-span-10"}`}>
      <slot />
    </div>
  </div>
</section>

<style>
  .termsheet-chapters { counter-reset: chapter; }
</style>
