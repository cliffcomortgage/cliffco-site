---
/**
 * Loan program body: numbered <Chapter>s scroll on the left while the contact
 * form (slot "form") stays pinned on the right, the mirror image of the Who We
 * Help pages. On phones the form comes first, right under the header.
 */
const hasForm = Astro.slots.has("form");
---

<section class="bg-white">
  <div class="container-wide py-12 lg:py-16 grid lg:grid-cols-12 gap-10 lg:gap-14">
    {hasForm && (
      <div class="termsheet-form lg:col-span-5 xl:col-span-4 lg:col-start-8 xl:col-start-9 lg:row-start-1 lg:sticky lg:top-24 self-start">
        <slot name="form" />
      </div>
    )}
    <div class={`termsheet-chapters lg:row-start-1 ${hasForm ? "lg:col-span-7" : "lg:col-span-10"}`}>
      <slot />
    </div>
  </div>
</section>

<style>
  .termsheet-chapters { counter-reset: chapter; }
  @media (min-width: 1024px) {
    .termsheet-form { max-height: calc(100vh - 7rem); overflow-y: auto; scrollbar-width: thin; }
  }
</style>
