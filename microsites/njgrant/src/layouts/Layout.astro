---
/**
 * Shared layout for the NJ First Generation Homebuyer grant microsite.
 * Standard Cliffco Mortgage Bankers branding (no naming restriction, unlike
 * the Alaska site) - company-facing, not built around one loan officer.
 */
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import PostHog from "../components/posthog.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://njfirstgenhomebuyer.com").toString();

// Verbatim standard disclosure, matching the pattern used on the MN microsite,
// with New Jersey's specific regulator line swapped in.
const disclosure = "Cliffco, Inc. is not affiliated with or acting on behalf of the FHA or any government entity. Equal Housing Lender. Cliffco, Inc. Corporate NMLS#65328 (www.nmlsconsumeraccess.org) 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553 (516) 408-7300. Licensed by the New Jersey Department of Banking and Insurance. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice. The NJHMFA First Generation Homebuyer Program and Down Payment Assistance Program are administered by the New Jersey Housing and Mortgage Finance Agency (NJHMFA), a State of New Jersey agency. Cliffco, Inc. is not NJHMFA and does not determine program eligibility or availability of funds. Program terms, amounts, and eligibility are subject to NJHMFA's guidelines and are subject to change without notice.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Cliffco Mortgage Bankers" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <PostHog />
    <script type="text/javascript" id="hs-script-loader" async defer src="//js.hs-scripts.com/21616430.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&family=Montserrat:wght@600&display=optional" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&family=Montserrat:wght@600&display=optional" /></noscript>
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col">

    <!-- HEADER: intentionally minimal nav - single landing page, no distractions from the goal -->
    <header class="bg-white border-b border-[var(--color-mist-gray)] sticky top-0 z-40">
      <div class="container-wide flex items-center justify-between gap-4 py-4">
        <a href="/" class="no-underline shrink-0" aria-label="Cliffco Mortgage Bankers home">
          <img src="/logo.png" alt="Cliffco Mortgage Bankers" class="h-[20px] w-auto" loading="eager" />
        </a>
        <a href="tel:+19083701575" class="btn btn-primary text-sm !py-2 !px-5 shrink-0 hidden sm:inline-flex">Call (908) 370-1575</a>
        <a href="tel:+19083701575" class="btn btn-primary text-sm !py-2.5 !px-3 shrink-0 sm:hidden" aria-label="Call (908) 370-1575">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
        </a>
      </div>
    </header>

    <main class="flex-1 flex flex-col">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-[var(--color-rich-black)] text-white">
      <div class="container-wide py-12">
        <div class="grid gap-10 md:grid-cols-3">
          <div>
            <span style="font-family: var(--font-logo); font-weight: 600; letter-spacing: 0.2em; font-size: 1.1rem; color: #fff;">CLIFFCO MORTGAGE BANKERS</span>
            <p class="mt-3 text-sm text-white/60">Getting families home since 1989.<br />NMLS #65328</p>
            <p class="mt-3 text-sm text-white/60">
              70 Charles Lindbergh Blvd, Suite 200<br />
              Uniondale, NY 11553
            </p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/40">Your NJ Team</p>
            <ul class="mt-3 space-y-2 text-sm list-none p-0">
              <li><a href="tel:+19083701575" class="text-white/70 no-underline hover:text-white">Eddie Morais &middot; (908) 370-1575</a></li>
              <li><a href="tel:+15857038862" class="text-white/70 no-underline hover:text-white">Gary Johansen &middot; (585) 703-8862</a></li>
              <li><a href="https://cliffcomortgage.com/find-a-loan-officer/" class="text-white/70 no-underline hover:text-white">All Cliffco loan officers &#8599;</a></li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/40">Legal</p>
            <ul class="mt-3 space-y-2 text-sm list-none p-0">
              <li><a href="https://www.nmlsconsumeraccess.org/" target="_blank" rel="noopener noreferrer" class="text-white/70 no-underline hover:text-white">NMLS Consumer Access &#8599;</a></li>
              <li><a href="https://cliffcomortgage.com/privacy-policy/" class="text-white/70 no-underline hover:text-white">Privacy Policy &#8599;</a></li>
              <li><a href="https://njhousing.gov/" target="_blank" rel="noopener noreferrer" class="text-white/70 no-underline hover:text-white">NJHMFA (njhousing.gov) &#8599;</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-10 pt-8 border-t border-white/10 flex items-start gap-4">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-label="Equal Housing Lender" role="img" class="shrink-0 mt-1 opacity-60"><path d="M12 3 2 10h2v11h16V10h2L12 3Zm0 2.4L17.5 9h-11L12 5.4ZM8 11h8v2H8v-2Zm0 4h8v2H8v-2Z" fill="#fff"/></svg>
          <p class="text-[11px] leading-relaxed text-white/35">{disclosure}</p>
        </div>

        <p class="mt-6 text-[11px] text-white/35">&copy; 2026 Cliffco, Inc. All rights reserved.</p>
      </div>
    </footer>

    <Analytics />
    <SpeedInsights />
  </body>
</html>
