---
import Layout from "../layouts/Layout.astro";

const programs = [
  {
    name: "VA Loans",
    href: "https://cliffcomortgage.com/loans/va/",
    blurb: "Zero down for service members, veterans, and surviving spouses. Alaska has one of the highest shares of veterans in the country, and we treat that service accordingly.",
  },
  {
    name: "Self-Employed & Non-QM",
    href: "https://cliffcomortgage.com/loans/non-qm-self-employed/",
    blurb: "Fishing seasons, guiding seasons, and slope schedules don't produce tidy W-2s. We qualify you on bank statements, 1099s, or assets instead of tax returns.",
  },
  {
    name: "Conventional & FHA",
    href: "https://cliffcomortgage.com/loans/conventional/",
    blurb: "Straightforward purchase and refinance financing, with as little as 3% down for first-time buyers and FHA flexibility for imperfect credit.",
  },
  {
    name: "DSCR Investor Loans",
    href: "https://cliffcomortgage.com/loans/dscr/",
    blurb: "Rental property loans qualified on the property's income, not yours. LLC vesting welcome, no personal income docs required.",
  },
];
---

<Layout
  title="Alaska Mortgage Lender | Cliffco, Inc."
  description="Cliffco, Inc. is a licensed Alaska mortgage lender (AK65328, NMLS #65328) making home loans across the state since 1989. VA, conventional, FHA, self-employed, and investor programs. Talk to a loan officer, not a call center."
>
  <!-- HERO -->
  <section class="accent-gradient">
    <!-- Anchorage skyline (Adobe Stock 137138496) fading under a dark overlay -->
    <div style="position:absolute;inset:0;overflow:hidden;z-index:0;pointer-events:none;" aria-hidden="true">
      <img
        src="/hero-anchorage.webp"
        alt=""
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%;opacity:0.5;"
        loading="eager"
        fetchpriority="high"
      />
      <div style="position:absolute;inset:0;background:linear-gradient(to right, rgba(13,13,13,0.96) 25%, rgba(13,13,13,0.72) 55%, rgba(13,13,13,0.42) 100%);"></div>
      <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(13,13,13,0.85) 0%, rgba(13,13,13,0) 40%);"></div>
    </div>
    <div class="container-wide py-20 lg:py-28">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Alaska Mortgage Lending · Cliffco, Inc.</p>
      <h1 class="mt-4 text-white max-w-2xl" style="font-size: var(--text-display-xl); line-height: 1.08; font-weight: 400;">
        Home loans for Alaskans, from a lender that finds a way.
      </h1>
      <p class="lead mt-5 text-white/85 max-w-xl">
        Cliffco, Inc. has been getting families home since 1989. We're licensed across Alaska,
        and when you call, a licensed loan officer picks up the phone.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a href="/contact/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get Started</a>
        <a href="tel:+15164087300" class="btn btn-secondary !border-white !text-white">(516) 408-7300</a>
      </div>
    </div>
  </section>

  <!-- TRUST STATS -->
  <section class="bg-white border-b border-[var(--color-mist-gray)]">
    <div class="container-wide py-10 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <p class="text-2xl font-semibold text-[var(--color-ink)]">1989</p>
        <p class="mt-1 text-sm text-[var(--color-text-muted)]">Getting families home since</p>
      </div>
      <div>
        <p class="text-2xl font-semibold text-[var(--color-ink)]">AK65328</p>
        <p class="mt-1 text-sm text-[var(--color-text-muted)]">Licensed by the AK Division of Banking and Securities</p>
      </div>
      <div>
        <p class="text-2xl font-semibold text-[var(--color-ink)]">#65328</p>
        <p class="mt-1 text-sm text-[var(--color-text-muted)]">Corporate NMLS</p>
      </div>
      <div>
        <p class="text-2xl font-semibold text-[var(--color-ink)]">1:1</p>
        <p class="mt-1 text-sm text-[var(--color-text-muted)]">You work with one loan officer, start to close</p>
      </div>
    </div>
  </section>

  <!-- PROGRAMS PREVIEW -->
  <section class="bg-[var(--color-mist-gray)]" style="padding-block: var(--spacing-section);">
    <div class="container-wide">
      <p class="eyebrow">Loan Programs</p>
      <h2 class="mt-3" style="font-size: var(--text-h2);">Built for the way Alaskans earn and live.</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {programs.map((p) => (
          <a href={p.href} class="card no-underline text-[var(--color-ink)] flex flex-col hover:border-[var(--color-accent)]">
            <h3 class="text-lg font-semibold">{p.name}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] flex-1">{p.blurb}</p>
            <span class="mt-4 text-sm font-semibold text-[var(--color-accent)]">Program details ↗</span>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <a href="/loan-programs/" class="btn btn-secondary">See all programs</a>
      </div>
    </div>
  </section>

  <!-- WHY CLIFFCO -->
  <section class="bg-white" style="padding-block: var(--spacing-section);">
    <div class="container-wide grid gap-12 lg:grid-cols-2 items-start">
      <div>
        <p class="eyebrow">Why Cliffco, Inc.</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">The lender for borrowers other banks turn away.</h2>
        <p class="mt-5 text-[var(--color-text)] leading-relaxed">
          A lot of Alaskans earn well and still get declined, because commercial fishing income,
          seasonal guiding, North Slope rotations, and small-business books don't fit a
          conventional underwriting checklist. That's the borrower we built this company for.
          If your income is real, we have programs designed to document it.
        </p>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed">
          We're a family-run lender, not a branch of a giant bank. Your file gets a person,
          that person gets you to closing, and you can call them by name the whole way.
        </p>
      </div>
      <div class="space-y-4">
        <div class="card">
          <h3 class="text-base font-semibold">Seasonal and self-employed income welcome</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Bank statement, 1099, and asset-based qualification instead of tax returns.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold">Second chances taken seriously</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Denied elsewhere? Bring us the file. Finding the yes is the part of this work we like most.</p>
        </div>
        <div class="card">
          <h3 class="text-base font-semibold">Fully remote process</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Application to closing handled online and by phone, wherever in Alaska you are.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="accent-gradient">
    <div class="container-wide py-16 text-center">
      <h2 class="text-white" style="font-size: var(--text-h2);">Tell us your situation. We'll tell you your options.</h2>
      <p class="lead mt-4 text-white/85">A licensed loan officer responds within one business day.</p>
      <div class="mt-8 flex justify-center gap-3 flex-wrap">
        <a href="/contact/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Get Started</a>
        <a href="tel:+15164087300" class="btn btn-secondary !border-white !text-white">(516) 408-7300</a>
      </div>
    </div>
  </section>
</Layout>
