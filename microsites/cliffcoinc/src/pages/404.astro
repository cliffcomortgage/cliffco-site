---
/**
 * 404 for cliffcoinc.com. Without this, a mistyped URL fell through to Vercel's unbranded
 * default. Keeps the site's own header, footer and Alaska disclaimer, and routes people to
 * the four real pages or straight to a loan officer on the phone.
 *
 * BRANDING RULE (see Layout.astro): Cliffco, Inc. only, never "Cliffco Mortgage Bankers".
 */
import Layout from "../layouts/Layout.astro";

const destinations = [
  { label: "Home", href: "/", blurb: "Alaska lending overview and how to start." },
  { label: "Loan Programs", href: "/loan-programs/", blurb: "VA, conventional, FHA, self-employed, and investor loans." },
  { label: "About Cliffco, Inc.", href: "/about/", blurb: "Who we are and how we work in Alaska." },
  { label: "Contact", href: "/contact/", blurb: "Reach a licensed Alaska loan officer." },
];
---

<Layout
  title="Page Not Found | Cliffco, Inc. | Alaska Mortgage Lender"
  description="That page doesn't exist on cliffcoinc.com. Head back to Alaska loan programs, or call a licensed Cliffco, Inc. loan officer at (516) 408-7300."
  noindex={true}
>
  <section class="accent-gradient">
    <div class="container-wide py-20 lg:py-28">
      <p class="eyebrow !text-[var(--color-ice-blue)]">Error 404</p>
      <h1 class="mt-4 text-white max-w-2xl" style="font-size: var(--text-display-lg); line-height: 1.08; font-weight: 400;">
        That page isn't here.
      </h1>
      <p class="mt-5 max-w-xl text-white/75" style="font-size: var(--text-lead);">
        The link may be out of date, or the address may have a typo. Everything on this site is
        one of the four pages below, and a licensed loan officer is a phone call away.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">Back to home</a>
        <a href="tel:+15164087300" class="btn btn-secondary !border-white !text-white">(516) 408-7300</a>
      </div>
    </div>
  </section>

  <section class="bg-white" style="padding-block: var(--spacing-section);">
    <div class="container-wide">
      <p class="eyebrow">Where to next</p>
      <h2 class="mt-3 max-w-2xl" style="font-size: var(--text-h2);">Try one of these instead.</h2>
      <ul class="mt-8 list-none m-0 p-0 grid gap-4 sm:grid-cols-2 max-w-3xl">
        {destinations.map((d) => (
          <li>
            <a href={d.href} class="card flex flex-col h-full no-underline text-[var(--color-ink)]">
              <span class="text-base font-semibold">{d.label}</span>
              <span class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{d.blurb}</span>
              <span class="mt-4 text-sm font-semibold">Go &rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
