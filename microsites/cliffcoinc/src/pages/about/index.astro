---
import Layout from "../../layouts/Layout.astro";

const values = [
  { name: "Family", blurb: "We're family-run, and we treat your homeownership like it's a family matter. Because for you, it is." },
  { name: "Integrity", blurb: "Straight answers about rates, costs, and whether a loan actually serves you. Even when the honest answer is wait." },
  { name: "Care", blurb: "A mortgage is the biggest financial decision most families make. You get a person who picks up the phone, every time." },
  { name: "Possibility", blurb: "Unusual income, thin credit, a past denial. We look for the path to yes that other lenders don't bother finding." },
];
---

<Layout
  title="About | Cliffco, Inc. | Alaska Mortgage Lender"
  description="Cliffco, Inc. (NMLS #65328) has been getting families home since 1989. Licensed in Alaska (AK65328), led by President Christopher Clifford, and built around loan officers rather than call centers."
>
  <section class="accent-gradient">
    <div class="container-wide py-16 lg:py-24">
      <p class="eyebrow !text-[var(--color-ice-blue)]">About Cliffco, Inc.</p>
      <h1 class="mt-4 text-white max-w-2xl" style="font-size: var(--text-display-lg); line-height: 1.1; font-weight: 400;">
        Getting families home since 1989.
      </h1>
      <p class="lead mt-5 text-white/85 max-w-xl">
        Cliffco, Inc. is an independent mortgage lender founded on Long Island, New York,
        and licensed to lend across Alaska. For more than 35 years we've specialized in the
        borrowers big banks overlook.
      </p>
    </div>
  </section>

  <section class="bg-white" style="padding-block: var(--spacing-section);">
    <div class="container-wide grid gap-12 lg:grid-cols-2 items-start">
      <div>
        <p class="eyebrow">Our story</p>
        <h2 class="mt-3" style="font-size: var(--text-h2);">A lender built around people, not products.</h2>
        <p class="mt-5 text-[var(--color-text)] leading-relaxed">
          Cliffco was founded in 1989 with a simple conviction: families who work hard deserve a
          lender who works just as hard to get them home. Thirty-five years later we're still
          independent, still family-run, and still answering our own phones.
        </p>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed">
          Our mission is to get families home. Especially the ones other banks turned away. And
          to grow their net worth and self-worth along the way.
        </p>
        <p class="mt-4 text-[var(--color-text)] leading-relaxed">
          The company is led by President
          <a href="https://cliffcomortgage.com/find-a-loan-officer/">Christopher Clifford</a>
          (NMLS #65234), who is personally licensed in Alaska and has spent his career
          building loan programs for borrowers whose income doesn't fit a standard form.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {values.map((v) => (
          <div class="card">
            <h3 class="text-base font-semibold text-[var(--color-accent)]">{v.name}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)]">{v.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-mist-gray)] flex-1" style="padding-block: var(--spacing-section);">
    <div class="container-wide">
      <p class="eyebrow">Cliffco in Alaska</p>
      <h2 class="mt-3 max-w-2xl" style="font-size: var(--text-h2);">Licensed statewide, from Anchorage to the Interior.</h2>
      <p class="mt-5 max-w-2xl text-[var(--color-text)] leading-relaxed">
        Cliffco, Inc. is licensed by the Alaska Division of Banking and Securities (AK65328,
        AK65328-1). Our lending process is fully remote: application, document collection, and
        closing coordination all happen online and by phone, so where you live in Alaska never
        slows your loan down.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-primary">Talk to a loan officer</a>
        <a href="/loan-programs/" class="btn btn-secondary">See loan programs</a>
      </div>
    </div>
  </section>
</Layout>
