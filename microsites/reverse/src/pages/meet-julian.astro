---
/**
 * /meet-julian/
 * Google Ads sitelink LP — trust page for Julian Giaquinto
 * Standalone, noindex, HubSpot form.
 */

import "../styles/global.css";
import { COMPANY } from "../data/company";
import PostHog from "../components/posthog.astro";

const phone     = "(516) 884-6696";
const phoneE164 = "+15168846696";
const currentYear = new Date().getFullYear();
const yearsServing = currentYear - COMPANY.founded;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Meet Julian Giaquinto, Long Island Reverse Mortgage Specialist | Cliffco</title>
  <meta name="description" content="Julian Giaquinto is a licensed Long Island reverse mortgage specialist with 20+ years of experience. Branch Manager at Cliffco Mortgage Bankers. NMLS #56473." />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <PostHog />
  <script src="https://js.hsforms.net/forms/embed/21616430.js" defer></script>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18193082925"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-18193082925');
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload" as="style"
    href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Montserrat:wght@600&display=optional"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Montserrat:wght@600&display=optional" />
  </noscript>
</head>

<body class="min-h-screen flex flex-col bg-white" style="padding-bottom: env(safe-area-inset-bottom, 0px);">
  <a href="#main" class="skip-link">Skip to main content</a>

  <!-- ── HEADER ───────────────────────────────────────────────────────── -->
  <header class="border-b border-[var(--color-mist-gray)] bg-white sticky top-0 z-40 shadow-sm">
    <div class="container-wide flex items-center justify-between gap-6 py-4">
      <a href="/long-island/" aria-label="Cliffco Mortgage Bankers home">
        <img src="/logo-black.png" alt="Cliffco Mortgage Bankers" class="h-[32px] w-auto" loading="eager" />
      </a>
      <a href={`tel:${phoneE164}`} class="btn btn-primary flex items-center gap-2 text-sm" aria-label={`Call Julian at ${phone}`}>
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
        </svg>
        {phone}
      </a>
    </div>
  </header>

  <main id="main" class="flex-1">

    <!-- ── HERO ─────────────────────────────────────────────────────── -->
    <section id="hero" class="accent-gradient text-white py-14 lg:py-20">
      <div class="container-wide">
        <div class="grid lg:grid-cols-[1fr_420px] gap-10 items-center">

          <!-- Left: Julian profile -->
          <div>
            <p class="eyebrow text-[var(--color-ice-blue)]">Long Island · NMLS #56473</p>
            <h1 class="mt-3 text-white" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; line-height: 1.15;">
              Meet Julian Giaquinto.
            </h1>
            <p class="mt-4 lead text-white/80">
              Branch Manager at Cliffco Mortgage Bankers. Long Island's trusted reverse mortgage specialist since 2008.
            </p>

            <!-- Photo + quick stats -->
            <div class="mt-8 flex items-start gap-6">
              <img
                src="/team/julian-giaquinto.jpg"
                alt="Julian Giaquinto, Reverse Mortgage Specialist"
                class="w-28 h-28 rounded-full object-cover object-top border-4 border-white/30 shrink-0"
                loading="eager"
              />
              <div class="grid grid-cols-2 gap-4">
                {[
                  { stat: "20+", label: "Years in mortgage" },
                  { stat: "2008", label: "Reverse mortgage focus" },
                  { stat: "HECM", label: "HUD-approved specialist" },
                  { stat: "11", label: "States licensed" },
                ].map(({ stat, label }) => (
                  <div>
                    <p class="text-xl font-bold text-white">{stat}</p>
                    <p class="text-xs text-white/60 leading-tight">{label}</p>
                  </div>
                ))}
              </div>
            </div>

            <!-- What to expect -->
            <div class="mt-8 space-y-3">
              {[
                "Free, no-obligation consultation. No pressure.",
                "Honest answers about whether a reverse mortgage fits your situation",
                "Licensed in NY, NJ, CT, FL, PA and 6 other states",
                "Closing typically within 45–60 days of application",
              ].map(item => (
                <div class="flex gap-3 items-start">
                  <svg class="shrink-0 mt-0.5" width="16" height="16" fill="none" stroke="var(--color-ice-blue)" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                  </svg>
                  <p class="text-sm text-white/80">{item}</p>
                </div>
              ))}
            </div>

            <!-- Featured quote -->
            <blockquote class="mt-8 border-l-4 border-white/25 pl-4">
              <p class="text-sm text-white/75 italic leading-relaxed">"Julian took the time to walk us through every detail and made sure we fully understood before we signed anything. Best decision we made."</p>
              <cite class="mt-2 block text-xs text-white/45 not-italic">Robert &amp; Carol T., Wantagh, NY</cite>
            </blockquote>
          </div>

          <!-- Right: form card -->
          <div class="bg-white rounded-lg shadow-2xl p-7 lg:p-8" style="box-shadow: 0 24px 64px rgba(0,0,0,0.35);">
            <p class="eyebrow">Free consultation · No obligation</p>
            <h2 class="mt-2 font-bold text-[var(--color-ink)]" style="font-size: var(--text-h3);">
              Speak with Julian
            </h2>
            <p class="mt-1 text-xs text-[var(--color-text-muted)]">He'll call you within one business day.</p>
            <div class="mt-5">
              <div class="hs-form-frame" data-region="na1" data-form-id="3ded71fb-d483-4ade-a24e-ce9bbd4832ef" data-portal-id="21616430"></div>
            </div>
            <div class="mt-4 text-center">
              <a href={`tel:${phoneE164}`} class="text-sm font-semibold text-[var(--color-accent)] no-underline hover:underline">
                Or call {phone}
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ── BIO ──────────────────────────────────────────────────────── -->
    <section class="section bg-white">
      <div class="container-wide max-w-3xl">
        <p class="eyebrow">About Julian</p>
        <h2 class="mt-2" style="font-size: var(--text-h2);">20+ Years Helping Long Island Homeowners</h2>
        <div class="mt-6 space-y-4 text-[var(--color-text)] leading-relaxed">
          <p>
            With over 20 years in the mortgage financing industry, Julian Giaquinto has built a reputation as a dedicated and trusted mortgage banker in New York. As Branch Manager at Cliffco Mortgage Bankers, Julian offers a wide range of residential loan solutions designed to meet the needs of diverse borrowers, from first-time homebuyers to seasoned real estate investors.
          </p>
          <p>
            Since 2008, Julian has developed a strong specialty in reverse mortgages, guiding seniors and retirees through one of the most important financial decisions of their lives. He believes that when it comes to reverse mortgages, education and personalized guidance are key. Julian takes the time to walk every client through every option, without pressure or jargon.
          </p>
          <p>
            In addition to reverse mortgages, Julian also provides financing for self-employed borrowers, no-income check loans, and clients who have been turned down by other banks.
          </p>
        </div>

        <!-- Credentials grid -->
        <div class="mt-10 grid sm:grid-cols-2 gap-4">
          {[
            { label: "NMLS License", value: "#56473" },
            { label: "Title", value: "Branch Manager" },
            { label: "Office", value: "Wantagh, NY" },
            { label: "Direct Phone", value: "(516) 654-9679" },
            { label: "Cell", value: "(516) 884-6696" },
            { label: "Email", value: "jgiaquinto@cliffcomortgage.com" },
            { label: "States Licensed", value: "NY, NJ, CT, FL, PA, CA, AZ, NC, SC, TX, VA" },
            { label: "Specialty", value: "HECM Reverse Mortgages" },
          ].map(({ label, value }) => (
            <div class="card p-4">
              <p class="text-xs text-[var(--color-text-muted)] font-medium uppercase tracking-wide mb-1">{label}</p>
              <p class="text-sm font-semibold text-[var(--color-ink)]">{value}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── BOTTOM CTA ────────────────────────────────────────────────── -->
    <section class="accent-gradient text-white py-14">
      <div class="container-wide text-center max-w-xl">
        <h2 class="text-white" style="font-size: var(--text-h2);">Ready to talk to Julian?</h2>
        <p class="mt-3 text-white/75 lead">No pressure. No commitment. Just honest answers from a licensed Long Island HECM specialist.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#hero" class="btn" style="background:rgba(255,255,255,0.15);color:#fff;border:1.5px solid rgba(255,255,255,0.4);">Get a Free Quote</a>
          <a href={`tel:${phoneE164}`} class="btn" style="background:rgba(255,255,255,0.15);color:#fff;border:1.5px solid rgba(255,255,255,0.4);">
            {phone}
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- ── FOOTER ───────────────────────────────────────────────────────── -->
  <footer style="background:var(--color-rich-black);" class="pt-8 pb-6">
    <div class="container-wide max-w-6xl mx-auto px-6">
      <div class="mb-6">
        <img src="/logo-black.png" alt="Cliffco Mortgage Bankers" class="h-[36px] w-auto brightness-0 invert" loading="lazy" />
      </div>
      <div class="flex flex-wrap items-center justify-between gap-y-2 gap-x-6 mb-5">
        <nav aria-label="Footer links" class="flex flex-wrap gap-x-5 gap-y-1">
          <a href="/meet-julian/" class="text-xs text-white/60 hover:text-white underline transition-colors">Meet Julian</a>
          <a href="/how-hecm-works/" class="text-xs text-white/60 hover:text-white underline transition-colors">How It Works</a>
          <a href="/client-reviews/" class="text-xs text-white/60 hover:text-white underline transition-colors">Client Reviews</a>
          <a href="https://cliffcomortgage.com/" class="text-xs text-white/60 hover:text-white underline transition-colors">Visit Full Site</a>
          <a href="https://www.nmlsconsumeraccess.org/EntityDetails.aspx/COMPANY/65328" target="_blank" rel="noopener" class="text-xs text-white/60 hover:text-white underline transition-colors">NMLS Consumer Access</a>
          <a href="https://cliffcomortgage.com/privacy-policy/" class="text-xs text-white/60 hover:text-white underline transition-colors">Privacy Policy</a>
          <a href="https://cliffcomortgage.com/licensing/" class="text-xs text-white/60 hover:text-white underline transition-colors">Licensing</a>
        </nav>
        <p class="text-xs text-white/60">&copy; {currentYear} Cliffco, Inc. &middot; NMLS #65328 &middot; Equal Housing Lender</p>
      </div>
      <hr class="border-white/10 mb-5" />
      <p class="text-[11px] leading-relaxed text-white/35 mb-4">
        Cliffco, Inc. is not affiliated with or acting on behalf of the FHA or any government entity. Equal Housing Lender. Cliffco, Inc. Corporate NMLS#65328 (www.nmlsconsumeraccess.org) 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553 (516) 408-7300. Licensed Mortgage Lender by AK Division of Banking and Securities AK65328, AK65328-1; AL Mortgage Broker/Lender License #23581; AZ Mortgage Banker License 1045708; CA DFPI Financing Law License 60DBO-181882; CO Dept. of Regulatory Agencies Division of Banking; CT Department of Banking MCL-65328; DC Department of Insurance, Securities, &amp; Banking MLB65328; DE Office of the State Bank Commissioner 040096; FL Office of Financial Regulation MLD1245; GA Department of Banking &amp; Finance 65328; IL Department of Financial &amp; Professional Regulation MB.6761824; IN Indiana Department of Financial Institutions 70581; KS State Bank Commissioner of Kansas MC.0026625; KY Department of Financial Institutions MC838985; LA Office of Financial Institutions 65328; MA Mortgage Broker and Mortgage Lender License MC65328 MA Division of Banks; MD Office of Financial Regulation; MN Department of Commerce #MN-MO-65328; NC Commissioner of Banks L-211081; NJ Department of Banking &amp; Insurance; NM New Mexico Regulation &amp; Licensing Dept.; Licensed Mortgage Banker by the NYS Department of Financial Services LMBC109800; OH Department of Commerce Residential Mortgage Lending Act RM.805200.000; OR Oregon Department of Consumer and Business Services 65328; PA Department of Banking &amp; Securities 45275; SC State Board of Financial Institutions MLS-65328; TN Department of Financial Institutions Mortgage License 65328; TX Department of Savings &amp; Mortgage Lending; VA Bureau of Financial Institutions MC-7742; VT Department of Financial Regulation LL-65328; WA State Department of Financial Institutions CL-65328. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice. Cliffco, Inc. doing business in Florida as Swish Capital, Inc., is a New York corporation authorized to transact business in the State of Florida.
      </p>
      <p class="text-[11px] leading-relaxed text-white/35">
        Minimum borrower age is 62 years old and must occupy property. You retain title to the subject property until you sell or transfer the property,
        and you are responsible for paying taxes, insurance, and maintenance of the property. Failing to pay these amounts may cause the reverse mortgage
        loan to become due immediately and may subject the property to a tax lien. Reverse mortgage borrowers are required to obtain an eligibility
        certificate by receiving counseling sessions with a HUD-approved agency. This is not an offer to enter into an agreement. Not all customers will
        qualify. Information, rates, and programs are subject to change without notice. All products are subject to credit and property approval.
        Other restrictions may apply. Cliffco, Inc. does not provide financial planning or tax advice.
      </p>
    </div>
  </footer>

  <div style="height: 90px; background:var(--color-rich-black);" aria-hidden="true"></div>

  <!-- ── MOBILE STICKY CALL BAR ────────────────────────────────────── -->
  <div id="lp-call-bar" class="fixed bottom-0 left-0 right-0 z-50 lg:hidden bg-[var(--color-rich-black)] border-t border-[var(--color-accent)]/40 px-4 py-3" aria-label="Call Julian" style="display:none;">
    <a href={`tel:${phoneE164}`} class="btn btn-primary w-full flex items-center justify-center gap-3 !bg-[var(--color-accent)]">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
      </svg>
      Call {phone}
    </a>
  </div>

  <script>
    (() => {
      const bar  = document.getElementById('lp-call-bar') as HTMLElement | null;
      const hero = document.querySelector<HTMLElement>('main section:first-of-type');
      if (!bar || !hero) return;
      const observer = new IntersectionObserver(([entry]) => {
        bar.style.display = entry.isIntersecting ? 'none' : 'block';
      }, { threshold: 0.05 });
      observer.observe(hero);
    })();
  </script>

  <div id="cf-cursor" aria-hidden="true"></div>
  <script>
    (() => {
      const dot = document.getElementById('cf-cursor');
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isTouch = window.matchMedia('(pointer: coarse)').matches;
      if (!dot || prefersReduced || isTouch) return;
      const dotEl = dot as HTMLElement;
      let mx = window.innerWidth / 2, my = window.innerHeight / 2, cx = mx, cy = my, scale = 1, targetScale = 1;
      const LERP_POS = 0.65, LERP_SCALE = 0.35;
      const COLORS = { default: '#6633cc', link: '#9966ee', button: '#4a1fa0', card: '#bde8f1', dark: '#ffffff' };
      let targetColor = COLORS.default, lastColor = COLORS.default;
      document.querySelectorAll('section, footer').forEach(el => {
        const bg = getComputedStyle(el).backgroundColor;
        if (bg === 'rgb(13, 13, 13)' || bg === 'rgb(26, 0, 64)') (el as HTMLElement).dataset.cursorDark = '';
      });
      document.querySelectorAll('.accent-gradient').forEach(el => { (el as HTMLElement).dataset.cursorDark = ''; });
      function getContext(el: Element | null): keyof typeof COLORS {
        if (!el) return 'default';
        if (el.closest('[data-cursor-dark]')) return 'dark';
        if (el.closest('.btn, button, [role="button"], input[type="submit"]')) return 'button';
        if (el.closest('a')) return 'link';
        if (el.closest('.card, article, figure, picture')) return 'card';
        return 'default';
      }
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      document.addEventListener('mousemove', (e) => {
        mx = e.clientX; my = e.clientY;
        const ctx = getContext(document.elementFromPoint(mx, my));
        targetColor = COLORS[ctx]; targetScale = ctx === 'default' ? 1 : 1.6;
      });
      document.addEventListener('mouseleave', () => { dotEl.style.opacity = '0'; });
      document.addEventListener('mouseenter', () => { dotEl.style.opacity = '1'; });
      function tick() {
        cx = lerp(cx, mx, LERP_POS); cy = lerp(cy, my, LERP_POS); scale = lerp(scale, targetScale, LERP_SCALE);
        dotEl.style.transform = `translate(${cx}px, ${cy}px) scale(${scale})`;
        if (lastColor !== targetColor) { dotEl.style.background = targetColor; lastColor = targetColor; }
        requestAnimationFrame(tick);
      }
      tick();
    })();
  </script>

  <script>
    window.addEventListener('message', function(event) {
      if (event.data && event.data.type === 'hsFormCallback' && event.data.eventName === 'onFormSubmitted') {
        gtag('event', 'conversion', {
          'send_to': 'AW-18193082925/MuoBCMT2yMEcEK3UkeND',
          'value': 16452.0,
          'currency': 'USD'
        });
      }
    });
  </script>
</body>
</html>
