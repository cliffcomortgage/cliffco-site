  <script>
    // ── 1. UTM + gclid capture ──────────────────────────────────────────
    // Maps URL param names → HubSpot hidden field names.
    // gclid uses HubSpot's native hs_google_click_id property.
    // Persists to sessionStorage so values survive #anchor navigation.
    // Uses MutationObserver to wait for the async HubSpot form render.
    (function () {
      const PARAM_MAP: Record<string, string> = {
        gclid:        'hs_google_click_id',
        utm_source:   'utm_source',
        utm_medium:   'utm_medium',
        utm_campaign: 'utm_campaign',
        utm_content:  'utm_content',
        utm_term:     'utm_term',
      };

      const params = new URLSearchParams(window.location.search);
      Object.keys(PARAM_MAP).forEach(key => {
        const val = params.get(key);
        if (val) sessionStorage.setItem('cliffco_lp_' + key, val);
      });

      function fillForm(formEl: Element) {
        Object.entries(PARAM_MAP).forEach(([urlParam, fieldName]) => {
          const val = sessionStorage.getItem('cliffco_lp_' + urlParam);
          if (!val) return;
          const input = formEl.querySelector(`[name="${fieldName}"]`) as HTMLInputElement | null;
          if (input) input.value = val;
        });
      }

      // HubSpot renders the form async inside .hs-form-frame — wait for it.
      const frame = document.querySelector('.hs-form-frame');
      if (!frame) return;
      const observer = new MutationObserver(() => {
        const formEl = frame.querySelector('form');
        if (formEl) { observer.disconnect(); fillForm(formEl); }
      });
      observer.observe(frame, { childList: true, subtree: true });
    })();

    // ── 2. Mobile sticky call bar ───────────────────────────────────────
    // Shows once the hero form scrolls out of view; hides when back in view.
    (function () {
      const bar  = document.getElementById('lp-call-bar') as HTMLElement | null;
      const hero = document.querySelector<HTMLElement>('main section:first-of-type');
      if (!bar || !hero) return;

      const observer = new IntersectionObserver(
        ([entry]) => {
          bar.style.display = entry.isIntersecting ? 'none' : 'block';
        },
        { threshold: 0.05 }
      );
      observer.observe(hero);
    })();

  </script>

  <!-- Custom cursor dot (matches Layout.astro behaviour) -->
