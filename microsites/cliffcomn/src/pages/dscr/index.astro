---
import "../../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import PostHog from "../../components/posthog.astro";

const faq = [
  { q: "What is a DSCR loan?", a: "A DSCR (Debt-Service Coverage Ratio) loan qualifies you based on the rental income of the property you're buying or refinancing, not your personal income or tax returns. The qualifying ratio is monthly rent divided by monthly principal, interest, taxes, insurance, and HOA (PITIA)." },
  { q: "How is DSCR calculated?", a: "DSCR = Gross Monthly Rent ÷ Monthly PITIA. A $2,500/mo rental with $2,000/mo PITIA gives a DSCR of 1.25. Cliffco can use long-term lease income or short-term-rental projections where allowed." },
  { q: "Do I need to show personal income or tax returns?", a: "No. Your DSCR loan is qualified on the subject property's rental income, not your personal income, employment, or tax returns." },
  { q: "Can I close in an LLC?", a: "Yes. Cliffco's DSCR loans allow vesting in an LLC or in your personal name, a common preference for investors building a portfolio." },
  { q: "What's the minimum DSCR ratio?", a: "Cliffco offers programs down to 0.75 DSCR with compensating factors like stronger reserves or a larger down payment. The most competitive pricing is at 1.25+ DSCR." },
  { q: "Do I have to live in Minnesota to buy a Minnesota rental?", a: "No. Out-of-state investors are common on Cliffco's DSCR programs. Cliffco is licensed in 32 states, so we can lend on a Minnesota property regardless of where you live." },
  { q: "Are short-term rentals (Airbnb / Vrbo) eligible?", a: "In many cases, yes. Short-term-rental income can be used where local rules allow STR operation; talk to Mitch about your specific property and market." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DSCR Investment Property Loans in Minnesota | Cliffco</title>
    <meta name="description" content="Qualify on rental income, not your paycheck. DSCR loans for Minnesota real estate investors: no personal income docs, LLC vesting, long-term or short-term rentals. Work directly with Mitchell Patterson, Cliffco's Minnesota loan officer." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <PostHog />
    <script type="text/javascript" id="hs-script-loader" async defer src="//js.hs-scripts.com/21616430.js"></script>
    <script charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js"></script>
    <!-- Google tag (gtag.js) — Google Ads conversion tracking -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WV6SFC5W7P"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WV6SFC5W7P');
      gtag('config', 'AW-17848823591');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Montserrat:wght@600&display=optional" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Montserrat:wght@600&display=optional" /></noscript>
  </head>

  <body class="min-h-screen flex flex-col">

    <!-- HEADER -->
    <header class="bg-white border-b border-[var(--color-mist-gray)] sticky top-0 z-40">
      <div class="container-wide flex items-center justify-between py-4">
        <a href="/" aria-label="Cliffco Mortgage Bankers home">
          <img src="/logo-black.png" alt="Cliffco Mortgage Bankers" class="h-8 w-auto" loading="eager" />
        </a>
        <a href="tel:9524546635" class="btn btn-primary text-sm !py-2 !px-5">
          Call Mitch: (952) 454-6635
        </a>
      </div>
    </header>

    <main class="flex-1">

      <!-- HERO -->
      <section id="start" class="accent-gradient">
        <div class="container-wide py-20 lg:py-28">
          <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">

            <!-- Left: headline + CTA -->
            <div>
              <p class="eyebrow !text-[var(--color-ice-blue)]">DSCR Loans &middot; Minnesota Investors</p>
              <h1 class="mt-4 text-white max-w-xl" style="font-size: var(--text-display-xl); line-height: 1.08; font-weight: 400;">
                Qualify on rental income. Not your paycheck.
              </h1>
              <p class="lead mt-5 text-white/85 max-w-lg">
                Cliffco's DSCR loans qualify Minnesota real estate investors using the property's rental income, not personal income or tax returns. Long-term or short-term rentals, LLC vesting welcome, out-of-state investors welcome &mdash; originated locally from our Excelsior office.
              </p>
              <div class="mt-8">
                <div class="flex flex-col sm:flex-row gap-3">
                  <a href="#apply" class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)] text-base !px-8 !py-4">
                    See What You Qualify For
                  </a>
                  <a href="tel:9524546635" class="btn text-base !px-8 !py-4 !bg-transparent !text-white border border-white/40 hover:!bg-white/10">
                    (952) 454-6635
                  </a>
                </div>
                <p class="mt-3 text-sm text-white/60">No personal income documentation. No cost to check. Takes minutes.</p>
              </div>
            </div>

            <!-- Right: Mitch card + lead form -->
            <div class="flex justify-center lg:justify-end" id="apply">
              <div class="card max-w-lg w-full !p-8">
                <p class="text-center font-semibold text-[var(--color-ink)] mb-4">Tell us about the property</p>
                <!-- HubSpot lead form (rendered via hbspt.forms.create for reliable submit callback) -->
                <div id="dscr-lead-form"></div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- TRUST BAR -->
      <section class="bg-[var(--color-mist-gray)] py-12">
        <div class="container-wide">
          <p class="text-center text-sm text-[var(--color-text-muted)] mb-8">Cliffco Mortgage Bankers company-wide stats: the team and track record behind your loan.</p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            {[
              { stat: "37+", label: "Years in business" },
              { stat: "32", label: "Licensed states" },
              { stat: "$6B+", label: "Mortgages closed" },
              { stat: "4.9★", label: "Average rating" },
            ].map((item) => (
              <div class="flex flex-col gap-1">
                <span class="text-3xl font-bold text-[var(--color-accent)]">{item.stat}</span>
                <span class="text-sm text-[var(--color-text-muted)]">{item.label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- QUICK MATH -->
      <section id="how-it-works" class="bg-white py-20">
        <div class="container-wide grid gap-10 lg:grid-cols-[1fr_2fr]">
          <div>
            <p class="eyebrow">Quick math</p>
            <h2 class="mt-3" style="font-size: var(--text-h2); font-weight: 300;">DSCR is a one-line formula.</h2>
            <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">No pay stubs. No W-2s. No tax-return debates. Just the property's numbers.</p>
          </div>
          <div class="card">
            <p class="text-2xl font-mono text-[var(--color-ink)]"><strong>DSCR</strong> = Gross Monthly Rent &divide; Monthly PITIA</p>
            <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">
              PITIA = Principal + Interest + Property Taxes + Insurance + HOA dues. For a $2,500/mo rental with $2,000/mo PITIA, DSCR = <strong class="text-[var(--color-ink)]">1.25</strong>. Cliffco offers programs down to 0.75 DSCR with compensating factors; the most competitive pricing is at 1.25+.
            </p>
          </div>
        </div>
      </section>

      <!-- BENEFITS -->
      <section class="bg-[var(--color-mist-gray)] py-20">
        <div class="container-wide">
          <p class="eyebrow">Built for investors</p>
          <h2 class="mt-3" style="font-size: var(--text-h2); font-weight: 300;">Financing that works the way investors actually buy.</h2>
          <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {[
              { h: "No personal income documentation", b: "Qualify on the property's rental income — not pay stubs, W-2s, or tax returns." },
              { h: "LLC vesting welcome", b: "Close in an LLC or your personal name, whichever fits how you're building your portfolio." },
              { h: "Long-term or short-term rentals", b: "Lease income or short-term-rental projections, where local rules allow STR operation." },
              { h: "Out-of-state investors welcome", b: "You don't need to live in Minnesota to buy here. Cliffco is licensed in 32 states." },
              { h: "Ratios from 0.75 to 1.25+", b: "Programs available down to 0.75 DSCR with compensating factors; best pricing at 1.25+." },
              { h: "Local origination, Excelsior branch", b: "Your file is handled by a real Minnesota-based loan officer, not a call center." },
            ].map((item) => (
              <div class="card">
                <h3 class="font-semibold text-[var(--color-ink)]">{item.h}</h3>
                <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{item.b}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ABOUT MITCH -->
      <section class="bg-white py-20">
        <div class="container-wide">
          <div class="grid lg:grid-cols-[320px_1fr] gap-12 items-start">

            <div class="text-center">
              <img
                src="/mitchell-patterson.webp"
                alt="Mitchell Patterson, Cliffco Mortgage Loan Officer"
                class="w-48 h-48 rounded-lg object-cover mx-auto shadow-lg"
                loading="lazy"
              />
              <h2 class="mt-5 text-2xl font-bold text-[var(--color-ink)]">Mitch Patterson</h2>
              <p class="text-[var(--color-accent)] font-semibold text-sm mt-1">Loan Officer</p>
              <div class="mt-4 space-y-2 text-sm text-[var(--color-text-muted)]">
                <p>
                  <strong class="text-[var(--color-ink)]">NMLS</strong> #2560483 &middot;
                  <a href="https://www.nmlsconsumeraccess.org/EntityDetails.aspx/INDIVIDUAL/2560483" class="text-[var(--color-accent)] no-underline hover:underline" target="_blank" rel="noopener">
                    Verify ↗
                  </a>
                </p>
                <p><strong class="text-[var(--color-ink)]">Licensed in</strong> California, Florida, Minnesota &amp; Texas</p>
                <p><strong class="text-[var(--color-ink)]">Branch</strong> Excelsior, MN</p>
              </div>
              <div class="mt-6 flex flex-col gap-3">
                <a href="#apply" class="btn btn-primary w-full">See What You Qualify For</a>
                <a href="tel:9524546635" class="btn btn-secondary w-full">(952) 454-6635</a>
                <a href="mailto:mpatterson@cliffcomortgage.com" class="text-sm text-[var(--color-accent)] no-underline hover:underline">
                  mpatterson@cliffcomortgage.com
                </a>
              </div>
            </div>

            <div>
              <p class="eyebrow">Your Minnesota Loan Officer</p>
              <h3 class="mt-3" style="font-size: var(--text-h2); font-weight: 300;">
                A real person who answers the phone.
              </h3>
              <div class="mt-5 space-y-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">
                <p>
                  At Cliffco Mortgage Bankers, Mitch Patterson works with Minnesota investors and homeowners to find financing that fits their actual situation, not a one-size-fits-all product.
                </p>
                <p>
                  What sets Mitch apart: he explains everything clearly, with no confusing terms and no surprises. He's in it for the long term, not just until your loan closes &mdash; and your file is handled locally, from Cliffco's Excelsior office.
                </p>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="bg-[var(--color-mist-gray)] py-20">
        <div class="container-wide max-w-3xl">
          <h2 style="font-size: var(--text-h2); font-weight: 300;">Questions investors ask before their first DSCR deal.</h2>
          <div class="mt-10 space-y-2">
            {faq.map((item) => (
              <details class="bg-white rounded-lg border border-[var(--color-mist-gray)] overflow-hidden">
                <summary class="flex items-center justify-between px-6 py-5 font-semibold text-[var(--color-ink)] cursor-pointer list-none">
                  {item.q}
                </summary>
                <p class="px-6 pb-6 text-sm text-[var(--color-text)] leading-relaxed border-t border-[var(--color-mist-gray)] pt-4">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- FINAL CTA -->
      <section class="accent-gradient">
        <div class="container-wide py-16 text-center">
          <h2 class="text-white" style="font-size: var(--text-h2); font-weight: 300;">Pre-qual in 24 hours. Close in 21&ndash;30 days.</h2>
          <p class="lead mt-4 text-white/85 max-w-xl mx-auto">Tell Mitch the address, the projected rent, and the down payment. He'll tell you what Cliffco can do.</p>
          <div class="mt-8 flex justify-center gap-3 flex-wrap">
            <a href="#apply" class="btn btn-primary !bg-white !text-[var(--color-rich-black)]">See What You Qualify For</a>
            <a href="tel:9524546635" class="btn btn-secondary !border-white !text-white">(952) 454-6635</a>
          </div>
        </div>
      </section>

    </main>

    <!-- FOOTER -->
    <footer class="bg-[var(--color-rich-black)] text-white">
      <div class="container-wide py-10">

        <div class="flex flex-wrap gap-4 justify-between items-center pb-6 border-b border-white/10">
          <img src="/logo-black.png" alt="Cliffco Mortgage Bankers" class="h-6 w-auto" style="filter: brightness(0) invert(1);" loading="lazy" />
          <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a href="https://cliffcomortgage.com/" class="text-white/60 hover:text-white no-underline" target="_blank" rel="noopener">Visit Full Site</a>
            <a href="https://cliffcomortgage.com/licensing/" class="text-white/60 hover:text-white no-underline" target="_blank" rel="noopener">Licensing</a>
            <a href="https://cliffcomortgage.com/privacy-policy/" class="text-white/60 hover:text-white no-underline" target="_blank" rel="noopener">Privacy Policy</a>
            <a href="https://www.nmlsconsumeraccess.org/" class="text-white/60 hover:text-white no-underline" target="_blank" rel="noopener">NMLS Consumer Access</a>
          </div>
        </div>

        <div class="mt-6 pb-6 border-b border-white/10 text-sm text-white/60">
          <p class="font-semibold text-white/80">Cliffco Mortgage Bankers &middot; Excelsior, MN</p>
          <p class="mt-1">276 Water Street, Excelsior, MN 55331</p>
          <p class="mt-0.5">Branch NMLS #2763960 &middot; <a href="tel:5162023307" class="hover:text-white no-underline">Office: 516-202-3307</a></p>
        </div>

        <div class="mt-6 text-xs text-white/40 leading-relaxed space-y-3">
          <p>
            Cliffco, Inc. is not affiliated with or acting on behalf of the FHA or any government entity. Equal Housing Lender. Cliffco, Inc. Corporate NMLS#65328 (<a href="https://www.nmlsconsumeraccess.org/" class="text-white/50 hover:text-white underline" target="_blank" rel="noopener">www.nmlsconsumeraccess.org</a>) 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553 (516) 408-7300. MN Department of Commerce #MN-MO-65328. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice.
          </p>
          <p>
            This site is not authorized by the New York State Department of Financial Services. No mortgage solicitation activity or loan applications for properties located in the State of New York can be facilitated through this site. This website is only for property of persons located in the state of Minnesota.
          </p>
        </div>

        <p class="mt-6 text-xs text-white/30">&copy; 2026 Cliffco, Inc. &middot; NMLS #65328 &middot; Equal Housing Lender</p>

      </div>
    </footer>

    <!-- MOBILE STICKY CTA -->
    <div class="lg:hidden fixed bottom-0 inset-x-0 z-50 bg-white border-t border-[var(--color-mist-gray)] p-3 shadow-[0_-4px_16px_rgba(13,13,13,0.08)]">
      <a href="#apply" class="btn btn-primary w-full text-sm !py-3">See What You Qualify For &middot; 2 Minutes</a>
    </div>
    <div class="lg:hidden h-16" aria-hidden="true"></div>

    <Analytics />
    <SpeedInsights />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('a[href^="tel:"]').forEach(function (el) {
          el.addEventListener('click', function () {
            window.posthog?.capture('phone_clicked', { phone_number: el.getAttribute('href').replace('tel:', '') });
          });
        });

        document.querySelectorAll('a[href^="mailto:"]').forEach(function (el) {
          el.addEventListener('click', function () {
            window.posthog?.capture('email_clicked', { email: el.getAttribute('href').replace('mailto:', '') });
          });
        });

        document.querySelectorAll('a[href*="nmlsconsumeraccess.org/EntityDetails"]').forEach(function (el) {
          el.addEventListener('click', function () {
            window.posthog?.capture('nmls_verify_clicked');
          });
        });

        document.querySelectorAll('a[href="https://cliffcomortgage.com/"]').forEach(function (el) {
          el.addEventListener('click', function () {
            window.posthog?.capture('full_site_visited');
          });
        });
      });

      // Render the HubSpot form and fire the Google Ads conversion on submit.
      // hbspt.forms.create's onFormSubmitted is a reliable lifecycle callback,
      // unlike the new hs-form-frame embed's postMessage (which fires inconsistently).
      if (window.hbspt && window.hbspt.forms) {
        window.hbspt.forms.create({
          region: 'na1',
          portalId: '21616430',
          formId: 'addd8c42-9e6a-40c0-a3bf-cbbe90331e8b',
          target: '#dscr-lead-form',
          onFormSubmitted: function () {
            if (typeof gtag === 'function') {
              gtag('event', 'conversion', {
                send_to: 'AW-17848823591/jWcrCIr7yvwcEKfe_b5C',
                value: 0.0,
                currency: 'USD'
              });
            }
            if (window.posthog) window.posthog.capture('dscr_mn_form_submitted');
          }
        });
      }
    </script>
  </body>
</html>
