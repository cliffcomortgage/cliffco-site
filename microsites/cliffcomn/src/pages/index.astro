---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Minnesota Mortgage Lender | Fast Home Loan Approval | Cliffco</title>
    <meta name="description" content="Cliffco Mortgage Bankers offers fast mortgage approval for Minnesota homebuyers. Work directly with Mitchell Patterson, your local MN loan officer. No credit pull. No commitment. Get started in 5 minutes." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Montserrat:wght@600&display=optional" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Montserrat:wght@600&display=optional" /></noscript>
  </head>

  <body class="min-h-screen flex flex-col">

    <!-- HEADER -->
    <header class="bg-white border-b border-[var(--color-mist-gray)] sticky top-0 z-40">
      <div class="container-wide flex items-center justify-between py-4">
        <a href="/" aria-label="Cliffco Mortgage Bankers home">
          <img src="/logo-black.png" alt="Cliffco Mortgage Bankers" class="h-8 w-auto" loading="eager" />
        </a>
        <a href="tel:9524546635" class="btn btn-primary text-sm !py-2 !px-5">
          Call Mitch: (952) 454-6635
        </a>
      </div>
    </header>

    <main class="flex-1">

      <!-- HERO -->
      <section class="accent-gradient">
        <!-- Family background image fading into the gradient -->
        <div style="position:absolute;inset:0;overflow:hidden;z-index:0;pointer-events:none;" aria-hidden="true">
          <img
            src="/hero-family.jpg"
            alt=""
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center right;opacity:0.32;mix-blend-mode:luminosity;"
          />
          <div style="position:absolute;inset:0;background:linear-gradient(to right, rgba(13,13,13,0.98) 25%, rgba(13,13,13,0.7) 55%, rgba(13,13,13,0.25) 100%);"></div>
        </div>
        <div class="container-wide py-20 lg:py-28">
          <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

            <!-- Left: headline + CTA -->
            <div>
              <p class="eyebrow !text-[var(--color-ice-blue)]">Minnesota Mortgage Lender · Cliffco</p>
              <h1 class="mt-4 text-white max-w-xl" style="font-size: var(--text-display-xl); line-height: 1.08; font-weight: 700;">
                Fast Mortgage Approval for Minnesota Homebuyers.
              </h1>
              <p class="lead mt-5 text-white/85 max-w-lg">
                Cliffco has been getting families into homes since 1989. Now we're serving Minnesota with a fully digital intake process that takes minutes, not weeks, and a real loan officer who answers the phone.
              </p>
              <div class="mt-8">
                <a
                  href="https://cliffco-portal-prod.vercel.app/"
                  class="btn btn-primary !bg-white !text-[var(--color-rich-black)] hover:!bg-[var(--color-ice-blue)] text-base !px-8 !py-4"
                  target="_blank"
                  rel="noopener"
                >
                  Get Approved
                </a>
                <p class="mt-3 text-sm text-white/60">No credit pull. No commitment. Takes 5 minutes or less.</p>
              </div>
            </div>

            <!-- Right: Mitch card -->
            <div class="flex justify-center lg:justify-end">
              <div class="card max-w-lg w-full text-center !p-8">
                <img
                  src="/mitchell-patterson.webp"
                  alt="Mitchell Patterson, Cliffco Loan Officer"
                  class="w-36 h-36 rounded-full object-cover mx-auto border-4 border-[var(--color-accent)]/20"
                  loading="eager"
                />
                <h2 class="mt-4 text-xl font-bold text-[var(--color-ink)]">Mitch Patterson</h2>
                <p class="text-[var(--color-text-muted)] text-sm mt-1">Loan Officer &middot; NMLS #2560483</p>
                <p class="text-[var(--color-text-muted)] text-xs mt-0.5">Licensed in Minnesota &amp; Texas</p>
                <div class="mt-5 flex flex-col gap-3">
                  <a
                    href="https://cliffco-portal-prod.vercel.app/"
                    class="btn btn-primary w-full"
                    target="_blank"
                    rel="noopener"
                  >
                    Get Approved
                  </a>
                  <a href="tel:9524546635" class="btn btn-secondary w-full">
                    (952) 454-6635
                  </a>
                  <a
                    href="mailto:mpatterson@cliffcomortgage.com"
                    class="text-sm text-[var(--color-accent)] no-underline hover:underline"
                  >
                    mpatterson@cliffcomortgage.com
                  </a>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- TRUST BAR -->
      <section class="bg-[var(--color-mist-gray)] py-12">
        <div class="container-wide">
          <p class="text-center text-sm text-[var(--color-text-muted)] mb-8">Cliffco Mortgage Bankers company-wide stats: the team and track record behind your loan.</p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            {[
              { stat: "37+", label: "Years in business" },
              { stat: "32", label: "Licensed states" },
              { stat: "$6B+", label: "Mortgages closed" },
              { stat: "4.9★", label: "Average rating" },
            ].map((item) => (
              <div class="flex flex-col gap-1">
                <span class="text-3xl font-bold text-[var(--color-accent)]">{item.stat}</span>
                <span class="text-sm text-[var(--color-text-muted)]">{item.label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ABOUT MITCH -->
      <section class="bg-white py-20">
        <div class="container-wide">
          <div class="grid lg:grid-cols-[320px_1fr] gap-12 items-start">

            <!-- Photo + contact card -->
            <div class="text-center">
              <img
                src="/mitchell-patterson.webp"
                alt="Mitchell Patterson, Cliffco Mortgage Loan Officer"
                class="w-48 h-48 rounded-2xl object-cover mx-auto shadow-lg"
                loading="lazy"
              />
              <h2 class="mt-5 text-2xl font-bold text-[var(--color-ink)]">Mitch Patterson</h2>
              <p class="text-[var(--color-accent)] font-semibold text-sm mt-1">Loan Officer</p>
              <div class="mt-4 space-y-2 text-sm text-[var(--color-text-muted)]">
                <p>
                  <strong class="text-[var(--color-ink)]">NMLS</strong> #2560483 &middot;
                  <a
                    href="https://www.nmlsconsumeraccess.org/EntityDetails.aspx/INDIVIDUAL/2560483"
                    class="text-[var(--color-accent)] no-underline hover:underline"
                    target="_blank"
                    rel="noopener"
                  >
                    Verify ↗
                  </a>
                </p>
                <p><strong class="text-[var(--color-ink)]">Licensed in</strong> Minnesota &amp; Texas</p>
                <p><strong class="text-[var(--color-ink)]">Branch</strong> Excelsior, MN</p>
              </div>
              <div class="mt-6 flex flex-col gap-3">
                <a
                  href="https://cliffco-portal-prod.vercel.app/"
                  class="btn btn-primary w-full"
                  target="_blank"
                  rel="noopener"
                >
                  Get Approved
                </a>
                <a href="tel:9524546635" class="btn btn-secondary w-full">
                  (952) 454-6635
                </a>
                <a
                  href="mailto:mpatterson@cliffcomortgage.com"
                  class="text-sm text-[var(--color-accent)] no-underline hover:underline"
                >
                  mpatterson@cliffcomortgage.com
                </a>
              </div>
            </div>

            <!-- Bio -->
            <div>
              <p class="eyebrow">Your Minnesota Loan Officer</p>
              <h3 class="mt-3" style="font-size: var(--text-h2);">
                Mortgage options you can actually understand.
              </h3>
              <div class="mt-5 space-y-4 text-[var(--color-text)] leading-relaxed" style="font-size: 1.0625rem;">
                <p>
                  At Cliffco Mortgage Bankers, Mitch Patterson helps Minnesota homebuyers find their path to homeownership, even when that path looks complicated. Many of his clients are surprised to discover financing solutions they never knew existed.
                </p>
                <p>
                  What sets Mitch apart: he explains everything clearly, with no confusing terms and no surprises. He builds loan options around your specific situation and goals, not around a quota. And he's in it for the long term, not just until your loan closes.
                </p>
                <p>
                  Whether you're buying your very first home, moving up, or starting a new chapter, Mitch will guide you through every step of the process.
                </p>
              </div>

              <!-- Key differentiators -->
              <div class="mt-8 grid sm:grid-cols-2 gap-4">
                {[
                  { heading: "Clear communication", body: "No jargon, no surprises. You'll know exactly where you stand at every step." },
                  { heading: "Built around you", body: "Loan options tailored to your personal situation and goals, not a one-size-fits-all product." },
                  { heading: "Long-term relationship", body: "Mitchell is here after closing too. Your success is the point, not just the transaction." },
                  { heading: "Access to more options", body: "Cliffco works with multiple lenders to find you the best possible rates and terms for your situation." },
                ].map((item) => (
                  <div class="card">
                    <h4 class="font-semibold text-[var(--color-ink)]">{item.heading}</h4>
                    <p class="mt-1 text-sm text-[var(--color-text-muted)] leading-relaxed">{item.body}</p>
                  </div>
                ))}
              </div>
            </div>

          </div>
        </div>
      </section>

    </main>

    <!-- FOOTER -->
    <footer class="bg-[var(--color-rich-black)] text-white">
      <div class="container-wide py-10">

        <!-- Top row: logo + links -->
        <div class="flex flex-wrap gap-4 justify-between items-center pb-6 border-b border-white/10">
          <img
            src="/logo-black.png"
            alt="Cliffco Mortgage Bankers"
            class="h-6 w-auto"
            style="filter: brightness(0) invert(1);"
            loading="lazy"
          />
          <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a
              href="https://cliffcomortgage.com/"
              class="text-white/60 hover:text-white no-underline"
              target="_blank"
              rel="noopener"
            >
              Visit Full Site
            </a>
            <a
              href="https://cliffcomortgage.com/licensing/"
              class="text-white/60 hover:text-white no-underline"
              target="_blank"
              rel="noopener"
            >
              Licensing
            </a>
            <a
              href="https://cliffcomortgage.com/privacy-policy/"
              class="text-white/60 hover:text-white no-underline"
              target="_blank"
              rel="noopener"
            >
              Privacy Policy
            </a>
            <a
              href="https://www.nmlsconsumeraccess.org/"
              class="text-white/60 hover:text-white no-underline"
              target="_blank"
              rel="noopener"
            >
              NMLS Consumer Access
            </a>
          </div>
        </div>

        <!-- Disclaimer -->
        <div class="mt-6 text-xs text-white/40 leading-relaxed space-y-3">
          <p>
            Cliffco, Inc. is not affiliated with or acting on behalf of the FHA or any government entity. Equal Housing Lender. Cliffco, Inc. Corporate NMLS#65328 (<a href="https://www.nmlsconsumeraccess.org/" class="text-white/50 hover:text-white underline" target="_blank" rel="noopener">www.nmlsconsumeraccess.org</a>) 70 Charles Lindbergh Blvd, Suite 200, Uniondale, NY 11553 (516) 408-7300. MN Department of Commerce #MN-MO-65328. This is not a commitment to lend or extend credit. Restrictions may apply. All loans are subject to credit and underwriting approval. Not all loan products are available in all states. Rates may not be available at time of application. Information and/or data are subject to change without notice.
          </p>
          <p>
            This site is not authorized by the New York State Department of Financial Services. No mortgage solicitation activity or loan applications for properties located in the State of New York can be facilitated through this site. This website is only for property of persons located in the state of Minnesota.
          </p>
        </div>

        <p class="mt-6 text-xs text-white/30">&copy; 2026 Cliffco, Inc. &middot; NMLS #65328 &middot; Equal Housing Lender</p>

      </div>
    </footer>

    <Analytics />
    <SpeedInsights />
  </body>
</html>
